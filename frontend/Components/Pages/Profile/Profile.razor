@page "/profile"
@inject Frontend.ViewModels.ProfileViewModel VM
@inject Frontend.ViewModels.AuthViewModel AuthVM
@inject Frontend.Services.AuthService AuthService
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IConfiguration Configuration
@layout Frontend.Components.Layout.ProfileLayout
@implements IDisposable

<PageTitle>Hồ Sơ Của Tôi — NexusKeys</PageTitle>
<h1 class="sr-only">Hồ sơ của tôi</h1>

<div class="space-y-6 w-full">
    @if (VM.IsLoading && VM.Profile == null)
    {
        <div class="flex items-center justify-center h-64 bg-[#18181c] rounded-2xl border border-white/10">
            <div class="flex flex-col items-center gap-3">
                <span class="loading loading-spinner loading-lg text-[#0078f2]"></span>
                <span class="text-xs text-white/50 uppercase tracking-widest font-bold">Đang tải hồ sơ...</span>
            </div>
        </div>
    }
    else if (VM.Profile != null)
    {
        @* Page Header *@
        <div class="mb-2">
            <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">Cài Đặt Tài Khoản</h1>
            <p class="text-xs sm:text-sm text-white/60 mt-1">Quản lý thông tin cá nhân, cài đặt mật khẩu và trạng thái an toàn tài khoản.</p>
        </div>

        @* Quick Info Cards *@
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-[#18181c] p-6 rounded-2xl border border-white/10 relative overflow-hidden flex flex-col justify-between shadow-xl">
                <div class="flex items-start justify-between">
                    <div>
                        <span class="text-[11px] font-black uppercase tracking-wider text-white/40 block mb-1">Ví NexusPay</span>
                        <div class="text-3xl font-black text-white">@VM.Profile.WalletBalance.ToString("N0") <span class="text-lg font-bold text-white/50">₫</span></div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-[#0078f2]/10 border border-[#0078f2]/20 flex items-center justify-center text-[#0078f2]">
                        <Icon Name="HeroiconName.Wallet" Class="w-6 h-6" IconType="HeroiconType.Solid" />
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between">
                    <span class="text-xs text-white/50">Sử dụng thanh toán game tức thì</span>
                    <a href="/profile/wallet" class="px-4 py-2 rounded-xl bg-[#0078f2] hover:bg-[#0068d6] text-white text-xs font-black uppercase tracking-wider shadow-md shadow-[#0078f2]/30 transition-all flex items-center gap-1.5 active:scale-95">
                        <Icon Name="HeroiconName.Plus" Class="w-3.5 h-3.5" />
                        <span>Nạp Tiền</span>
                    </a>
                </div>
            </div>
            
            <div class="bg-[#18181c] p-6 rounded-2xl border border-white/10 flex flex-col justify-between shadow-xl">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                        <Icon Name="HeroiconName.ShieldCheck" Class="w-6 h-6" IconType="HeroiconType.Solid" />
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="text-base font-bold text-white">Bảo Mật Tài Khoản</h2>
                            <span class="px-2.5 py-0.5 rounded text-xs font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                                Đã bảo vệ
                            </span>
                        </div>
                        <p class="text-sm text-white/60 mt-1 leading-relaxed">Xác thực 2 bước (2FA) đang hoạt động. Bạn sẽ nhận thông báo khi có đăng nhập từ thiết bị lạ.</p>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-white/50">
                    <span>Mức độ an toàn: Tối ưu</span>
                    <span class="text-emerald-400 font-bold flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> 2FA Hoạt động
                    </span>
                </div>
            </div>
        </div>

        @* Personal Information Form *@
        <div class="bg-[#18181c] rounded-2xl border border-white/10 shadow-xl overflow-hidden">
            <div class="p-5 sm:p-6 border-b border-white/10 bg-[#202024]/60 flex items-center justify-between">
                <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2.5">
                    <Icon Name="HeroiconName.User" Class="w-5 h-5 text-[#0078f2]" />
                    <span>Thông Tin Cá Nhân</span>
                </h2>
                <span class="text-xs text-white/40 hidden sm:inline">ID: @VM.Profile.Username</span>
            </div>
            
            <div class="p-5 sm:p-6">
                @if (!string.IsNullOrEmpty(VM.SuccessMessage))
                {
                    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 flex items-center gap-3 text-sm mb-6">
                        <Icon Name="HeroiconName.CheckCircle" Class="w-5 h-5 shrink-0" IconType="HeroiconType.Solid" />
                        <span>@VM.SuccessMessage</span>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(VM.ErrorMessage))
                {
                    <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 flex items-center gap-3 text-sm mb-6">
                        <Icon Name="HeroiconName.ExclamationCircle" Class="w-5 h-5 shrink-0" IconType="HeroiconType.Solid" />
                        <span>@VM.ErrorMessage</span>
                    </div>
                }

                <form @onsubmit="HandleUpdate" @onsubmit:preventDefault="true" class="space-y-5 max-w-2xl">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="profile-username" class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-2">
                                Tên đăng nhập
                            </label>
                            <input id="profile-username" type="text" value="@VM.Profile.Username" disabled class="w-full bg-[#202024] border border-white/10 rounded-xl px-4 py-3 text-sm text-white/40 cursor-not-allowed font-medium select-none" />
                            <span class="text-[11px] text-white/40 mt-1 block">Tên tài khoản không thể chỉnh sửa.</span>
                        </div>
                        
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label for="profile-email" class="block text-xs font-bold uppercase tracking-wider text-white/60">
                                    Địa chỉ Email
                                </label>
                                <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">Đã xác minh</span>
                            </div>
                            <input id="profile-email" type="email" value="@VM.Profile.Email" disabled class="w-full bg-[#202024] border border-white/10 rounded-xl px-4 py-3 text-sm text-white/40 cursor-not-allowed font-medium select-none" />
                            <span class="text-[11px] text-white/40 mt-1 block">Dùng để nhận License Key và hóa đơn.</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="profile-full-name" class="block text-xs font-bold uppercase tracking-wider text-white/70 mb-2">
                                Họ và Tên
                            </label>
                            <input id="profile-full-name" type="text" @bind="_fullName" @bind:event="oninput" class="w-full bg-[#202024] border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:border-[#0078f2] focus:ring-1 focus:ring-[#0078f2] outline-none transition-all" placeholder="Nguyễn Văn A" />
                        </div>
                        
                        <div>
                            <label for="profile-phone" class="block text-xs font-bold uppercase tracking-wider text-white/70 mb-2">
                                Số điện thoại
                            </label>
                            <input id="profile-phone" type="tel" @bind="_phone" @bind:event="oninput" class="w-full bg-[#202024] border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:border-[#0078f2] focus:ring-1 focus:ring-[#0078f2] outline-none transition-all" placeholder="0901234567" />
                        </div>
                    </div>
                    
                    <div class="pt-2">
                        <button type="submit" class="px-6 py-3 rounded-xl bg-[#0078f2] hover:bg-[#0060c2] text-white text-xs font-black uppercase tracking-wider transition-all shadow-lg shadow-[#0078f2]/30 active:scale-95 flex items-center gap-2" disabled="@VM.IsLoading">
                            @if (VM.IsLoading)
                            {
                                <span class="loading loading-spinner loading-xs"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <Icon Name="HeroiconName.Check" Class="w-4 h-4" />
                                <span>Lưu Thay Đổi</span>
                            }
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
        @* Change Password Form *@
        <div class="bg-[#18181c] rounded-2xl border border-white/10 shadow-xl overflow-hidden">
            <div class="p-5 sm:p-6 border-b border-white/10 bg-[#202024]/60 flex items-center justify-between">
                <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2.5">
                    <Icon Name="HeroiconName.LockClosed" Class="w-5 h-5 text-amber-400" />
                    <span>Đổi Mật Khẩu</span>
                </h2>
                <span class="text-xs text-white/40">Tối thiểu 6 ký tự</span>
            </div>
            
            <div class="p-5 sm:p-6">
                @if (!string.IsNullOrEmpty(_pwdSuccessMessage))
                {
                    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 flex items-center gap-3 text-sm mb-6">
                        <Icon Name="HeroiconName.CheckCircle" Class="w-5 h-5 shrink-0" IconType="HeroiconType.Solid" />
                        <span>@_pwdSuccessMessage</span>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(_pwdErrorMessage))
                {
                    <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 flex items-center gap-3 text-sm mb-6">
                        <Icon Name="HeroiconName.ExclamationCircle" Class="w-5 h-5 shrink-0" IconType="HeroiconType.Solid" />
                        <span>@_pwdErrorMessage</span>
                    </div>
                }

                <form @onsubmit="HandleChangePassword" @onsubmit:preventDefault="true" class="space-y-4 max-w-2xl">
                    <div>
                        <label for="current-password" class="block text-xs font-bold uppercase tracking-wider text-white/70 mb-2">
                            Mật khẩu hiện tại
                        </label>
                        <div class="relative">
                            <input id="current-password" type="password" @bind="_currentPassword" @bind:event="oninput" required class="w-full bg-[#202024] border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:border-[#0078f2] focus:ring-1 focus:ring-[#0078f2] outline-none transition-all" placeholder="••••••••" />
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="new-password" class="block text-xs font-bold uppercase tracking-wider text-white/70 mb-2">
                                Mật khẩu mới
                            </label>
                            <input id="new-password" type="password" @bind="_newPassword" @bind:event="oninput" required minlength="6" class="w-full bg-[#202024] border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:border-[#0078f2] focus:ring-1 focus:ring-[#0078f2] outline-none transition-all" placeholder="••••••••" />
                        </div>
                        
                        <div>
                            <label for="confirm-password" class="block text-xs font-bold uppercase tracking-wider text-white/70 mb-2">
                                Xác nhận mật khẩu mới
                            </label>
                            <input id="confirm-password" type="password" @bind="_confirmPassword" @bind:event="oninput" required minlength="6" class="w-full bg-[#202024] border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:border-[#0078f2] focus:ring-1 focus:ring-[#0078f2] outline-none transition-all" placeholder="••••••••" />
                        </div>
                    </div>
                    
                    <div class="pt-2">
                        <button type="submit" class="px-6 py-3 rounded-xl bg-[#202024] hover:bg-[#28282d] border border-white/15 text-white text-xs font-black uppercase tracking-wider transition-all shadow-md active:scale-95 flex items-center gap-2" disabled="@_isChangingPwd">
                            @if (_isChangingPwd)
                            {
                                <span class="loading loading-spinner loading-xs"></span>
                                <span>Đang cập nhật...</span>
                            }
                            else
                            {
                                <Icon Name="HeroiconName.Key" Class="w-4 h-4 text-amber-400" />
                                <span>Cập Nhật Mật Khẩu</span>
                            }
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @* Admin Quick Access (If Staff or Admin) *@
        @if (string.Equals(AuthVM.Role, "Admin", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(AuthVM.Role, "Staff", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(AuthVM.Role, "Developer", StringComparison.OrdinalIgnoreCase))
        {
            <div class="bg-[#18181c] rounded-2xl border border-white/10 p-5 sm:p-6 shadow-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl bg-[#0078f2]/10 border border-[#0078f2]/20 text-[#0078f2] flex items-center justify-center shrink-0">
                        <Icon Name="HeroiconName.ShieldCheck" Class="w-6 h-6" />
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-white">Bảng Quản Trị Hệ Thống</h3>
                        <p class="text-xs text-white/50 mt-0.5">Bạn có quyền truy cập vào bảng điều khiển quản trị NexusKeys Admin Studio.</p>
                    </div>
                </div>
                <button type="button" @onclick="GoToAdminPanel" class="px-5 py-2.5 rounded-xl bg-[#0078f2] hover:bg-[#0060c2] text-white text-xs font-black uppercase tracking-wider transition-all shadow-md shadow-[#0078f2]/30 active:scale-95 shrink-0 flex items-center gap-2">
                    <span>Mở Admin Portal</span>
                    <Icon Name="HeroiconName.ArrowTopRightOnSquare" Class="w-4 h-4" />
                </button>
            </div>
        }
    }
</div>

@code {
    private string _fullName = "";
    private string _phone = "";
    
    // Password fields
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string _pwdSuccessMessage = "";
    private string _pwdErrorMessage = "";
    private bool _isChangingPwd = false;
    
    protected override async Task OnInitializedAsync()
    {
        VM.StateChanged += StateHasChanged;
        await VM.LoadProfileAsync();
        
        if (VM.Profile != null)
        {
            _fullName = VM.Profile.FullName;
            _phone = VM.Profile.PhoneNumber;
        }
    }
    
    private async Task HandleUpdate()
    {
        await VM.UpdateProfileAsync(_fullName, _phone, VM.Profile?.AvatarUrl ?? "");
    }
    
    private async Task HandleChangePassword()
    {
        _pwdSuccessMessage = "";
        _pwdErrorMessage = "";
        
        if (string.IsNullOrEmpty(_currentPassword) || string.IsNullOrEmpty(_newPassword) || string.IsNullOrEmpty(_confirmPassword))
        {
            _pwdErrorMessage = "Vui lòng nhập đầy đủ thông tin.";
            return;
        }
        
        if (_newPassword != _confirmPassword)
        {
            _pwdErrorMessage = "Mật khẩu xác nhận không khớp.";
            return;
        }
        
        if (_newPassword.Length < 6)
        {
            _pwdErrorMessage = "Mật khẩu mới phải có ít nhất 6 ký tự.";
            return;
        }
        
        _isChangingPwd = true;
        
        var request = new Frontend.Models.Auth.ChangePasswordRequest
        {
            CurrentPassword = _currentPassword,
            NewPassword = _newPassword,
            ConfirmPassword = _confirmPassword
        };

        var response = await AuthService.ChangePasswordAsync(request);
        
        if (response.IsSuccessStatusCode)
        {
            _pwdSuccessMessage = "Đổi mật khẩu thành công!";
            _currentPassword = "";
            _newPassword = "";
            _confirmPassword = "";
        }
        else
        {
            var errorResult = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            if (errorResult.TryGetProperty("message", out var msgProp))
            {
                _pwdErrorMessage = msgProp.GetString() ?? "Lỗi khi đổi mật khẩu.";
            }
            else
            {
                _pwdErrorMessage = "Đã xảy ra lỗi hệ thống khi đổi mật khẩu.";
            }
        }

        _isChangingPwd = false;
    }
    
    private async Task GoToAdminPanel()
    {
        var adminUrl = Configuration["AdminPortal:BaseUrl"]?.TrimEnd('/') ?? "http://localhost:3001";
        await JS.InvokeVoidAsync("open", $"{adminUrl}/Auth/Login", "_blank", "noopener,noreferrer");
    }

    public void Dispose()
    {
        VM.StateChanged -= StateHasChanged;
    }
}
