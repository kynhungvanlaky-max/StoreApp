@page "/profile/library"
@inject Frontend.ViewModels.ProfileViewModel VM
@inject IJSRuntime JSRuntime
@inject Frontend.Services.ToastService ToastService
@inject Frontend.Services.ToastService ToastService
@layout Frontend.Components.Layout.ProfileLayout
@implements IDisposable

<PageTitle>Thư Viện Của Tôi — NexusKeys</PageTitle>
<div class="w-full">
    <div class="flex items-center gap-3 mb-8">
        <span class="badge badge-primary badge-lg ml-2">@VM.Library.Count tựa game</span>
    </div>

    @if (VM.IsLoading && VM.Library.Count == 0)
    {
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
            @for (int i = 0; i < 10; i++)
            {
                <div class="card bg-base-200 border border-base-300">
                    <div class="skeleton aspect-[3/4] w-full rounded-b-none"></div>
                    <div class="p-3">
                        <div class="skeleton h-4 w-full mb-2"></div>
                        <div class="skeleton h-3 w-1/2"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (VM.Library.Count == 0)
    {
        <div class="bg-[#202020] rounded-2xl border border-[#303030] p-12 text-center shadow-xl">
            <h2 class="text-2xl font-bold text-white mb-2">Thư viện trống</h2>
            <p class="text-gray-400 mb-6">Bạn chưa sở hữu sản phẩm nào. Hãy dạo qua Cửa hàng để tìm tựa game ưng ý nhé!</p>
            <a href="/products" class="btn btn-primary btn-lg">
                <Icon Name="HeroiconName.BuildingStorefront" Class="w-5 h-5 inline-block mr-2" /> Đến Cửa Hàng
            </a>
        </div>
    }
    else
    {
        <div class="flex justify-between items-center mb-6 bg-base-200 p-3 rounded-xl border border-base-300">
            <div class="flex-1 max-w-sm relative">
                <Icon Name="HeroiconName.MagnifyingGlass" Class="w-5 h-5 absolute left-3 top-2.5 text-gray-400" />
                <input type="text" @bind="_searchQuery" @bind:event="oninput" placeholder="Tìm kiếm trong thư viện..." class="input input-sm input-bordered w-full bg-base-300 pl-10" />
            </div>
            
            <div class="flex gap-2">
                <button class="btn btn-sm btn-ghost btn-square @(_viewMode == "grid" ? "bg-base-300 text-white" : "text-gray-500")" @onclick='@(() => _viewMode = "grid")'>
                    <Icon Name="HeroiconName.Squares2x2" Class="w-5 h-5" />
                </button>
                <button class="btn btn-sm btn-ghost btn-square @(_viewMode == "list" ? "bg-base-300 text-white" : "text-gray-500")" @onclick='@(() => _viewMode = "list")'>
                    <Icon Name="HeroiconName.ListBullet" Class="w-5 h-5" />
                </button>
            </div>
        </div>

        var filteredLibrary = VM.Library
            .Where(l => string.IsNullOrEmpty(_searchQuery) || l.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
            .ToList();
            
        var groupedLibrary = filteredLibrary.GroupBy(l => l.Id).ToList();

        <div class="space-y-4">
            @foreach (var group in groupedLibrary)
            {
                var firstItem = group.First();
                var keys = group.ToList();
                var isExpanded = _expandedGroups.Contains(firstItem.Id);

                <div class="bg-[#202020] border border-[#303030] rounded-xl overflow-hidden transition-colors hover:border-[#404040]">
                    <div class="flex items-center justify-between p-4 cursor-pointer" @onclick='@(() => ToggleGroup(firstItem.Id))'>
                        <div class="flex items-center gap-4">
                            <img src="@(string.IsNullOrEmpty(firstItem.ImageUrl) ? "/images/placeholder-game.jpg" : firstItem.ImageUrl)" class="w-16 h-16 rounded-lg object-cover" />
                            <div class="flex-1">
                                <h3 class="text-xl font-bold text-white">@firstItem.Name</h3>
                                <p class="text-sm text-gray-400 mt-1">Sở hữu <span class="text-primary font-bold">@keys.Count</span> bản quyền</p>
                            </div>
                        </div>
                        <Icon Name="@(isExpanded ? HeroiconName.ChevronUp : HeroiconName.ChevronDown)" Class="w-6 h-6 text-gray-500" />
                    </div>
                    
                    @if (isExpanded)
                    {
                        <div class="px-4 md:px-8 pb-5 border-t border-[#303030]/50 pt-5">
                            <div class="space-y-3 w-full">
                                @foreach (var keyItem in keys)
                                {
                                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between bg-[#151515] p-4 rounded-xl border border-[#303030]">
                                        <div class="flex flex-col mb-3 md:mb-0">
                                            <span class="text-xs text-gray-500 mb-1">Ngày mua: @keyItem.AcquiredDate.ToString("dd/MM/yyyy")</span>
                                            @if (_revealedKeys.Contains(keyItem.KeyCode))
                                            {
                                                <span class="font-mono text-white tracking-widest font-bold text-lg">@keyItem.KeyCode</span>
                                            }
                                            else
                                            {
                                                <span class="font-mono text-gray-600 tracking-widest font-bold text-lg">XXXX-XXXX-XXXX-XXXX</span>
                                            }
                                        </div>
                                        <div class="flex gap-2 w-full md:w-auto">
                                            @if (_revealedKeys.Contains(keyItem.KeyCode))
                                            {
                                                <button class="btn btn-sm btn-ghost text-gray-400" @onclick='@(() => _revealedKeys.Remove(keyItem.KeyCode))'>
                                                    <Icon Name="HeroiconName.EyeSlash" Class="w-4 h-4 mr-1" /> Ẩn
                                                </button>
                                                <button class="btn btn-sm btn-primary btn-outline flex-1 md:flex-none" @onclick='@(() => CopyToClipboard(keyItem.KeyCode))'>
                                                    <Icon Name="HeroiconName.DocumentDuplicate" Class="w-4 h-4 mr-1" /> Sao chép
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-primary btn-sm rounded-full flex-1 md:flex-none shadow-lg shadow-primary/30" @onclick='@(() => _revealedKeys.Add(keyItem.KeyCode))'>
                                                    <Icon Name="HeroiconName.Eye" Class="w-4 h-4 mr-1" /> Hiển thị Key
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private string _searchQuery = "";
    private string _viewMode = "grid";
    private HashSet<string> _revealedKeys = new();
    private HashSet<int> _expandedGroups = new();
    
    protected override async Task OnInitializedAsync()
    {
        VM.StateChanged += StateHasChanged;
        await VM.LoadLibraryAsync();
    }
    
    public void Dispose()
    {
        VM.StateChanged -= StateHasChanged;
    }

    private async Task CopyToClipboard(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        ToastService.ShowSuccess("Đã sao chép Key vào khay nhớ tạm!");
    }

    private void ToggleGroup(int id)
    {
        if (_expandedGroups.Contains(id))
            _expandedGroups.Remove(id);
        else
            _expandedGroups.Add(id);
    }
}
