@page "/cart"
@inject Frontend.ViewModels.CartViewModel VM
@implements IDisposable

<PageTitle>Giỏ Hàng — NexusKeys</PageTitle>

<div class="container mx-auto px-4 py-8 max-w-6xl">
    @if (VM.Items.Count == 0)
    {
        <div class="bg-[#202020] rounded-2xl border border-[#303030] p-12 text-center shadow-xl">
            <h2 class="text-2xl font-bold text-white mb-2">Giỏ hàng trống</h2>
            <p class="text-gray-400 mb-6">Bạn chưa thêm sản phẩm nào vào giỏ hàng. Khám phá kho game khổng lồ của chúng tôi ngay!</p>
            <a href="/products" class="btn btn-primary btn-lg">
                <Icon Name="HeroiconName.BuildingStorefront" Class="w-5 h-5 mr-2" /> Đến Cửa Hàng
            </a>
        </div>
    }
    else
    {
        <div class="flex flex-col lg:flex-row gap-8">
            @* Cart Items List *@
            <div class="flex-1 space-y-4">
                @foreach (var item in VM.Items)
                {
                    <div @onclick="() => VM.ToggleSelectionAsync(item.ProductId)" 
                         class="cursor-pointer bg-[#202020] rounded-xl border p-4 flex gap-4 items-center group transition-all duration-300
                                @(item.IsSelected ? "border-[#0078F2] shadow-lg shadow-[#0078F2]/20" : "border-[#303030] opacity-60 hover:opacity-100 hover:border-[#0078F2]/50")">
                        
                        <div class="flex-shrink-0">
                            @if (item.IsSelected)
                            {
                                <Icon Name="HeroiconName.CheckCircle" Class="w-6 h-6 text-primary" IconType="HeroiconType.Solid" />
                            }
                            else
                            {
                                <div class="w-6 h-6 rounded-full border-2 border-gray-500 group-hover:border-primary transition-colors"></div>
                            }
                        </div>

                        <div class="w-32 aspect-video rounded-lg overflow-hidden bg-[#303030] flex-shrink-0">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder-game.jpg" : item.ImageUrl)" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                        </div>
                        <div class="flex-1">
                            <h3 class="font-bold text-white text-lg line-clamp-1"><a href="/products/@item.ProductId" class="hover:text-primary">@item.Name</a></h3>
                            <div class="text-primary font-bold mt-1">@item.Price.ToString("N0") đ</div>
                        </div>
                        <button @onclick="@(() => VM.RemoveFromCartAsync(item.ProductId))" @onclick:stopPropagation="true" class="btn btn-ghost btn-circle text-error hover:bg-error/20" title="Xóa">
                            <Icon Name="HeroiconName.Trash" Class="w-5 h-5" />
                        </button>
                    </div>
                }
                
                <div class="flex justify-between items-center mt-6 p-4 bg-[#202020]/50 rounded-xl border border-[#303030] border-dashed">
                    <button @onclick="VM.ClearCartAsync" class="btn btn-ghost text-error btn-sm">Xóa toàn bộ</button>
                    <a href="/products" class="btn btn-ghost btn-sm text-primary">Tiếp tục mua sắm</a>
                </div>
            </div>
            
            @* Order Summary *@
            <div class="w-full lg:w-96 flex-shrink-0">
                <div class="sticky top-24 bg-[#202020] rounded-2xl border border-[#303030] shadow-xl overflow-hidden">
                    <div class="p-6 border-b border-[#303030] bg-[#303030]/30">
                        <h2 class="text-xl font-bold text-white">Tóm Tắt Đơn Hàng</h2>
                    </div>
                    
                    <div class="p-6 space-y-4">
                        <div class="flex justify-between text-gray-400">
                            <span>Tạm tính (@VM.SelectedTotalItems sản phẩm)</span>
                            <span>@VM.SelectedTotalAmount.ToString("N0") đ</span>
                        </div>
                        <div class="flex justify-between text-gray-400">
                            <span>Giảm giá</span>
                            <span>0 đ</span>
                        </div>
                        <div class="divider my-2"></div>
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-white">Tổng cộng</span>
                            <div class="text-right">
                                <span class="text-3xl font-black text-primary">@VM.SelectedTotalAmount.ToString("N0") đ</span>
                                <div class="text-xs text-gray-500 mt-1">Đã bao gồm VAT (nếu có)</div>
                            </div>
                        </div>
                        
                        <a href="/checkout" class="btn btn-primary btn-lg w-full mt-6 shadow-lg shadow-primary/30 font-bold">
                            Thanh Toán Ngay <Icon Name="HeroiconName.ArrowRight" Class="w-5 h-5 ml-1" />
                        </a>
                        
                        <div class="flex items-center justify-center gap-2 mt-4 opacity-50">
                            <Icon Name="HeroiconName.LockClosed" Class="w-5 h-5" />
                            <span class="text-xs">Thanh toán an toàn & bảo mật</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        VM.StateChanged += StateHasChanged;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.InitializeAsync();
        }
    }
    
    public void Dispose()
    {
        VM.StateChanged -= StateHasChanged;
    }
}
