@page "/register"
@inject Frontend.ViewModels.AuthViewModel AuthViewModel
@inject Frontend.Services.AuthService AuthService
@inject NavigationManager NavigationManager
@using Frontend.Models.Auth

<PageTitle>Đăng Ký — NexusKeys</PageTitle>

<div class="flex items-center justify-center min-h-[calc(100vh-200px)] py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-[#202020] p-8 rounded-xl border border-[#303030]">
        <div class="text-center">
            <Icon Name="HeroiconName.UserPlus" Class="w-12 h-12 text-white mx-auto mb-4" IconType="HeroiconType.Solid" />
            <h1 class="mt-2 text-2xl font-bold text-white tracking-tight uppercase">
                Tạo Tài Khoản
            </h1>
            <p class="mt-2 text-sm text-gray-400">
                Đã có tài khoản?
                <a href="/login" class="font-bold text-white hover:underline uppercase tracking-wider text-xs ml-1">
                    Đăng nhập
                </a>
            </p>
        </div>
        <form class="mt-8 space-y-6" @onsubmit="HandleRegister" @onsubmit:preventDefault="true">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="p-4 bg-error/20 border border-error/50 rounded flex items-center gap-3 text-error text-sm">
                    <Icon Name="HeroiconName.ExclamationTriangle" Class="w-5 h-5 shrink-0" />
                    <span>@ErrorMessage</span>
                </div>
            }

            <div class="space-y-4">
                <div>
                    <label for="register-username" class="sr-only">Tên hiển thị</label>
                    <input id="register-username" type="text" @bind="RegisterRequest.Username" @bind:event="oninput" required autocomplete="username" class="w-full bg-[#121212] text-white text-sm rounded border border-transparent focus:border-white px-4 py-3 outline-none transition-colors" placeholder="Tên hiển thị của bạn">
                </div>
                <div>
                    <label for="register-email" class="sr-only">Email</label>
                    <input id="register-email" type="email" @bind="RegisterRequest.Email" @bind:event="oninput" required autocomplete="email" class="w-full bg-[#121212] text-white text-sm rounded border border-transparent focus:border-white px-4 py-3 outline-none transition-colors" placeholder="Địa chỉ email">
                </div>
                <div>
                    <label for="register-password" class="sr-only">Mật khẩu</label>
                    <input id="register-password" type="password" @bind="RegisterRequest.Password" @bind:event="oninput" required minlength="6" autocomplete="new-password" class="w-full bg-[#121212] text-white text-sm rounded border border-transparent focus:border-white px-4 py-3 outline-none transition-colors" placeholder="Mật khẩu (Ít nhất 6 ký tự)">
                </div>
                <div>
                    <label for="register-secret" class="sr-only">Mã bí mật (Không bắt buộc)</label>
                    <input id="register-secret" type="text" @bind="RegisterRequest.SecretCode" @bind:event="oninput" autocomplete="off" class="w-full bg-[#121212] text-white text-sm rounded border border-transparent focus:border-white px-4 py-3 outline-none transition-colors" placeholder="Mã nhận quyền đặc biệt (Không bắt buộc)">
                </div>
            </div>

            <div>
                <button type="submit" class="w-full py-4 px-6 text-sm font-bold text-[#121212] bg-[#0078F2] rounded hover:bg-[#005bb5] transition-colors uppercase tracking-wider flex items-center justify-center gap-2" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <div class="w-4 h-4 rounded-full border-2 border-black border-t-transparent animate-spin"></div>
                    }
                    Đăng Ký NGAY
                </button>
            </div>
            
            <div class="text-xs text-gray-500 text-center mt-4 leading-relaxed">
                Bằng việc đăng ký, bạn đồng ý với <a href="/terms" class="text-gray-300 hover:text-white underline">Điều khoản Dịch vụ</a> và <a href="/privacy" class="text-gray-300 hover:text-white underline">Chính sách Bảo mật</a> của chúng tôi.
            </div>
        </form>
    </div>
</div>

@code {
    private RegisterRequest RegisterRequest = new();
    private bool IsLoading = false;
    private string? ErrorMessage;

    protected override void OnInitialized()
    {
        if (AuthViewModel.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(RegisterRequest.Username) || 
            string.IsNullOrWhiteSpace(RegisterRequest.Email) || 
            string.IsNullOrWhiteSpace(RegisterRequest.Password))
        {
            ErrorMessage = "Vui lòng nhập đầy đủ thông tin bắt buộc.";
            return;
        }
        if (RegisterRequest.Password.Length < 6)
        {
            ErrorMessage = "Mật khẩu phải có ít nhất 6 ký tự.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        
        var success = await AuthService.RegisterAsync(RegisterRequest);
        if (success)
        {
            // Tự động đăng nhập
            var loginRequest = new LoginRequest { Email = RegisterRequest.Email, Password = RegisterRequest.Password };
            await AuthViewModel.LoginAsync(loginRequest);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Đăng ký thất bại. Email có thể đã tồn tại.";
        }
        
        IsLoading = false;
    }
}
