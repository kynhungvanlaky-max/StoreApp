@page "/forgot-password"
@inject Frontend.ViewModels.AuthViewModel AuthViewModel
@inject NavigationManager NavigationManager
@using Frontend.Models.Auth

<PageTitle>Quên Mật Khẩu — Nexus Store</PageTitle>

<div class="flex items-center justify-center min-h-[calc(100vh-200px)] py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-[#202020] p-8 rounded-xl border border-[#303030]">
        <div class="text-center">
            <Icon Name="HeroiconName.Key" Class="w-12 h-12 text-white mx-auto mb-4" IconType="HeroiconType.Solid" />
            <h2 class="mt-2 text-2xl font-bold text-white tracking-tight uppercase">
                Quên Mật Khẩu
            </h2>
            <p class="mt-2 text-sm text-gray-400">
                Nhập email của bạn và chúng tôi sẽ gửi liên kết để đặt lại mật khẩu.
            </p>
        </div>
        
        @if (IsSuccess)
        {
            <div class="p-4 bg-success/20 border border-success/50 rounded flex flex-col items-center gap-3 text-success text-center">
                <Icon Name="HeroiconName.CheckCircle" Class="w-10 h-10 shrink-0" />
                <span>@SuccessMessage</span>
                <a href="/login" class="mt-4 w-full py-3 px-6 text-sm font-bold text-[#121212] bg-[#0078F2] rounded hover:bg-[#005bb5] transition-colors uppercase tracking-wider block text-white">Quay lại Đăng nhập</a>
            </div>
        }
        else
        {
            <form class="mt-8 space-y-6" @onsubmit="HandleSubmit">
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="p-4 bg-error/20 border border-error/50 rounded flex items-center gap-3 text-error text-sm">
                        <Icon Name="HeroiconName.ExclamationTriangle" Class="w-5 h-5 shrink-0" />
                        <span>@ErrorMessage</span>
                    </div>
                }

                <div>
                    <label class="sr-only">Email</label>
                    <input type="email" @bind="Request.Email" required class="w-full bg-[#121212] text-white text-sm rounded border border-transparent focus:border-[#0078F2] px-4 py-3 outline-none transition-colors" placeholder="Địa chỉ email của bạn">
                </div>

                <div>
                    <button type="submit" class="w-full py-4 px-6 text-sm font-bold text-[#121212] bg-[#0078F2] rounded hover:bg-[#005bb5] transition-colors uppercase tracking-wider flex items-center justify-center gap-2" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <div class="w-4 h-4 rounded-full border-2 border-black border-t-transparent animate-spin"></div>
                        }
                        Gửi Yêu Cầu
                    </button>
                </div>
                
                <div class="text-center mt-4">
                    <a href="/login" class="text-sm font-medium text-gray-400 hover:text-white transition-colors flex items-center justify-center gap-1">
                        <Icon Name="HeroiconName.ArrowLeft" Class="w-4 h-4" /> Quay lại đăng nhập
                    </a>
                </div>
            </form>
        }
    </div>
</div>

@code {
    private ForgotPasswordRequest Request = new();
    private bool IsLoading = false;
    private bool IsSuccess = false;
    private string? ErrorMessage;
    private string? SuccessMessage;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(Request.Email))
        {
            ErrorMessage = "Vui lòng nhập địa chỉ email.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            var response = await AuthViewModel.ForgotPasswordAsync(Request);
            if (response.IsSuccessStatusCode)
            {
                IsSuccess = true;
                SuccessMessage = "Nếu email tồn tại trong hệ thống, chúng tôi đã gửi hướng dẫn lấy lại mật khẩu tới email của bạn.";
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                ErrorMessage = errorResult.TryGetProperty("message", out var msg) ? msg.GetString() : "Đã có lỗi xảy ra.";
            }
        }
        catch (Exception)
        {
            ErrorMessage = "Lỗi kết nối tới máy chủ.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}
