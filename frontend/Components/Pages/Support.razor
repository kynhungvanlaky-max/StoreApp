    private void ToggleFaq(int id)
    {
        if (_openFaqIds.Contains(id))
            _openFaqIds.Remove(id);
        else
            _openFaqIds.Add(id);
    }

    private void SelectCategory(string category)
    {
        _activeCategory = category;
        _faqSearch = "";
    }

    private void SetSearch(string keyword)
    {
        _faqSearch = keyword;
        _activeCategory = "all";
    }

    private List<FaqItem> GetFilteredFaqs()
    {
        return _faqList
            .Where(f => (_activeCategory == "all" || f.Category == _activeCategory))
            .Where(f => string.IsNullOrWhiteSpace(_faqSearch) || 
                        f.Question.Contains(_faqSearch, StringComparison.OrdinalIgnoreCase) || 
                        f.Answer.Contains(_faqSearch, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task SubmitTicket()
    {
        _isSubmitting = true;
        _errorMessage = "";
        
        var request = new Frontend.Services.CreateSupportTicketDto
        {
            Topic = _ticketTopic,
            Email = _ticketEmail,
            OrderId = string.IsNullOrWhiteSpace(_ticketOrderId) ? null : _ticketOrderId,
            Content = _ticketContent
        };

        var success = await SupportService.CreateTicketAsync(request);
        
        _isSubmitting = false;
        
        if (success)
        {
            _isTicketSubmitted = true;
        }
        else
        {
            _errorMessage = "Có lỗi xảy ra khi gửi yêu cầu. Vui lòng thử lại sau giây lát.";
        }
    }
    
    private void ResetForm()
    {
        _ticketTopic = "";
        _ticketEmail = "";
        _ticketOrderId = "";
        _ticketContent = "";
        _isTicketSubmitted = false;
    }
}
