@page "/"
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Epic Games Store | Official Storefront</PageTitle>

<div class="egs-wrap">
    <div class="egs-content">

        @* ================================================================= *@
        @* SUB-NAV: SEARCH STORE | DISCOVER | BROWSE | NEWS                  *@
        @* ================================================================= *@
        <div class="egs-subnav relative">
            @* Search Bar with Live Autocomplete Popover *@
            <div class="relative">
                <div class="egs-search-box">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    <input type="text" placeholder="Search store" aria-label="Search store"
                           @bind="_searchKeyword" @bind:event="oninput"
                           @onfocus="() => _showSearchDropdown = true"
                           @onkeydown="HandleSearchKeyDown" />
                </div>

                @if (_showSearchDropdown)
                {
                    <div class="fixed inset-0 z-[55] bg-transparent" @onclick="() => _showSearchDropdown = false"></div>
                    <div class="egs-quick-search-dropdown absolute left-0 top-12 z-[60] w-80 sm:w-96 p-3 bg-[#18181c] border border-white/10 rounded-2xl shadow-2xl text-white" style="max-height: 420px; overflow-y: auto;">
                        @if (string.IsNullOrWhiteSpace(_searchKeyword))
                        {
                            <div class="p-2">
                                <span class="text-xs font-black uppercase tracking-wider text-white/40 block mb-2">Xu hướng tìm kiếm</span>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var tag in _trendingKeywords)
                                    {
                                        <button type="button" @onclick="() => SelectTrending(tag)" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/15 text-xs text-white/80 hover:text-white transition-colors">
                                            @tag
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            var filtered = _quickSearchResults;
                            <div class="p-1">
                                <span class="text-xs font-black uppercase tracking-wider text-white/40 block px-2 mb-2">Gợi ý sản phẩm</span>
                                @if (filtered.Any())
                                {
                                    <div class="space-y-1">
                                        @foreach (var item in filtered)
                                        {
                                            <a href="@item.Link" @onclick="() => _showSearchDropdown = false" class="flex items-center gap-3 p-2 rounded-xl hover:bg-white/10 transition-colors">
                                                <img src="@item.Image" alt="@item.Title" class="w-10 h-12 rounded-lg object-cover bg-white/5" />
                                                <div class="flex-1 min-w-0">
                                                    <h4 class="text-xs font-bold text-white truncate">@item.Title</h4>
                                                    <span class="text-xs text-white/50 block">@item.Genre</span>
                                                    <div class="flex items-center gap-1.5 mt-0.5">
                                                        @if (item.Discount > 0)
                                                        {
                                                            <span class="px-2 py-0.5 rounded text-xs font-extrabold bg-[#0078f2] text-white">-@item.Discount%</span>
                                                        }
                                                        <span class="text-xs font-bold text-white">@item.Price</span>
                                                    </div>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="py-4 text-center text-xs text-white/50">
                                        Không tìm thấy game nào cho "@_searchKeyword"
                                    </div>
                                }

                                <div class="pt-2 mt-2 border-t border-white/10">
                                    <a href="/products?search=@Uri.EscapeDataString(_searchKeyword)" @onclick="() => _showSearchDropdown = false" class="text-xs text-[#0078f2] hover:underline font-bold block text-center py-1">
                                        Xem tất cả kết quả cho "@_searchKeyword" ➔
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Store Links *@
            <a href="/" class="egs-subnav-link active">Discover</a>
            <a href="/products" class="egs-subnav-link">Browse</a>
            <a href="/news" class="egs-subnav-link">News</a>
            <a href="/assistant" class="egs-subnav-link">Trợ lý AI</a>
        </div>

        @* ================================================================= *@
        @* SECTION 1: HERO SPOTLIGHT (Stage & Animated Rail)                 *@
        @* ================================================================= *@
        <section aria-label="Hero Spotlight">
            <div class="egs-hero-grid">
                @* Hero Stage with Animated Slide Transition, Verified Official Cover Art & Overlay *@
                <a href="@CurrentSlide.Link" class="egs-hero-stage egs-card-hover egs-shimmer-card" aria-label="@CurrentSlide.Title">
                    <img @key="_heroIndex" src="@CurrentSlide.Image" alt="@CurrentSlide.Title" class="egs-hero-bg egs-hero-stage-animated" />
                    <div class="egs-hero-overlay">
                        <span class="egs-hero-badge">@CurrentSlide.Badge</span>
                        <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-white tracking-tight drop-shadow-md">@CurrentSlide.Title</h2>
                        <p class="egs-hero-desc">@CurrentSlide.Description</p>
                        <span class="egs-hero-price">@CurrentSlide.Price</span>
                        <div class="egs-hero-actions">
                            <span class="egs-hero-btn-buy">Khám phá ngay</span>
                            <span class="egs-hero-btn-icon" title="Thêm vào danh sách ước">
                                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                            </span>
                        </div>
                    </div>
                </a>

                @* Hero Rail with Authentic Dynamic Visuals & Animated Progress Bar *@
                <div class="egs-hero-rail-wrap">
                    <div class="egs-hero-rail">
                        @for (int i = 0; i < _slides.Length; i++)
                        {
                            var idx = i;
                            var slide = _slides[idx];
                            var isActive = _heroIndex == idx;
                            <button type="button"
                                    class="egs-rail-item @(isActive ? "active" : "")"
                                    @onclick="() => SetHeroSlide(idx)"
                                    @onmouseenter="PauseAutoSlide"
                                    @onmouseleave="ResumeAutoSlide">
                                <img src="@slide.Thumb" alt="@slide.Title" class="egs-rail-thumb" />
                                <span class="egs-rail-title">@slide.Title</span>
                                @if (isActive)
                                {
                                    <div @key="@($"timer-{_heroIndex}")" class="egs-rail-timer"></div>
                                }
                            </button>
                        }
                    </div>

                    @* Rail Carousel Controls *@
                    <div class="egs-rail-arrows">
                        <button type="button" class="egs-circle-btn" @onclick="PrevHeroSlide" aria-label="Previous">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <button type="button" class="egs-circle-btn" @onclick="NextHeroSlide" aria-label="Next">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        @* ================================================================= *@
        @* SECTION 2: DISCOVER SOMETHING NEW & 4 MINI CARDS                   *@
        @* ================================================================= *@
        <section aria-label="Discover Something New">
            <div class="egs-section-header mb-4">
                <div class="egs-section-title-wrap">
                    <a href="/products" class="egs-section-title hover:text-white flex items-center gap-2">
                        <span>Khám phá tựa game mới</span>
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>

            <div class="egs-discover-row">
                <a href="/products" class="egs-discover-banner egs-card-hover egs-shimmer-card">
                    <img src="https://cdn.akamai.steamstatic.com/steam/apps/1174180/library_hero.jpg" alt="Red Dead Redemption 2" />
                    <div class="egs-discover-overlay">
                        <span class="egs-discover-badge">Tâm điểm nổi bật</span>
                        <h3 class="egs-discover-title">Red Dead Redemption 2</h3>
                        <p class="egs-discover-desc">Trải nghiệm tuyệt phẩm miền Tây hoang dã với hơn 175 giải thưởng Game của Năm danh giá.</p>
                        <div class="pt-1">
                            <span class="egs-discover-btn">Khám phá ngay</span>
                        </div>
                    </div>
                </a>

                <div class="egs-mini-grid">
                    @* Mini 1: Chop Chop Together (From User Screenshot) *@
                    <a href="/products" class="egs-mini-card group">
                        <div class="egs-mini-thumb-wrap">
                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/3065360/header.jpg" alt="Chop Chop Together" class="egs-mini-thumb" />
                            <button type="button" class="egs-mini-bookmark" @onclick:preventDefault="true" @onclick:stopPropagation="true" title="Thêm vào danh sách ước" aria-label="Thêm vào danh sách ước">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7c-1.1 0-2 .9-2 2v16l7-4.5 7 4.5V5c0-1.1-.9-2-2-2z"/></svg>
                            </button>
                        </div>
                        <div class="egs-mini-info">
                            <span class="egs-mini-tag">Game cơ bản</span>
                            <span class="egs-mini-title">Chop Chop Together</span>
                            <span class="egs-mini-price">136.000 <u>đ</u></span>
                        </div>
                    </a>

                    @* Mini 2: Control Ultimate Edition *@
                    <a href="/products" class="egs-mini-card group">
                        <div class="egs-mini-thumb-wrap">
                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/870780/library_600x900.jpg" alt="Control Ultimate Edition" class="egs-mini-thumb" />
                            <button type="button" class="egs-mini-bookmark" @onclick:preventDefault="true" @onclick:stopPropagation="true" title="Thêm vào danh sách ước" aria-label="Thêm vào danh sách ước">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7c-1.1 0-2 .9-2 2v16l7-4.5 7 4.5V5c0-1.1-.9-2-2-2z"/></svg>
                            </button>
                        </div>
                        <div class="egs-mini-info">
                            <span class="egs-mini-tag">Bản đặc biệt</span>
                            <span class="egs-mini-title">Control Ultimate Edition</span>
                            <span class="egs-mini-price">599.000 <u>đ</u></span>
                        </div>
                    </a>

                    @* Mini 3: Dave The Diver *@
                    <a href="/products" class="egs-mini-card group">
                        <div class="egs-mini-thumb-wrap">
                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/1868140/library_600x900.jpg" alt="Dave The Diver" class="egs-mini-thumb" />
                            <button type="button" class="egs-mini-bookmark" @onclick:preventDefault="true" @onclick:stopPropagation="true" title="Thêm vào danh sách ước" aria-label="Thêm vào danh sách ước">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7c-1.1 0-2 .9-2 2v16l7-4.5 7 4.5V5c0-1.1-.9-2-2-2z"/></svg>
                            </button>
                        </div>
                        <div class="egs-mini-info">
                            <span class="egs-mini-tag">Game cơ bản</span>
                            <span class="egs-mini-title">Dave The Diver</span>
                            <span class="egs-mini-price">260.000 <u>đ</u></span>
                        </div>
                    </a>

                    @* Mini 4: Hades II *@
                    <a href="/products" class="egs-mini-card group">
                        <div class="egs-mini-thumb-wrap">
                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/1145350/library_600x900.jpg" alt="Hades II" class="egs-mini-thumb" />
                            <button type="button" class="egs-mini-bookmark" @onclick:preventDefault="true" @onclick:stopPropagation="true" title="Thêm vào danh sách ước" aria-label="Thêm vào danh sách ước">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7c-1.1 0-2 .9-2 2v16l7-4.5 7 4.5V5c0-1.1-.9-2-2-2z"/></svg>
                            </button>
                        </div>
                        <div class="egs-mini-info">
                            <span class="egs-mini-tag">Truy cập sớm</span>
                            <span class="egs-mini-title">Hades II</span>
                            <span class="egs-mini-price">385.000 <u>đ</u></span>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        @* ================================================================= *@
        @* SECTION 3: SPOTLIGHT FULL BANNER (Helldivers 2)                    *@
        @* ================================================================= *@
        <section aria-label="Featured Banner Spotlight">
            <div class="egs-full-banner-wrap">
                <a href="/products" class="egs-full-banner egs-card-hover egs-shimmer-card">
                    <img src="https://cdn.akamai.steamstatic.com/steam/apps/553850/library_hero.jpg" alt="HELLDIVERS™ 2" />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent p-6 sm:p-10 flex flex-col justify-center max-w-xl">
                        <span class="text-xs uppercase tracking-widest font-extrabold text-[#0078f2] mb-1">Hiện có trên Store</span>
                        <h3 class="text-2xl sm:text-4xl font-black text-white leading-tight mb-2">HELLDIVERS™ 2</h3>
                        <p class="text-xs sm:text-sm text-white/80 line-clamp-2 mb-4">Gia nhập Lực lượng Helldivers và chiến đấu vì Tự Do trên khắp thiên hà rực lửa trong tựa game bắn súng góc nhìn thứ ba kịch tính.</p>
                        <div class="flex items-center gap-3">
                            <span class="egs-hero-btn-buy">Chơi ngay • 790.000 đ</span>
                        </div>
                    </div>
                </a>
            </div>
        </section>

        @* ================================================================= *@
        @* SECTION 4: FREE GAMES VAULT                                       *@
        @* ================================================================= *@
        <section aria-label="Free Games Vault" class="my-8">
            <div class="p-6 sm:p-8 lg:p-9 rounded-2xl bg-gradient-to-b from-[#202024] to-[#16161a] border border-white/10 shadow-2xl relative overflow-hidden">
                @* Ambient Top Glow *@
                <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-[#0078f2]/10 blur-3xl pointer-events-none rounded-full"></div>

                @* Header *@
                <div class="flex items-center justify-between mb-7 relative z-10">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 border border-amber-500/30 flex items-center justify-center text-amber-400 shadow-md">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V4.5a2.5 2.5 0 10-5 0V8m5 0V4.5a2.5 2.5 0 115 0V8m-10 0h10a2 2 0 012 2v2a2 2 0 01-2 2H7a2 2 0 01-2-2v-2a2 2 0 012-2zm-1 6h12a2 2 0 012 2v3a2 2 0 01-2 2H6a2 2 0 01-2-2v-3a2 2 0 012-2z"/>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight leading-none">Free Games</h2>
                            <span class="text-xs text-white/40 font-medium block mt-1">Cập nhật mỗi thứ Năm • Nhận miễn phí vĩnh viễn</span>
                        </div>
                    </div>

                    <a href="/products?pricing=free" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/15 border border-white/15 hover:border-white/35 text-white text-xs font-bold uppercase tracking-wider transition-all duration-200 flex items-center gap-1.5 shadow-sm group">
                        <span>Xem thêm</span>
                        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>

                @* 4 Cards Grid *@
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 relative z-10">
                    @* Card 1: Apex Legends - Free Now *@
                    <a href="/products" class="group flex flex-col cursor-pointer transition-all duration-300 hover:-translate-y-2">
                        <div class="w-full aspect-[4/5] rounded-2xl overflow-hidden bg-[#18181c] border border-white/10 group-hover:border-[#0078f2]/60 group-hover:shadow-[0_16px_32px_rgba(0,120,242,0.25)] transition-all duration-300 flex flex-col relative">
                            @* Live Badge *@
                            <div class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-black/75 backdrop-blur-md border border-white/15 text-white text-xs font-black uppercase tracking-wider flex items-center gap-1.5 shadow-lg">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#0078f2] animate-pulse"></span>
                                <span>Miễn phí tuần này</span>
                            </div>

                            <div class="w-full flex-1 min-h-0 overflow-hidden relative">
                                <img src="https://cdn.akamai.steamstatic.com/steam/apps/1172470/library_600x900.jpg" alt="Apex Legends" 
                                     class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" 
                                     style="object-position: center 10%;" />
                            </div>
                            
                            <div class="w-full h-9 bg-gradient-to-r from-[#0078f2] to-[#0066d6] text-white text-[11px] font-black tracking-wider uppercase flex items-center justify-center shrink-0 shadow-inner">
                                MIỄN PHÍ NGAY BÂY GIỜ
                            </div>
                        </div>
                        <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-[#0078f2] transition-colors mt-3.5 line-clamp-1">Apex Legends</h3>
                        <p class="text-xs sm:text-[13px] text-white/50 group-hover:text-white/70 transition-colors mt-1 font-medium flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 text-white/40 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span>Miễn phí đến 22 thg 10 lúc 22:00</span>
                        </p>
                    </a>

                    @* Card 2: Agent A: A puzzle in disguise - Coming Soon *@
                    <a href="/products" class="group flex flex-col cursor-pointer transition-all duration-300 hover:-translate-y-2">
                        <div class="w-full aspect-[4/5] rounded-2xl overflow-hidden bg-[#18181c] border border-white/10 group-hover:border-white/30 group-hover:shadow-[0_16px_32px_rgba(0,0,0,0.6)] transition-all duration-300 flex flex-col relative">
                            @* Coming Soon Badge *@
                            <div class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-black/75 backdrop-blur-md border border-white/15 text-amber-400 text-xs font-black uppercase tracking-wider flex items-center gap-1.5 shadow-lg">
                                <span>⏳</span>
                                <span>Tuần tới</span>
                            </div>

                            <div class="w-full flex-1 min-h-0 overflow-hidden relative">
                                <img src="https://cdn.akamai.steamstatic.com/steam/apps/801480/library_600x900.jpg" alt="Agent A: A puzzle in disguise" 
                                     class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" 
                                     style="object-position: center center;" />
                            </div>
                            
                            <div class="w-full h-9 bg-[#0c0c0e] border-t border-white/10 text-white/85 text-[11px] font-black tracking-wider uppercase flex items-center justify-center shrink-0">
                                SẮP RA MẮT
                            </div>
                        </div>
                        <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-amber-400 transition-colors mt-3.5 line-clamp-1">Agent A: A puzzle in disguise</h3>
                        <p class="text-xs sm:text-[13px] text-white/50 group-hover:text-white/70 transition-colors mt-1 font-medium flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 text-white/40 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <span>15 thg 10 – 22 thg 10 miễn phí</span>
                        </p>
                    </a>

                    @* Card 3: Destiny 2 - Free Now *@
                    <a href="/products" class="group flex flex-col cursor-pointer transition-all duration-300 hover:-translate-y-2">
                        <div class="w-full aspect-[4/5] rounded-2xl overflow-hidden bg-[#18181c] border border-white/10 group-hover:border-[#0078f2]/60 group-hover:shadow-[0_16px_32px_rgba(0,120,242,0.25)] transition-all duration-300 flex flex-col relative">
                            @* Live Badge *@
                            <div class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-black/75 backdrop-blur-md border border-white/15 text-white text-xs font-black uppercase tracking-wider flex items-center gap-1.5 shadow-lg">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#0078f2] animate-pulse"></span>
                                <span>Miễn phí tuần này</span>
                            </div>

                            <div class="w-full flex-1 min-h-0 overflow-hidden relative">
                                <img src="https://cdn.akamai.steamstatic.com/steam/apps/1085660/library_600x900.jpg" alt="Destiny 2" 
                                     class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" 
                                     style="object-position: center 25%;" />
                            </div>
                            
                            <div class="w-full h-9 bg-gradient-to-r from-[#0078f2] to-[#0066d6] text-white text-[11px] font-black tracking-wider uppercase flex items-center justify-center shrink-0 shadow-inner">
                                MIỄN PHÍ NGAY BÂY GIỜ
                            </div>
