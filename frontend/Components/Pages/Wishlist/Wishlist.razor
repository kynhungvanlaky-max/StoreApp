@page "/wishlist"
@inject Frontend.ViewModels.WishlistViewModel VM
@inject Frontend.ViewModels.CartViewModel CartVM
@layout Frontend.Components.Layout.ProfileLayout
@implements IDisposable

<PageTitle>Danh Sách Yêu Thích — NexusKeys</PageTitle>

<div class="w-full">
            @if (VM.IsLoading && VM.Items.Count == 0)
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="card bg-[#202020] border border-[#303030]">
                            <div class="skeleton aspect-[3/4] w-full rounded-b-none"></div>
                            <div class="p-3">
                                <div class="skeleton h-4 w-full mb-2"></div>
                                <div class="skeleton h-4 w-1/2"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (VM.Items.Count == 0)
            {
                <div class="bg-[#202020] rounded-2xl border border-[#303030] p-12 text-center shadow-xl">
                    <h2 class="text-2xl font-bold text-white mb-2">Danh sách yêu thích trống</h2>
                    <p class="text-gray-400 mb-6">Bạn chưa thêm sản phẩm nào vào danh sách. Hãy dạo qua Cửa hàng để tìm tựa game ưng ý nhé!</p>
                    <a href="/products" class="btn btn-primary btn-lg">
                        <Icon Name="HeroiconName.BuildingStorefront" Class="w-5 h-5 inline-block mr-2" /> Đến Cửa Hàng
                    </a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    @for (int i = 0; i < VM.Items.Count; i++)
                    {
                        var item = VM.Items[i];
                        <Frontend.Components.Shared.ProductCard 
                            Product="@(new Frontend.Models.Product.ProductDto {
                                Id = item.Product.Id,
                                Name = item.Product.Name,
                                BasePrice = item.Product.BasePrice,
                                ImageUrl = item.Product.ImageUrl ?? string.Empty
                            })"
                            IsWishlistMode="true"
                            OnAddToCart="() => AddToCart(item)"
                            OnRemoveFromWishlist="() => VM.RemoveFromWishlistAsync(item.ProductId)" />
                    }
                </div>

            }
</div>

@code {
    protected override void OnInitialized()
    {
        VM.StateChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.LoadWishlistAsync();
        }
    }
    
    public void Dispose()
    {
        VM.StateChanged -= StateHasChanged;
    }

    private async Task AddToCart(Frontend.Models.Wishlist.WishlistItem item)
    {
        await CartVM.AddToCartAsync(new Frontend.Models.Cart.CartItem
        {
            ProductId = item.Product.Id,
            Name = item.Product.Name,
            Price = item.Product.BasePrice,
            ImageUrl = item.Product.ImageUrl ?? "/images/placeholder-game.jpg"
        });
    }
}
