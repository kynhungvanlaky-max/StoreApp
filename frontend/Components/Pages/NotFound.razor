@page "/not-found"
@layout MainLayout

<PageTitle>Không tìm thấy trang — NexusKeys</PageTitle>

<section class="container mx-auto px-4 py-20 min-h-[65vh] flex items-center justify-center text-center" aria-labelledby="not-found-title">
    <div class="max-w-lg">
        <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-primary/10 text-primary flex items-center justify-center">
            <Icon Name="HeroiconName.MagnifyingGlass" Class="w-10 h-10" />
        </div>
        <p class="text-sm font-black uppercase tracking-[0.3em] text-primary mb-3">Lỗi 404</p>
        <h1 id="not-found-title" class="text-3xl md:text-4xl font-black text-base-content mb-4">Không tìm thấy trang</h1>
        <p class="text-base-content/65 mb-8">Đường dẫn có thể đã thay đổi hoặc nội dung không còn tồn tại.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
            <a href="/" class="btn btn-primary">Về trang chủ</a>
            <a href="/products" class="btn btn-outline">Đến cửa hàng</a>
        </div>
    </div>
</section>
