@page "/products"
@inject Frontend.ViewModels.ProductViewModel ViewModel
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Cửa Hàng — NexusKeys</PageTitle>

<div class="px-4 md:px-6 lg:px-8 py-8 mx-auto max-w-[1600px] min-h-[70vh]">
    
    @* Search Header *@
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-white mb-6 tracking-tight">Cửa Hàng</h1>
        
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div class="relative w-full sm:max-w-md md:max-w-lg">
                <Icon Name="HeroiconName.MagnifyingGlass" Class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" />
                <label for="store-search" class="sr-only">Tìm kiếm sản phẩm</label>
                <input id="store-search" @bind="ViewModel.SearchQuery" @bind:event="oninput"
                       @onkeyup="@(e => { if(e.Key=="Enter") NavigateToCurrentState(1); })"
                       type="text" placeholder="Tìm kiếm sản phẩm..." 
                       class="w-full bg-[#1a1a1a] border border-[#2a2a2a] text-gray-200 text-sm rounded-xl pl-12 pr-4 py-3 outline-none focus:border-[#0078F2] focus:bg-[#1e1e1e] transition-all duration-300" />
            </div>
            
            <div class="flex items-center gap-3 w-full sm:w-auto">
                <span class="text-sm text-gray-400 whitespace-nowrap">Sắp xếp:</span>
                <label for="store-sort" class="sr-only">Sắp xếp sản phẩm</label>
                <select id="store-sort" class="w-full sm:w-auto bg-[#1a1a1a] border border-[#2a2a2a] text-white text-sm rounded-lg outline-none cursor-pointer px-3 py-2 hover:border-[#3a3a3a] focus:border-[#0078F2] transition-all duration-300"
                        value="@ViewModel.SortBy"
                        @onchange='@(e => ChangeSort(e.Value?.ToString() ?? "newest"))'>
                    <option class="bg-[#1a1a1a]" value="newest">Mới phát hành</option>
                    <option class="bg-[#1a1a1a]" value="price_asc">Giá tăng dần</option>
                    <option class="bg-[#1a1a1a]" value="price_desc">Giá giảm dần</option>
                    <option class="bg-[#1a1a1a]" value="discount">Giảm giá</option>
                </select>
            </div>
        </div>
    </div>

    @* Active Filter Tags *@
    @if (ViewModel.SelectedCategories.Any() || ViewModel.SelectedPriceRanges.Any())
    {
        <div class="flex flex-wrap items-center gap-2 mb-6">
            <span class="text-xs text-gray-500 uppercase tracking-wider mr-1">Đang lọc:</span>
            @foreach (var cat in ViewModel.SelectedCategories)
            {
                <button @onclick="@(() => ToggleCategory(cat))"
                        class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#0078F2]/15 border border-[#0078F2]/30 text-[#4da6ff] text-xs font-medium rounded-full hover:bg-[#0078F2]/25 transition-all duration-200">
                    @cat
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            }
            @foreach (var pr in ViewModel.SelectedPriceRanges)
            {
                <button @onclick="@(() => TogglePriceRange(pr))"
                        class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#0078F2]/15 border border-[#0078F2]/30 text-[#4da6ff] text-xs font-medium rounded-full hover:bg-[#0078F2]/25 transition-all duration-200">
                    @GetPriceRangeLabel(pr)
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            }
            <button @onclick="ResetFilters"
                    class="text-xs text-gray-400 hover:text-white ml-2 underline underline-offset-2 transition-colors duration-200">
                Xóa tất cả
            </button>
        </div>
    }

    @* Mobile Filter Toggle *@
    <div class="lg:hidden mb-6">
        <button @onclick="@(() => _showMobileFilter = !_showMobileFilter)"
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#1a1a1a] border border-[#2a2a2a] text-white text-sm font-medium rounded-xl hover:bg-[#222] hover:border-[#3a3a3a] transition-all duration-300">
            <Icon Name="HeroiconName.AdjustmentsHorizontal" Class="w-4 h-4" />
            Bộ lọc
            @if (ViewModel.SelectedCategories.Any() || ViewModel.SelectedPriceRanges.Any())
            {
                <span class="flex items-center justify-center w-5 h-5 bg-[#0078F2] text-white text-xs font-bold rounded-full">
                    @(ViewModel.SelectedCategories.Count + ViewModel.SelectedPriceRanges.Count)
                </span>
            }
        </button>
    </div>

    @* MAIN LAYOUT: Sidebar Left + Product Grid Right *@
    <div class="flex flex-col lg:flex-row gap-8">
        
        @* Left Column: Filter Sidebar *@
        <aside class="w-full lg:w-[260px] xl:w-[280px] flex-shrink-0 @(_showMobileFilter ? "block" : "hidden") lg:block">
            <div class="lg:sticky lg:top-24 space-y-1">
                
                @* Filter Panel *@
                <div class="bg-[#161616] border border-[#252525] rounded-2xl p-5 space-y-5">
                    
                    @* Panel Header *@
                    <div class="flex justify-between items-center">
                        <h2 class="text-sm font-semibold text-white flex items-center gap-2">
                            <Icon Name="HeroiconName.AdjustmentsHorizontal" Class="w-4 h-4 text-gray-400" />
                            Bộ lọc
                        </h2>
                        @if (ViewModel.SelectedCategories.Any() || ViewModel.SelectedPriceRanges.Any())
                        {
                            <button @onclick="ResetFilters"
                                    class="text-[11px] text-[#4da6ff] hover:text-white font-medium uppercase tracking-wider transition-colors duration-200">
                                Đặt lại
                            </button>
                        }
                    </div>
                    
                    @* Category Section *@
                    <div>
                        <button @onclick="@(() => _showCategories = !_showCategories)" 
                                class="flex items-center justify-between w-full py-2 group">
                            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider group-hover:text-gray-300 transition-colors">Thể loại</h3>
                            <svg class="w-3.5 h-3.5 text-gray-500 transition-transform duration-300 @(_showCategories ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        
                        @if (_showCategories)
                        {
                            <div class="space-y-0.5 mt-1">
                                @{
                                    var categories = new[] { "Hành động", "Nhập vai", "Chiến thuật", "Bắn súng", "Thể thao", "Mô phỏng", "Phần mềm", "Thẻ quà tặng" };
                                }
                                @foreach (var cat in categories)
                                {
                                    var isSelected = ViewModel.SelectedCategories.Contains(cat);
                                    <label class="flex items-center gap-3 px-2.5 py-2 rounded-lg cursor-pointer transition-all duration-200 @(isSelected ? "bg-[#0078F2]/10" : "hover:bg-white/[0.03]")">
                                        <div class="relative flex items-center justify-center w-[18px] h-[18px] rounded-[5px] border-2 transition-all duration-200 @(isSelected ? "bg-[#0078F2] border-[#0078F2]" : "border-[#3a3a3a] hover:border-[#555]")">
                                            <input type="checkbox" checked="@isSelected" 
                                                   @onchange='@(_ => ToggleCategory(cat))'
                                                   class="absolute opacity-0 cursor-pointer w-full h-full" />
                                            @if (isSelected)
                                            {
                                                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                                </svg>
                                            }
                                        </div>
                                        <span class="text-[13px] transition-colors duration-200 @(isSelected ? "text-white font-medium" : "text-gray-400")">@cat</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                    
                    @* Divider *@
                    <div class="border-t border-[#252525]"></div>
                    
                    @* Price Section *@
                    <div>
                        <button @onclick="@(() => _showPriceRanges = !_showPriceRanges)" 
                                class="flex items-center justify-between w-full py-2 group">
                            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider group-hover:text-gray-300 transition-colors">Khoảng giá</h3>
                            <svg class="w-3.5 h-3.5 text-gray-500 transition-transform duration-300 @(_showPriceRanges ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        
                        @if (_showPriceRanges)
                        {
                            <div class="space-y-0.5 mt-1">
                                @{
                                    var priceRanges = new (string Key, string Label)[] {
                                        ("under_100k", "Dưới 100.000 đ"),
                                        ("100k_500k", "100.000 đ – 500.000 đ"),
                                        ("over_500k", "Trên 500.000 đ")
                                    };
                                }
                                @foreach (var pr in priceRanges)
                                {
                                    var isSelected = ViewModel.SelectedPriceRanges.Contains(pr.Key);
                                    <label class="flex items-center gap-3 px-2.5 py-2 rounded-lg cursor-pointer transition-all duration-200 @(isSelected ? "bg-[#0078F2]/10" : "hover:bg-white/[0.03]")">
                                        <div class="relative flex items-center justify-center w-[18px] h-[18px] rounded-[5px] border-2 transition-all duration-200 @(isSelected ? "bg-[#0078F2] border-[#0078F2]" : "border-[#3a3a3a] hover:border-[#555]")">
                                            <input type="checkbox" checked="@isSelected" 
                                                   @onchange='@(_ => TogglePriceRange(pr.Key))'
                                                   class="absolute opacity-0 cursor-pointer w-full h-full" />
                                            @if (isSelected)
                                            {
                                                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                                </svg>
                                            }
                                        </div>
                                        <span class="text-[13px] transition-colors duration-200 @(isSelected ? "text-white font-medium" : "text-gray-400")">@pr.Label</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </aside>

        @* Right Column: Product Grid *@
        <div class="flex-1 min-w-0">
            <h2 class="sr-only">Danh sách sản phẩm</h2>
            @if (ViewModel.IsLoading)
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4 lg:gap-5">
                    @for (int i = 0; i < 10; i++)
                    {
                        <div class="animate-pulse">
                            <div class="aspect-[3/4] bg-[#1a1a1a] rounded-xl mb-3"></div>
                            <div class="h-3 bg-[#1a1a1a] rounded-full w-1/2 mb-2"></div>
                            <div class="h-4 bg-[#1a1a1a] rounded-full w-3/4 mb-3"></div>
                            <div class="h-4 bg-[#1a1a1a] rounded-full w-1/4"></div>
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
            {
                <div class="flex flex-col items-center justify-center py-24 text-center" role="alert">
                    <Icon Name="HeroiconName.ExclamationTriangle" Class="w-12 h-12 text-amber-400 mb-4" />
                    <h2 class="text-xl font-bold text-white mb-2">Không thể tải cửa hàng</h2>
                    <p class="text-gray-400 mb-6 max-w-md">@ViewModel.ErrorMessage</p>
                    <button type="button" @onclick="@(() => ViewModel.LoadAsync(ViewModel.CurrentPage))" class="px-6 py-2.5 text-sm font-bold text-white bg-[#0078F2] rounded-lg hover:bg-[#0066cc]">Thử lại</button>
                </div>
            }
            else if (ViewModel.Products.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-24 text-center">
                    <div class="w-20 h-20 bg-[#1a1a1a] rounded-full flex items-center justify-center mb-5">
                        <Icon Name="HeroiconName.MagnifyingGlass" Class="w-10 h-10 text-[#303030]" />
                    </div>
                    <h2 class="text-xl font-bold text-white mb-2">Không tìm thấy kết quả</h2>
                    <p class="text-gray-400 mb-6 max-w-md">Thử thay đổi từ khóa tìm kiếm hoặc xóa bớt bộ lọc để tìm thấy sản phẩm bạn cần.</p>
                    <button @onclick="ResetAll"
                            class="px-6 py-2.5 text-sm font-medium text-white bg-[#0078F2] rounded-lg hover:bg-[#0066cc] transition-colors duration-200">
                        Đặt lại bộ lọc
                    </button>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4 lg:gap-5">
                    @foreach (var product in ViewModel.Products)
                    {
                        <Frontend.Components.Shared.ProductCard Product="product" />
                    }
                </div>
                
                @* Pagination *@
                @if (ViewModel.TotalPages > 1)
                {
                    <div class="flex justify-center items-center gap-1.5 mt-12">
                        <button class="w-11 h-11 flex items-center justify-center rounded-lg text-white disabled:opacity-30 hover:bg-[#1a1a1a] disabled:hover:bg-transparent transition-colors duration-200"
                                aria-label="Trang trước"
                                disabled="@(ViewModel.CurrentPage == 1)"
                                @onclick="@(() => NavigateToCurrentState(ViewModel.CurrentPage - 1))">
                            <Icon Name="HeroiconName.ChevronLeft" Class="w-4 h-4" />
                        </button>
                        
                        @for (int i = 1; i <= ViewModel.TotalPages; i++)
                        {
                            var pageNum = i;
                            @if (ShouldShowPage(pageNum))
                            {
                                <button class="w-11 h-11 flex items-center justify-center rounded-lg text-sm font-medium transition-all duration-200 @(pageNum == ViewModel.CurrentPage ? "bg-[#0078F2] text-white" : "text-gray-400 hover:bg-[#1a1a1a] hover:text-white")"
                                        aria-label="@($"Trang {pageNum}")" aria-current="@(pageNum == ViewModel.CurrentPage ? "page" : null)"
                                        @onclick="@(() => NavigateToCurrentState(pageNum))">
                                    @pageNum
                                </button>
                            }
                            else if (ShouldShowEllipsis(pageNum))
                            {
                                <span class="w-11 h-11 flex items-center justify-center text-gray-500 text-sm">…</span>
                            }
                        }
                        
                        <button class="w-11 h-11 flex items-center justify-center rounded-lg text-white disabled:opacity-30 hover:bg-[#1a1a1a] disabled:hover:bg-transparent transition-colors duration-200"
                                aria-label="Trang sau"
                                disabled="@(ViewModel.CurrentPage == ViewModel.TotalPages)"
                                @onclick="@(() => NavigateToCurrentState(ViewModel.CurrentPage + 1))">
                            <Icon Name="HeroiconName.ChevronRight" Class="w-4 h-4" />
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private bool _showMobileFilter = false;
    private bool _showCategories = true;
    private bool _showPriceRanges = true;

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "categories")]
    public string[]? Categories { get; set; }

    [SupplyParameterFromQuery(Name = "priceRanges")]
    public string[]? PriceRanges { get; set; }

    [SupplyParameterFromQuery(Name = "sortBy")]
    public string? Sort { get; set; }

    private string? _lastStateSignature;

    protected override void OnInitialized()
    {
        ViewModel.StateChanged += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var categories = Categories?.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList() ?? new();
        var priceRanges = PriceRanges?.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList() ?? new();
        var sort = Sort is "price_asc" or "price_desc" or "discount" ? Sort : "newest";
        var page = Math.Max(1, Page);
        var signature = $"{page}|{Search}|{sort}|{string.Join(',', categories)}|{string.Join(',', priceRanges)}";

        if (!string.Equals(signature, _lastStateSignature, StringComparison.Ordinal))
        {
            _lastStateSignature = signature;
            ViewModel.SearchQuery = Search ?? "";
            ViewModel.SortBy = sort;
            ViewModel.SelectedCategories.Clear();
            ViewModel.SelectedCategories.AddRange(categories);
            ViewModel.SelectedPriceRanges.Clear();
            ViewModel.SelectedPriceRanges.AddRange(priceRanges);
            await ViewModel.LoadAsync(page);
        }
    }
    
    public void Dispose()
    {
        ViewModel.StateChanged -= StateHasChanged;
    }

    private string GetPriceRangeLabel(string key) => key switch
    {
        "under_100k" => "Dưới 100.000 đ",
        "100k_500k" => "100.000 đ – 500.000 đ",
        "over_500k" => "Trên 500.000 đ",
        _ => key
    };

    private bool ShouldShowPage(int page)
    {
        if (ViewModel.TotalPages <= 7) return true;
        if (page == 1 || page == ViewModel.TotalPages) return true;
        if (Math.Abs(page - ViewModel.CurrentPage) <= 1) return true;
        return false;
    }

    private bool ShouldShowEllipsis(int page)
    {
        if (ViewModel.TotalPages <= 7) return false;
        if (page == 2 && ViewModel.CurrentPage > 3) return true;
        if (page == ViewModel.TotalPages - 1 && ViewModel.CurrentPage < ViewModel.TotalPages - 2) return true;
        return false;
    }

    private void ToggleCategory(string category)
    {
        if (!ViewModel.SelectedCategories.Remove(category))
        {
            ViewModel.SelectedCategories.Add(category);
        }
        NavigateToCurrentState(1);
    }

    private void TogglePriceRange(string range)
    {
        if (!ViewModel.SelectedPriceRanges.Remove(range))
        {
            ViewModel.SelectedPriceRanges.Add(range);
        }
        NavigateToCurrentState(1);
    }

    private void ChangeSort(string sortBy)
    {
        ViewModel.SortBy = sortBy;
        NavigateToCurrentState(1);
    }

    private void ResetFilters()
    {
        ViewModel.SelectedCategories.Clear();
        ViewModel.SelectedPriceRanges.Clear();
        NavigateToCurrentState(1);
    }

    private void ResetAll()
    {
        ViewModel.SearchQuery = string.Empty;
        ViewModel.SortBy = "newest";
        ViewModel.SelectedCategories.Clear();
        ViewModel.SelectedPriceRanges.Clear();
        NavigateToCurrentState(1);
    }

    private void NavigateToCurrentState(int page)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(ViewModel.SearchQuery))
        {
            parts.Add($"search={Uri.EscapeDataString(ViewModel.SearchQuery.Trim())}");
        }
        if (!string.Equals(ViewModel.SortBy, "newest", StringComparison.Ordinal))
        {
            parts.Add($"sortBy={Uri.EscapeDataString(ViewModel.SortBy)}");
        }
        foreach (var category in ViewModel.SelectedCategories)
        {
            parts.Add($"categories={Uri.EscapeDataString(category)}");
        }
        foreach (var range in ViewModel.SelectedPriceRanges)
        {
            parts.Add($"priceRanges={Uri.EscapeDataString(range)}");
        }
        if (page > 1)
        {
            parts.Add($"page={page}");
        }

        NavigationManager.NavigateTo(parts.Count == 0 ? "/products" : $"/products?{string.Join("&", parts)}");
    }
}
