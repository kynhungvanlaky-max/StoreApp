@page "/orders/{Id:int}"
@inject Frontend.ViewModels.OrderViewModel VM
@inject Frontend.Services.OrderService OrderService
@inject Frontend.Services.ToastService ToastService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@layout Frontend.Components.Layout.ProfileLayout
@implements IDisposable

<PageTitle>Chi Tiết Đơn Hàng #@Id — NexusKeys</PageTitle>
<h1 class="sr-only">Chi tiết đơn hàng #@Id</h1>

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="text-sm breadcrumbs mb-6 text-gray-400">
        <ul>
            <li><a href="/profile">Hồ sơ</a></li>
            <li><a href="/orders">Đơn hàng</a></li>
            <li class="text-white font-medium">#@Id</li>
        </ul>
    </div>
    
    @if (VM.IsLoading)
    {
        <div class="flex justify-center py-20">
            <span class="loading loading-spinner loading-lg text-primary"></span>
        </div>
    }
    else if (VM.CurrentOrder == null)
    {
        <div class="alert alert-error">Không tìm thấy thông tin đơn hàng này.</div>
    }
    else
    {
        var order = VM.CurrentOrder;
        string badgeClass = order.Status switch
        {
            "Completed" => "badge-success",
            "Pending" => "badge-warning",
            "Failed" => "badge-error",
            _ => "badge-ghost"
        };
        string statusText = order.Status switch
        {
            "Completed" => "Đã hoàn thành",
            "Pending" => "Chờ thanh toán",
            "Failed" => "Thất bại",
            _ => order.Status
        };

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h2 class="text-2xl font-black text-white flex flex-wrap items-center gap-3">
                    Đơn Hàng #@order.Id
                    <span class="badge @badgeClass badge-outline font-bold">@statusText</span>
                </h2>
                <p class="text-gray-400 mt-1">Đặt lúc @order.OrderDate.ToString("HH:mm - dd/MM/yyyy")</p>
            </div>
            
            @if (order.Status == "Pending")
            {
                <button type="button" class="btn btn-primary shadow-lg shadow-primary/30" @onclick="() => RetryPaymentAsync(order.Id)" disabled="@_isPaying">
                    @if (_isPaying)
                    {
                        <span class="loading loading-spinner loading-sm"></span>
                    }
                    else
                    {
                        <Icon Name="HeroiconName.CreditCard" Class="w-5 h-5 mr-1 inline-block" />
                    }
                    Thanh toán qua VNPay
                </button>
            }
        </div>

        <div class="bg-[#202020] rounded-2xl border border-[#303030] shadow-xl overflow-hidden mb-8">
            <div class="p-4 border-b border-[#303030] bg-[#252525]">
                <h3 class="font-bold text-white">Sản phẩm đã mua</h3>
            </div>
            
            <div class="divide-y divide-[#303030]">
                @foreach (var itemName in order.Items)
                {
                    <div class="p-4 flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-[#252525] rounded-lg flex items-center justify-center">
                                <Icon Name="HeroiconName.PuzzlePiece" Class="w-6 h-6 text-gray-500" />
                            </div>
                            <span class="font-bold text-white">@itemName</span>
                        </div>
                    </div>
                }
            </div>
            
            <div class="p-6 bg-[#252525] border-t border-[#303030] flex justify-end">
                <div class="w-64 space-y-2">
                    <div class="flex justify-between text-gray-400">
                        <span>Tạm tính</span>
                        <span>@order.TotalAmount.ToString("N0") đ</span>
                    </div>
                    <div class="divider my-0"></div>
                    <div class="flex justify-between items-center text-lg">
                        <span class="font-bold text-white">Tổng cộng</span>
                        <span class="font-black text-primary">@order.TotalAmount.ToString("N0") đ</span>
                    </div>
                </div>
            </div>
        </div>

        @if (order.Status == "Completed" && order.Keys != null && order.Keys.Count > 0)
        {
            <div class="bg-[#202020] rounded-2xl border border-primary/30 shadow-xl overflow-hidden relative">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-secondary"></div>
                <div class="p-6 border-b border-[#303030] flex items-center gap-2">
                    <Icon Name="HeroiconName.Key" Class="w-6 h-6 text-primary" />
                    <h3 class="font-bold text-white text-lg">License Keys Của Bạn</h3>
                </div>
                
                <div class="p-6 space-y-4">
                    @foreach (var key in order.Keys)
                    {
                        <div class="bg-[#252525] p-4 rounded-xl border border-[#303030] flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                            <div>
                                <div class="text-sm text-gray-400 mb-1">Sản phẩm</div>
                                <div class="font-bold text-white">@key.ProductName</div>
                            </div>
                            
                            <div class="flex-1 md:text-right w-full md:w-auto">
                                <div class="text-sm text-gray-400 mb-1">Mã kích hoạt</div>
                                <div class="flex gap-2">
                                    <input type="text" value="@key.KeyCode" aria-label="License Key của @key.ProductName" readonly class="input input-sm input-bordered w-full md:w-auto font-mono text-center tracking-widest text-primary font-bold bg-[#202020] focus:outline-none" />
                                    <button type="button" aria-label="Sao chép License Key của @key.ProductName" class="btn btn-sm btn-square btn-outline tooltip tooltip-top" data-tip="Sao chép" @onclick="() => CopyToClipboard(key.KeyCode)">
                                        <Icon Name="HeroiconName.DocumentDuplicate" Class="w-5 h-5" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <div class="alert alert-info bg-info/10 text-info border-info/20 mt-4 text-sm">
                        <Icon Name="HeroiconName.InformationCircle" Class="w-5 h-5 mr-1 inline-block" />
                        <span>Vui lòng bảo mật kỹ mã kích hoạt của bạn. Không chia sẻ cho người khác.</span>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        VM.StateChanged += StateHasChanged;
        await VM.LoadOrderDetailsAsync(Id);
    }
    
    private bool _isPaying;

    private async Task CopyToClipboard(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        ToastService.ShowSuccess("Đã sao chép License Key.");
    }

    private async Task RetryPaymentAsync(int orderId)
    {
        if (_isPaying) return;

        _isPaying = true;
        try
        {
            var response = await OrderService.RetryPaymentAsync(orderId);
            if (response != null && !string.IsNullOrWhiteSpace(response.PaymentUrl))
            {
                NavigationManager.NavigateTo(response.PaymentUrl, forceLoad: true);
                return;
            }

            ToastService.ShowError("Không thể khởi tạo lại thanh toán cho đơn hàng này.");
        }
        finally
        {
            _isPaying = false;
        }
    }
    
    public void Dispose()
    {
        VM.StateChanged -= StateHasChanged;
    }
}
