@page "/Error"
@using System.Diagnostics

<PageTitle>Đã xảy ra lỗi — NexusKeys</PageTitle>

<section class="container mx-auto px-4 py-20 min-h-[65vh] flex items-center justify-center text-center" aria-labelledby="error-title">
    <div class="max-w-lg">
        <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-error/10 text-error flex items-center justify-center">
            <Icon Name="HeroiconName.ExclamationTriangle" Class="w-10 h-10" />
        </div>
        <h1 id="error-title" class="text-3xl md:text-4xl font-black text-base-content mb-4">NexusKeys đang gặp sự cố</h1>
        <p class="text-base-content/65 mb-3">Yêu cầu của bạn chưa thể xử lý. Hãy thử tải lại trang hoặc quay về trang chủ.</p>
        @if (ShowRequestId)
        {
            <p class="text-xs text-base-content/45 font-mono mb-8">Mã yêu cầu: @RequestId</p>
        }
        <div class="flex flex-col sm:flex-row justify-center gap-3 mt-8">
            <a href="." class="btn btn-primary">Tải lại trang</a>
            <a href="/" class="btn btn-outline">Về trang chủ</a>
        </div>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
