@inherits LayoutComponentBase
@layout MainLayout
@inject NavigationManager NavigationManager

<div class="container mx-auto px-4 py-8 max-w-6xl">
    <div class="flex flex-col lg:flex-row gap-8">
        @* Sidebar Navigation *@
        <div class="w-full lg:w-64 flex-shrink-0">
            <div class="bg-[#202020] rounded-2xl border border-[#303030] overflow-hidden sticky top-24 shadow-xl">
                <div class="p-4 border-b border-[#303030] bg-[#1a1a1a]">
                    <h2 class="text-lg font-black text-white flex items-center gap-2 uppercase tracking-wider">
                        <Icon Name="HeroiconName.UserCircle" Class="w-5 h-5 text-[#0078F2]" />
                        Tài khoản
                    </h2>
                </div>
                <ul class="menu p-4 w-full text-base-content space-y-1">
                    <li>
                        <a href="/profile" class="@(IsActive("/profile") ? "active bg-[#0078F2]/10 text-[#0078F2] font-bold" : "text-gray-400 hover:text-white hover:bg-[#303030]") rounded-xl py-3">
                            <Icon Name="HeroiconName.User" Class="w-5 h-5 mr-3" /> Thông tin chung
                        </a>
                    </li>
                    <li class="menu-title text-xs font-bold text-gray-500 uppercase tracking-wider mt-4 mb-2 px-4">Giao dịch & Thư viện</li>
                    <li>
                        <a href="/orders" class="@(IsActive("/orders") ? "active bg-[#0078F2]/10 text-[#0078F2] font-bold" : "text-gray-400 hover:text-white hover:bg-[#303030]") rounded-xl py-3">
                            <Icon Name="HeroiconName.DocumentText" Class="w-5 h-5 mr-3" /> Lịch sử đơn hàng
                        </a>
                    </li>
                    <li>
                        <a href="/profile/library" class="@(IsActive("/profile/library") ? "active bg-[#0078F2]/10 text-[#0078F2] font-bold" : "text-gray-400 hover:text-white hover:bg-[#303030]") rounded-xl py-3">
                            <Icon Name="HeroiconName.Key" Class="w-5 h-5 mr-3" /> Quản lý License Key
                        </a>
                    </li>
                    <li>
                        <a href="/wishlist" class="@(IsActive("/wishlist") ? "active bg-[#0078F2]/10 text-[#0078F2] font-bold" : "text-gray-400 hover:text-white hover:bg-[#303030]") rounded-xl py-3">
                            <Icon Name="HeroiconName.Heart" Class="w-5 h-5 mr-3" /> Danh sách yêu thích
                        </a>
                    </li>
                    <li class="menu-title text-xs font-bold text-gray-500 uppercase tracking-wider mt-4 mb-2 px-4">Cài đặt</li>
                    <li>
                        <a href="/profile/wallet" class="@(IsActive("/profile/wallet") ? "active bg-[#0078F2]/10 text-[#0078F2] font-bold" : "text-gray-400 hover:text-white hover:bg-[#303030]") rounded-xl py-3">
                            <Icon Name="HeroiconName.Banknotes" Class="w-5 h-5 mr-3" /> Nạp tiền ví
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        @* Main Content *@
        <div class="flex-1 w-full overflow-hidden">
            @Body
        </div>
    </div>
</div>

@code {
    private bool IsActive(string href)
    {
        var currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();
        if (string.IsNullOrEmpty(currentUrl)) currentUrl = "/";
        else currentUrl = "/" + currentUrl;
        
        if (href == "/profile")
        {
            return currentUrl == "/profile";
        }
        
        return currentUrl.StartsWith(href.ToLower());
    }
}
