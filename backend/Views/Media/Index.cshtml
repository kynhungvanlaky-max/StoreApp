@{
    ViewData["Title"] = "Quản Lý Thư Viện Media";
}

<div class="glassmorphism rounded-3xl p-8 mb-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <h2 class="text-2xl font-bold text-white">Thư Viện Tệp Tin (Media)</h2>
        <div class="text-gray-400 text-sm">
            Tổng cộng: <span id="totalFiles" class="font-bold text-white">0</span> tệp
        </div>
    </div>

    <!-- Image Grid -->
    <div id="mediaGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
        <div class="col-span-full py-12 text-center text-gray-500">Đang tải dữ liệu...</div>
    </div>
</div>

@section Scripts {
<script>
    const token = '@ViewData["Token"]';
    const headers = {
        'Authorization': `Bearer ${token}`
    };

    function formatBytes(bytes, decimals = 2) {
        if (!+bytes) return '0 Bytes';
        const k = 1024;
        const dm = decimals < 0 ? 0 : decimals;
        const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
    }

    async function loadMedia() {
        try {
            const res = await fetch('http://localhost:5021/api/upload', { headers });
            const data = await res.json();
            
            document.getElementById('totalFiles').innerText = data.length;
            const grid = document.getElementById('mediaGrid');
            
            if(data.length === 0) {
                grid.innerHTML = '<div class="col-span-full py-12 text-center text-gray-500">Kho lưu trữ chưa có tệp nào.</div>';
                return;
            }

            grid.innerHTML = data.map(f => {
                const isImage = f.fileName.match(/\.(jpeg|jpg|gif|png|webp)$/i) != null;
                const mediaTag = isImage ? 
                    `<img src="${f.url}" alt="${f.fileName}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />` : 
                    `<div class="w-full h-full flex items-center justify-center bg-white/5"><svg class="w-12 h-12 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg></div>`;
                    
                return `
                    <div class="relative group bg-white/5 rounded-2xl overflow-hidden border border-white/10 aspect-square flex flex-col">
                        <div class="flex-1 relative overflow-hidden bg-black">
                            ${mediaTag}
                            <!-- Overlay actions -->
                            <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3">
                                <button onclick="copyToClipboard('${f.url}')" class="w-10 h-10 bg-blue-500/80 hover:bg-blue-500 text-white rounded-full flex items-center justify-center transition-colors" title="Copy URL">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                </button>
                                <button onclick="deleteMedia('${f.fileName}')" class="w-10 h-10 bg-red-500/80 hover:bg-red-500 text-white rounded-full flex items-center justify-center transition-colors" title="Xóa tệp này">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </div>
                        </div>
                        <div class="p-3 bg-[#1a1a1f] shrink-0 border-t border-white/10">
                            <p class="text-xs text-white font-medium truncate" title="${f.fileName}">${f.fileName}</p>
                            <p class="text-[10px] text-gray-500 mt-1 flex justify-between">
                                <span>${formatBytes(f.size)}</span>
                                <span>${new Date(f.createdAt).toLocaleDateString('vi-VN')}</span>
                            </p>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (e) {
            console.error(e);
        }
    }

    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
            alert('Đã copy đường dẫn ảnh vào Clipboard!');
        });
    }

    async function deleteMedia(fileName) {
        if(!confirm('Cảnh báo: Bạn sắp XÓA VĨNH VIỄN tệp này khỏi ổ cứng server.\nCác dữ liệu Game/News đang sử dụng ảnh này sẽ bị lỗi hiển thị. Bạn có chắc chắn muốn xóa?')) return;
        
        const res = await fetch(`http://localhost:5021/api/upload/${encodeURIComponent(fileName)}`, { method: 'DELETE', headers });
        if(res.ok) {
            loadMedia();
        } else {
            alert('Có lỗi xảy ra khi xóa tệp.');
        }
    }

    document.addEventListener('DOMContentLoaded', loadMedia);
</script>
}
