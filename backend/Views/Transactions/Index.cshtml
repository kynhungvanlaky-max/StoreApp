@model List<Backend.Models.TransactionViewModel>

@{
    ViewData["Title"] = "Lịch Sử Giao Dịch";
}

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h3 class="text-xl font-black text-slate-800">Nhật Ký Lịch Sử Giao Dịch Nạp / Thanh Toán</h3>
            <p class="text-xs text-slate-400 font-medium mt-1">Theo dõi biến động số dư ví điện tử và dòng tiền giao dịch qua hệ thống.</p>
        </div>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto min-h-[380px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-wider bg-slate-50/80 border-b border-slate-200">
                    <th class="py-3 px-4 font-bold w-16 text-center rounded-l-xl">ID</th>
                    <th class="py-3 px-4 font-bold">Người Dùng</th>
                    <th class="py-3 px-4 font-bold">Loại Giao Dịch</th>
                    <th class="py-3 px-4 font-bold">Cổng Thanh Toán</th>
                    <th class="py-3 px-4 font-bold">Mã Giao Dịch Cổng</th>
                    <th class="py-3 px-4 font-bold">Số Tiền</th>
                    <th class="py-3 px-4 font-bold">Trạng Thái</th>
                    <th class="py-3 px-4 font-bold text-right rounded-r-xl">Thời Gian</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="py-12 text-center text-slate-400 font-medium">
                            <i class="fa-solid fa-money-bill-transfer text-3xl text-slate-300 mb-2 block"></i>
                            <span>Chưa có lịch sử giao dịch nào.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var tx in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-all duration-150 group">
                            <td class="py-3.5 px-4 text-slate-400 font-mono font-bold text-center">#@tx.Id</td>
                            <td class="py-3.5 px-4 font-bold text-slate-700">@(string.IsNullOrWhiteSpace(tx.Username) ? "N/A" : tx.Username)</td>
                            <td class="py-3.5 px-4 font-extrabold text-slate-800">
                                @if (tx.TransactionType == "Deposit" || tx.TransactionType == "Nạp Tiền")
                                {
                                    <span class="text-emerald-600 inline-flex items-center gap-1.5"><i class="fa-solid fa-arrow-down-left"></i> Nạp Ví</span>
                                }
                                else
                                {
                                    <span class="text-indigo-600 inline-flex items-center gap-1.5"><i class="fa-solid fa-cart-shopping"></i> Mua Game</span>
                                }
                            </td>
                            <td class="py-3.5 px-4 font-bold text-slate-600">@tx.PaymentGateway</td>
                            <td class="py-3.5 px-4 font-mono font-bold text-slate-400">@(string.IsNullOrEmpty(tx.GatewayTransactionId) ? "N/A" : tx.GatewayTransactionId)</td>
                            <td class="py-3.5 px-4 font-black @(tx.TransactionType == "Deposit" ? "text-emerald-600" : "text-slate-900")">@(tx.TransactionType == "Deposit" ? "+" : "-")@Math.Abs(tx.Amount).ToString("N0")đ</td>
                            <td class="py-3.5 px-4">
                                @if (tx.Status == "Success" || tx.Status == "Thành Công")
                                {
                                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-200">Thành Công</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-lg text-xs font-bold border border-amber-200">Đang Xử Lý</span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-right text-slate-400 text-xs font-medium">@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
