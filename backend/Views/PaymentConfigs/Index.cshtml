@model List<Backend.Models.PaymentConfigViewModel>

@{
    ViewData["Title"] = "Cấu Hình Cổng Thanh Toán";
}

<div class="admin-card p-8 mb-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 border-b border-slate-100 pb-6">
        <div>
            <h3 class="text-xl font-black text-slate-800">Cấu Hình Cổng Thanh Toán Trực Tuyến</h3>
            <p class="text-xs text-slate-400 font-medium mt-1">Cấu hình tham số kết nối API cho VNPay, MoMo và Ví Điện Tử Nexus.</p>
        </div>
        <button onclick="saveConfigs()" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold shadow-sm shadow-indigo-200 transition-all active:scale-95 text-xs flex items-center gap-2">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Lưu Cấu Hình</span>
        </button>
    </div>

    <!-- Payment Gateways Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- VNPay Config Card -->
        <div class="border border-slate-200 rounded-3xl p-6 bg-slate-50/50">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-200/80">
                <div class="w-10 h-10 rounded-2xl bg-blue-100 text-blue-600 font-black flex items-center justify-center text-sm">
                    <i class="fa-solid fa-credit-card"></i>
                </div>
                <div>
                    <h4 class="text-base font-extrabold text-slate-800">Cổng Thanh Toán VNPay</h4>
                    <span class="text-xs font-bold text-emerald-600">Đang Hoạt Động (Sandbox)</span>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Mã Website (TmnCode)</label>
                    <input type="text" id="vnp_TmnCode" value="@(Model?.FirstOrDefault(c => c.GatewayName == "VNPay" && c.ConfigKey == "TmnCode")?.ConfigValue ?? "TESTTMNC")" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 font-mono font-bold" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Mã Khóa Bí Mật (HashSecret)</label>
                    <input type="password" id="vnp_HashSecret" value="@(Model?.FirstOrDefault(c => c.GatewayName == "VNPay" && c.ConfigKey == "HashSecret")?.ConfigValue ?? "01234567890123456789012345678912")" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 font-mono font-bold" />
                </div>
            </div>
        </div>

        <!-- MoMo Config Card -->
        <div class="border border-slate-200 rounded-3xl p-6 bg-slate-50/50">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-200/80">
                <div class="w-10 h-10 rounded-2xl bg-pink-100 text-pink-600 font-black flex items-center justify-center text-sm">
                    <i class="fa-solid fa-wallet"></i>
                </div>
                <div>
                    <h4 class="text-base font-extrabold text-slate-800">Ví Điện Tử MoMo</h4>
                    <span class="text-xs font-bold text-emerald-600">Đang Hoạt Động (Sandbox)</span>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Mã Đối Tác (PartnerCode)</label>
                    <input type="text" id="momo_PartnerCode" value="@(Model?.FirstOrDefault(c => c.GatewayName == "MoMo" && c.ConfigKey == "PartnerCode")?.ConfigValue ?? "MOMOTEST")" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 font-mono font-bold" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">AccessKey</label>
                    <input type="text" id="momo_AccessKey" value="@(Model?.FirstOrDefault(c => c.GatewayName == "MoMo" && c.ConfigKey == "AccessKey")?.ConfigValue ?? "TESTACCESSKEY123")" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 font-mono font-bold" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function saveConfigs() {
        const payload = [
            { gatewayName: 'VNPay', configKey: 'TmnCode', configValue: document.getElementById('vnp_TmnCode').value },
            { gatewayName: 'VNPay', configKey: 'HashSecret', configValue: document.getElementById('vnp_HashSecret').value },
            { gatewayName: 'MoMo', configKey: 'PartnerCode', configValue: document.getElementById('momo_PartnerCode').value },
            { gatewayName: 'MoMo', configKey: 'AccessKey', configValue: document.getElementById('momo_AccessKey').value }
        ];

        try {
            const res = await apiFetch('/api-proxy/api/v1/payment-configurations', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                alert("Lưu cấu hình cổng thanh toán thành công!");
                window.location.reload();
            } else {
                alert("Lỗi khi lưu cấu hình!");
            }
        } catch (e) { console.error(e); }
    }
</script>
}
