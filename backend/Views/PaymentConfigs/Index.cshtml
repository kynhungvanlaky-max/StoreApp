@model List<Backend.Models.PaymentConfigDto>

@{
    ViewData["Title"] = "Cấu hình Thanh toán";
    Layout = "_Layout";
    
    var vnPayConfigs = Model.Where(c => c.GatewayName == "VNPay").ToList();
    var moMoConfigs = Model.Where(c => c.GatewayName == "MoMo").ToList();
    
    // Default keys to display
    var vnPayKeys = new[] { "TmnCode", "HashSecret", "BaseUrl", "ReturnUrl" };
    var moMoKeys = new[] { "PartnerCode", "AccessKey", "SecretKey", "Endpoint", "ReturnUrl", "NotifyUrl" };
}

<div class="glassmorphism rounded-3xl p-8 mb-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 border-b border-white/10 pb-6">
        <div>
            <h1 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500 mb-2">Cổng Thanh Toán</h1>
            <p class="text-gray-400 text-sm">Quản lý tham số cấu hình cho VNPay và Ví MoMo</p>
        </div>
        <div class="flex items-center gap-3">
            <button form="configForm" type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-400 to-purple-400 hover:from-blue-500 hover:to-purple-500 text-white rounded-xl font-bold shadow-[0_0_20px_rgba(37,99,235,0.3)] flex items-center gap-2 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                Lưu Thay Đổi
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-8 p-4 bg-green-500/10 border border-green-500/20 text-green-400 rounded-xl font-medium flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-8 p-4 bg-red-500/10 border border-red-500/20 text-red-400 rounded-xl font-medium flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            @TempData["Error"]
        </div>
    }

    <form id="configForm" asp-action="Save" method="post">
        <div class="grid grid-cols-1 gap-6">
            
            <div class="bg-black/40 border border-blue-500/20 rounded-3xl p-6 relative overflow-hidden group cursor-pointer" onclick="toggleAccordion('vnpay-config', 'vnpay-icon')">
                <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/100/5 rounded-full blur-3xl -mr-20 -mt-20 group-hover:bg-blue-500/10 transition-colors pointer-events-none"></div>
                
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-5">
                        <div class="w-16 h-12 flex items-center justify-center rounded-xl bg-white shadow-[0_4px_15px_rgba(0,91,170,0.2)] shrink-0">
                            <span class="font-black text-lg tracking-tighter italic">
                                <span class="text-[#005BAA]">VN</span><span class="text-[#ED1C24]">PAY</span>
                            </span>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-white">VNPay</h2>
                            <p class="text-blue-400 text-xs font-medium">Cổng thanh toán quốc gia</p>
                        </div>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10 group-hover:bg-white/10 transition-colors">
                        <svg id="vnpay-icon" class="w-5 h-5 text-white transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>

                <div id="vnpay-config" class="space-y-5 relative z-10 mt-8 hidden border-t border-white/10 pt-6 cursor-default" onclick="event.stopPropagation()">
                    @{ int index = 0; }
                    @foreach (var key in vnPayKeys)
                    {
                        var config = vnPayConfigs.FirstOrDefault(c => c.ConfigKey == key);
                        var val = config != null ? config.ConfigValue : "";

                        <div>
                            <label class="block text-sm font-bold text-gray-400 mb-2 ml-1">@key</label>
                            <input type="hidden" name="configs[@index].GatewayName" value="VNPay" />
                            <input type="hidden" name="configs[@index].ConfigKey" value="@key" />
                            <input type="text" name="configs[@index].ConfigValue" value="@val" class="w-full bg-white/5 border border-white/10 rounded-xl px-5 py-3.5 text-white focus:outline-none focus:border-blue-500 focus:bg-white/5/10 transition-all placeholder:text-gray-400 font-mono text-sm" placeholder="Chưa cấu hình..." />
                        </div>
                        index++;
                    }
                </div>
            </div>

            <div class="bg-black/40 border border-pink-500/20 rounded-3xl p-6 relative overflow-hidden group cursor-pointer" onclick="toggleAccordion('momo-config', 'momo-icon')">
                <div class="absolute top-0 left-0 w-64 h-64 bg-pink-500/5 rounded-full blur-3xl -ml-20 -mt-20 group-hover:bg-pink-500/10 transition-colors pointer-events-none"></div>
                
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-5">
                        <div class="w-16 h-12 flex items-center justify-center rounded-xl bg-[#A50064] shadow-[0_4px_15px_rgba(165,0,100,0.4)] shrink-0">
                            <span class="text-white font-black text-xl tracking-tighter lowercase">momo</span>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-white">Ví MoMo</h2>
                            <p class="text-pink-400 text-xs font-medium">Thanh toán qua ví điện tử</p>
                        </div>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10 group-hover:bg-white/10 transition-colors">
                        <svg id="momo-icon" class="w-5 h-5 text-white transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>

                <div id="momo-config" class="space-y-5 relative z-10 mt-8 hidden border-t border-white/10 pt-6 cursor-default" onclick="event.stopPropagation()">
                    @foreach (var key in moMoKeys)
                    {
                        var config = moMoConfigs.FirstOrDefault(c => c.ConfigKey == key);
                        var val = config != null ? config.ConfigValue : "";

                        <div>
                            <label class="block text-sm font-bold text-gray-400 mb-2 ml-1">@key</label>
                            <input type="hidden" name="configs[@index].GatewayName" value="MoMo" />
                            <input type="hidden" name="configs[@index].ConfigKey" value="@key" />
                            <input type="text" name="configs[@index].ConfigValue" value="@val" class="w-full bg-white/5 border border-white/10 rounded-xl px-5 py-3.5 text-white focus:outline-none focus:border-pink-500 focus:bg-white/5/10 transition-all placeholder:text-gray-400 font-mono text-sm" placeholder="Chưa cấu hình..." />
                        </div>
                        index++;
                    }
                </div>
            </div>

        </div>
    </form>
    
    <script>
        function toggleAccordion(contentId, iconId) {
            const content = document.getElementById(contentId);
            const icon = document.getElementById(iconId);
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            } else {
                content.classList.add('hidden');
                icon.style.transform = 'rotate(0deg)';
            }
        }
    </script>
</div>