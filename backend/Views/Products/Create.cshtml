@model Backend.Models.ProductViewModel

@{
    ViewData["Title"] = "Thêm Game Mới";
}

<div class="max-w-4xl">
    <div class="flex items-center gap-4 mb-8">
        <a href="/Products" class="w-10 h-10 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-white transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <h1 class="text-2xl font-bold text-white">Thêm Sản Phẩm Mới</h1>
    </div>

    <form asp-action="Create" method="post" class="space-y-6">
        <div class="glassmorphism rounded-3xl p-8">
            <h2 class="text-lg font-bold text-white mb-6 border-b border-white/10 pb-4">Thông tin cơ bản</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label asp-for="Name" class="text-sm font-bold text-gray-300">Tên Game <span class="text-red-500">*</span></label>
                    <input asp-for="Name" class="w-full bg-[#050505] border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="Ví dụ: Cyberpunk 2077" required />
                    <span asp-validation-for="Name" class="text-xs text-red-500"></span>
                </div>
                
                <div class="space-y-2">
                    <label asp-for="DeveloperName" class="text-sm font-bold text-gray-300">Nhà Phát Triển <span class="text-red-500">*</span></label>
                    <input asp-for="DeveloperName" class="w-full bg-[#050505] border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="Ví dụ: CD Projekt Red" required />
                    <span asp-validation-for="DeveloperName" class="text-xs text-red-500"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Type" class="text-sm font-bold text-gray-300">Thể Loại</label>
                    <input asp-for="Type" class="w-full bg-[#050505] border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="Ví dụ: RPG, Action" />
                </div>
                
                <div class="space-y-2">
                    <label asp-for="BasePrice" class="text-sm font-bold text-gray-300">Giá Gốc (VNĐ) <span class="text-red-500">*</span></label>
                    <input asp-for="BasePrice" type="number" class="w-full bg-[#050505] border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="0" required />
                    <span asp-validation-for="BasePrice" class="text-xs text-red-500"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Status" class="text-sm font-bold text-gray-300">Trạng Thái</label>
                    <select asp-for="Status" class="w-full bg-[#050505] border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors">
                        <option value="Active">Đang Bán</option>
                        <option value="Inactive">Ngừng Bán</option>
                    </select>
                </div>

                <div class="space-y-2 md:col-span-2">
                    <label asp-for="ImageUrl" class="text-sm font-bold text-gray-300">Link Hình Ảnh (Cover)</label>
                    <input asp-for="ImageUrl" class="w-full bg-[#050505] border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="https://..." />
                </div>

                <div class="space-y-2 md:col-span-2">
                    <label asp-for="Description" class="text-sm font-bold text-gray-300">Mô Tả Chi Tiết</label>
                    <textarea asp-for="Description" rows="5" class="w-full bg-[#050505] border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="Nhập giới thiệu về game..."></textarea>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-4">
            <a href="/Products" class="px-6 py-3 rounded-xl font-bold text-white bg-white/5 hover:bg-white/10 transition-colors">Hủy</a>
            <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-400 to-purple-400 hover:from-blue-500 hover:to-purple-500 text-white rounded-xl font-bold shadow-[0_0_20px_rgba(37,99,235,0.3)] transition-all">Lưu Sản Phẩm</button>
        </div>
    </form>
</div>
