@{
    ViewData["Title"] = "Quản Lý Sản Phẩm (Game)";
}

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div class="relative w-full md:w-96">
            <input type="text" id="searchInput" placeholder="Tìm kiếm sản phẩm, nhà phát triển..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 pl-11 text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all font-medium placeholder-slate-400" />
            <i class="fa-solid fa-magnifying-glass text-slate-400 absolute left-4 top-3.5 text-sm"></i>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="openModal()" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold shadow-sm shadow-indigo-200 flex items-center gap-2 transition-all active:scale-95 text-sm">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>Thêm Game Mới</span>
            </button>
        </div>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto min-h-[380px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-wider bg-slate-50/80 border-b border-slate-200">
                    <th class="py-3 px-4 font-bold w-16 text-center rounded-l-xl">ID</th>
                    <th class="py-3 px-4 font-bold">Hình Ảnh & Tên Game</th>
                    <th class="py-3 px-4 font-bold">Nhà Phát Triển</th>
                    <th class="py-3 px-4 font-bold">Thể Loại</th>
                    <th class="py-3 px-4 font-bold">Giá Gốc</th>
                    <th class="py-3 px-4 font-bold">Trạng Thái</th>
                    <th class="py-3 px-4 font-bold text-right rounded-r-xl">Hành Động</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100" id="productsTableBody">
                <tr>
                    <td colspan="7" class="py-12 text-center text-slate-400">
                        <div class="flex items-center justify-center gap-2 font-medium">
                            <i class="fa-solid fa-circle-notch fa-spin text-indigo-600 text-lg"></i>
                            <span>Đang tải dữ liệu sản phẩm...</span>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-slate-100 pt-6 gap-4">
        <div class="text-sm font-semibold text-slate-500" id="pageInfo">
            Hiển thị 0 kết quả
        </div>
        <div class="flex items-center gap-1.5" id="paginationContainer">
        </div>
    </div>
</div>

<!-- Modal Create / Edit Product -->
<div id="productModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeModal()"></div>
    
    <div class="relative bg-white rounded-3xl w-full max-w-xl overflow-hidden shadow-2xl border border-slate-200 transform transition-all max-h-[90vh] flex flex-col">
        <div class="p-6 border-b border-slate-100 bg-slate-50/80 flex justify-between items-center">
            <h3 id="modalTitle" class="text-xl font-black text-slate-800">Thêm Game Mới</h3>
            <button onclick="closeModal()" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-all">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        
        <form id="productForm" class="p-6 space-y-4 overflow-y-auto flex-1">
            <input type="hidden" id="productId" value="" />
            
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Tên Game / Sản Phẩm</label>
                <input type="text" id="pName" required placeholder="Nhập tên sản phẩm..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none font-medium" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Loại Sản Phẩm</label>
                    <select id="pType" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none font-medium">
                        <option value="Game">Game</option>
                        <option value="App">App / Phần mềm</option>
                        <option value="DLC">DLC / Mở rộng</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Giá Gốc (VNĐ)</label>
                    <input type="number" id="pBasePrice" required min="0" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none font-medium" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Thể Loại (Danh Mục)</label>
                <div id="categoryCheckboxesContainer" class="grid grid-cols-2 sm:grid-cols-3 gap-2 p-3 bg-slate-50 border border-slate-200 rounded-xl max-h-36 overflow-y-auto">
                    <p class="col-span-3 text-xs text-slate-400 text-center py-2">Đang tải danh sách thể loại...</p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Nhà Phát Triển</label>
                    <input type="text" id="pDeveloper" placeholder="VD: CD Projekt Red..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none font-medium" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Trạng Thái</label>
                    <select id="pStatus" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none font-medium">
                        <option value="Active">Đang Bán (Active)</option>
                        <option value="Inactive">Ngừng Bán (Inactive)</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Hình Ảnh & Video Sản Phẩm</label>
                <div class="flex gap-2 mb-3">
                    <button type="button" onclick="document.getElementById('pImgFile').click()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs border border-slate-200 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-cloud-arrow-up text-indigo-600"></i>
                        <span>Tải Ảnh/Video Lên</span>
                    </button>
                    <input type="file" id="pImgFile" accept="image/*,video/*" multiple class="hidden" onchange="uploadMultipleMedia(this)" />
                </div>
                <div id="mediaListContainer" class="grid grid-cols-3 gap-2 p-3 bg-slate-50 border border-slate-200 rounded-xl min-h-[90px]">
                    <p id="emptyMediaText" class="col-span-3 text-center text-xs text-slate-400 py-4 font-medium">Chưa có media nào được tải lên.</p>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Mô Tả Sản Phẩm</label>
                <textarea id="pDescription" rows="3" placeholder="Nhập mô tả chi tiết..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none font-medium"></textarea>
            </div>
        </form>
        
        <div class="p-6 border-t border-slate-100 bg-slate-50/60 flex justify-end gap-3">
            <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl text-slate-700 font-bold bg-slate-100 hover:bg-slate-200 transition-all text-xs border border-slate-200">Hủy Bỏ</button>
            <button type="button" onclick="saveProduct()" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold transition-all text-xs shadow-sm shadow-indigo-200 active:scale-95">Lưu Sản Phẩm</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const authHeaders = {};

    let currentPage = 1;
    let currentSearch = '';
    let mediaList = []; // { url: string, type: 'Image' | 'Video' }
    let allCategories = [];

    const DOM = {
        tbody: document.getElementById('productsTableBody'),
        searchInput: document.getElementById('searchInput'),
        pageInfo: document.getElementById('pageInfo'),
        paginationContainer: document.getElementById('paginationContainer'),
        modal: document.getElementById('productModal'),
        form: document.getElementById('productForm')
    };

    function formatVND(n) {
        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
    }

    function safeUrl(url) {
        if (!url) return '';
        if (url.startsWith('http://') || url.startsWith('https://')) return url;
        if (url.startsWith('/')) return url;
        return '/' + url;
    }

    async function loadCategories() {
        try {
            const res = await apiFetch('/api-proxy/api/v1/categories', { headers: authHeaders });
            if (res.ok) {
                allCategories = await res.json();
                renderCategoryCheckboxes();
            }
        } catch (e) { console.error("Lỗi khi tải categories:", e); }
    }

    function renderCategoryCheckboxes(selectedCategories = []) {
        const container = document.getElementById('categoryCheckboxesContainer');
        if (!allCategories || allCategories.length === 0) {
            container.innerHTML = `<p class="col-span-3 text-xs text-slate-400 text-center py-2">Không có thể loại nào</p>`;
            return;
        }
        container.innerHTML = allCategories.map(cat => {
            const isChecked = selectedCategories && selectedCategories.includes(cat.name);
            return `
                <label class="flex items-center gap-2 text-xs text-slate-700 hover:text-indigo-600 cursor-pointer p-1 rounded hover:bg-slate-100 transition-colors">
                    <input type="checkbox" value="${cat.name}" ${isChecked ? 'checked' : ''} class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-3.5 h-3.5" />
                    <span class="truncate font-medium">${cat.name}</span>
                </label>
            `;
        }).join('');
    }

    async function loadProducts(page = 1, search = '') {
        currentPage = page;
        DOM.tbody.innerHTML = `
            <tr>
                <td colspan="7" class="py-12 text-center text-slate-400">
                    <div class="flex items-center justify-center gap-2 font-medium">
                        <i class="fa-solid fa-circle-notch fa-spin text-indigo-600 text-lg"></i>
                        <span>Đang tải dữ liệu sản phẩm...</span>
                    </div>
                </td>
            </tr>
        `;

        try {
            const query = new URLSearchParams({
                page: page,
                pageSize: 10,
                search: search
            });

            const res = await apiFetch(`/api-proxy/api/v1/products?${query.toString()}`, {
                headers: authHeaders
            });

            if (res.ok) {
                const data = await res.json();
                renderTable(data.data || []);
                renderPagination(data.currentPage, data.totalPages, data.totalItems);
            } else {
                DOM.tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-rose-500 font-semibold">Lỗi tải danh sách sản phẩm!</td></tr>`;
            }
        } catch (e) {
            console.error(e);
            DOM.tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-rose-500 font-semibold">Không thể kết nối máy chủ!</td></tr>`;
        }
    }

    function renderTable(products) {
        if (!products || products.length === 0) {
            DOM.tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="py-12 text-center text-slate-400">
                        <i class="fa-solid fa-box-open text-3xl mb-2 text-slate-300"></i>
                        <p class="font-medium">Không tìm thấy sản phẩm nào phù hợp.</p>
                    </td>
                </tr>
            `;
            return;
        }

        DOM.tbody.innerHTML = products.map(p => {
            const statusBadge = p.status === 'Active'
                ? `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-600 border border-emerald-200">Đang Bán</span>`
                : `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500 border border-slate-200">Ngừng Bán</span>`;

            const categoriesText = (p.categories && p.categories.length > 0)
                ? p.categories.slice(0, 2).map(c => `<span class="inline-block bg-slate-100 text-slate-600 text-[10px] font-semibold px-2 py-0.5 rounded-md mr-1 mb-1">${c}</span>`).join('') + (p.categories.length > 2 ? `<span class="text-[10px] text-slate-400">+${p.categories.length - 2}</span>` : '')
                : `<span class="text-xs text-slate-400 italic">Chưa phân loại</span>`;

            return `
                <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-slate-400 text-center">#${p.id}</td>
                    <td class="py-3.5 px-4">
                        <div class="flex items-center gap-3">
                            <img src="${safeUrl(p.imageUrl) || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?w=100'}" class="w-12 h-12 object-cover rounded-xl border border-slate-200 bg-slate-100 flex-shrink-0" onerror="this.src='https://images.unsplash.com/photo-1542751371-adc38448a05e?w=100'" />
                            <div>
                                <span class="font-bold text-slate-800 line-clamp-1">${p.name}</span>
                                <span class="text-xs text-slate-400">${p.type || 'Game'}</span>
                            </div>
                        </div>
                    </td>
                    <td class="py-3.5 px-4 font-medium text-slate-600">${p.developerName || 'Chưa cập nhật'}</td>
                    <td class="py-3.5 px-4 max-w-[200px]">${categoriesText}</td>
                    <td class="py-3.5 px-4 font-black text-slate-800">${formatVND(p.basePrice)}</td>
                    <td class="py-3.5 px-4">${statusBadge}</td>
                    <td class="py-3.5 px-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <button onclick="editProduct(${p.id})" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 flex items-center justify-center transition-all" title="Chỉnh sửa">
                                <i class="fa-solid fa-pen-to-square text-xs"></i>
                            </button>
                            <button onclick="deleteProduct(${p.id})" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-rose-50 hover:text-rose-600 text-slate-600 flex items-center justify-center transition-all" title="Xóa">
                                <i class="fa-solid fa-trash-can text-xs"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        }).join('');
    }

    function renderPagination(current, total, totalItems) {
        DOM.pageInfo.innerText = `Hiển thị ${totalItems} kết quả (Trang ${current}/${total || 1})`;
        if (total <= 1) {
            DOM.paginationContainer.innerHTML = '';
            return;
        }

        let html = '';
        if (current > 1) {
            html += `<button onclick="loadProducts(${current - 1}, '${currentSearch}')" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs"><i class="fa-solid fa-chevron-left"></i></button>`;
        }
        for (let i = 1; i <= total; i++) {
            if (i === 1 || i === total || (i >= current - 1 && i <= current + 1)) {
                html += `<button onclick="loadProducts(${i}, '${currentSearch}')" class="w-8 h-8 rounded-xl ${i === current ? 'bg-indigo-600 text-white shadow-sm shadow-indigo-200' : 'bg-slate-100 hover:bg-slate-200 text-slate-600'} flex items-center justify-center font-bold text-xs">${i}</button>`;
            } else if (i === current - 2 || i === current + 2) {
                html += `<span class="px-1 text-slate-400 text-xs">...</span>`;
            }
        }
        if (current < total) {
            html += `<button onclick="loadProducts(${current + 1}, '${currentSearch}')" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs"><i class="fa-solid fa-chevron-right"></i></button>`;
        }
        DOM.paginationContainer.innerHTML = html;
    }

    function openModal() {
        document.getElementById('modalTitle').innerText = "Thêm Game Mới";
        document.getElementById('productId').value = '';
        DOM.form.reset();
        mediaList = [];
        renderMediaList();
        renderCategoryCheckboxes([]);
        DOM.modal.classList.remove('hidden');
    }

    function closeModal() {
        DOM.modal.classList.add('hidden');
    }

    function renderMediaList() {
        const container = document.getElementById('mediaListContainer');
        if (!mediaList || mediaList.length === 0) {
            container.innerHTML = `<p id="emptyMediaText" class="col-span-3 text-center text-xs text-slate-400 py-4 font-medium">Chưa có media nào được tải lên.</p>`;
            return;
        }

        container.innerHTML = mediaList.map((m, idx) => `
            <div class="relative group rounded-lg overflow-hidden border border-slate-200 bg-black/5 h-20">
                ${m.type === 'Video' 
                    ? `<video src="${safeUrl(m.url)}" class="w-full h-full object-cover"></video><span class="absolute bottom-1 left-1 bg-black/60 text-white text-[9px] px-1 rounded font-bold"><i class="fa-solid fa-video"></i></span>`
                    : `<img src="${safeUrl(m.url)}" alt="" class="w-full h-full object-cover" />`
                }
                <button type="button" onclick="removeMedia(${idx})" class="absolute top-1 right-1 w-5 h-5 rounded-full bg-rose-500 text-white text-xs flex items-center justify-center shadow-xs opacity-80 hover:opacity-100 transition-opacity">
                    <i class="fa-solid fa-xmark text-[10px]"></i>
                </button>
            </div>
        `).join('');
    }

    function removeMedia(idx) {
        mediaList.splice(idx, 1);
        renderMediaList();
    }

    async function uploadMultipleMedia(input) {
        if (!input.files || input.files.length === 0) return;
        const formData = new FormData();
        for (let i = 0; i < input.files.length; i++) {
            formData.append('files', input.files[i]);
        }

        try {
            const res = await apiFetch('/api-proxy/api/v1/media-files', {
                method: 'POST',
                headers: authHeaders,
                body: formData
            });
            if (res.ok) {
                const data = await res.json();
                if (data.urls && data.urls.length > 0) {
                    data.urls.forEach(url => {
                        const isVideo = url.endsWith('.mp4') || url.endsWith('.webm');
                        mediaList.push({ url: url, type: isVideo ? 'Video' : 'Image' });
                    });
                    renderMediaList();
                }
            } else {
                alert("Lỗi khi tải file media lên!");
            }
        } catch (e) { console.error(e); }
    }

    async function editProduct(id) {
        try {
            const res = await apiFetch(`/api-proxy/api/v1/products/${id}`, { headers: authHeaders });
            if (res.ok) {
                const p = await res.json();
                document.getElementById('modalTitle').innerText = "Chỉnh Sửa Sản Phẩm";
                document.getElementById('productId').value = p.id;
                document.getElementById('pName').value = p.name;
                document.getElementById('pType').value = p.type || 'Game';
                document.getElementById('pBasePrice').value = p.basePrice || 0;
                document.getElementById('pDeveloper').value = p.developerName || '';
                document.getElementById('pStatus').value = p.status || 'Active';
                document.getElementById('pDescription').value = p.description || '';
                
                mediaList = p.media && p.media.length > 0 ? p.media : (p.imageUrl ? [{ url: p.imageUrl, type: 'Image' }] : []);
                renderMediaList();
                renderCategoryCheckboxes(p.categories || []);
                DOM.modal.classList.remove('hidden');
            }
        } catch (e) { console.error(e); }
    }

    async function saveProduct() {
        const id = document.getElementById('productId').value;
        const selectedCategories = [];
        document.querySelectorAll('#categoryCheckboxesContainer input[type="checkbox"]:checked').forEach(cb => {
            selectedCategories.push(cb.value);
        });

        const payload = {
            name: document.getElementById('pName').value,
            type: document.getElementById('pType').value,
            basePrice: parseFloat(document.getElementById('pBasePrice').value) || 0,
            developerName: document.getElementById('pDeveloper').value,
            status: document.getElementById('pStatus').value,
            imageUrl: mediaList.length > 0 ? mediaList[0].url : '',
            media: mediaList,
            categories: selectedCategories,
            description: document.getElementById('pDescription').value
        };

        const method = id ? 'PUT' : 'POST';
        const url = id ? `/api-proxy/api/v1/products/${id}` : '/api-proxy/api/v1/products';

        try {
            const res = await apiFetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json', ...authHeaders },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                closeModal();
                loadProducts(currentPage, currentSearch);
                loadCategories();
            } else {
                alert("Có lỗi xảy ra khi lưu sản phẩm!");
            }
        } catch (e) { console.error(e); }
    }

    async function deleteProduct(id) {
        if (!confirm("Bạn có chắc chắn muốn xóa sản phẩm này?")) return;
        try {
            const res = await apiFetch(`/api-proxy/api/v1/products/${id}`, {
                method: 'DELETE',
                headers: authHeaders
            });
            if (res.ok) {
                loadProducts(currentPage, currentSearch);
                loadCategories();
            } else {
                const text = await res.text();
                alert(text || "Không thể xóa sản phẩm này!");
            }
        } catch (e) { console.error(e); }
    }

    let searchTimeout;
    DOM.searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            currentSearch = e.target.value;
            loadProducts(1, currentSearch);
        }, 400);
    });

    document.addEventListener('DOMContentLoaded', () => {
        loadCategories();
        loadProducts(1, '');
    });
</script>
}
