@model List<Backend.Models.PromotionViewModel>

@{
    ViewData["Title"] = "Quản Lý Chương Trình Khuyến Mãi";
}

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div class="relative w-full md:w-96">
            <input type="text" id="searchInput" placeholder="Tìm kiếm chiến dịch khuyến mãi..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 pl-11 text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all font-medium placeholder-slate-400" />
            <i class="fa-solid fa-magnifying-glass text-slate-400 absolute left-4 top-3.5 text-sm"></i>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="document.getElementById('promoModal').classList.remove('hidden')" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold shadow-sm shadow-indigo-200 flex items-center gap-2 transition-all active:scale-95 text-sm">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>Tạo Chiến Dịch Khuyến Mãi</span>
            </button>
        </div>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto min-h-[380px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-wider bg-slate-50/80 border-b border-slate-200">
                    <th class="py-3 px-4 font-bold w-16 text-center rounded-l-xl">ID</th>
                    <th class="py-3 px-4 font-bold">Tên Chiến Dịch Khuyến Mãi</th>
                    <th class="py-3 px-4 font-bold">Mức Giảm (%)</th>
                    <th class="py-3 px-4 font-bold">Ngày Bắt Đầu</th>
                    <th class="py-3 px-4 font-bold">Ngày Kết Thúc</th>
                    <th class="py-3 px-4 font-bold">Trạng Thái</th>
                    <th class="py-3 px-4 font-bold text-right rounded-r-xl">Hành Động</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-slate-400 font-medium">
                            <i class="fa-solid fa-bullhorn text-3xl text-slate-300 mb-2 block"></i>
                            <span>Chưa có chương trình khuyến mãi nào.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-all duration-150 group">
                            <td class="py-3.5 px-4 text-slate-400 font-mono font-bold text-center">#@p.Id</td>
                            <td class="py-3.5 px-4 font-extrabold text-slate-800 group-hover:text-indigo-600 transition-colors">@p.Name</td>
                            <td class="py-3.5 px-4 font-black text-rose-600">-@p.DiscountPercent%</td>
                            <td class="py-3.5 px-4 text-slate-500 text-xs font-medium">@p.StartDate.ToString("dd/MM/yyyy")</td>
                            <td class="py-3.5 px-4 text-slate-500 text-xs font-medium">@p.EndDate.ToString("dd/MM/yyyy")</td>
                            <td class="py-3.5 px-4">
                                @if (p.IsActive)
                                {
                                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-200">Đang Khuyến Mãi</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-lg text-xs font-bold border border-amber-200">Đã Kết Thúc</span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <button onclick="deletePromotion(@p.Id)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white inline-flex items-center justify-center transition-all shadow-2xs" title="Xóa">
                                    <i class="fa-solid fa-trash text-xs"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Create Promotion -->
<div id="promoModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="document.getElementById('promoModal').classList.add('hidden')"></div>
    
    <div class="relative bg-white rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl border border-slate-200 transform transition-all">
        <div class="p-6 border-b border-slate-100 bg-slate-50/80 flex justify-between items-center">
            <h3 class="text-xl font-black text-slate-800">Tạo Chiến Dịch Khuyến Mãi Mới</h3>
            <button onclick="document.getElementById('promoModal').classList.add('hidden')" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-all">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        
        <form id="promoForm" onsubmit="savePromotion(event)" class="p-6 space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Tên Chiến Dịch Khuyến Mãi</label>
                <input type="text" id="pTitle" required placeholder="VD: Khuyến Mãi Mùa Hè Steam..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-bold" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Mức Giảm Giá (%)</label>
                <input type="number" id="pDiscount" required min="1" max="100" placeholder="VD: 25" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-bold" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Ngày Bắt Đầu</label>
                    <input type="date" id="pStartDate" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-medium" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Ngày Kết Thúc</label>
                    <input type="date" id="pEndDate" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-medium" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Mô Tả Chiến Dịch</label>
                <textarea id="pDescription" rows="2" placeholder="Nhập chi tiết điều kiện áp dụng..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-medium"></textarea>
            </div>

            <div class="p-6 border-t border-slate-100 bg-slate-50/60 flex justify-end gap-3 -mx-6 -mb-6 mt-6">
                <button type="button" onclick="document.getElementById('promoModal').classList.add('hidden')" class="px-5 py-2.5 rounded-xl text-slate-700 font-bold bg-slate-100 hover:bg-slate-200 transition-all text-xs border border-slate-200">Hủy Bỏ</button>
                <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold transition-all text-xs shadow-sm shadow-indigo-200 active:scale-95">Tạo Khuyến Mãi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const authHeaders = {};

    async function savePromotion(e) {
        e.preventDefault();
        const payload = {
            name: document.getElementById('pTitle').value,
            discountPercent: parseFloat(document.getElementById('pDiscount').value) || 0,
            startDate: document.getElementById('pStartDate').value,
            endDate: document.getElementById('pEndDate').value,
            description: document.getElementById('pDescription').value,
            isActive: true
        };

        try {
            const res = await apiFetch('/api-proxy/api/v1/promotions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', ...authHeaders },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                document.getElementById('promoModal').classList.add('hidden');
                window.location.reload();
            } else {
                alert("Lỗi khi tạo chương trình khuyến mãi!");
            }
        } catch (err) { console.error(err); }
    }

    async function deletePromotion(id) {
        if (!confirm("Bạn có chắc chắn muốn xóa chiến dịch khuyến mãi này?")) return;
        try {
            const res = await apiFetch(`/api-proxy/api/v1/promotions/${id}`, {
                method: 'DELETE',
                headers: authHeaders
            });
            if (res.ok) window.location.reload();
        } catch (e) { console.error(e); }
    }
</script>
}

