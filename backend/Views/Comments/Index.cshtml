@model Backend.Models.CommentListViewModel

@{
    ViewData["Title"] = "Quản lý Bình luận";
    Layout = "_Layout";
    ViewBag.PaginationAction = "?page=";
}

<div class="glassmorphism rounded-3xl p-8 mb-8">
    <div class="flex justify-between items-center mb-8 border-b border-white/10 pb-6">
        <div>
            <h1 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500 mb-2">Quản lý Đánh Giá</h1>
            <p class="text-gray-400 text-sm">Quản lý đánh giá và phản hồi từ người dùng</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-8 p-4 bg-green-500/10 border border-green-500/20 text-green-400 rounded-xl font-medium flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-8 p-4 bg-red-500/10 border border-red-500/20 text-red-400 rounded-xl font-medium flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            @TempData["Error"]
        </div>
    }

    <div class="space-y-6">
        @if (!Model.Comments.Any())
        {
            <div class="bg-black/40 border border-white/10 rounded-2xl p-8 text-center">
                <p class="text-gray-400">Chưa có bình luận nào.</p>
            </div>
        }

        @foreach (var c in Model.Comments)
        {
            <div class="bg-black/40 border border-white/10 rounded-2xl p-6 transition-all hover:bg-white/5 group">
                <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                    
                    <div class="flex-1">
                        <div class="flex items-center gap-3 mb-2">
                            <h3 class="font-bold text-white text-lg">@c.Username</h3>
                            <span class="text-gray-500 text-sm">&bull;</span>
                            <span class="text-blue-400 text-sm font-medium">@c.ProductName</span>
                            <span class="text-gray-500 text-sm">&bull;</span>
                            <span class="text-gray-400 text-sm">@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            
                            @if(c.IsHidden) {
                                <span class="px-2 py-0.5 bg-yellow-500/20 text-yellow-400 text-xs rounded border border-yellow-500/30">Đã ẩn</span>
                            }
                        </div>
                        
                        <div class="mb-3">
                            @if(c.Rating >= 3) {
                                <span class="inline-flex items-center gap-1 text-green-400 font-bold text-sm bg-green-500/10 px-2 py-1 rounded">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                    Đã khuyên dùng
                                </span>
                            } else {
                                <span class="inline-flex items-center gap-1 text-red-400 font-bold text-sm bg-red-500/10 px-2 py-1 rounded">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"></path></svg>
                                    Không khuyên dùng
                                </span>
                            }
                        </div>
                        
                        <p class="text-gray-300">@c.Content</p>
                    </div>

                    <div class="flex items-center gap-2">
                        <form asp-action="ToggleVisibility" asp-route-id="@c.Id" method="post" class="m-0">
                            <button type="submit" class="w-9 h-9 rounded bg-white/5 hover:bg-white/10 text-white flex items-center justify-center transition-colors" title="@(c.IsHidden ? "Hiện đánh giá" : "Ẩn đánh giá")">
                                @if (c.IsHidden)
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                }
                                else
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
                                }
                            </button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa Đánh giá này? Toàn bộ phản hồi của đánh giá này cũng sẽ bị xóa.');">
                            <button type="submit" class="w-9 h-9 rounded bg-red-500/10 hover:bg-red-500/100 text-red-400 hover:text-blue-400 flex items-center justify-center transition-colors" title="Xóa đánh giá">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </form>
                    </div>
                </div>

                @if (c.Replies != null && c.Replies.Any())
                {
                    <div class="mt-6 ml-8 pl-6 border-l-2 border-white/10 space-y-4">
                        @foreach (var reply in c.Replies)
                        {
                            <div class="bg-white/5 rounded-xl p-4 relative group/reply">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="font-bold text-white text-sm">@reply.Username</span>
                                            <span class="text-gray-500 text-xs">@reply.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                            @if(reply.IsHidden) {
                                                <span class="px-1.5 py-0.5 bg-yellow-500/20 text-yellow-400 text-[10px] rounded border border-yellow-500/30">Đã ẩn</span>
                                            }
                                        </div>
                                        <p class="text-sm text-gray-300">@reply.Content</p>
                                    </div>
                                    <div class="flex items-center gap-1 opacity-0 group-hover/reply:opacity-100 transition-opacity">
                                        <form asp-action="ToggleReplyVisibility" asp-route-id="@reply.Id" method="post" class="m-0">
                                            <button type="submit" class="w-7 h-7 rounded bg-white/5 hover:bg-white/10 text-white flex items-center justify-center transition-colors" title="@(reply.IsHidden ? "Hiện phản hồi" : "Ẩn phản hồi")">
                                                @if (reply.IsHidden)
                                                {
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                                }
                                                else
                                                {
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
                                                }
                                            </button>
                                        </form>
                                        <form asp-action="DeleteReply" asp-route-id="@reply.Id" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa Phản hồi này?');">
                                            <button type="submit" class="w-7 h-7 rounded bg-red-500/10 hover:bg-red-500/100 text-red-400 hover:text-blue-400 flex items-center justify-center transition-colors" title="Xóa phản hồi">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="glassmorphism rounded-3xl p-6">
            @await Html.PartialAsync("_Pagination")
        </div>
    }
</div>
