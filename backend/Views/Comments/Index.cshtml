@model List<Backend.Models.ReviewViewModel>

@{
    ViewData["Title"] = "Quản Lý Đánh Giá & Bình Luận";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count ?? 0);
}

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h3 class="text-xl font-black text-slate-800">Quản Lý Đánh Giá Game từ Người Dùng</h3>
            <p class="text-xs text-slate-400 font-medium mt-1">Kiểm duyệt đánh giá, phản hồi bình luận và quản lý trải nghiệm sản phẩm.</p>
        </div>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto min-h-[380px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-wider bg-slate-50/80 border-b border-slate-200">
                    <th class="py-3 px-4 font-bold w-16 text-center rounded-l-xl">ID</th>
                    <th class="py-3 px-4 font-bold">Người Dùng</th>
                    <th class="py-3 px-4 font-bold">Đánh Giá</th>
                    <th class="py-3 px-4 font-bold max-w-md">Nội Dung Bình Luận</th>
                    <th class="py-3 px-4 font-bold">Phản Hồi</th>
                    <th class="py-3 px-4 font-bold">Thời Gian</th>
                    <th class="py-3 px-4 font-bold text-right rounded-r-xl">Hành Động</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-slate-400 font-medium">
                            <i class="fa-solid fa-comments text-3xl text-slate-300 mb-2 block"></i>
                            <span>Chưa có đánh giá nào từ người dùng.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var r in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-all duration-150 group">
                            <td class="py-3.5 px-4 text-slate-400 font-mono font-bold text-center">#@r.Id</td>
                            <td class="py-3.5 px-4 font-extrabold text-slate-800">@r.Username</td>
                            <td class="py-3.5 px-4">
                                @if (r.IsPositive)
                                {
                                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-200 inline-flex items-center gap-1">
                                        <i class="fa-solid fa-thumbs-up"></i> Khuyên Dùng
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 bg-rose-50 text-rose-700 rounded-lg text-xs font-bold border border-rose-200 inline-flex items-center gap-1">
                                        <i class="fa-solid fa-thumbs-down"></i> Không Khuyên
                                    </span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-slate-700 font-medium max-w-md truncate" title="@r.Content">@r.Content</td>
                            <td class="py-3.5 px-4 text-slate-600 font-bold">@(r.Replies?.Count ?? 0) Phản Hồi</td>
                            <td class="py-3.5 px-4 text-slate-400 text-xs font-medium">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="py-3.5 px-4 text-right">
                                <button onclick="deleteReview(@r.Id)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white inline-flex items-center justify-center transition-all shadow-2xs" title="Xóa">
                                    <i class="fa-solid fa-trash text-xs"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-slate-100 pt-6 gap-4">
            <div class="text-sm font-semibold text-slate-500">
                Tổng cộng @totalItems kết quả (Trang @currentPage/@totalPages)
            </div>
            <div class="flex items-center gap-1.5">
                @if (currentPage > 1)
                {
                    <a href="?page=@(currentPage - 1)" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="?page=@i" class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs @(i == currentPage ? "bg-indigo-600 text-white shadow-sm shadow-indigo-200" : "border border-slate-200 bg-white hover:bg-slate-50 text-slate-600") transition-all">@i</a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="?page=@(currentPage + 1)" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    const authHeaders = {};

    async function deleteReview(id) {
        if (!confirm("Bạn có chắc chắn muốn xóa đánh giá này?")) return;
        try {
            const res = await apiFetch(`/api-proxy/api/v1/reviews/${id}`, {
                method: 'DELETE',
                headers: authHeaders
            });
            if (res.ok) window.location.reload();
        } catch (e) { console.error(e); }
    }
</script>
}

