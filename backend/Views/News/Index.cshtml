@model List<Backend.Models.NewsViewModel>

@{
    ViewData["Title"] = "Tin Tức & Bài Viết";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count ?? 0);
}

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h3 class="text-xl font-black text-slate-800">Tin Tức & Bài Viết</h3>
            <p class="text-xs text-slate-400 font-medium mt-1">Quản lý nội dung tin tức tin game, sự kiện và thông báo hệ thống.</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="openModal()" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold shadow-sm shadow-indigo-200 flex items-center gap-2 transition-all active:scale-95 text-sm">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>Tạo Bài Viết Mới</span>
            </button>
        </div>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto min-h-[380px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-wider bg-slate-50/80 border-b border-slate-200">
                    <th class="py-3 px-4 font-bold w-16 text-center rounded-l-xl">ID</th>
                    <th class="py-3 px-4 font-bold">Bài Viết</th>
                    <th class="py-3 px-4 font-bold max-w-xs">Tóm Tắt</th>
                    <th class="py-3 px-4 font-bold">Tác Giả</th>
                    <th class="py-3 px-4 font-bold">Ngày Đăng</th>
                    <th class="py-3 px-4 font-bold text-right rounded-r-xl">Hành Động</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="py-12 text-center text-slate-400 font-medium">
                            <i class="fa-solid fa-newspaper text-3xl text-slate-300 mb-2 block"></i>
                            <span>Chưa có bài viết nào được đăng.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var n in Model)
                    {
                        var img = string.IsNullOrEmpty(n.CoverImageUrl) ? "https://images.unsplash.com/photo-1511512578047-dfb367046420?w=800&q=80" : n.CoverImageUrl;
                        <tr class="hover:bg-slate-50/80 transition-all duration-150 group">
                            <td class="py-3.5 px-4 text-slate-400 font-mono font-bold text-center">#@n.Id</td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-3">
                                    <img src="@img" class="w-12 h-9 rounded-lg object-cover border border-slate-200" />
                                    <div class="font-extrabold text-slate-800 group-hover:text-indigo-600 transition-colors line-clamp-1">@n.Title</div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4 text-slate-600 font-medium max-w-xs truncate" title="@n.Summary">@n.Summary</td>
                            <td class="py-3.5 px-4 font-bold text-slate-700">@n.AuthorName</td>
                            <td class="py-3.5 px-4 text-slate-400 text-xs font-medium">@n.PublishedAt.ToString("dd/MM/yyyy")</td>
                            <td class="py-3.5 px-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <button onclick="editNews(@n.Id)" class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white inline-flex items-center justify-center transition-all shadow-2xs" title="Chỉnh Sửa">
                                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                                    </button>
                                    <button onclick="deleteNews(@n.Id)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white inline-flex items-center justify-center transition-all shadow-2xs" title="Xóa">
                                        <i class="fa-solid fa-trash text-xs"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-slate-100 pt-6 gap-4">
            <div class="text-sm font-semibold text-slate-500">
                Tổng cộng @totalItems kết quả (Trang @currentPage/@totalPages)
            </div>
            <div class="flex items-center gap-1.5">
                @if (currentPage > 1)
                {
                    <a href="?page=@(currentPage - 1)" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="?page=@i" class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs @(i == currentPage ? "bg-indigo-600 text-white shadow-sm shadow-indigo-200" : "border border-slate-200 bg-white hover:bg-slate-50 text-slate-600") transition-all">@i</a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="?page=@(currentPage + 1)" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Modal Create / Edit News -->
<div id="newsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeModal()"></div>
    
    <div class="relative bg-white rounded-3xl w-full max-w-xl overflow-hidden shadow-2xl border border-slate-200 transform transition-all max-h-[90vh] flex flex-col">
        <div class="p-6 border-b border-slate-100 bg-slate-50/80 flex justify-between items-center">
            <h3 id="modalTitle" class="text-xl font-black text-slate-800">Tạo Bài Viết Mới</h3>
            <button onclick="closeModal()" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-all">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        
        <form id="newsForm" onsubmit="saveNews(event)" class="p-6 space-y-4 overflow-y-auto flex-1">
            <input type="hidden" id="newsId" value="" />

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Tiêu Đề Bài Viết</label>
                <input type="text" id="nTitle" required placeholder="VD: Khám phá bản cập nhật mới nhất..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-bold" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Tóm Tắt Nội Dung</label>
                <input type="text" id="nSummary" required placeholder="Tóm tắt ngắn gọn hiển thị trên trang tin..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-medium" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Hình Ảnh Bìa (Cover Image)</label>
                <div class="flex gap-2">
                    <input type="text" id="nCoverUrl" placeholder="https://..." class="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-medium" />
                    <button type="button" onclick="document.getElementById('nCoverFile').click()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs border border-slate-200 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-cloud-arrow-up text-indigo-600"></i>
                        <span>Upload</span>
                    </button>
                </div>
                <input type="file" id="nCoverFile" accept="image/*" class="hidden" onchange="uploadCover(this)" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Nội Dung Chi Tiết</label>
                <textarea id="nContent" rows="5" required placeholder="Soạn thảo nội dung bài viết..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-medium"></textarea>
            </div>

            <div class="p-6 border-t border-slate-100 bg-slate-50/60 flex justify-end gap-3 -mx-6 -mb-6 mt-6">
                <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl text-slate-700 font-bold bg-slate-100 hover:bg-slate-200 transition-all text-xs border border-slate-200">Hủy Bỏ</button>
                <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold transition-all text-xs shadow-sm shadow-indigo-200 active:scale-95">Lưu Bài Viết</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const authHeaders = {};

    function openModal() {
        document.getElementById('modalTitle').innerText = "Tạo Bài Viết Mới";
        document.getElementById('newsId').value = '';
        document.getElementById('newsForm').reset();
        document.getElementById('newsModal').classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('newsModal').classList.add('hidden');
    }

    async function uploadCover(input) {
        if (!input.files || input.files.length === 0) return;
        const formData = new FormData();
        formData.append('files', input.files[0]);

        try {
            const res = await apiFetch('/api-proxy/api/v1/media-files', {
                method: 'POST',
                headers: authHeaders,
                body: formData
            });
            if (res.ok) {
                const data = await res.json();
                if (data.urls && data.urls.length > 0) {
                    document.getElementById('nCoverUrl').value = data.urls[0];
                }
            } else {
                alert("Lỗi khi tải ảnh bìa lên!");
            }
        } catch (e) { console.error(e); }
    }

    async function editNews(id) {
        try {
            const res = await apiFetch(`/api-proxy/api/v1/news/${id}`, { headers: authHeaders });
            if (res.ok) {
                const n = await res.json();
                document.getElementById('modalTitle').innerText = "Chỉnh Sửa Bài Viết";
                document.getElementById('newsId').value = n.id;
                document.getElementById('nTitle').value = n.title;
                document.getElementById('nSummary').value = n.summary;
                document.getElementById('nCoverUrl').value = n.coverImageUrl || '';
                document.getElementById('nContent').value = n.content || '';
                document.getElementById('newsModal').classList.remove('hidden');
            }
        } catch (e) { console.error(e); }
    }

    async function saveNews(e) {
        e.preventDefault();
        const id = document.getElementById('newsId').value;
        const payload = {
            title: document.getElementById('nTitle').value,
            summary: document.getElementById('nSummary').value,
            coverImageUrl: document.getElementById('nCoverUrl').value,
            content: document.getElementById('nContent').value,
            isPublished: true
        };

        const method = id ? 'PUT' : 'POST';
        const url = id ? `/api-proxy/api/v1/news/${id}` : '/api-proxy/api/v1/news';

        try {
            const res = await apiFetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json', ...authHeaders },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                closeModal();
                window.location.reload();
            } else {
                alert("Lỗi khi lưu bài viết!");
            }
        } catch (err) { console.error(err); }
    }

    async function deleteNews(id) {
        if (!confirm("Bạn có chắc chắn muốn xóa bài viết này?")) return;
        try {
            const res = await apiFetch(`/api-proxy/api/v1/news/${id}`, {
                method: 'DELETE',
                headers: authHeaders
            });
            if (res.ok) window.location.reload();
        } catch (e) { console.error(e); }
    }
</script>
}

