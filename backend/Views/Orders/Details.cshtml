@model Backend.Models.OrderViewModel

@{
    ViewData["Title"] = "Chi tiết Đơn hàng #" + Model.Id;
    Layout = "_Layout";
}

<div class="p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-white">@ViewData["Title"]</h1>
        <a href="/Orders" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded transition-colors">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 p-4 bg-green-500/20 border border-green-500/30 text-green-400 rounded-lg">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 p-4 bg-red-500/20 border border-red-500/30 text-red-400 rounded-lg">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div class="bg-[#1A1A1A] border border-white/10 rounded-xl p-6">
            <h2 class="text-lg font-bold text-white mb-4 border-b border-white/10 pb-2">Thông tin Đơn hàng</h2>
            <div class="space-y-3">
                <div class="flex justify-between">
                    <span class="text-gray-500">Khách hàng:</span>
                    <span class="text-white font-medium">@Model.Username</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Tổng tiền:</span>
                    <span class="text-blue-400 font-bold">@Model.TotalAmount.ToString("N0")đ</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Trạng thái:</span>
                    <span>
                        @if (Model.Status == "Completed")
                        {
                            <span class="px-2 py-1 bg-green-500/10 text-green-400 rounded-md text-xs font-bold border border-green-500/20">Hoàn Thành</span>
                        }
                        else if (Model.Status == "Pending")
                        {
                            <span class="px-2 py-1 bg-yellow-500/10 text-yellow-400 rounded-md text-xs font-bold border border-yellow-500/20">Chờ Xử Lý</span>
                        }
                        else
                        {
                            <span class="px-2 py-1 bg-red-500/10 text-red-400 rounded-md text-xs font-bold border border-red-500/20">Thất Bại</span>
                        }
                    </span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Ngày đặt:</span>
                    <span class="text-white">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        <div class="bg-[#1A1A1A] border border-white/10 rounded-xl p-6">
            <h2 class="text-lg font-bold text-white mb-4 border-b border-white/10 pb-2">Sản phẩm</h2>
            <ul class="list-disc list-inside text-white/80 space-y-2">
                @foreach(var item in Model.Items)
                {
                    <li>@item</li>
                }
            </ul>
        </div>
    </div>

    <div class="bg-[#1A1A1A] border border-white/10 rounded-xl overflow-hidden">
        <h2 class="text-lg font-bold text-white p-6 border-b border-white/10">Danh sách Mã Game</h2>
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-[#050505] border-b border-white/10">
                    <th class="p-4 text-gray-500 font-medium">Sản phẩm</th>
                    <th class="p-4 text-gray-500 font-medium">Mã kích hoạt (Key)</th>
                    <th class="p-4 text-gray-500 font-medium text-right">Hành động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/10">
                @if(Model.Keys != null && Model.Keys.Any())
                {
                    foreach (var key in Model.Keys)
                    {
                        <tr class="hover:bg-white/5 transition-colors">
                            <td class="p-4 text-white">@key.ProductName</td>
                            <td class="p-4 text-blue-400 font-mono tracking-wider">@key.KeyCode</td>
                            <td class="p-4 text-right">
                                <form asp-action="DeleteKey" method="post" class="m-0 inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn xóa mã game này khỏi đơn hàng? Mã này sẽ được đưa trở lại kho.');">
                                    <input type="hidden" name="orderId" value="@Model.Id" />
                                    <input type="hidden" name="keyId" value="@key.Id" />
                                    <button type="submit" class="px-3 py-1.5 bg-red-500/20 hover:bg-red-500/100/40 text-red-400 rounded-md text-sm transition-colors border border-red-500/30">
                                        <i class="fa-solid fa-trash"></i> Xóa Mã
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="p-8 text-center text-gray-500">Đơn hàng này không có mã game nào (chưa thanh toán hoặc là lỗi).</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
