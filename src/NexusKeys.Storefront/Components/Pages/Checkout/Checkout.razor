@page "/checkout"
@inject Frontend.ViewModels.CheckoutViewModel CheckoutVM
@inject Frontend.ViewModels.CartViewModel CartVM
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment HostEnvironment
@implements IDisposable

<PageTitle>Thanh Toán — NexusKeys</PageTitle>

<div class="egs-wrap">
    <div class="egs-content">
        @* Breadcrumbs *@
        <div class="flex items-center gap-2 text-xs text-white/50 mb-6 font-semibold">
            <a href="/" class="hover:text-white transition-colors">Cửa hàng</a>
            <span>›</span>
            <a href="/cart" class="hover:text-white transition-colors">Giỏ hàng</a>
            <span>›</span>
            <span class="text-white">Thanh toán</span>
        </div>

        @* Checkout Stepper: Step 2 Active, Step 1 Done *@
        <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-[#18181c] border border-white/10 shadow-lg">
            <div class="flex items-center justify-between max-w-3xl mx-auto">
                <!-- Step 1: Completed -->
                <a href="/cart" class="flex items-center gap-2.5 sm:gap-3 group hover:opacity-100 transition-opacity">
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-xs sm:text-sm shadow-md shadow-emerald-500/10">
                        <Icon Name="HeroiconName.Check" Class="w-4 h-4 sm:w-5 sm:h-5 text-emerald-400" />
                    </div>
                    <div>
                        <span class="text-xs uppercase font-bold text-emerald-400 block tracking-wider group-hover:underline">Bước 1 ✓</span>
                        <span class="text-xs sm:text-sm font-bold text-white whitespace-nowrap">Giỏ Hàng</span>
                    </div>
                </a>

                <!-- Connector Line 1-2 (Active/Done) -->
                <div class="flex-1 h-[2px] mx-3 sm:mx-6 bg-gradient-to-r from-emerald-500/50 to-[#0078f2]/50 rounded-full"></div>

                <!-- Step 2: Active -->
                <div class="flex items-center gap-2.5 sm:gap-3">
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#0078f2] text-white flex items-center justify-center font-black text-xs sm:text-sm shadow-md shadow-[#0078f2]/40 ring-4 ring-[#0078f2]/20">
                        2
                    </div>
                    <div>
                        <span class="text-xs uppercase font-bold text-[#0078f2] block tracking-wider">Bước 2</span>
                        <span class="text-xs sm:text-sm font-bold text-white whitespace-nowrap">Thanh Toán</span>
                    </div>
                </div>

                <!-- Connector Line 2-3 -->
                <div class="flex-1 h-[2px] mx-3 sm:mx-6 bg-white/10 rounded-full"></div>

                <!-- Step 3: Upcoming -->
                <div class="flex items-center gap-2.5 sm:gap-3 opacity-50">
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#202024] text-white/50 border border-white/15 flex items-center justify-center font-bold text-xs sm:text-sm">
                        3
                    </div>
                    <div>
                        <span class="text-xs uppercase font-bold text-white/40 block tracking-wider">Bước 3</span>
                        <span class="text-xs sm:text-sm font-semibold text-white/60 whitespace-nowrap">Hoàn Tất & Nhận Key</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-3 mb-6">
            <Icon Name="HeroiconName.CreditCard" Class="w-9 h-9 text-[#0078f2]" IconType="HeroiconType.Solid" />
            <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Thanh Toán Đơn Hàng</h1>
        </div>

    @if ((CartVM.Items.Count == 0 || CartVM.SelectedTotalItems == 0) && !CheckoutVM.IsProcessing)
    {
        <div class="p-8 rounded-2xl bg-[#18181c] border border-white/10 text-center max-w-xl mx-auto shadow-2xl">
            <div class="w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto mb-4">
                <Icon Name="HeroiconName.ExclamationTriangle" Class="w-8 h-8" />
            </div>
            <h2 class="text-xl font-bold text-white mb-2">Chưa có sản phẩm nào được chọn</h2>
            <p class="text-white/60 text-sm mb-6">Bạn chưa chọn sản phẩm nào trong giỏ hàng để tiến hành thanh toán.</p>
            <a href="/cart" class="px-6 py-3 rounded-xl bg-[#0078f2] hover:bg-[#006bd8] text-white text-xs font-bold uppercase tracking-wider transition-all inline-flex items-center gap-2">
                <Icon Name="HeroiconName.ShoppingCart" Class="w-4 h-4" />
                <span>Quay lại Giỏ hàng</span>
            </a>
        </div>
    }
    else
    {
        <div class="flex flex-col lg:flex-row gap-8">
            @* Payment Methods *@
            <div class="flex-1 space-y-6">
                <div class="bg-[#18181c] rounded-2xl border border-white/10 p-6 sm:p-8 shadow-xl">
                    <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2.5">
                        <Icon Name="HeroiconName.Wallet" Class="w-6 h-6 text-[#0078f2]" IconType="HeroiconType.Solid" />
                        <span>Chọn phương thức thanh toán</span>
                    </h2>
                    
                    @if (!string.IsNullOrEmpty(CheckoutVM.ErrorMessage))
                    {
                        <div class="p-4 rounded-xl bg-red-500/15 border border-red-500/30 text-red-300 mb-6 text-sm flex items-center gap-3">
                            <Icon Name="HeroiconName.ExclamationCircle" Class="w-5 h-5 shrink-0" />
                            <span>@CheckoutVM.ErrorMessage</span>
                        </div>
                    }
                    
                    <div class="space-y-4">
                        @* VNPay *@
                        <label class="cursor-pointer block my-2">
                            <div class="flex items-center gap-4 p-4 rounded-xl border transition-all @(CheckoutVM.SelectedPaymentMethod == "VNPay" ? "border-[#0078f2] bg-[#0078f2]/10" : "border-white/10 bg-[#202024] hover:border-white/30")">
                                <input type="radio" name="paymentMethod" aria-label="Thanh toán bằng VNPay" class="accent-[#0078f2] w-4 h-4"
                                       checked="@(CheckoutVM.SelectedPaymentMethod == "VNPay")" 
                                       @onchange="@(() => CheckoutVM.SelectedPaymentMethod = "VNPay")" />
                                <div class="w-12 h-12 bg-white rounded-lg flex items-center justify-center p-1 shrink-0">
                                    <img src="/images/vnpay.png" alt="VNPay" class="w-full h-full object-contain" />
                                </div>
                                <div class="flex-1">
                                    <h3 class="font-bold text-white text-sm sm:text-base">Ví điện tử / Cổng thanh toán VNPay</h3>
                                    <p class="text-xs text-white/50">Thanh toán qua thẻ ATM, Visa, MasterCard, JCB, QR Pay</p>
                                </div>
                            </div>
                        </label>
                        
                        @* MoMo *@
                        <label class="cursor-pointer block my-2">
                            <div class="flex items-center gap-4 p-4 rounded-xl border transition-all @(CheckoutVM.SelectedPaymentMethod == "MoMo" ? "border-[#0078f2] bg-[#0078f2]/10" : "border-white/10 bg-[#202024] hover:border-white/30")">
                                <input type="radio" name="paymentMethod" aria-label="Thanh toán bằng MoMo" class="accent-[#0078f2] w-4 h-4"
                                       checked="@(CheckoutVM.SelectedPaymentMethod == "MoMo")" 
                                       @onchange="@(() => CheckoutVM.SelectedPaymentMethod = "MoMo")" />
                                <div class="w-12 h-12 rounded-lg flex items-center justify-center overflow-hidden shrink-0">
                                    <img src="/images/momo.png" alt="MoMo" class="w-full h-full object-contain" />
                                </div>
                                <div class="flex-1">
                                    <h3 class="font-bold text-white text-sm sm:text-base">Ví điện tử MoMo</h3>
                                    <p class="text-xs text-white/50">Thanh toán nhanh bằng ứng dụng MoMo</p>
                                </div>
                            </div>
                        </label>
                        
                        @if (HostEnvironment.IsDevelopment())
                        {
                            @* Mock Gateway is intentionally visible only in Development. *@
                            <label class="cursor-pointer block my-2">
                                <div class="flex items-center gap-4 p-4 rounded-xl border transition-all @(CheckoutVM.SelectedPaymentMethod == "MockGateway" ? "border-[#0078f2] bg-[#0078f2]/10" : "border-white/10 bg-[#202024] hover:border-white/30")">
                                    <input type="radio" name="paymentMethod" aria-label="Thanh toán qua cổng thử nghiệm" class="accent-[#0078f2] w-4 h-4"
                                           checked="@(CheckoutVM.SelectedPaymentMethod == "MockGateway")"
                                           @onchange="@(() => CheckoutVM.SelectedPaymentMethod = "MockGateway")" />
                                    <div class="w-12 h-12 bg-white/10 rounded-lg flex items-center justify-center shrink-0">
                                        <Icon Name="HeroiconName.BugAnt" Class="w-6 h-6 text-white" />
                                    </div>
                                    <div class="flex-1">
                                        <h3 class="font-bold text-white text-sm sm:text-base">Cổng Test (Developer)</h3>
                                        <p class="text-xs text-white/50">Giả lập thanh toán thành công ngay lập tức</p>
                                    </div>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            </div>
            
            @* Order Summary *@
            <div class="w-full lg:w-96 flex-shrink-0">
                <div class="sticky top-[104px] bg-[#18181c] rounded-2xl border border-white/10 shadow-xl overflow-hidden">
                    <div class="p-6 border-b border-white/10 bg-[#202024]/60">
                        <h2 class="text-xl font-bold text-white">Đơn Hàng Của Bạn</h2>
                        <span class="text-xs text-white/50">(@CartVM.SelectedTotalItems sản phẩm được chọn)</span>
                    </div>
                    
                    <div class="p-6">
                        <div class="space-y-4 max-h-60 overflow-y-auto mb-6 pr-2 custom-scrollbar">
                            @foreach (var item in CartVM.Items.Where(i => i.IsSelected))
                            {
                                <div class="flex gap-3 items-center">
                                    <div class="w-12 aspect-video rounded overflow-hidden bg-[#202024] flex-shrink-0">
                                        <ProductImage Src="@item.ImageUrl" Alt="@item.Name" ImageClass="w-full h-full object-cover" IconClass="w-6 h-6 text-white/40" />
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h4 class="text-sm font-medium text-white truncate">@item.Name</h4>
                                    </div>
                                    <div class="text-[#0078f2] font-bold text-sm whitespace-nowrap">@item.Price.ToString("N0") đ</div>
                                </div>
                            }
                        </div>
                        
                        <div class="border-t border-white/10 my-4"></div>
                        
                        @* Coupon Section *@
                        <div class="mb-6">
                            <label for="coupon-code" class="text-xs font-bold uppercase tracking-wider text-white/60 mb-2 block">Mã giảm giá</label>
                            <div class="flex gap-2">
                                <input id="coupon-code" type="text" @bind="CheckoutVM.CouponCodeInput" placeholder="Nhập mã..." class="flex-1 bg-[#202024] border border-white/10 text-white rounded-xl px-4 py-2.5 text-xs focus:border-[#0078f2] outline-none uppercase font-mono tracking-wider transition-colors" disabled="@CheckoutVM.IsProcessing" />
                                <button @onclick="CheckoutVM.ApplyCouponAsync" disabled="@CheckoutVM.IsProcessing" class="px-5 py-2.5 rounded-xl bg-[#0078f2] hover:bg-[#006bd8] text-white text-xs font-bold uppercase tracking-wider transition-all disabled:opacity-40">Áp dụng</button>
                            </div>
                            @if (!string.IsNullOrEmpty(CheckoutVM.CouponMessage))
                            {
                                <p class="text-xs mt-2 @(CheckoutVM.IsCouponSuccess ? "text-emerald-400 font-semibold" : "text-red-400")">
                                    @CheckoutVM.CouponMessage
                                </p>
                            }
                        </div>
                        
                        <div class="border-t border-white/10 my-4"></div>
                        
                        @{
                            var subtotal = CartVM.SelectedTotalAmount;
                            var discountAmount = subtotal * (CheckoutVM.DiscountPercent / 100m);
                            var finalTotal = subtotal - discountAmount;
                        }
                        
                        <div class="space-y-3 mb-6">
                            <div class="flex justify-between text-gray-400 text-sm">
                                <span>Tạm tính</span>
                                <span>@subtotal.ToString("N0") đ</span>
                            </div>
                            @if (discountAmount > 0)
                            {
                                <div class="flex justify-between text-green-400 text-sm font-medium">
                                    <span>Giảm giá (@CheckoutVM.DiscountPercent%)</span>
                                    <span>-@discountAmount.ToString("N0") đ</span>
                                </div>
                            }
                            <div class="flex justify-between text-gray-400 text-sm">
                                <span>Phí giao dịch</span>
                                <span>Miễn phí</span>
                            </div>
                        </div>
                        
                        <div class="flex justify-between items-center mb-6 p-4 bg-[#202024] rounded-xl border border-white/5">
                            <span class="font-bold text-white">Tổng thanh toán</span>
                            <span class="text-2xl font-black text-[#0078f2]">@finalTotal.ToString("N0") đ</span>
                        </div>
                        
                        <button @onclick="ProcessPayment" disabled="@CheckoutVM.IsProcessing" class="w-full py-4 rounded-xl bg-[#0078f2] hover:bg-[#006bd8] text-white font-black text-sm uppercase tracking-wider transition-all shadow-xl shadow-[#0078f2]/30 active:scale-[0.99] disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer flex items-center justify-center gap-2">
                            @if (CheckoutVM.IsProcessing)
                            {
                                <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                <span>Đang xử lý thanh toán...</span>
                            }
                            else
                            {
                                <span>Hoàn Tất Thanh Toán</span>
                                <Icon Name="HeroiconName.ShieldCheck" Class="w-5 h-5 ml-1" />
                            }
                        </button>
                        
                        <p class="text-xs text-white/70 text-center mt-4">Bằng việc thanh toán, bạn đồng ý với Điều khoản dịch vụ của NexusKeys.</p>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        CheckoutVM.StateChanged += StateHasChanged;
        CartVM.StateChanged += StateHasChanged;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CartVM.InitializeAsync();
        }
    }
    
    private async Task ProcessPayment()
    {
        var response = await CheckoutVM.ProcessCheckoutAsync();
        if (response != null)
        {
            if (!string.IsNullOrEmpty(response.PaymentUrl))
            {
                // Navigate to external payment gateway
                NavigationManager.NavigateTo(response.PaymentUrl, true);
            }
            else
            {
                // Local/mock payments complete immediately and therefore do not
                // return an external redirect URL.
                NavigationManager.NavigateTo($"/checkout/success?orderId={response.OrderId}");
            }
        }
    }
    
    public void Dispose()
    {
        CheckoutVM.StateChanged -= StateHasChanged;
        CartVM.StateChanged -= StateHasChanged;
    }
}
