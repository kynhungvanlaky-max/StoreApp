            </div>
        </section>

        @* ================================================================= *@
        @* SECTION 9: BOTTOM CTA BANNER                                      *@
        @* ================================================================= *@
        <section class="rounded-3xl bg-gradient-to-r from-[#0078f2]/25 via-[#181820] to-[#0078f2]/15 border border-[#0078f2]/40 p-8 sm:p-14 text-center relative overflow-hidden shadow-2xl">
            <div class="max-w-2xl mx-auto space-y-6 relative z-10">
                <span class="px-3 py-1 rounded-full bg-[#0078f2]/20 text-[#40a9ff] text-xs font-black uppercase tracking-wider border border-[#0078f2]/30 inline-block">
