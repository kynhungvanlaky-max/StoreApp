@page "/distribution"
@inject Frontend.ViewModels.AuthViewModel AuthViewModel
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IConfiguration Configuration

<PageTitle>Tự Xuất Bản & Phân Phối Trò Chơi & Ứng Dụng — Cổng Nhà Phát Triển NexusKeys</PageTitle>

@* ================================================================= *@
@* DEDICATED DISTRIBUTION & DEVELOPER NAVIGATION MENU BAR             *@
@* ================================================================= *@
<div class="egs-dist-nav-sticky">
    <div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12 2xl:px-16 h-14 flex items-center justify-between gap-6 xl:gap-8">
        @* Left: Brand / Section Title *@
        <div class="flex items-center gap-2.5 shrink-0">
            <div class="w-8 h-8 rounded-lg bg-[#0078f2]/15 border border-[#0078f2]/30 flex items-center justify-center text-[#0078f2] shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs sm:text-sm font-black tracking-wide text-white uppercase whitespace-nowrap">Cổng Phân Phối</span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-[#0078f2]/20 text-[#40a9ff] border border-[#0078f2]/40 whitespace-nowrap hidden sm:inline-block">
                    Game & App PC
                </span>
            </div>
        </div>

        @* Center: Horizontal Menu Items *@
        <nav class="egs-dist-nav-scroll flex items-center gap-0.5 sm:gap-1 py-1 text-xs font-bold text-white/70 min-w-0" style="scrollbar-width: none; -ms-overflow-style: none;" aria-label="Distribution Navigation">
            <a href="#overview" class="egs-dist-nav-link active">
                <span>Tổng quan</span>
            </a>
            <a href="#games" class="egs-dist-nav-link">
                <svg class="w-3.5 h-3.5 text-[#0078f2]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                <span>Game</span>
            </a>
            <a href="#apps" class="egs-dist-nav-link">
                <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693l-1.57-.393m15.6 0a24.267 24.267 0 01-15.6 0"/></svg>
                <span>Ứng dụng</span>
            </a>
            <a href="#calculator" class="egs-dist-nav-link text-[#0078f2]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm3-4.5h.008v.008h-.008V11.25zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm3-4.5h.008v.008h-.008V11.25zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zM6.75 6.75h10.5a2.25 2.25 0 012.25 2.25v10.5a2.25 2.25 0 01-2.25 2.25H6.75a2.25 2.25 0 01-2.25-2.25V9a2.25 2.25 0 012.25-2.25z"/></svg>
                <span>Tính doanh thu</span>
            </a>
            <a href="#benefits" class="egs-dist-nav-link">
                <span>Chính sách 88/12</span>
            </a>
            <a href="#tools" class="egs-dist-nav-link">
                <span>Bộ công cụ</span>
            </a>
            <a href="#workflow" class="egs-dist-nav-link">
                <span>Quy trình</span>
            </a>
            <a href="#faq" class="egs-dist-nav-link">
                <span>FAQ</span>
            </a>
        </nav>

        @* Right: Action CTA Buttons *@
        <div class="flex items-center gap-2 shrink-0">
            @if (AuthViewModel.IsLoggedIn && (string.Equals(AuthViewModel.Role, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(AuthViewModel.Role, "Developer", StringComparison.OrdinalIgnoreCase)))
            {
                var adminPortalUrl = Configuration["AdminPortal:BaseUrl"] ?? "http://localhost:3001";
                <a href="@adminPortalUrl" target="_blank" rel="noopener noreferrer" class="px-3 sm:px-4 py-2 rounded-xl bg-[#0078f2] hover:bg-[#006bd8] text-white font-black text-xs flex items-center gap-2 shadow-lg shadow-[#0078f2]/30 hover:shadow-[#0078f2]/50 transition-all">
                    <span>Developer Portal</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
                </a>
            }
            else
            {
                <a href="/login" class="px-3 sm:px-4 py-2 rounded-xl bg-[#0078f2] hover:bg-[#006bd8] text-white font-black text-xs flex items-center gap-1.5 shadow-lg shadow-[#0078f2]/30 hover:shadow-[#0078f2]/50 transition-all">
                    <span>Bắt đầu xuất bản</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
            }
        </div>
    </div>
</div>

<div class="egs-wrap">
    <div class="egs-content space-y-12">

        @* ================================================================= *@
        @* SECTION 1: HERO BANNER (OVERVIEW)                                 *@
        @* ================================================================= *@
        <section id="overview" class="egs-dist-hero p-8 sm:p-12 lg:p-16 scroll-mt-28">
            <div class="egs-dist-hero-grid">
                <div class="space-y-6">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0078f2]/20 border border-[#0078f2]/40 text-[#40a9ff] text-xs font-black uppercase tracking-wider shadow-sm shadow-[#0078f2]/20">
                        <svg class="w-4 h-4 text-[#0078f2]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        Nền Tảng Tự Xuất Bản Tiên Phong Cho PC
                    </div>

                    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.25]">
                        Đưa <span class="text-[#0078f2]">Trò Chơi</span> & <span class="text-purple-400">Ứng Dụng</span> Đến 270M+ Người Dùng
                    </h1>

                    <p class="text-white/70 text-base sm:text-lg leading-relaxed max-w-2xl">
                        Nền tảng mở toàn diện cho cả <strong class="text-white font-bold">Studio Game</strong> và <strong class="text-white font-bold">Nhà Phát Triển Phần Mềm / Ứng Dụng</strong>. Giữ lại <strong class="text-white font-bold">88% doanh thu</strong> từ mỗi bản bán ra, hoặc hưởng trọn <strong class="text-emerald-400 font-bold">100% doanh thu</strong> khi sử dụng cổng thanh toán in-app của riêng bạn. Miễn phí hạ tầng CDN, cập nhật vi sai Delta và 0% phí Unreal Engine.
                    </p>

                    @* Action Buttons matching User State *@
                    <div class="flex flex-wrap items-center gap-4 pt-2">
                        @if (AuthViewModel.IsLoggedIn && (string.Equals(AuthViewModel.Role, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(AuthViewModel.Role, "Developer", StringComparison.OrdinalIgnoreCase)))
                        {
                            var adminPortalUrl = Configuration["AdminPortal:BaseUrl"] ?? "http://localhost:3001";
                            <a href="@adminPortalUrl" target="_blank" rel="noopener noreferrer" class="px-8 py-4 rounded-xl bg-[#0078f2] hover:bg-[#006bd8] text-white font-black text-sm tracking-wide shadow-xl shadow-[#0078f2]/40 hover:shadow-[#0078f2]/60 hover:-translate-y-0.5 transition-all flex items-center gap-3">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                                <span>MỞ CỔNG QUẢN TRỊ DEVELOPER (PORTAL)</span>
                            </a>
                        }
                        else
                        {
                            <a href="/login" class="px-8 py-4 rounded-xl bg-[#0078f2] hover:bg-[#006bd8] text-white font-black text-sm tracking-wide shadow-xl shadow-[#0078f2]/40 hover:shadow-[#0078f2]/60 hover:-translate-y-0.5 transition-all flex items-center gap-2">
                                <span>BẮT ĐẦU TỰ XUẤT BẢN NGAY</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        }

                        <a href="#calculator" class="px-6 py-4 rounded-xl bg-[#202024]/90 hover:bg-[#28282d] border border-white/15 text-white font-bold text-sm hover:border-[#0078f2]/40 transition-all flex items-center gap-2">
                            <svg class="w-4 h-4 text-[#0078f2]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm3-4.5h.008v.008h-.008V11.25zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm3-4.5h.008v.008h-.008V11.25zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zM6.75 6.75h10.5a2.25 2.25 0 012.25 2.25v10.5a2.25 2.25 0 01-2.25 2.25H6.75a2.25 2.25 0 01-2.25-2.25V9a2.25 2.25 0 012.25-2.25z"/></svg>
                            <span>Tính Doanh Thu Nhận Về</span>
                        </a>
                    </div>

                    @* Fast Highlight Pills *@
                    <div class="egs-dist-stat-grid pt-6 border-t border-white/10">
                        <div class="egs-dist-stat-pill">
                            <span class="text-xl sm:text-2xl font-black text-white block">270M+</span>
                            <span class="text-[11px] text-white/50 font-medium">Người dùng hoạt động</span>
                        </div>
                        <div class="egs-dist-stat-pill">
                            <span class="text-xl sm:text-2xl font-black text-[#0078f2] block">88%</span>
                            <span class="text-[11px] text-white/50 font-medium">Tỷ lệ chuẩn về tay bạn</span>
                        </div>
                        <div class="egs-dist-stat-pill">
                            <span class="text-xl sm:text-2xl font-black text-emerald-400 block">100%</span>
                            <span class="text-[11px] text-white/50 font-medium">Cổng thanh toán riêng / First Run</span>
                        </div>
                        <div class="egs-dist-stat-pill">
                            <span class="text-xl sm:text-2xl font-black text-purple-400 block">0%</span>
                            <span class="text-[11px] text-white/50 font-medium">Phí Unreal Engine</span>
                        </div>
                    </div>
                </div>

                @* Right Column: Epic Revenue Split Card *@
                <div class="flex justify-center">
                    <div class="w-full max-w-md bg-[#18181c]/95 border border-white/15 rounded-3xl p-6 sm:p-8 shadow-2xl backdrop-blur-xl relative overflow-hidden">
                        <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#0078f2]/10 rounded-full blur-3xl pointer-events-none"></div>

                        <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10">
                            <div>
                                <span class="text-xs font-black uppercase tracking-wider text-white/40 block">TỶ LỆ CHIA SẺ DOANH THU</span>
                                <span class="text-sm font-bold text-white">NexusKeys Store vs Thị Trường</span>
                            </div>
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-400 text-xs font-black border border-emerald-500/30">
                                +18% Lợi Nhuận
                            </span>
                        </div>

                        @* NexusKeys Store Bar *@
                        <div class="space-y-2 mb-6">
                            <div class="flex items-center justify-between text-xs font-bold">
                                <span class="text-white flex items-center gap-1.5">
                                    <span class="w-2.5 h-2.5 rounded-full bg-[#0078f2]"></span>
                                    NexusKeys Store (Game & App)
                                </span>
                                <span class="text-[#0078f2] font-black text-sm">88% Về Bạn</span>
                            </div>
                            <div class="h-5 w-full bg-[#202024] rounded-full overflow-hidden p-0.5 border border-white/10 flex">
                                <div class="bg-gradient-to-r from-[#0078f2] to-[#40a9ff] h-full rounded-full flex items-center justify-center text-xs font-black text-white" style="width: 88%;">
                                    88%
                                </div>
                                <div class="bg-white/10 h-full rounded-full flex items-center justify-center text-[11px] font-bold text-white/40" style="width: 12%;">
                                    12%
                                </div>
                            </div>
                            <div class="flex justify-between text-xs text-white/40 px-1">
                                <span>Bạn nhận: 88%</span>
                                <span>Phí Store: 12%</span>
                            </div>
                        </div>

                        @* Traditional Platforms Bar *@
                        <div class="space-y-2 mb-6">
                            <div class="flex items-center justify-between text-xs font-bold">
                                <span class="text-white/60 flex items-center gap-1.5">
                                    <span class="w-2.5 h-2.5 rounded-full bg-white/30"></span>
                                    Cửa Hàng Khác (Steam, App Store)
                                </span>
                                <span class="text-white/70 font-black text-sm">70% Về Bạn</span>
                            </div>
                            <div class="h-5 w-full bg-[#202024] rounded-full overflow-hidden p-0.5 border border-white/10 flex">
                                <div class="bg-white/30 h-full rounded-full flex items-center justify-center text-xs font-black text-white/90" style="width: 70%;">
                                    70%
                                </div>
                                <div class="bg-red-500/30 h-full rounded-full flex items-center justify-center text-[11px] font-bold text-red-300" style="width: 30%;">
                                    30%
                                </div>
                            </div>
                            <div class="flex justify-between text-xs text-white/40 px-1">
                                <span>Bạn nhận: 70%</span>
                                <span class="text-red-400/80">Phí cắt phế: 30%</span>
                            </div>
                        </div>

                        @* App In-App Feature Box *@
                        <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-500/10 via-emerald-500/5 to-transparent border border-emerald-500/30 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 font-black text-xs border border-emerald-500/30">
                                100%
                            </div>
                            <div>
                                <span class="text-xs font-bold text-white block">Thanh Toán Riêng Cho Ứng Dụng & First Run</span>
                                <span class="text-xs text-white/70 block">0% phí hoa hồng — giữ trọn 100% doanh thu khi dùng cổng thanh toán in-app riêng!</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @* ================================================================= *@
        @* SECTION 2: DUAL FOCUS — PHÁT HÀNH TRÒ CHƠI & PHÁT HÀNH ỨNG DỤNG     *@
        @* ================================================================= *@
        <section id="categories" class="space-y-8 scroll-mt-28">
            <div class="text-center max-w-3xl mx-auto space-y-2">
                <span class="text-xs font-black uppercase tracking-widest text-[#0078f2]">MÔ HÌNH TOÀN DIỆN CHO CẢ HAI LĨNH VỰC</span>
                <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">Hệ Sinh Thái Phân Phối Trò Chơi & Ứng Dụng PC</h2>
                <p class="text-sm text-white/50 leading-relaxed">
                    Dù bạn phát triển tựa game bom tấn 3D hay phần mềm sáng tạo chuyên nghiệp, NexusKeys mang đến hạ tầng phân phối mở, chi phí tối ưu và điều kiện công bằng nhất thị trường.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                @* CARD 1: DÀNH CHO NHÀ PHÁT TRIỂN TRÒ CHƠI (GAMES) *@
                <div id="games" class="egs-dist-dual-card border-[#0078f2]/30 hover:border-[#0078f2]/70 scroll-mt-28 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/10">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-2xl bg-[#0078f2]/20 border border-[#0078f2]/40 text-[#0078f2] flex items-center justify-center shadow-lg shadow-[#0078f2]/20">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                                </div>
                                <div>
                                    <span class="text-xs font-black text-[#0078f2] uppercase tracking-wider block">Game Studios & Indies</span>
                                    <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight">Phân Phối Trò Chơi (Games)</h3>
                                </div>
                            </div>
                            <span class="px-3 py-1 rounded-full text-xs font-black bg-[#0078f2]/15 text-[#40a9ff] border border-[#0078f2]/30">PC Gaming</span>
                        </div>

                        <p class="text-sm text-white/70 leading-relaxed mb-6">
                            Đưa tựa game của bạn đến cộng đồng game thủ trung thành toàn cầu. Hỗ trợ toàn diện từ khâu thử nghiệm nội bộ, phân phối key reviewer, đến bán các gói nội dung mở rộng DLC.
                        </p>

                        <div class="space-y-3.5 mb-6">
                            <div class="flex items-start gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
                                <div class="w-7 h-7 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center shrink-0 mt-0.5 font-black text-xs">0%</div>
                                <div>
                                    <h4 class="text-sm font-bold text-white">Miễn phí 100% bản quyền Unreal Engine</h4>
                                    <p class="text-sm text-white/60 leading-relaxed">Tiết kiệm trọn vẹn 5% phí bản quyền Unreal khi game được phân phối trên cửa hàng.</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
                                <div class="w-7 h-7 rounded-lg bg-[#0078f2]/20 text-[#0078f2] flex items-center justify-center shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/></svg>
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-white">Epic Online Services (EOS) & Anti-Cheat</h4>
                                    <p class="text-sm text-white/60 leading-relaxed">Miễn phí hạ tầng chơi chéo đa nền tảng (PC/Console/Mobile), chống gian lận EAC, Cloud saves và hệ thống thành tích XP.</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
                                <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-black text-xs">100%</div>
                                <div>
                                    <h4 class="text-sm font-bold text-white">Epic First Run & Now On Epic</h4>
                                    <p class="text-sm text-white/60 leading-relaxed">Nhận trọn vẹn 100% doanh thu ròng trong 6 tháng đầu phát hành độc quyền hoặc đưa game từ Steam sang.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                        <span class="text-xs text-white/50">Hỗ trợ Unreal, Unity, Godot, C++</span>
                        <a href="#workflow" class="text-xs font-bold text-[#0078f2] hover:text-white flex items-center gap-1 transition-colors">
                            <span>Quy trình đưa game lên store →</span>
                        </a>
                    </div>
                </div>

                @* CARD 2: DÀNH CHO NHÀ PHÁT TRIỂN ỨNG DỤNG & PHẦN MỀM (APPS & SOFTWARE) *@
                <div id="apps" class="egs-dist-dual-card border-purple-500/30 hover:border-purple-500/70 scroll-mt-28 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/10">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-2xl bg-purple-500/20 border border-purple-500/40 text-purple-400 flex items-center justify-center shadow-lg shadow-purple-500/20">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693l-1.57-.393m15.6 0a24.267 24.267 0 01-15.6 0"/></svg>
                                </div>
                                <div>
                                    <span class="text-xs font-black text-purple-400 uppercase tracking-wider block">Software Creators & Tools</span>
                                    <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight">Phân Phối Ứng Dụng (Apps)</h3>
                                </div>
                            </div>
                            <span class="px-3 py-1 rounded-full text-xs font-black bg-purple-500/15 text-purple-300 border border-purple-500/30">Software & Tools</span>
                        </div>

                        <p class="text-sm text-white/70 leading-relaxed mb-6">
                            Mở rộng tệp khách hàng người dùng PC cho phần mềm sáng tạo, công cụ thiết kế đồ họa, âm thanh, video và tiện ích công nghệ với chính sách mở, không ép buộc độc quyền cổng thanh toán.
                        </p>

                        <div class="space-y-3.5 mb-6">
                            <div class="flex items-start gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
                                <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-black text-xs">0%</div>
                                <div>
                                    <h4 class="text-sm font-bold text-white">0% Hoa hồng khi dùng cổng thanh toán in-app riêng</h4>
                                    <p class="text-sm text-white/60 leading-relaxed">Tự do tích hợp Stripe, PayPal, VNPay, MoMo cho subscription & mua hàng in-app — Bạn giữ trọn 100% doanh thu!</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
                                <div class="w-7 h-7 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-white">Hạ tầng phân phối CDN & Delta Patching miễn phí</h4>
                                    <p class="text-sm text-white/60 leading-relaxed">Người dùng tải ứng dụng gigabyte hoàn toàn không tính phí băng thông của nhà phát triển. Cập nhật bản vá siêu nhẹ.</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
                                <div class="w-7 h-7 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-white">Mô hình linh hoạt: Mua đứt, Thuê bao (Subscription), Freemium</h4>
                                    <p class="text-sm text-white/60 leading-relaxed">Hỗ trợ đầy đủ các mô hình kinh doanh phần mềm: giấy phép vĩnh viễn, đăng ký hàng tháng hoặc ứng dụng miễn phí kèm addons.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                        <span class="text-xs text-white/50">Đồ họa 3D, Âm thanh, Video, Tiện ích, AI</span>
                        <a href="#faq" class="text-xs font-bold text-purple-400 hover:text-white flex items-center gap-1 transition-colors">
                            <span>FAQ xuất bản ứng dụng →</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        @* ================================================================= *@
        @* SECTION 3: INTERACTIVE REVENUE CALCULATOR (GAMES & APPS)           *@
        @* ================================================================= *@
        <section id="calculator" class="egs-dist-calc-box scroll-mt-28">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 mb-8 border-b border-white/10">
                <div>
                    <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#0078f2]/15 text-[#0078f2] text-[11px] font-black uppercase tracking-wider mb-2">
                        Công Cụ Trực Quan
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Tính Khoản Tiền Bạn Giữ Lại Được Trên NexusKeys</h2>
                    <p class="text-sm text-white/50 mt-1">So sánh số tiền thực nhận giữa chính sách NexusKeys Store và tỷ lệ 70/30 truyền thống</p>
                </div>

                @* Quick Presets *@
                <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-xs text-white/40 font-bold mr-1">Mốc doanh số:</span>
                    <button type="button" @onclick="() => SetSalesPreset(100000000)" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all @(estimatedSales == 100000000 ? "bg-[#0078f2] text-white shadow" : "bg-[#202024] text-white/70 hover:text-white border border-white/10")">100 Tr ₫</button>
                    <button type="button" @onclick="() => SetSalesPreset(500000000)" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all @(estimatedSales == 500000000 ? "bg-[#0078f2] text-white shadow" : "bg-[#202024] text-white/70 hover:text-white border border-white/10")">500 Tr ₫</button>
                    <button type="button" @onclick="() => SetSalesPreset(1000000000)" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all @(estimatedSales == 1000000000 ? "bg-[#0078f2] text-white shadow" : "bg-[#202024] text-white/70 hover:text-white border border-white/10")">1 Tỷ ₫</button>
                    <button type="button" @onclick="() => SetSalesPreset(5000000000)" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all @(estimatedSales == 5000000000 ? "bg-[#0078f2] text-white shadow" : "bg-[#202024] text-white/70 hover:text-white border border-white/10")">5 Tỷ ₫</button>
                    <button type="button" @onclick="() => SetSalesPreset(10000000000)" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all @(estimatedSales == 10000000000 ? "bg-[#0078f2] text-white shadow" : "bg-[#202024] text-white/70 hover:text-white border border-white/10")">10 Tỷ ₫</button>
                    <button type="button" @onclick="() => SetSalesPreset(25000000000)" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all @(estimatedSales == 25000000000 ? "bg-emerald-600 text-white shadow" : "bg-emerald-950/40 text-emerald-300 hover:text-white border border-emerald-500/30")" title="Mốc 1 triệu USD (~25 tỷ VNĐ) miễn phí doanh thu">25 Tỷ ₫ ($1M)</button>
                </div>
            </div>

            @* Calculation Mode Selector: Product Type (Game vs App) & Distribution Scheme *@
            <div class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                @* Select Category: Game or App *@
                <div class="p-3.5 rounded-xl bg-[#121216] border border-white/10 flex items-center justify-between gap-3">
                    <span class="text-xs font-bold text-white/50">Loại sản phẩm:</span>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="() => SetCategoryMode(false)" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(!isAppCategorySelected ? "bg-[#0078f2] text-white shadow" : "bg-[#18181c] text-white/60 hover:text-white border border-white/10")">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                            <span>Trò Chơi (Game)</span>
                        </button>
                        <button type="button" @onclick="() => SetCategoryMode(true)" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(isAppCategorySelected ? "bg-purple-600 text-white shadow" : "bg-[#18181c] text-white/60 hover:text-white border border-white/10")">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693l-1.57-.393m15.6 0a24.267 24.267 0 01-15.6 0"/></svg>
                            <span>Ứng Dụng (App)</span>
                        </button>
                    </div>
                </div>

                @* Select Scheme depending on category *@
                <div class="p-3.5 rounded-xl bg-[#121216] border border-white/10 flex items-center justify-between gap-3">
                    <span class="text-xs font-bold text-white/50">Cơ chế áp dụng:</span>
                    <div class="flex items-center gap-2">
                        @if (!isAppCategorySelected)
                        {
                            <button type="button" @onclick="() => SetSpecialScheme(false)" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all @(!isSpecialSchemeEnabled ? "bg-[#0078f2] text-white shadow" : "bg-[#18181c] text-white/60 hover:text-white border border-white/10")">
                                <span>Chuẩn 88/12</span>
                            </button>
                            <button type="button" @onclick="() => SetSpecialScheme(true)" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(isSpecialSchemeEnabled ? "bg-emerald-600 text-white shadow" : "bg-[#18181c] text-white/60 hover:text-white border border-white/10")">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span>First Run 100% (6 Tháng)</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="() => SetSpecialScheme(false)" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all @(!isSpecialSchemeEnabled ? "bg-purple-600 text-white shadow" : "bg-[#18181c] text-white/60 hover:text-white border border-white/10")">
                                <span>Cổng Store (88/12)</span>
                            </button>
                            <button type="button" @onclick="() => SetSpecialScheme(true)" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(isSpecialSchemeEnabled ? "bg-emerald-600 text-white shadow" : "bg-[#18181c] text-white/60 hover:text-white border border-white/10")">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span>Thanh Toán Riêng (100% về bạn)</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="egs-dist-calc-grid">
                @* Slider & Input *@
                <div class="space-y-5">
                    <label class="block">
                        <span class="text-xs font-black uppercase tracking-wider text-white/60 block mb-2">Ước tính tổng doanh số bán (Gross Sales)</span>
                        <div class="relative">
                            <input type="text" readonly value="@estimatedSales.ToString("N0") ₫" class="w-full bg-[#121216] border border-white/15 rounded-xl px-4 py-3 text-lg font-black text-white focus:outline-none focus:border-[#0078f2]" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-white/40">VNĐ</span>
                        </div>
                    </label>

                    <div class="space-y-2">
                        <div class="flex justify-between text-xs text-white/40">
                            <span>100 Triệu ₫</span>
                            <span>25 Tỷ ₫</span>
                        </div>
                        <input type="range" min="100000000" max="25000000000" step="100000000" value="@estimatedSales" @oninput="OnSalesSliderChanged" class="w-full accent-[#0078f2] cursor-pointer" />
                    </div>

                    <p class="text-sm text-white/60 leading-relaxed">
                        @if (isSpecialSchemeEnabled)
                        {
                            if (!isAppCategorySelected)
                            {
                                <span class="text-emerald-400 font-bold">Chế độ Epic First Run:</span> <span>Bạn nhận trọn vẹn 100% doanh thu ròng (0% phí Store) trong 6 tháng đầu phát hành game độc quyền!</span>
                            }
                            else
                            {
                                <span class="text-emerald-400 font-bold">Cổng Thanh Toán Riêng Cho Ứng Dụng:</span> <span>Bạn tích hợp cổng thanh toán riêng của phần mềm mình — NexusKeys thu 0% hoa hồng, bạn giữ trọn 100% doanh thu!</span>
                            }
                        }
                        else
                        {
                            <span>Tỷ lệ 88% áp dụng tự động cho mọi đơn hàng mà không phát sinh thêm chi phí ẩn, phí băng thông tải về hay phí xử lý thanh toán nào.</span>
                        }
                    </p>
                </div>

                @* Results Side by Side *@
                <div class="egs-dist-calc-results">
                    @* NexusKeys Store Result *@
                    <div class="p-5 rounded-2xl bg-[#202026] border-2 @(isSpecialSchemeEnabled ? "border-emerald-500/50 shadow-emerald-500/10" : "border-[#0078f2]/40 shadow-[#0078f2]/10") shadow-lg flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-bold text-white/50">Bạn nhận về:</span>
                                <span class="px-2.5 py-0.5 rounded-full @(isSpecialSchemeEnabled ? "bg-emerald-600 text-white" : "bg-[#0078f2] text-white") text-xs font-black uppercase tracking-wider">
                                    @(isSpecialSchemeEnabled ? "NexusKeys (100%)" : "NexusKeys (88%)")
                                </span>
                            </div>
                            <span class="text-xl lg:text-2xl font-black @(isSpecialSchemeEnabled ? "text-emerald-400" : "text-[#0078f2]") block tracking-tight whitespace-nowrap">@epicRevenue.ToString("N0") ₫</span>
                        </div>
                        <span class="text-[11px] text-white/40 block mt-3 border-t border-white/10 pt-2">
                            @(isSpecialSchemeEnabled ? "Phí Store 0%: 0 ₫ (Miễn phí 100%)" : $"Phí Store 12%: {epicStoreFee:N0} ₫")
                        </span>
                    </div>

                    @* Other Platform Result *@
                    <div class="p-5 rounded-2xl bg-[#16161a] border border-white/10 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-bold text-white/50">Store truyền thống:</span>
                                <span class="px-2.5 py-0.5 rounded-full bg-white/10 text-white/60 text-xs font-black uppercase tracking-wider">
                                    Khác (70%)
                                </span>
                            </div>
                            <span class="text-xl lg:text-2xl font-black text-white/80 block tracking-tight whitespace-nowrap">@steamRevenue.ToString("N0") ₫</span>
                        </div>
                        <span class="text-[11px] text-red-400/80 block mt-3 border-t border-white/10 pt-2">Bị cắt phế 30%: @steamStoreFee.ToString("N0") ₫</span>
                    </div>

                    @* Savings / Extra Money Result *@
                    <div class="p-5 rounded-2xl bg-gradient-to-br from-emerald-500/20 via-[#18181c] to-emerald-500/10 border border-emerald-500/40 shadow-lg flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-bold text-emerald-400">Bạn giữ thêm được:</span>
                                <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-black uppercase tracking-wider border border-emerald-500/30">
                                    @(isSpecialSchemeEnabled ? "+30% Doanh thu" : "+18% Doanh thu")
                                </span>
                            </div>
                            <span class="text-xl lg:text-2xl font-black text-emerald-400 block tracking-tight whitespace-nowrap">+@bonusSavings.ToString("N0") ₫</span>
                        </div>
                        <span class="text-[11px] text-emerald-300/70 block mt-3 border-t border-white/10 pt-2">
                            @(isSpecialSchemeEnabled ? "+30% doanh thu bỏ túi ròng" : "+18% doanh thu bỏ túi trọn đời")
                        </span>
                    </div>
                </div>
            </div>
        </section>

        @* ================================================================= *@
        @* SECTION 4: 4 KEY PILLARS                                          *@
        @* ================================================================= *@
        <section id="benefits" class="space-y-8 scroll-mt-28">
            <div class="text-center max-w-2xl mx-auto space-y-2">
                <span class="text-xs font-black uppercase tracking-widest text-[#0078f2]">LỢI ÍCH KHÁC BIỆT</span>
                <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">4 Đặc Quyền Tiên Quyết Cho Nhà Phát Triển</h2>
                <p class="text-sm text-white/50">Chúng tôi xây dựng hệ sinh thái vì sự thịnh vượng lâu dài của các studio game & tác giả phần mềm</p>
            </div>

            <div class="egs-dist-pillars-grid">
                @* Pillar 1: 88/12 Revenue Split & $1M Waiver *@
                <div class="egs-dist-step-card flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-[#0078f2]/15 border border-[#0078f2]/30 text-[#40a9ff] flex items-center justify-center mb-5">
                            <span class="text-lg font-black">88%</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2">Tỷ Lệ 88/12 & $1M Miễn Phí</h3>
                        <p class="text-sm text-white/60 leading-relaxed mb-4">
                            Áp dụng tỷ lệ 88% cho mọi đối tác. Đặc biệt, miễn 100% phí chia sẻ doanh thu cho <strong class="text-[#0078f2]">1.000.000 USD đầu tiên</strong> doanh số mỗi năm cho mỗi sản phẩm.
                        </p>
                    </div>
                    <span class="text-xs text-[#0078f2] font-bold flex items-center gap-1">Chính sách công bằng nhất →</span>
                </div>

                @* Pillar 2: Epic First Run & Now On Epic *@
                <div class="egs-dist-step-card flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center mb-5">
                            <span class="text-lg font-black">100%</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2">First Run & Now On Epic</h3>
                        <p class="text-sm text-white/60 leading-relaxed mb-4">
                            Sản phẩm mới độc quyền 6 tháng (First Run) hoặc đưa từ nền tảng khác sang (Now On Epic) đều nhận trọn vẹn <strong class="text-emerald-400 font-bold">100% doanh thu ròng</strong> trong 6 tháng đầu.
                        </p>
                    </div>
                    <span class="text-xs text-emerald-400 font-bold flex items-center gap-1">0% phí trong 6 tháng đầu →</span>
                </div>

                @* Pillar 3: 0% Unreal Royalty *@
                <div class="egs-dist-step-card flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-purple-500/15 border border-purple-500/30 text-purple-400 flex items-center justify-center mb-5">
                            <span class="text-lg font-black">0%</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2">0% Bản Quyền Unreal</h3>
                        <p class="text-sm text-white/60 leading-relaxed mb-4">
                            Nếu trò chơi hoặc ứng dụng 3D của bạn được xây dựng bằng Unreal Engine, bạn sẽ được <strong class="text-purple-400 font-bold">miễn hoàn toàn 5% phí bản quyền</strong> khi phân phối tại đây.
                        </p>
                    </div>
                    <span class="text-xs text-purple-400 font-bold flex items-center gap-1">Tiết kiệm trọn vẹn 5% royalty →</span>
                </div>

                @* Pillar 4: Thanh toán & In-App Payment *@
