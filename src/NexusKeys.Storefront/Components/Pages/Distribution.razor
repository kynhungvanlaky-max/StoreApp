                    </a>
                </div>

                @* Support Contact Channels *@
                <div class="pt-6 border-t border-white/10 flex items-center justify-center gap-6 text-xs text-white/50 flex-wrap">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Hỗ trợ kỹ thuật 24/7
                    </span>
                    <span class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Tài liệu SDK đầy đủ
                    </span>
                    <span class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Email: publishing@nexuskeys.com
                    </span>
                </div>
            </div>
        </section>

    </div>
</div>

@code {
    private long estimatedSales = 1000000000; // 1 Tỷ VNĐ default
    private bool isAppCategorySelected = false; // false: Games, true: Apps
    private bool isSpecialSchemeEnabled = false; // For Game: First Run (100%), For App: Custom In-App Payment (100%)

    private double epicRevenueRate => isSpecialSchemeEnabled ? 1.00 : 0.88;
    private double epicFeeRate => isSpecialSchemeEnabled ? 0.00 : 0.12;

    private long epicRevenue => (long)(estimatedSales * epicRevenueRate);
    private long epicStoreFee => (long)(estimatedSales * epicFeeRate);
    private long steamRevenue => (long)(estimatedSales * 0.70);
    private long steamStoreFee => (long)(estimatedSales * 0.30);
    private long bonusSavings => epicRevenue - steamRevenue;

    private Dictionary<int, bool> expandedFaqs = new()
    {
        { 1, true },
        { 2, true },
        { 3, false },
        { 4, false },
        { 5, false },
        { 6, false }
    };

    private void SetSalesPreset(long amount)
    {
        estimatedSales = amount;
    }

    private void SetCategoryMode(bool isApp)
    {
        isAppCategorySelected = isApp;
    }

    private void SetSpecialScheme(bool enabled)
    {
        isSpecialSchemeEnabled = enabled;
    }

    private void OnSalesSliderChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var val))
        {
            estimatedSales = val;
        }
    }

    private bool IsFaqOpen(int id) => expandedFaqs.TryGetValue(id, out var isOpen) && isOpen;

    private void ToggleFaq(int id)
    {
        if (expandedFaqs.ContainsKey(id))
        {
            expandedFaqs[id] = !expandedFaqs[id];
        }
        else
        {
            expandedFaqs[id] = true;
        }
    }
}
