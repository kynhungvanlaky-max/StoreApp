@page "/products"
@inject Frontend.ViewModels.ProductViewModel ViewModel
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Kho Game & Ứng Dụng Bản Quyền — NexusKeys</PageTitle>

<div class="egs-wrap">
    <div class="egs-content">

        @* R1 & R3: Modern Quick Type Navigation Tabs (Game vs App vs All) *@
        <div class="mb-8" role="tablist" aria-label="Phân loại cấp cao sản phẩm">
            <div class="inline-flex items-center gap-2 p-1.5 rounded-2xl bg-[#16161a]/90 backdrop-blur-md border border-white/10 shadow-lg shadow-black/40 max-w-full overflow-x-auto no-scrollbar">
                @{
                    var isAllSelected = string.IsNullOrEmpty(ViewModel.SelectedType);
                    var isGameSelected = string.Equals(ViewModel.SelectedType, "Game", StringComparison.OrdinalIgnoreCase);
                    var isAppSelected = string.Equals(ViewModel.SelectedType, "Software", StringComparison.OrdinalIgnoreCase) || string.Equals(ViewModel.SelectedType, "App", StringComparison.OrdinalIgnoreCase);
                }
                <button type="button" role="tab"
                        id="tab-all-products"
                        aria-selected="@(isAllSelected ? "true" : "false")"
                        @onclick='() => SelectType(null)'
                        class="min-h-[44px] px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap flex items-center gap-2.5 cursor-pointer @(isAllSelected ? "bg-gradient-to-r from-[#0078f2] to-[#005fb8] text-white shadow-[0_0_20px_rgba(0,120,242,0.45)] border border-[#4da6ff]/40 font-black scale-[1.02]" : "text-zinc-400 hover:text-white hover:bg-white/[0.06] border border-transparent")">
                    <span class="text-base">🌐</span>
                    <span>Tất cả sản phẩm</span>
                    @if (isAllSelected)
                    {
                        <span class="w-1.5 h-1.5 rounded-full bg-white shadow-[0_0_8px_white] animate-pulse"></span>
                    }
                </button>

                <button type="button" role="tab"
                        id="tab-game-products"
                        aria-selected="@(isGameSelected ? "true" : "false")"
                        @onclick='() => SelectType("Game")'
                        class="min-h-[44px] px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap flex items-center gap-2.5 cursor-pointer @(isGameSelected ? "bg-gradient-to-r from-[#0078f2] to-[#005fb8] text-white shadow-[0_0_20px_rgba(0,120,242,0.45)] border border-[#4da6ff]/40 font-black scale-[1.02]" : "text-zinc-400 hover:text-white hover:bg-white/[0.06] border border-transparent")">
                    <span class="text-base">🎮</span>
                    <span>Trò chơi (Game)</span>
                    @if (isGameSelected)
                    {
                        <span class="w-1.5 h-1.5 rounded-full bg-white shadow-[0_0_8px_white] animate-pulse"></span>
                    }
                </button>

                <button type="button" role="tab"
                        id="tab-app-products"
                        aria-selected="@(isAppSelected ? "true" : "false")"
                        @onclick='() => SelectType("App")'
                        class="min-h-[44px] px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap flex items-center gap-2.5 cursor-pointer @(isAppSelected ? "bg-gradient-to-r from-[#0078f2] to-[#005fb8] text-white shadow-[0_0_20px_rgba(0,120,242,0.45)] border border-[#4da6ff]/40 font-black scale-[1.02]" : "text-zinc-400 hover:text-white hover:bg-white/[0.06] border border-transparent")">
                    <span class="text-base">💻</span>
                    <span>Ứng dụng & Phần mềm</span>
                    @if (isAppSelected)
                    {
                        <span class="w-1.5 h-1.5 rounded-full bg-white shadow-[0_0_8px_white] animate-pulse"></span>
                    }
                </button>
            </div>
        </div>

        @* Modern Catalog Header Bar *@
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-5 border-b border-white/10">
            <div>
                <div class="flex items-center gap-3">
                    <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight">
                        @GetHeaderTitle()
                    </h1>
                    @if (!ViewModel.IsLoading && ViewModel.TotalCount > 0)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#0078f2]/15 border border-[#0078f2]/30 text-[#4da6ff]">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#0078f2] animate-pulse"></span>
                            @ViewModel.TotalCount.ToString("N0") sản phẩm
                        </span>
                    }
                </div>
                <p class="text-xs sm:text-sm text-zinc-400 mt-1">
                    @GetHeaderDescription()
                </p>
            </div>

            <div class="flex items-center gap-3">
                @{
                    int activeFilterCount = ViewModel.SelectedCategories.Count + ViewModel.SelectedPriceRanges.Count + (!string.IsNullOrEmpty(ViewModel.SelectedType) ? 1 : 0);
                }

                <div class="relative flex items-center">
                    <span class="text-xs text-zinc-400 font-bold uppercase tracking-wider hidden sm:inline mr-2.5">Sắp xếp:</span>
                    <div class="relative">
                        <select id="store-sort" class="appearance-none min-h-[44px] bg-[#1c1c22] border border-white/15 text-white text-xs font-bold rounded-xl outline-none cursor-pointer pl-4 pr-10 py-2.5 hover:border-[#0078f2]/50 focus:border-[#0078f2] focus:ring-2 focus:ring-[#0078f2]/30 transition-all shadow-md"
                                value="@ViewModel.SortBy"
                                @onchange='@(e => ChangeSort(e.Value?.ToString() ?? "newest"))'>
                            <option class="bg-[#1c1c22]" value="newest">⚡ Mới nhất (New Releases)</option>
                            <option class="bg-[#1c1c22]" value="discount">🔥 Ưu đãi giảm giá tốt nhất</option>
                            <option class="bg-[#1c1c22]" value="price_asc">🏷️ Giá: Thấp đến Cao</option>
                            <option class="bg-[#1c1c22]" value="price_desc">💎 Giá: Cao đến Thấp</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-zinc-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </div>
                    </div>
                </div>

                @* Mobile Filter Trigger Button *@
                <button type="button" @onclick="@(() => _showMobileFilter = true)"
                        class="lg:hidden min-h-[44px] inline-flex items-center gap-2 px-4 py-2.5 bg-[#1c1c22] hover:bg-[#25252e] border border-white/15 text-white text-xs font-bold rounded-xl transition-all shadow-md active:scale-95 cursor-pointer">
                    <svg class="w-4 h-4 text-[#0078f2]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                    <span>Bộ lọc</span>
                    @if (activeFilterCount > 0)
                    {
                        <span class="min-w-[20px] h-5 px-1.5 rounded-full bg-gradient-to-r from-[#0078f2] to-[#005fb8] text-white text-[11px] font-black flex items-center justify-center shadow-sm shadow-[#0078f2]/50">
                            @activeFilterCount
                        </span>
                    }
                </button>
            </div>
        </div>

        @* Active Filter Chips *@
        @if (ViewModel.SelectedCategories.Any() || ViewModel.SelectedPriceRanges.Any() || !string.IsNullOrWhiteSpace(ViewModel.SearchQuery) || !string.IsNullOrWhiteSpace(ViewModel.SelectedType))
        {
            <div class="flex flex-wrap items-center gap-2.5 mb-6 p-3.5 bg-[#16161a]/90 backdrop-blur-md border border-white/10 rounded-2xl shadow-sm">
                <span class="text-xs text-zinc-300 uppercase tracking-wider mr-1 font-bold flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#0078f2] shadow-[0_0_8px_#0078f2] animate-pulse"></span>
                    Đang lọc:
                </span>
                @if (!string.IsNullOrWhiteSpace(ViewModel.SelectedType))
                {
                    <span class="min-h-[40px] inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#0078F2]/15 border border-[#0078F2]/40 text-[#4da6ff] text-xs font-bold rounded-xl shadow-sm">
                        <span>@GetTypeChipLabel(ViewModel.SelectedType)</span>
                        <button type="button" @onclick='() => SelectType(null)' class="p-1 hover:bg-[#0078F2]/30 rounded-lg text-white/70 hover:text-white transition-all cursor-pointer" aria-label="Xóa bộ lọc loại sản phẩm">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(ViewModel.SearchQuery))
                {
                    <span class="min-h-[40px] inline-flex items-center gap-2 px-3.5 py-1.5 bg-purple-500/15 border border-purple-500/40 text-purple-300 text-xs font-semibold rounded-xl shadow-sm">
                        <span>🔍 "@ViewModel.SearchQuery"</span>
                        <button type="button" @onclick='() => { ViewModel.SearchQuery = ""; NavigateToCurrentState(1); }' class="p-1 hover:bg-purple-500/30 rounded-lg text-white/70 hover:text-white transition-all cursor-pointer" aria-label="Xóa bộ lọc từ khóa">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                    </span>
                }
                @foreach (var cat in ViewModel.SelectedCategories)
                {
                    <button type="button" @onclick="@(() => ToggleCategory(cat))"
                            class="min-h-[40px] inline-flex items-center gap-2 px-3.5 py-1.5 bg-sky-500/15 border border-sky-500/40 text-sky-300 text-xs font-bold rounded-xl hover:bg-sky-500/25 transition-all cursor-pointer group shadow-sm"
                            aria-label="@($"Xóa bộ lọc thể loại {cat}")">
                        <span>🏷️ @cat</span>
                        <svg class="w-3.5 h-3.5 text-sky-400/80 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                }
                @foreach (var pr in ViewModel.SelectedPriceRanges)
                {
                    <button type="button" @onclick="@(() => TogglePriceRange(pr))"
                            class="min-h-[40px] inline-flex items-center gap-2 px-3.5 py-1.5 bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-xs font-bold rounded-xl hover:bg-emerald-500/25 transition-all cursor-pointer group shadow-sm"
                            aria-label="@($"Xóa bộ lọc giá {GetPriceRangeLabel(pr)}")">
                        <span>💰 @GetPriceRangeLabel(pr)</span>
                        <svg class="w-3.5 h-3.5 text-emerald-400/80 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                }
                <button type="button" @onclick="ResetFilters"
                        class="min-h-[36px] px-3.5 py-1.5 text-xs text-rose-400 hover:text-rose-300 bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 rounded-xl transition-all font-bold inline-flex items-center gap-1.5 ml-auto cursor-pointer shadow-sm active:scale-95">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    <span>Xóa tất cả</span>
                </button>
            </div>
        }

        @* MAIN EPIC LAYOUT: Product Grid on Left + Filter Sidebar on Right *@
        <div class="flex flex-col lg:flex-row gap-8 items-start">
            
            @* Left / Center: Catalog Products Grid *@
            <div class="egs-filter-catalog">
                <h2 class="sr-only">Danh sách sản phẩm</h2>
                
                @if (ViewModel.IsLoading)
                {
                    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4 lg:gap-5">
                        @for (int i = 0; i < 8; i++)
                        {
                            <div class="animate-pulse">
                                <div class="aspect-[3/4] bg-[#202024] rounded-xl mb-3"></div>
                                <div class="h-3 bg-[#202024] rounded-full w-1/3 mb-2"></div>
                                <div class="h-4 bg-[#202024] rounded-full w-3/4 mb-2"></div>
                                <div class="h-4 bg-[#202024] rounded-full w-1/4"></div>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
                {
                    <div class="flex flex-col items-center justify-center py-24 text-center bg-[#18181c] border border-white/10 rounded-2xl p-8" role="alert">
                        <svg class="w-12 h-12 text-amber-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        <h2 class="text-xl font-bold text-white mb-2">Không thể tải danh sách sản phẩm</h2>
                        <p class="text-zinc-300 mb-6 max-w-md text-sm">@ViewModel.ErrorMessage</p>
                        <button type="button" @onclick="@(() => ViewModel.LoadAsync(ViewModel.CurrentPage))" class="min-h-[44px] px-6 py-2.5 text-xs font-bold text-white bg-[#0078F2] rounded-lg hover:bg-[#0066cc] uppercase tracking-wider inline-flex items-center justify-center cursor-pointer">Thử lại</button>
                    </div>
                }
                else if (ViewModel.Products.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center py-24 text-center bg-[#18181c] border border-white/10 rounded-2xl p-8">
                        <div class="w-16 h-16 bg-[#202024] rounded-full flex items-center justify-center mb-4">
                            <svg class="w-8 h-8 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </div>
                        <h2 class="text-xl font-bold text-white mb-2">Không tìm thấy sản phẩm nào</h2>
                        <p class="text-zinc-300 mb-6 max-w-md text-xs sm:text-sm">Thử thay đổi loại sản phẩm, từ khóa tìm kiếm hoặc bỏ chọn các bộ lọc để tiếp tục duyệt kho hàng.</p>
                        <button @onclick="ResetAll" class="min-h-[44px] px-6 py-2.5 text-xs font-bold text-white bg-[#0078F2] rounded-lg hover:bg-[#0066cc] uppercase tracking-wider transition-colors inline-flex items-center justify-center cursor-pointer">
                            Đặt lại bộ lọc
                        </button>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4 lg:gap-5">
                        @foreach (var product in ViewModel.Products)
                        {
                            <Frontend.Components.Shared.ProductCard Product="product" />
                        }
                    </div>
                    
                    @* Epic Pagination *@
                    @if (ViewModel.TotalPages > 1)
                    {
                        <div class="flex justify-center items-center gap-2 mt-12 pt-6 border-t border-white/10">
                            <button class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-[#202024] border border-white/15 text-white disabled:opacity-30 hover:bg-white/15 disabled:hover:bg-[#202024] transition-colors cursor-pointer"
                                    aria-label="Trang trước"
                                    disabled="@(ViewModel.CurrentPage == 1)"
                                    @onclick="@(() => NavigateToCurrentState(ViewModel.CurrentPage - 1))">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                            </button>
                            
                            @for (int i = 1; i <= ViewModel.TotalPages; i++)
                            {
                                var pageNum = i;
                                @if (ShouldShowPage(pageNum))
                                {
                                    <button class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg text-xs font-bold transition-all cursor-pointer @(pageNum == ViewModel.CurrentPage ? "bg-[#0078F2] text-white shadow-lg" : "bg-[#202024] border border-white/15 text-white/80 hover:text-white hover:bg-white/15")"
                                            aria-label="@($"Trang {pageNum}")" aria-current="@(pageNum == ViewModel.CurrentPage ? "page" : null)"
                                            @onclick="@(() => NavigateToCurrentState(pageNum))">
                                        @pageNum
                                    </button>
                                }
                                else if (ShouldShowEllipsis(pageNum))
                                {
                                    <span class="w-8 h-11 flex items-center justify-center text-white/60 text-sm">…</span>
                                }
                            }
                            
                            <button class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-[#202024] border border-white/15 text-white disabled:opacity-30 hover:bg-white/15 disabled:hover:bg-[#202024] transition-colors cursor-pointer"
                                    aria-label="Trang sau"
                                    disabled="@(ViewModel.CurrentPage == ViewModel.TotalPages)"
                                    @onclick="@(() => NavigateToCurrentState(ViewModel.CurrentPage + 1))">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                            </button>
                        </div>
                    }
                }
            </div>

            @* Right Column: Modern Filter Sidebar (Hidden on mobile, sticky on desktop) *@
            <aside class="egs-filter-sidebar hidden lg:block">
                <div class="lg:sticky lg:top-[104px] bg-[#16161a]/95 backdrop-blur-xl border border-[#2a2a34] rounded-2xl p-5 shadow-2xl shadow-black/50 space-y-5">
                    
                    @* Filter Header *@
                    <div class="flex items-center justify-between pb-4 border-b border-white/10">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#0078f2] to-[#0050a0] flex items-center justify-center text-white shadow-md shadow-[#0078f2]/30 flex-shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-black text-white uppercase tracking-wider">Bộ lọc</h3>
                                <p class="text-xs text-zinc-400">Tùy biến kho sản phẩm</p>
                            </div>
                        </div>

                        @if (ViewModel.SelectedCategories.Any() || ViewModel.SelectedPriceRanges.Any() || !string.IsNullOrEmpty(ViewModel.SelectedType))
                        {
                            <button type="button" @onclick="ResetFilters" 
                                    class="min-h-[34px] px-3 py-1 text-xs font-bold text-rose-400 hover:text-white bg-rose-500/10 hover:bg-rose-600 border border-rose-500/30 rounded-lg transition-all active:scale-[0.98] inline-flex items-center gap-1 cursor-pointer">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                <span>Đặt lại</span>
                            </button>
                        }
                    </div>

                    @* Filter Group 0: Product Type / Loại sản phẩm *@
                    <div class="border-b border-white/10 pb-4">
                        <button type="button" @onclick="@(() => _showProductTypes = !_showProductTypes)" 
                                class="flex items-center justify-between w-full py-2.5 min-h-[44px] text-left group cursor-pointer">
                            <span class="text-xs font-bold text-zinc-300 uppercase tracking-wider group-hover:text-white transition-colors flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-[#0078f2] shadow-[0_0_6px_#0078f2]"></span>
                                Loại sản phẩm
                            </span>
                            <div class="flex items-center gap-2">
                                @if (!string.IsNullOrEmpty(ViewModel.SelectedType))
                                {
                                    <span class="min-w-[20px] h-5 px-1.5 rounded-full bg-[#0078f2] text-white text-[11px] font-black flex items-center justify-center shadow-sm">
                                        1
                                    </span>
                                }
                                <svg class="w-4 h-4 text-zinc-400 group-hover:text-white transition-transform duration-200 @(_showProductTypes ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </div>
                        </button>

                        @if (_showProductTypes)
                        {
                            <div class="space-y-2 mt-2">
                                @{
                                    var typeOptions = new (string? Key, string Label, string Subtitle, string Icon)[]
                                    {
                                        (null, "Tất cả sản phẩm", "Kho tổng hợp toàn bộ", "🌐"),
                                        ("Game", "Trò chơi (Game)", "AAA & Indie bản quyền", "🎮"),
                                        ("App", "Ứng dụng & Phần mềm", "Đồ họa, dựng phim, tiện ích", "💻")
                                    };
                                }
                                @foreach (var opt in typeOptions)
                                {
                                    var isTypeSelected = opt.Key == null
                                        ? string.IsNullOrEmpty(ViewModel.SelectedType)
                                        : ((string.Equals(opt.Key, "App", StringComparison.OrdinalIgnoreCase) || string.Equals(opt.Key, "Software", StringComparison.OrdinalIgnoreCase))
                                            ? (string.Equals(ViewModel.SelectedType, "Software", StringComparison.OrdinalIgnoreCase) || string.Equals(ViewModel.SelectedType, "App", StringComparison.OrdinalIgnoreCase))
                                            : string.Equals(ViewModel.SelectedType, opt.Key, StringComparison.OrdinalIgnoreCase));

                                    <label class="group flex items-center justify-between min-h-[48px] px-3.5 py-2.5 rounded-xl cursor-pointer transition-all active:scale-[0.98] @(isTypeSelected ? "bg-gradient-to-r from-[#0078f2]/20 to-[#0078f2]/5 border border-[#0078f2] shadow-[0_0_15px_rgba(0,120,242,0.2)]" : "bg-[#1f1f26]/60 hover:bg-[#25252e] border border-white/5 hover:border-white/15")">
                                        <div class="flex items-center gap-3 min-w-0">
