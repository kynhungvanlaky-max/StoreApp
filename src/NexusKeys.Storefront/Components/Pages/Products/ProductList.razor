            <div class="p-4 border-t border-white/10 bg-[#1c1c24] flex items-center gap-3">
                <button type="button" @onclick="ResetFilters" class="flex-1 min-h-[44px] px-4 py-2 rounded-xl border border-white/15 text-zinc-300 hover:text-white hover:bg-white/5 font-bold text-xs transition-colors cursor-pointer">
                    Đặt lại
                </button>
                <button type="button" @onclick="@(() => _showMobileFilter = false)" class="flex-1 min-h-[44px] px-4 py-2 rounded-xl bg-gradient-to-r from-[#0078f2] to-[#005fb8] text-white font-bold text-xs shadow-lg shadow-[#0078f2]/30 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98">
                    <span>Xem kết quả</span>
                    @if (ViewModel.TotalCount > 0)
                    {
                        <span class="px-2 py-0.5 rounded-full bg-white/20 text-white text-[11px]">@ViewModel.TotalCount</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showMobileFilter = false;
    private bool _showProductTypes = true;
    private bool _showCategories = true;
    private bool _showPriceRanges = true;
    private string _categorySearchText = "";

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "type")]
    public string? Type { get; set; }

    [SupplyParameterFromQuery(Name = "categories")]
    public string[]? Categories { get; set; }

    [SupplyParameterFromQuery(Name = "priceRanges")]
    public string[]? PriceRanges { get; set; }

    [SupplyParameterFromQuery(Name = "sortBy")]
    public string? Sort { get; set; }

    private string? _lastStateSignature;

    protected override void OnInitialized()
    {
        ViewModel.StateChanged += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var categories = Categories?.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList() ?? new();
        var priceRanges = PriceRanges?.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList() ?? new();
        var sort = Sort is "price_asc" or "price_desc" or "discount" ? Sort : "newest";
        var page = Math.Max(1, Page);
        var selectedType = !string.IsNullOrWhiteSpace(Type) ? Type.Trim() : null;
        var signature = $"{page}|{Search}|{sort}|{selectedType}|{string.Join(',', categories)}|{string.Join(',', priceRanges)}";

        if (!string.Equals(signature, _lastStateSignature, StringComparison.Ordinal))
        {
            _lastStateSignature = signature;
            ViewModel.SearchQuery = Search ?? "";
            ViewModel.SortBy = sort;
            ViewModel.SelectedType = selectedType;
            ViewModel.SelectedCategories.Clear();
            ViewModel.SelectedCategories.AddRange(categories);
            ViewModel.SelectedPriceRanges.Clear();
            ViewModel.SelectedPriceRanges.AddRange(priceRanges);
            await ViewModel.LoadAsync(page);
        }
    }
    
    public void Dispose()
    {
        ViewModel.StateChanged -= StateHasChanged;
    }

    private string GetHeaderTitle()
    {
        if (string.Equals(ViewModel.SelectedType, "Game", StringComparison.OrdinalIgnoreCase))
            return "Kho Trò Chơi (Games)";
        if (string.Equals(ViewModel.SelectedType, "Software", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(ViewModel.SelectedType, "App", StringComparison.OrdinalIgnoreCase))
            return "Kho Ứng Dụng & Phần Mềm (Apps)";
        return "Kho Game & Ứng Dụng Bản Quyền";
    }

    private string GetHeaderDescription()
    {
        if (string.Equals(ViewModel.SelectedType, "Game", StringComparison.OrdinalIgnoreCase))
            return "Khám phá hàng ngàn tựa game AAA đỉnh cao, indie độc đáo và ưu đãi bản quyền Steam/Epic.";
        if (string.Equals(ViewModel.SelectedType, "Software", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(ViewModel.SelectedType, "App", StringComparison.OrdinalIgnoreCase))
            return "Bộ công cụ phần mềm đồ họa, biên tập video, âm thanh và tiện ích bản quyền chuyên nghiệp.";
        return "Khám phá toàn bộ kho game bản quyền, phần mềm chuyên nghiệp và ưu đãi độc quyền.";
    }

    private string GetCategoryGroupLabel()
    {
        if (string.Equals(ViewModel.SelectedType, "Game", StringComparison.OrdinalIgnoreCase))
            return "Thể loại trò chơi";
        if (string.Equals(ViewModel.SelectedType, "Software", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(ViewModel.SelectedType, "App", StringComparison.OrdinalIgnoreCase))
            return "Nhóm phần mềm & Tiện ích";
        return "Thể loại & Chuyên mục";
    }

    private string[] GetContextualCategories()
    {
        if (string.Equals(ViewModel.SelectedType, "Game", StringComparison.OrdinalIgnoreCase))
        {
            return new[]
            {
                "Hành động", "Nhập vai (RPG)", "Chiến thuật", "Bắn súng", "Thể thao",
                "Mô phỏng", "Thế giới mở", "Sinh tồn", "Kinh dị", "Đua xe"
            };
        }
        
        if (string.Equals(ViewModel.SelectedType, "Software", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(ViewModel.SelectedType, "App", StringComparison.OrdinalIgnoreCase))
        {
            return new[]
            {
                "Đồ họa & Thiết kế 3D", "Biên tập Video & Âm thanh", "Lập trình & Tiện ích", "Công cụ bản quyền"
            };
        }

        // Tất cả sản phẩm (All)
        return new[]
        {
            "Hành động", "Nhập vai (RPG)", "Chiến thuật", "Bắn súng", "Thể thao",
            "Mô phỏng", "Thế giới mở", "Sinh tồn", "Kinh dị", "Đua xe",
            "Đồ họa & Thiết kế 3D", "Biên tập Video & Âm thanh", "Lập trình & Tiện ích", "Công cụ bản quyền"
        };
    }

    private IEnumerable<string> GetFilteredCategories()
    {
        var cats = GetContextualCategories();
        if (string.IsNullOrWhiteSpace(_categorySearchText))
        {
            return cats;
        }
        return cats.Where(c => c.Contains(_categorySearchText.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private string GetTypeChipLabel(string type) => type switch
    {
        "Game" => "🎮 Loại: Trò chơi",
        "Software" or "App" => "💻 Loại: Ứng dụng & Phần mềm",
        _ => $"Loại: {type}"
    };

    private string GetPriceRangeLabel(string key) => key switch
    {
        "under_100k" => "Dưới 100.000 đ",
        "100k_500k" => "100.000 đ – 500.000 đ",
        "over_500k" => "Trên 500.000 đ",
        _ => key
    };

    private bool ShouldShowPage(int page)
    {
        if (ViewModel.TotalPages <= 7) return true;
        if (page == 1 || page == ViewModel.TotalPages) return true;
        if (Math.Abs(page - ViewModel.CurrentPage) <= 1) return true;
        return false;
    }

    private bool ShouldShowEllipsis(int page)
    {
        if (ViewModel.TotalPages <= 7) return false;
        if (page == 2 && ViewModel.CurrentPage > 3) return true;
        if (page == ViewModel.TotalPages - 1 && ViewModel.CurrentPage < ViewModel.TotalPages - 2) return true;
        return false;
    }

    private void SelectType(string? type)
    {
        ViewModel.SelectedType = type;
        ViewModel.SelectedCategories.Clear();
        _categorySearchText = "";
        NavigateToCurrentState(1);
    }

    private void ToggleCategory(string category)
    {
        if (!ViewModel.SelectedCategories.Remove(category))
        {
            ViewModel.SelectedCategories.Add(category);
        }
        NavigateToCurrentState(1);
    }

    private void TogglePriceRange(string range)
    {
        if (!ViewModel.SelectedPriceRanges.Remove(range))
        {
            ViewModel.SelectedPriceRanges.Add(range);
        }
        NavigateToCurrentState(1);
    }

    private void ChangeSort(string sortBy)
    {
        ViewModel.SortBy = sortBy;
        NavigateToCurrentState(1);
    }

    private void ResetFilters()
    {
        ViewModel.SelectedCategories.Clear();
        ViewModel.SelectedPriceRanges.Clear();
        ViewModel.SelectedType = null;
        _categorySearchText = "";
        NavigateToCurrentState(1);
    }

    private void ResetAll()
    {
        ViewModel.SearchQuery = string.Empty;
        ViewModel.SortBy = "newest";
        ViewModel.SelectedCategories.Clear();
        ViewModel.SelectedPriceRanges.Clear();
        ViewModel.SelectedType = null;
        _categorySearchText = "";
        NavigateToCurrentState(1);
    }

    private void NavigateToCurrentState(int page)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(ViewModel.SearchQuery))
        {
            parts.Add($"search={Uri.EscapeDataString(ViewModel.SearchQuery.Trim())}");
        }
        if (!string.IsNullOrWhiteSpace(ViewModel.SelectedType))
        {
            parts.Add($"type={Uri.EscapeDataString(ViewModel.SelectedType)}");
        }
        if (!string.Equals(ViewModel.SortBy, "newest", StringComparison.Ordinal))
        {
            parts.Add($"sortBy={Uri.EscapeDataString(ViewModel.SortBy)}");
        }
        foreach (var category in ViewModel.SelectedCategories)
        {
            parts.Add($"categories={Uri.EscapeDataString(category)}");
        }
        foreach (var range in ViewModel.SelectedPriceRanges)
        {
            parts.Add($"priceRanges={Uri.EscapeDataString(range)}");
        }
        if (page > 1)
        {
            parts.Add($"page={page}");
        }

        NavigationManager.NavigateTo(parts.Count == 0 ? "/products" : $"/products?{string.Join("&", parts)}");
    }
}
