                <button type="button" @onclick="() => _showShareModal = false" class="w-9 h-9 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg hover:bg-white/10 text-white/70 hover:text-white cursor-pointer" aria-label="Đóng">✕</button>
            </div>

            <div class="flex items-center gap-2 mb-4">
                <input type="text" readonly value="@NavigationManager.Uri" class="flex-1 bg-[#121216] border border-white/15 text-white text-xs px-3 py-2.5 min-h-[44px] rounded-xl" />
                <button type="button" @onclick="CopyShareUrl" class="px-5 py-2.5 min-h-[44px] bg-[#0078f2] hover:bg-[#0068d6] text-white text-xs font-bold rounded-xl cursor-pointer">Sao chép</button>
