@* Age Gate Warning Dialog *@
@if (_showAgeGateModal && ViewModel.Product != null)
{
    var p = ViewModel.Product;
    <div class="egs-modal-backdrop" @onclick="() => _showAgeGateModal = false" role="dialog" aria-modal="true">
        <div class="egs-modal-card max-w-md p-6 sm:p-8" @onclick:stopPropagation="true">
            <div class="text-center mb-6">
                @if (IsAllAgesProduct(p))
                {
                    <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-black uppercase mb-2">Phù hợp mọi lứa tuổi • Bản quyền chính hãng</span>
                    <h3 class="text-xl font-black text-white">Thông Tin Độ Tuổi</h3>
                    <p class="text-xs text-white/75 mt-2 leading-relaxed">
                        Sản phẩm <span class="text-white font-bold">@p.Name</span> phù hợp cho mọi lứa tuổi và đi kèm chứng nhận bản quyền chính hãng tại NexusKeys.
                    </p>
                }
                else
                {
                    <span class="inline-block px-3 py-1 rounded-full bg-amber-500/20 text-amber-400 text-xs font-black uppercase mb-2">ESRB M • 18+ MATURE</span>
                    <h3 class="text-xl font-black text-white">Xác Nhận Độ Tuổi</h3>
                    <p class="text-xs text-white/75 mt-2 leading-relaxed">
                        Tựa game <span class="text-white font-bold">@p.Name</span> có chứa các yếu tố kịch tính hoặc cảnh nhạy cảm. Bạn phải từ đủ 18 tuổi trở lên để tiếp tục.
                    </p>
                }
            </div>
            <div class="space-y-2">
                <button type="button" @onclick="ConfirmAgeGate" class="w-full py-3 min-h-[44px] rounded-xl bg-[#0078f2] text-white text-xs font-bold uppercase tracking-wider flex items-center justify-center cursor-pointer">
                    @(IsAllAgesProduct(p) ? "Đã hiểu — Tiếp tục" : "Tôi đã đủ 18 tuổi — Tiếp tục")
                </button>
                <a href="/products" class="w-full py-2.5 min-h-[44px] rounded-xl text-white/75 hover:text-white text-xs font-semibold uppercase flex items-center justify-center text-center">
                    Rời khỏi trang này
                </a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool _showAddedToCartModal = false;
    private bool _showShareModal = false;
    private bool _showLightboxModal = false;
    private bool _showAgeGateModal = false;

    private string _activeTab = "Overview";
    private int _currentMediaIndex = 0;

    private string newReviewContent = "";
    private bool? newReviewIsPositive = null;
    private bool isSubmittingReview = false;
    private string? _selectedMediaUrl = null;
    private string? _selectedMediaType = null;

    private string reviewFilter = "All";

    private void SetReviewFilter(string filter) => reviewFilter = filter;

    private static bool IsAllAgesProduct(Frontend.Models.Product.ProductDto product)
    {
        if (GameMediaHelper.IsApp(product.Name, product.Type, product.Categories))
        {
            return true;
        }

        if (product.Categories != null && product.Categories.Any(c =>
            c.Contains("Thể thao", StringComparison.OrdinalIgnoreCase) ||
            c.Contains("Đua xe", StringComparison.OrdinalIgnoreCase) ||
            c.Contains("Mô phỏng", StringComparison.OrdinalIgnoreCase) ||
            c.Contains("Sports", StringComparison.OrdinalIgnoreCase) ||
            c.Contains("Racing", StringComparison.OrdinalIgnoreCase) ||
            c.Contains("Simulation", StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        return false;
    }

    private void SelectMedia(string url, string type, int index = 0)
    {
        _selectedMediaUrl = url;
        _selectedMediaType = type;
        _currentMediaIndex = index;
    }

    private void NextMedia(int total)
    {
        if (total <= 0) return;
        _currentMediaIndex = (_currentMediaIndex + 1) % total;
        var gallery = GameMediaHelper.GetMediaGallery(ViewModel.Product?.Name, ViewModel.Product?.ImageUrl, ViewModel.Product?.Type, ViewModel.Product?.Categories);
        if (_currentMediaIndex < gallery.Count)
        {
            _selectedMediaUrl = gallery[_currentMediaIndex].Url;
            _selectedMediaType = gallery[_currentMediaIndex].Type;
        }
    }

    private void PrevMedia(int total)
    {
        if (total <= 0) return;
        _currentMediaIndex = (_currentMediaIndex - 1 + total) % total;
        var gallery = GameMediaHelper.GetMediaGallery(ViewModel.Product?.Name, ViewModel.Product?.ImageUrl, ViewModel.Product?.Type, ViewModel.Product?.Categories);
        if (_currentMediaIndex < gallery.Count)
        {
            _selectedMediaUrl = gallery[_currentMediaIndex].Url;
            _selectedMediaType = gallery[_currentMediaIndex].Type;
        }
    }

    private int _lastLoadedId = 0;
    private int _recordedRecentlyViewedId = 0;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.StateChanged += StateHasChanged;
        CartViewModel.StateChanged += StateHasChanged;
        WishlistViewModel.StateChanged += StateHasChanged;
        ProfileViewModel.StateChanged += StateHasChanged;
        
        if (AuthViewModel.IsLoggedIn)
        {
            await WishlistViewModel.LoadWishlistAsync();
            await ProfileViewModel.LoadLibraryAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id > 0 && Id != _lastLoadedId)
        {
            _lastLoadedId = Id;
            _selectedMediaUrl = null;
            _selectedMediaType = null;
            _currentMediaIndex = 0;
            _activeTab = "Overview";
            await ViewModel.LoadProductAsync(Id);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ViewModel.Product != null && ViewModel.Product.Id != _recordedRecentlyViewedId)
        {
            _recordedRecentlyViewedId = ViewModel.Product.Id;
            await RecentlyViewedService.AddRecentlyViewedAsync(
                ViewModel.Product.Id,
                ViewModel.Product.Name,
                GameMediaHelper.GetCover(ViewModel.Product.Name, ViewModel.Product.ImageUrl, ViewModel.Product.Type, ViewModel.Product.Categories),
                ViewModel.Product.BasePrice
            );
        }
    }

    private string _subnavSearch = "";
    private void HandleSubnavSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_subnavSearch))
        {
            NavigationManager.NavigateTo($"/products?search={Uri.EscapeDataString(_subnavSearch.Trim())}");
        }
    }

    private async Task AddToCart()
    {
        await AddToCartCoreAsync(showModal: true);
    }

    private async Task AddDeluxeToCart()
    {
        await AddToCartCoreAsync(showModal: true);
        if (ViewModel.Product != null)
        {
            ToastService.ShowSuccess($"Đã thêm gói nâng cấp \"{ViewModel.Product.Name} — Phiên Bản Cao Cấp (Deluxe)\" vào giỏ hàng!");
        }
    }

    private async Task AddToCartCoreAsync(bool showModal)
    {
        if (ViewModel.Product == null) return;
        var p = ViewModel.Product;
        var price = p.DiscountPrice is > 0 ? p.DiscountPrice.Value : p.BasePrice;
        
        await CartViewModel.AddToCartAsync(new Frontend.Models.Cart.CartItem
        {
            ProductId = p.Id,
            Name = p.Name,
            Price = price,
            ImageUrl = GameMediaHelper.GetCover(p.Name, p.ImageUrl, p.Type, p.Categories)
        });

        if (showModal)
        {
            _showAddedToCartModal = true;
        }
    }

    private async Task BuyNow()
    {
        await AddToCartCoreAsync(showModal: false);
        await CartViewModel.SelectOnlyAsync(Id);
        NavigationManager.NavigateTo("/cart");
    }

    private static string FormatDiscount(decimal discount) =>
        decimal.Truncate(discount) == discount
            ? discount.ToString("0")
            : discount.ToString("0.#");

    private string GetReviewSummary()
    {
        var reviews = ViewModel.Reviews;
        if (reviews == null || reviews.Count == 0)
        {
            return "Chưa có";
        }

        var positiveCount = reviews.Count(review => review.IsPositive);
        var positivePercentage = (int)Math.Round(positiveCount * 100d / reviews.Count);
        return $"{positivePercentage}% tích cực";
    }

    private async Task ToggleWishlist()
    {
        if (ViewModel.Product == null) return;
        
        bool isInWishlist = WishlistViewModel.Items.Any(i => i.ProductId == Id);
        if (isInWishlist)
        {
            await WishlistViewModel.RemoveFromWishlistAsync(Id);
        }
        else
        {
            await WishlistViewModel.AddToWishlistAsync(Id, ViewModel.Product.Name);
        }
    }
    
    private void OpenMediaLightbox()
    {
        _showLightboxModal = true;
    }

    private async Task CopyShareUrl()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", NavigationManager.Uri);
        ToastService.ShowSuccess(GameMediaHelper.IsApp(ViewModel.Product?.Name, ViewModel.Product?.Type, ViewModel.Product?.Categories) ? "Đã sao chép liên kết ứng dụng!" : "Đã sao chép liên kết trò chơi!");
    }

    private void ConfirmAgeGate()
    {
        _showAgeGateModal = false;
        ToastService.ShowSuccess("Đã xác nhận độ tuổi thành công.");
    }

    private async Task SubmitReview()
    {
        if (string.IsNullOrWhiteSpace(newReviewContent) || newReviewIsPositive == null) return;
        
        isSubmittingReview = true;
        var request = new Frontend.Models.Review.CreateReviewDto
        {
            ProductId = Id,
            Content = newReviewContent,
            IsRecommended = newReviewIsPositive.Value
        };
        
        var success = await ViewModel.SubmitReviewAsync(request);
        if (success)
        {
            newReviewContent = "";
            newReviewIsPositive = null;
        }
        
        isSubmittingReview = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        ViewModel.StateChanged -= StateHasChanged;
        CartViewModel.StateChanged -= StateHasChanged;
        WishlistViewModel.StateChanged -= StateHasChanged;
        ProfileViewModel.StateChanged -= StateHasChanged;
    }
}
