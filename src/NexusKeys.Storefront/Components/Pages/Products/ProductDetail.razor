@page "/products/{Id:int}"
@page "/product/{Id:int}"
@inject Frontend.ViewModels.ProductDetailViewModel ViewModel
@inject Frontend.ViewModels.AuthViewModel AuthViewModel
@inject Frontend.ViewModels.CartViewModel CartViewModel
@inject Frontend.ViewModels.WishlistViewModel WishlistViewModel
@inject Frontend.ViewModels.ProfileViewModel ProfileViewModel
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Frontend.Services.RecentlyViewedService RecentlyViewedService
@inject Frontend.Services.ToastService ToastService
@using Frontend.Services
@implements IDisposable

<PageTitle>@(ViewModel.Product?.Name ?? "Chi tiết sản phẩm") — NexusKeys</PageTitle>

<div class="egs-wrap">
    <div class="egs-content">

@if (ViewModel.IsLoading)
{
    <div class="py-12 animate-pulse space-y-6">
        <div class="h-4 w-48 bg-[#202024] rounded"></div>
        <div class="h-10 w-96 bg-[#202024] rounded"></div>
        <div class="flex flex-col lg:flex-row gap-10">
            <div class="w-full lg:w-[68%] space-y-4">
                <div class="aspect-[16/9] w-full bg-[#202024] rounded-2xl"></div>
                <div class="flex gap-3">
                    <div class="h-20 w-36 bg-[#202024] rounded-xl"></div>
                    <div class="h-20 w-36 bg-[#202024] rounded-xl"></div>
                    <div class="h-20 w-36 bg-[#202024] rounded-xl"></div>
                </div>
            </div>
            <div class="w-full lg:w-[32%] space-y-4 pt-6">
                <div class="h-40 w-full bg-[#202024] rounded-2xl"></div>
                <div class="h-12 w-full bg-[#202024] rounded-xl"></div>
                <div class="h-12 w-full bg-[#202024] rounded-xl"></div>
            </div>
        </div>
    </div>
}
else if (ViewModel.Product == null)
{
    <div class="flex flex-col items-center justify-center py-32 text-center bg-[#18181c] border border-white/10 rounded-2xl my-8 p-8">
        <div class="w-16 h-16 bg-[#202024] rounded-full flex items-center justify-center mb-4 text-amber-400">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <h1 class="text-2xl font-bold text-white mb-2 tracking-tight">Không tìm thấy sản phẩm</h1>
        <p class="text-zinc-300 mb-6 text-sm">Sản phẩm này không tồn tại hoặc đã được chuyển vào kho lưu trữ.</p>
        <a href="/products" class="min-h-[44px] px-6 py-2.5 text-xs font-bold text-white bg-[#0078F2] rounded-lg hover:bg-[#0066cc] uppercase tracking-wider transition-colors inline-flex items-center justify-center">Trở về cửa hàng</a>
    </div>
}
else
{
    var product = ViewModel.Product;
    var authenticCover = GameMediaHelper.GetCover(product.Name, product.ImageUrl, product.Type, product.Categories);
    var authenticHero = GameMediaHelper.GetHeroBanner(product.Name, product.ImageUrl, product.Type, product.Categories);
    var authenticCapsule = GameMediaHelper.GetCapsule(product.Name, product.ImageUrl, product.Type, product.Categories);
    var gallery = GameMediaHelper.GetMediaGallery(product.Name, product.ImageUrl, product.Type, product.Categories);

    @* Breadcrumbs *@
    <div class="flex items-center gap-2 text-xs text-white/70 mb-4 font-semibold">
        <a href="/" class="hover:text-white transition-colors">Cửa hàng</a>
        <span>›</span>
        @if (GameMediaHelper.IsApp(product.Name, product.Type, product.Categories))
        {
            <a href="/products?type=App" class="hover:text-white transition-colors">Kho ứng dụng</a>
        }
        else
        {
            <a href="/products?type=Game" class="hover:text-white transition-colors">Kho trò chơi</a>
        }
        <span>›</span>
        <span class="text-white truncate max-w-sm">@product.Name</span>
    </div>

    @* Game Header: Title & Badges *@
    <div class="mb-4">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-3">
            @product.Name
        </h1>

        <div class="flex flex-wrap items-center gap-3 mb-6">
            @* Product Type Badge *@
            @if (GameMediaHelper.IsApp(product.Name, product.Type, product.Categories))
            {
                <span class="inline-flex items-center px-3 py-1 rounded-md bg-purple-600/90 text-white text-xs font-black uppercase tracking-wider shadow-md backdrop-blur-sm border border-purple-400/40">
                    Ứng dụng & Phần mềm
                </span>
            }
            else
            {
                <span class="inline-flex items-center px-3 py-1 rounded-md bg-[#0078f2]/90 text-white text-xs font-black uppercase tracking-wider shadow-md backdrop-blur-sm border border-sky-400/40">
                    Trò chơi (Game)
                </span>
            }

            @* Detailed classification sub-badge *@
            <span class="px-2.5 py-1 rounded-md bg-white/10 border border-white/15 text-white/90 text-xs font-semibold">
                @GameMediaHelper.GetDetailedBadge(product.Name, product.Type, product.Categories)
            </span>

            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#202024] border border-white/10 text-white text-xs font-bold">
                <span class="text-amber-400 font-black">★ 4.8</span>
                <span class="text-white/40">|</span>
                <span class="text-white/80">@GetReviewSummary()</span>
            </div>

            @foreach (var cat in product.Categories)
            {
                <a href="@($"/products?categories={Uri.EscapeDataString(cat)}")" 
                   class="px-2.5 py-1 rounded-md bg-white/5 hover:bg-white/10 border border-white/10 text-white/80 hover:text-white text-xs font-semibold transition-colors">
                    @cat
                </a>
            }
        </div>
    </div>

    @* Main Two-Column Layout (Epic Games Store Grid) *@
    <div class="egs-product-layout">
        
        @* Left Column: Gallery, Overview, Specs, Reviews *@
        <div class="egs-product-main">
            
            @* 1. Media Stage & Thumbnails *@
            <div>
                <div class="aspect-[16/9] w-full rounded-2xl overflow-hidden bg-[#18181c] relative group shadow-2xl border border-white/10">
                    <img src="@(_selectedMediaUrl ?? authenticHero)" alt="@product.Name" class="w-full h-full object-cover transition-all duration-300 group-hover:scale-[1.01]" />
                    
                    @* Prev Arrow *@
                    <button type="button" @onclick="() => PrevMedia(gallery.Count)" aria-label="Hình trước"
                            class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 min-w-[44px] min-h-[44px] rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center border border-white/15 backdrop-blur-md transition-all opacity-100 sm:opacity-0 sm:group-hover:opacity-100 shadow-xl cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                    </button>

                    @* Next Arrow *@
                    <button type="button" @onclick="() => NextMedia(gallery.Count)" aria-label="Hình kế tiếp"
                            class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 min-w-[44px] min-h-[44px] rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center border border-white/15 backdrop-blur-md transition-all opacity-100 sm:opacity-0 sm:group-hover:opacity-100 shadow-xl cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                    </button>

                    @* Bottom Controls: Counter & Fullscreen *@
                    <div class="absolute bottom-4 right-4 flex items-center gap-2">
                        <div class="px-2.5 py-1 rounded-md bg-black/70 text-white/90 text-xs font-bold border border-white/15 backdrop-blur-md shadow-lg">
                            @(_currentMediaIndex + 1) / @gallery.Count
                        </div>
                        <button type="button" @onclick="OpenMediaLightbox" class="min-h-[36px] px-3 py-1.5 rounded-md bg-black/70 hover:bg-black text-white text-xs font-bold flex items-center gap-1.5 border border-white/15 backdrop-blur-md transition-all shadow-lg cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                            <span>Toàn màn hình</span>
                        </button>
                    </div>
                </div>

                @* Thumbnail Slider *@
                <div class="flex items-center gap-3 mt-3 overflow-x-auto pb-2">
                    @for (int i = 0; i < gallery.Count; i++)
                    {
                        var item = gallery[i];
                        var idx = i;
                        var isSelected = (_selectedMediaUrl ?? authenticHero) == item.Url;
                        <button type="button" 
                                @onclick="() => SelectMedia(item.Url, item.Type, idx)"
                                class="w-24 sm:w-28 aspect-[16/9] rounded-xl overflow-hidden border-2 transition-all flex-shrink-0 bg-[#202024] relative cursor-pointer @(isSelected ? "border-[#0078f2] shadow-lg scale-102 opacity-100" : "border-transparent opacity-60 hover:opacity-100")">
                            <img src="@item.Url" alt="@item.Title" class="w-full h-full object-cover" />
                        </button>
                    }
                </div>
            </div>

            @* Sub-Navigation Tabs Bar & Dynamic Content Container *@
            <div class="flex flex-col gap-6">
                @* 3 Sub-nav Tabs (No Thành Tựu) *@
                <div class="border-b border-white/10 flex items-center gap-6 sm:gap-8 text-sm sm:text-base font-bold overflow-x-auto pb-0">
                    <button type="button" @onclick='() => _activeTab = "Overview"'
                            class="pb-3 border-b-2 min-h-[44px] transition-all whitespace-nowrap cursor-pointer @(_activeTab == "Overview" ? "border-white text-white font-black" : "border-transparent text-white/70 hover:text-white")">
                        Tổng quan
                    </button>
                    <button type="button" @onclick='() => _activeTab = "Editions"'
                            class="pb-3 border-b-2 min-h-[44px] transition-all whitespace-nowrap cursor-pointer @(_activeTab == "Editions" ? "border-white text-white font-black" : "border-transparent text-white/70 hover:text-white")">
                        @(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Gói bản quyền & Tiện ích" : "Tiện ích bổ sung & Phiên bản")
                    </button>
                    <button type="button" @onclick='() => _activeTab = "Specs"'
                            class="pb-3 border-b-2 min-h-[44px] transition-all whitespace-nowrap cursor-pointer @(_activeTab == "Specs" ? "border-white text-white font-black" : "border-transparent text-white/70 hover:text-white")">
                        Yêu cầu hệ thống
                    </button>
                </div>

                @* Dynamic Tab Content Switcher *@
                @if (_activeTab == "Overview")
                {
                    <div class="flex flex-col gap-10" id="overview-section">
                        @* About The Game *@
                        @* About The Game / App *@
                        <div>
                            <h2 class="text-xl sm:text-2xl font-black text-white mb-4">
                                @(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Giới thiệu về ứng dụng" : "Giới thiệu về trò chơi")
                            </h2>
                            
                            @* Features / Attributes Row (NexusKeys style) *@
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-5 mb-6 border-y border-white/10">
                                <div class="space-y-1">
                                    <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider block">Thể loại</span>
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var c in product.Categories)
                                        {
                                            <span class="text-xs font-semibold text-white/90">@c</span>
                                        }
                                    </div>
                                </div>
                                @if (GameMediaHelper.IsApp(product.Name, product.Type, product.Categories))
                                {
                                    <div class="space-y-1">
                                        <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider block">Tính năng</span>
                                        <span class="text-xs font-semibold text-white/90 block">Bản quyền đầy đủ, Cập nhật tự động</span>
                                    </div>
                                    <div class="space-y-1">
                                        <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider block">Tương thích</span>
                                        <span class="text-xs font-semibold text-white/90 block">Windows PC, Đa nhân</span>
                                    </div>
                                    <div class="space-y-1">
                                        <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider block">Lưu trữ</span>
                                        <span class="text-xs font-semibold text-white/90 block">Cloud Sync & Local SSD</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="space-y-1">
                                        <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider block">Tính năng</span>
                                        <span class="text-xs font-semibold text-white/90 block">Một người chơi, Co-op</span>
                                    </div>
                                    <div class="space-y-1">
                                        <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider block">Hỗ trợ tay cầm</span>
                                        <span class="text-xs font-semibold text-white/90 block">Đầy đủ (Controller)</span>
                                    </div>
                                    <div class="space-y-1">
                                        <span class="text-[11px] font-bold text-white/70 uppercase tracking-wider block">Lưu trữ đám mây</span>
                                        <span class="text-xs font-semibold text-white/90 block">Cloud Saves</span>
                                    </div>
                                }
                            </div>

                            <div class="text-white/80 text-sm sm:text-base leading-relaxed space-y-4">
                                <p class="text-base sm:text-lg font-medium text-white/90 leading-normal">
                                    @if (GameMediaHelper.IsApp(product.Name, product.Type, product.Categories))
                                    {
                                        <span>Khám phá bộ công cụ và tính năng chuyên nghiệp của <span class="text-white font-bold">@product.Name</span>. Tối ưu hóa hiệu suất làm việc, xử lý mượt mà và hỗ trợ bản quyền chính hãng tại NexusKeys.</span>
                                    }
                                    else
                                    {
                                        <span>Trải nghiệm đỉnh cao của tuyệt phẩm <span class="text-white font-bold">@product.Name</span>. Khám phá thế giới đồ họa chân thực, gameplay mượt mà cùng hệ thống nhiệm vụ sâu sắc mang đậm dấu ấn tại NexusKeys.</span>
                                    }
                                </p>
                                <div class="text-white/80">
                                    @((MarkupString)(product.Description ?? "").Replace("\n", "<br/>"))
                                </div>
                            </div>

                            @* Highlights Cards Grid *@
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
                                @if (GameMediaHelper.IsApp(product.Name, product.Type, product.Categories))
                                {
                                    <div class="p-4 rounded-xl bg-[#18181c] border border-white/10">
                                        <span class="text-xs font-black text-purple-400 uppercase tracking-wider block mb-1">Hiệu Năng Tối Ưu</span>
                                        <p class="text-xs text-white/85">Tăng tốc xử lý phần cứng đa nhân, tương thích GPU hiện đại siêu tốc.</p>
                                    </div>
                                    <div class="p-4 rounded-xl bg-[#18181c] border border-white/10">
                                        <span class="text-xs font-black text-purple-400 uppercase tracking-wider block mb-1">Bản Quyền Vĩnh Viễn</span>
                                        <p class="text-xs text-white/85">Kích hoạt trực tiếp tài khoản chính hãng, cập nhật bảo mật liên tục.</p>
                                    </div>
                                    <div class="p-4 rounded-xl bg-[#18181c] border border-white/10">
                                        <span class="text-xs font-black text-purple-400 uppercase tracking-wider block mb-1">Tiện Ích Chuyên Nghiệp</span>
                                        <p class="text-xs text-white/85">Bộ công cụ hoàn chỉnh cho sáng tạo nội dung, đồ họa và biên tập.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-4 rounded-xl bg-[#18181c] border border-white/10">
                                        <span class="text-xs font-black text-[#0078f2] uppercase tracking-wider block mb-1">Đồ Họa Chuẩn 4K</span>
                                        <p class="text-xs text-white/85">Hỗ trợ Ray Tracing, HDR và tần số quét cao siêu mượt.</p>
                                    </div>
                                    <div class="p-4 rounded-xl bg-[#18181c] border border-white/10">
                                        <span class="text-xs font-black text-[#0078f2] uppercase tracking-wider block mb-1">Chế Độ Chơi Đa Dạng</span>
                                        <p class="text-xs text-white/85">Chế độ cốt truyện đơn hoành tráng cùng kết nối trực tuyến linh hoạt.</p>
                                    </div>
                                    <div class="p-4 rounded-xl bg-[#18181c] border border-white/10">
                                        <span class="text-xs font-black text-[#0078f2] uppercase tracking-wider block mb-1">Hỗ Trợ Tay Cầm</span>
                                        <p class="text-xs text-white/85">Tương thích hoàn hảo bàn phím/chuột và tay cầm DualSense / Xbox.</p>
                                    </div>
                                }
                            </div>
                        </div>

                        @* Ratings & Reviews *@
                        <div class="border-t border-white/10 pt-8">
                            <div class="flex items-center justify-between mb-6">
                                <h2 class="text-xl sm:text-2xl font-black text-white">Đánh giá từ cộng đồng</h2>
                                <span class="text-xs text-white/70">@(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Dựa trên người dùng đã mua" : "Dựa trên người chơi đã mua")</span>
                            </div>

                            @* Satisfaction Bar *@
                            <div class="p-6 rounded-2xl bg-[#18181c] border border-white/10 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
                                <div class="flex items-center gap-5">
                                    <div class="text-4xl sm:text-5xl font-black text-white">94%</div>
                                    <div>
                                        <div class="text-sm font-bold text-white mb-0.5">Tỷ lệ đánh giá rất tích cực</div>
                                        <div class="text-xs text-white/70">@(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Hầu hết người dùng đều hài lòng với chất lượng sản phẩm." : "Hầu hết người chơi đều hài lòng với chất lượng tựa game.")</div>
                                    </div>
                                </div>
                                
                                <div class="flex items-center gap-1.5 bg-[#202024] p-1 rounded-xl">
                                    <button type="button" @onclick='() => SetReviewFilter("All")' class="px-3.5 py-2 min-h-[36px] rounded-lg text-xs font-bold transition-colors cursor-pointer @(reviewFilter == "All" ? "bg-[#0078f2] text-white" : "text-white/70 hover:text-white")">Tất cả</button>
                                    <button type="button" @onclick='() => SetReviewFilter("Positive")' class="px-3.5 py-2 min-h-[36px] rounded-lg text-xs font-bold transition-colors cursor-pointer @(reviewFilter == "Positive" ? "bg-[#0078f2] text-white" : "text-white/70 hover:text-white")">Tích cực</button>
                                    <button type="button" @onclick='() => SetReviewFilter("Negative")' class="px-3.5 py-2 min-h-[36px] rounded-lg text-xs font-bold transition-colors cursor-pointer @(reviewFilter == "Negative" ? "bg-[#0078f2] text-white" : "text-white/70 hover:text-white")">Tiêu cực</button>
                                </div>
                            </div>

                            @* Review Form *@
                            <div class="p-6 rounded-2xl bg-[#18181c] border border-white/10 mb-8">
                                <h3 class="text-sm font-bold text-white mb-3">Viết nhận xét của bạn</h3>
                                @if (AuthViewModel.IsLoggedIn)
                                {
                                    <div class="space-y-4">
                                        <textarea @bind="newReviewContent" aria-label="Nội dung đánh giá" 
                                                  class="w-full bg-[#121216] border border-white/15 text-white p-3.5 rounded-xl text-xs sm:text-sm focus:outline-none focus:border-[#0078f2] min-h-[90px] resize-none"
                                                  placeholder="@(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Bạn cảm thấy trải nghiệm ứng dụng này như thế nào?" : "Bạn cảm thấy trải nghiệm tựa game này như thế nào?")"></textarea>
                                        
                                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                            <div class="flex items-center gap-2">
                                                <button type="button" @onclick="() => newReviewIsPositive = true" class="px-4 py-2 min-h-[44px] rounded-lg text-xs font-bold transition-all flex items-center gap-2 cursor-pointer @(newReviewIsPositive == true ? "bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 shadow-sm" : "bg-[#202024] text-white/70 border border-white/10 hover:text-white hover:bg-white/5")">
                                                    <Icon Name="HeroiconName.HandThumbUp" Class="w-4 h-4 text-emerald-400" IconType="HeroiconType.Solid" />
                                                    <span>Khuyên dùng</span>
                                                </button>
                                                <button type="button" @onclick="() => newReviewIsPositive = false" class="px-4 py-2 min-h-[44px] rounded-lg text-xs font-bold transition-all flex items-center gap-2 cursor-pointer @(newReviewIsPositive == false ? "bg-rose-500/15 text-rose-400 border border-rose-500/30 shadow-sm" : "bg-[#202024] text-white/70 border border-white/10 hover:text-white hover:bg-white/5")">
                                                    <Icon Name="HeroiconName.HandThumbDown" Class="w-4 h-4 text-rose-400" IconType="HeroiconType.Solid" />
                                                    <span>Không khuyên dùng</span>
                                                </button>
                                            </div>
                                            
                                            <button type="button" @onclick="SubmitReview" disabled="@(string.IsNullOrWhiteSpace(newReviewContent) || newReviewIsPositive == null || isSubmittingReview)" class="px-6 py-2.5 min-h-[44px] rounded-lg bg-[#0078f2] hover:bg-[#0068d6] text-white text-xs font-bold uppercase tracking-wider transition-colors disabled:opacity-40 cursor-pointer flex items-center justify-center">
                                                Gửi nhận xét
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-xs text-white/75">
                                        Vui lòng <a href="/login" class="text-[#0078f2] hover:underline font-bold">đăng nhập</a> để chia sẻ đánh giá của bạn.
                                    </div>
                                }
                            </div>

                            @* Reviews List *@
                            <div class="space-y-4">
                                @if (ViewModel.Reviews != null && ViewModel.Reviews.Any())
                                {
                                    var filtered = ViewModel.Reviews.Where(r => reviewFilter == "All" || (reviewFilter == "Positive" && r.IsPositive) || (reviewFilter == "Negative" && !r.IsPositive)).ToList();
                                    @if (filtered.Any())
                                    {
                                        @foreach (var rev in filtered)
                                        {
                                            <div class="p-5 rounded-2xl bg-[#18181c] border border-white/10">
                                                <div class="flex items-center justify-between mb-3">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-8 h-8 rounded-full bg-[#0078f2]/20 border border-[#0078f2]/40 text-[#0078f2] font-black text-xs flex items-center justify-center">
                                                            @(!string.IsNullOrEmpty(rev.Username) ? rev.Username.Substring(0, 1).ToUpper() : "U")
                                                        </div>
                                                        <div>
                                                            <span class="text-xs font-bold text-white block">@rev.Username</span>
                                                            <span class="text-xs text-white/70">@rev.CreatedAt.ToString("dd/MM/yyyy")</span>
                                                        </div>
                                                    </div>
                                                    @if (rev.IsPositive)
                                                    {
                                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                                                            <Icon Name="HeroiconName.HandThumbUp" Class="w-3.5 h-3.5 text-emerald-400" IconType="HeroiconType.Solid" />
                                                            <span>Khuyên dùng</span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-500/15 text-rose-400 border border-rose-500/30">
                                                            <Icon Name="HeroiconName.HandThumbDown" Class="w-3.5 h-3.5 text-rose-400" IconType="HeroiconType.Solid" />
                                                            <span>Không khuyên dùng</span>
                                                        </span>
                                                    }
                                                </div>
                                                <p class="text-sm text-white/85 leading-relaxed">@rev.Content</p>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="py-8 text-center text-xs text-white/70 bg-[#18181c] rounded-2xl border border-white/10">
                                            Không có đánh giá nào thuộc bộ lọc này.
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="py-8 text-center text-xs text-white/70 bg-[#18181c] rounded-2xl border border-white/10">
                                        Chưa có nhận xét nào cho sản phẩm này. Hãy là người đầu tiên đánh giá!
                                    </div>
                                }
                            </div>
                        </div>

                        @* Related Products *@
                        @if (ViewModel.RelatedProducts != null && ViewModel.RelatedProducts.Any())
                        {
                            <div class="border-t border-white/10 pt-8">
                                <h2 class="text-xl sm:text-2xl font-black text-white mb-6">
                                    @(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Ứng dụng tương tự" : "Tựa game tương tự")
                                </h2>
                                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                                    @foreach (var related in ViewModel.RelatedProducts.Take(4))
                                    {
                                        <Frontend.Components.Shared.ProductCard Product="related" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == "Editions")
                {
                    @* Editions & Add-ons Content *@
                    <div id="editions-section">
                        <h2 class="text-xl sm:text-2xl font-black text-white mb-6">@(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Các gói bản quyền & Tiện ích bổ sung" : "Các phiên bản & Tiện ích bổ sung")</h2>
                        
                        <div class="space-y-4">
                            @* Standard Edition *@
                            <div class="p-5 sm:p-6 rounded-2xl bg-[#18181c] border border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:border-white/20 transition-all">
                                <div class="space-y-1">
                                    <span class="text-[11px] font-black text-[#0078f2] uppercase tracking-wider">Phiên bản chuẩn</span>
                                    <h3 class="text-lg font-bold text-white">@product.Name — Phiên Bản Tiêu Chuẩn (Standard)</h3>
                                    <p class="text-xs text-white/75">@(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Bao gồm ứng dụng gốc và toàn bộ các bản vá cập nhật mới nhất." : "Bao gồm trò chơi gốc và toàn bộ các bản vá cập nhật mới nhất.")</p>
                                </div>
                                <div class="flex items-center gap-4 sm:flex-shrink-0">
                                    <div class="text-right">
                                        @if (product.DiscountPercent is > 0 && product.DiscountPrice.HasValue)
                                        {
                                            <div class="text-xs text-white/65 line-through">@product.BasePrice.ToString("N0") ₫</div>
                                            <div class="text-base font-black text-white">@product.DiscountPrice.Value.ToString("N0") ₫</div>
                                        }
                                        else
                                        {
                                            <div class="text-base font-black text-white">@(product.BasePrice == 0 ? "Miễn phí" : product.BasePrice.ToString("N0") + " ₫")</div>
                                        }
                                    </div>
                                    <button type="button" @onclick="AddToCart" class="px-5 py-2.5 min-h-[44px] rounded-lg bg-[#202024] hover:bg-white/15 text-white text-xs font-bold uppercase tracking-wider transition-colors border border-white/15 cursor-pointer flex items-center justify-center">
                                        Thêm vào giỏ
                                    </button>
                                </div>
                            </div>

                            @* Deluxe Edition *@
                            <div class="p-5 sm:p-6 rounded-2xl bg-[#18181c] border border-[#0078f2]/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:border-[#0078f2] transition-all">
                                <div class="space-y-1">
                                    <span class="text-[11px] font-black text-amber-400 uppercase tracking-wider">Phiên bản đặc biệt</span>
                                    <h3 class="text-lg font-bold text-white">@product.Name — Phiên Bản Cao Cấp (Deluxe)</h3>
                                    <p class="text-xs text-white/75">@(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Bao gồm bản quyền đầy đủ, các tiện ích mở rộng (Plugins), tài liệu hướng dẫn và hỗ trợ kỹ thuật ưu tiên." : "Bao gồm game gốc, Season Pass mở rộng, Artbook kỹ thuật số và gói trang phục độc quyền.")</p>
                                </div>
                                <div class="flex items-center gap-4 sm:flex-shrink-0">
                                    <div class="text-right">
                                        @if (product.BasePrice == 0)
                                        {
                                            <div class="text-base font-black text-white">Miễn phí (Bản đầy đủ)</div>
                                        }
                                        else
                                        {
                                            <div class="text-xs text-white/65 line-through">@((product.BasePrice * 1.3m).ToString("N0")) ₫</div>
                                            <div class="text-base font-black text-white">@((product.BasePrice * 1.15m).ToString("N0")) ₫</div>
                                        }
                                    </div>
                                    <button type="button" @onclick="AddDeluxeToCart" class="px-5 py-2.5 min-h-[44px] rounded-lg bg-[#0078f2] hover:bg-[#0068d6] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-lg cursor-pointer flex items-center justify-center">
                                        Nâng cấp
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeTab == "Specs")
                {
                    @* System Requirements Content *@
                    var minReq = product.SystemRequirements?.FirstOrDefault(r => string.Equals(r.RequirementType, "Minimum", StringComparison.OrdinalIgnoreCase));
                    var recReq = product.SystemRequirements?.FirstOrDefault(r => string.Equals(r.RequirementType, "Recommended", StringComparison.OrdinalIgnoreCase));
                    <div id="specs-section">
                        <h2 class="text-xl sm:text-2xl font-black text-white mb-6">Yêu cầu hệ thống</h2>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-[#18181c] p-6 sm:p-8 rounded-2xl border border-white/10">
                            <div class="space-y-4 text-xs sm:text-sm">
                                <h3 class="text-xs font-black text-white/70 uppercase tracking-wider mb-2">Cấu hình tối thiểu</h3>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Hệ điều hành</span>
                                    <span class="text-white font-medium">@(minReq?.OSVersion ?? minReq?.TargetOS ?? "Windows 10 64-bit (phiên bản 1909 trở lên)")</span>
                                </div>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Bộ xử lý (CPU)</span>
                                    <span class="text-white font-medium">@(minReq?.Processor ?? "Intel Core i5-6600K / AMD Ryzen 5 1600")</span>
                                </div>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Bộ nhớ (RAM)</span>
                                    <span class="text-white font-medium">@(minReq?.Memory ?? "12 GB RAM")</span>
                                </div>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Đồ họa (GPU)</span>
                                    <span class="text-white font-medium">@(minReq?.Graphics ?? "NVIDIA GeForce GTX 1060 6GB / AMD Radeon RX 580")</span>
                                </div>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Lưu trữ</span>
                                    <span class="text-white font-medium">@(minReq?.Storage ?? "70 GB dung lượng khả dụng (khuyến nghị SSD)")</span>
                                </div>
                            </div>

                            <div class="space-y-4 text-xs sm:text-sm md:border-l md:border-white/10 md:pl-6">
                                <h3 class="text-xs font-black text-[#0078f2] uppercase tracking-wider mb-2">Cấu hình khuyến nghị</h3>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Hệ điều hành</span>
                                    <span class="text-white font-medium">@(recReq?.OSVersion ?? recReq?.TargetOS ?? "Windows 11 64-bit")</span>
                                </div>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Bộ xử lý (CPU)</span>
                                    <span class="text-white font-medium">@(recReq?.Processor ?? "Intel Core i7-10700K / AMD Ryzen 7 3700X")</span>
                                </div>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Bộ nhớ (RAM)</span>
                                    <span class="text-white font-medium">@(recReq?.Memory ?? "16 GB RAM Dual-Channel")</span>
                                </div>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Đồ họa (GPU)</span>
                                    <span class="text-white font-medium">@(recReq?.Graphics ?? "NVIDIA GeForce RTX 3070 / AMD Radeon RX 6700 XT")</span>
                                </div>
                                <div>
                                    <span class="text-white/70 block text-[11px] uppercase font-bold">Lưu trữ</span>
                                    <span class="text-white font-medium">@(recReq?.Storage ?? "70 GB SSD NVMe tốc độ cao")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>

        @* Right Column: Sticky Buy Panel & Metadata (Epic Sidebar) *@
        <aside class="egs-product-sidebar">
            
            @* Game Capsule Key Art *@
            <div class="aspect-[16/9] rounded-2xl overflow-hidden bg-[#18181c] border border-white/10 shadow-2xl">
                <img src="@authenticCapsule" alt="@product.Name" class="w-full h-full object-cover" />
            </div>

            @* Base Game / App Pill Badge *@
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded bg-[#202024] text-white/90 font-bold text-[11px] uppercase tracking-wider border border-white/10">
                    @GameMediaHelper.GetDetailedBadge(product.Name, product.Type, product.Categories)
                </span>
                <span class="text-xs text-white/70">Bản phát hành chính thức</span>
            </div>

            @* Price Display *@
            <div class="space-y-1">
                @if (product.Pricing == "Miễn phí" || product.BasePrice == 0)
                {
                    <div class="text-3xl font-black text-white">Miễn phí</div>
                }
                else if (product.DiscountPercent is > 0 && product.DiscountPrice.HasValue)
                {
                    <div class="flex items-center gap-2.5">
                        <span class="px-2.5 py-1 rounded bg-[#0078f2] text-white font-black text-xs">
                            -@FormatDiscount(product.DiscountPercent.Value)%
                        </span>
                        <span class="text-sm text-white/65 line-through font-semibold">
                            @product.BasePrice.ToString("N0") ₫
                        </span>
                    </div>
                    <div class="text-3xl font-black text-white tracking-tight">
                        @product.DiscountPrice.Value.ToString("N0") ₫
                    </div>
                    <div class="text-xs text-amber-400 font-semibold">
                        Ưu đãi kết thúc vào 23:59 ngày 31/10
                    </div>
                }
                else
                {
                    <div class="text-3xl font-black text-white tracking-tight">
                        @product.BasePrice.ToString("N0") ₫
                    </div>
                }
            </div>

            <p class="text-sm text-white/70 leading-relaxed">
                Bản quyền điện tử kích hoạt chính thức. Khả dụng tải xuống và kích hoạt tài khoản ngay sau khi thanh toán.
            </p>

            @* CTA Action Buttons (Full-Width Epic Style) *@
            <div class="space-y-3 pt-1">
                @if (product.IsOutOfStock)
                {
                    <button disabled class="w-full h-12 rounded-lg bg-red-600/30 text-white/70 font-bold uppercase tracking-wider text-xs cursor-not-allowed">
                        Hết Hàng Tạm Thời
                    </button>
                }
                else
                {
                    @* 1. BUY NOW (MUA NGAY) - Epic Primary Blue *@
                    <button type="button" @onclick="BuyNow" 
                            class="w-full h-12 rounded-lg bg-[#0078f2] hover:bg-[#0060c4] text-white text-xs font-black uppercase tracking-widest transition-all shadow-lg hover:shadow-xl hover:shadow-[#0078f2]/30 active:scale-[0.99] flex items-center justify-center cursor-pointer">
                        MUA NGAY
                    </button>

                    @* 2. ADD TO CART (THÊM VÀO GIỎ HÀNG) - Epic Secondary Dark *@
                    <button type="button" @onclick="AddToCart" 
                            class="w-full h-12 rounded-lg bg-[#202024] hover:bg-[#2a2a30] text-white text-xs font-bold uppercase tracking-wider transition-all border border-white/15 flex items-center justify-center gap-2 cursor-pointer active:scale-[0.99]">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                        <span>@(CartViewModel.Items.Any(i => i.ProductId == product.Id) ? "ĐÃ CÓ TRONG GIỎ HÀNG" : "THÊM VÀO GIỎ HÀNG")</span>
                    </button>
                }

                @* 3. ADD TO WISHLIST (THÊM VÀO DANH SÁCH YÊU THÍCH) - Full-Width Epic Style *@
                @{
                    bool isInWishlist = WishlistViewModel.Items.Any(i => i.ProductId == product.Id);
                }
                <button type="button" @onclick="ToggleWishlist" 
                        class="w-full h-12 rounded-lg @(isInWishlist ? "bg-white/15 border-white/30 text-white" : "bg-[#202024] hover:bg-[#2a2a30] text-white border-white/15") text-xs font-bold uppercase tracking-wider transition-all border flex items-center justify-center gap-2 cursor-pointer active:scale-[0.99]">
                    <svg class="w-4 h-4 @(isInWishlist ? "text-red-500 fill-current" : "text-white")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                    <span>@(isInWishlist ? "ĐÃ THÊM VÀO DANH SÁCH YÊU THÍCH" : "THÊM VÀO DANH SÁCH YÊU THÍCH")</span>
                </button>

                @* Utility Row: Share & SKU *@
                <div class="flex items-center justify-between text-xs text-white/70 pt-1 px-1">
                    <button type="button" @onclick="() => _showShareModal = true" class="hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer py-1 px-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                        <span>Chia sẻ</span>
                    </button>
                    <span class="text-white/70">Mã SKU: #@product.Id</span>
                </div>
            </div>

            @* Specifications & Attributes Table *@
            <div class="border-t border-white/10 pt-5 space-y-3 text-xs">
                <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                    <span class="text-white/70">Loại sản phẩm</span>
                    <span class="text-white font-semibold text-right">
                        @(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Ứng dụng & Phần mềm" : "Trò chơi (Game)")
                    </span>
                </div>
                <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                    <span class="text-white/70">Phân loại</span>
                    <span class="text-white font-semibold text-right">@GameMediaHelper.GetDetailedBadge(product.Name, product.Type, product.Categories)</span>
                </div>
                <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                    <span class="text-white/70">Loại hoàn tiền</span>
                    <span class="text-white font-semibold text-right">Hoàn tiền trong 48 giờ</span>
                </div>
                <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                    <span class="text-white/70">Nhà phát triển</span>
                    <span class="text-white font-semibold text-right">@product.DeveloperName</span>
                </div>
                <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                    <span class="text-white/70">Nhà phát hành</span>
                    <span class="text-white font-semibold text-right">@product.DeveloperName</span>
                </div>
                <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                    <span class="text-white/70">Ngày phát hành</span>
                    <span class="text-white font-semibold text-right">@product.ReleaseDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                    <span class="text-white/70">Nền tảng</span>
                    <span class="text-white font-semibold text-right flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801"/></svg>
                        <span>Windows, macOS</span>
                    </span>
                </div>
            </div>

            @* Age Rating / Certification Banner *@
            <div class="p-3.5 rounded-xl bg-[#18181c] border border-white/10 flex items-center justify-between text-xs text-white/80">
                @if (IsAllAgesProduct(product))
                {
                    <div class="flex items-center gap-3">
                        <span class="px-2 py-1 rounded bg-[#202024] border border-emerald-500/30 text-emerald-400 font-black text-xs uppercase">✓ E</span>
                        <div>
                            <span class="font-bold block text-white">@(GameMediaHelper.IsApp(product.Name, product.Type, product.Categories) ? "Bản quyền phần mềm chính hãng" : "Nội dung lành mạnh")</span>
                            <span class="text-[11px] text-white/70">Phù hợp mọi lứa tuổi • Bản quyền chính hãng</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-3">
                        <span class="px-2 py-1 rounded bg-[#202024] border border-white/20 text-white font-black text-xs uppercase">18+</span>
                        <div>
                            <span class="font-bold block text-white">Nội dung người lớn</span>
                            <span class="text-[11px] text-white/70">Bạo lực dữ dội, máu me</span>
                        </div>
                    </div>
                    <button type="button" @onclick="() => _showAgeGateModal = true" class="text-xs text-[#0078f2] hover:underline font-bold cursor-pointer">
                        Chi tiết
                    </button>
                }
            </div>

        </aside>

    </div>
}

    </div>
</div>

@* Added to Cart Flyout Modal *@
@if (_showAddedToCartModal && ViewModel.Product != null)
{
    var p = ViewModel.Product;
    <div class="egs-modal-backdrop" @onclick="() => _showAddedToCartModal = false" role="dialog" aria-modal="true">
        <div class="egs-modal-card max-w-md p-6" @onclick:stopPropagation="true">
            <div class="flex items-center gap-2 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-3">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Đã thêm vào giỏ hàng thành công</span>
            </div>

            <div class="flex items-center gap-3 p-3 bg-[#202024] rounded-xl border border-white/10 mb-5">
                <img src="@GameMediaHelper.GetCover(p.Name, p.ImageUrl, p.Type, p.Categories)" alt="@p.Name" class="w-12 h-16 rounded-lg object-cover" />
                <div class="flex-1 min-w-0">
                    <h4 class="text-white font-bold text-sm truncate">@p.Name</h4>
                    <span class="text-xs text-white/70 block">Phiên bản Bản quyền NexusKeys</span>
                    <span class="text-xs font-bold text-white mt-1 block">@(p.DiscountPrice is > 0 ? p.DiscountPrice.Value.ToString("N0") + " đ" : p.BasePrice.ToString("N0") + " đ")</span>
                </div>
            </div>

            <div class="space-y-2">
                <a href="/cart" class="w-full py-3 min-h-[44px] rounded-xl bg-[#0078f2] hover:bg-[#0068d6] text-white text-xs font-black uppercase tracking-wider text-center flex items-center justify-center transition-colors shadow-lg">
                    Xem giỏ hàng & Thanh toán
                </a>
                <button type="button" @onclick="() => _showAddedToCartModal = false" class="w-full py-2.5 min-h-[44px] rounded-xl bg-transparent hover:bg-white/10 text-white/75 hover:text-white text-xs font-bold uppercase tracking-wider transition-colors flex items-center justify-center cursor-pointer">
                    Tiếp tục mua sắm
                </button>
            </div>
        </div>
    </div>
}

@* Share Game Modal *@
