                <button type="button" @onclick="() => _showLightboxModal = false" class="w-9 h-9 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg hover:bg-white/10 text-white/70 hover:text-white cursor-pointer" aria-label="Đóng">✕</button>
