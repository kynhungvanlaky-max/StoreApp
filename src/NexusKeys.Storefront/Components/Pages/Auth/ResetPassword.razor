@page "/reset-password"
@inject Frontend.ViewModels.AuthViewModel AuthViewModel
@inject NavigationManager NavigationManager
@using Frontend.Models.Auth

<PageTitle>Đặt Lại Mật Khẩu — NexusKeys</PageTitle>

<div class="egs-auth-container">
    <div class="egs-auth-card">
        @* Top Back Link *@
        <div class="mb-4">
            <a href="/login" class="inline-flex items-center gap-1.5 text-xs text-white/60 hover:text-white transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
                </svg>
                <span>Quay lại Đăng nhập</span>
            </a>
        </div>

        @* NexusKeys Brand Badge *@
        <div class="flex justify-center mb-4">
            <a href="/" title="NexusKeys Game Store" class="inline-flex items-center gap-2.5 transition-transform hover:scale-105">
                <div class="w-10 h-10 rounded-xl bg-[#0078F2]/10 border border-[#0078F2]/30 flex items-center justify-center text-[#0078F2] shadow-lg shadow-[#0078F2]/10">
                    <Icon Name="HeroiconName.PuzzlePiece" Class="w-6 h-6 text-[#0078F2]" IconType="HeroiconType.Solid" />
                </div>
                <span class="text-xl font-black text-white tracking-tighter">NEXUS<span class="text-[#0078F2]">KEYS</span></span>
            </a>
        </div>

        <h1 class="text-xl sm:text-2xl font-bold text-center text-white tracking-tight mb-1.5">
            Đặt Lại Mật Khẩu
        </h1>
        <p class="text-xs text-white/60 text-center mb-6">
            Vui lòng nhập mật khẩu mới an toàn cho tài khoản của bạn.
        </p>

        @if (string.IsNullOrEmpty(Request.Token))
        {
            <div class="egs-auth-error mb-4">
                <svg class="w-5 h-5 shrink-0 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span class="text-xs font-medium">Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn.</span>
            </div>
            <div class="text-center mt-4">
                <a href="/login" class="text-xs text-[#0078f2] hover:underline font-bold">Quay lại Đăng nhập</a>
            </div>
        }
        else if (IsSuccess)
        {
            <div class="p-5 bg-emerald-500/15 border border-emerald-500/30 rounded-xl flex flex-col items-center gap-3 text-emerald-300 text-center mb-6">
                <svg class="w-10 h-10 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-xs leading-relaxed">@SuccessMessage</span>
                <a href="/login" class="egs-auth-btn-primary mt-2">Đến Trang Đăng Nhập</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="egs-auth-error mb-4">
                    <svg class="w-5 h-5 shrink-0 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <span class="text-xs font-medium">@ErrorMessage</span>
                </div>
            }

            <form class="space-y-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <div>
                    <label for="reset-password" class="block text-xs font-semibold text-white/70 mb-1.5">Mật khẩu mới</label>
                    <input id="reset-password" type="password" @bind="Request.NewPassword" @bind:event="oninput" required minlength="6" autocomplete="new-password" class="egs-auth-input" placeholder="Tối thiểu 6 ký tự">
                </div>

                <div>
                    <label for="reset-confirm-password" class="block text-xs font-semibold text-white/70 mb-1.5">Xác nhận mật khẩu mới</label>
                    <input id="reset-confirm-password" type="password" @bind="Request.ConfirmPassword" @bind:event="oninput" required minlength="6" autocomplete="new-password" class="egs-auth-input" placeholder="Nhập lại mật khẩu mới">
                </div>

                <button type="submit" class="egs-auth-btn-primary mt-4" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <div class="w-4 h-4 rounded-full border-2 border-white border-t-transparent animate-spin"></div>
                    }
                    Lưu Mật Khẩu Mới
                </button>
            </form>
        }

        <div class="mt-6 text-center">
            <a href="/policies" class="text-xs text-white/60 hover:text-white transition-colors">Điều khoản dịch vụ & Chính sách bảo mật</a>
        </div>
    </div>
</div>

@code {
    private ResetPasswordRequest Request = new();
    private bool IsLoading = false;
    private bool IsSuccess = false;
    private string? ErrorMessage;
    private string? SuccessMessage;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Token))
        {
            Request.Token = Token;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(Request.NewPassword) || string.IsNullOrWhiteSpace(Request.ConfirmPassword))
        {
            ErrorMessage = "Vui lòng nhập đầy đủ mật khẩu.";
            return;
        }

        if (Request.NewPassword != Request.ConfirmPassword)
        {
            ErrorMessage = "Mật khẩu xác nhận không khớp.";
            return;
        }

        if (Request.NewPassword.Length < 6)
        {
            ErrorMessage = "Mật khẩu phải có ít nhất 6 ký tự.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            var response = await AuthViewModel.ResetPasswordAsync(Request);
            if (response.IsSuccessStatusCode)
            {
                IsSuccess = true;
                SuccessMessage = "Mật khẩu của bạn đã được thay đổi thành công. Bây giờ bạn có thể đăng nhập bằng mật khẩu mới.";
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                ErrorMessage = errorResult.TryGetProperty("message", out var msg) ? msg.GetString() : "Đã có lỗi xảy ra. Token không hợp lệ hoặc đã hết hạn.";
            }
        }
        catch (Exception)
        {
            ErrorMessage = "Lỗi kết nối tới máy chủ.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}
