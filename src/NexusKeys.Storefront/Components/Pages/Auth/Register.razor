@page "/register"
@inject Frontend.ViewModels.AuthViewModel AuthViewModel
@inject Frontend.Services.AuthService AuthService
@inject NavigationManager NavigationManager
@using Frontend.Models.Auth

<PageTitle>Đăng Ký Tài Khoản — NexusKeys</PageTitle>

<div class="egs-auth-container">
    <div class="egs-auth-card">
        @* Top Back Link *@
        <div class="mb-4">
            <a href="/login" class="inline-flex items-center gap-1.5 text-xs text-white/60 hover:text-white transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
                </svg>
                <span>Quay lại</span>
            </a>
        </div>

        @* NexusKeys Brand Badge *@
        <div class="flex justify-center mb-4">
            <a href="/" title="NexusKeys Game Store" class="inline-flex items-center gap-2.5 transition-transform hover:scale-105">
                <div class="w-10 h-10 rounded-xl bg-[#0078F2]/10 border border-[#0078F2]/30 flex items-center justify-center text-[#0078F2] shadow-lg shadow-[#0078F2]/10">
                    <Icon Name="HeroiconName.PuzzlePiece" Class="w-6 h-6 text-[#0078F2]" IconType="HeroiconType.Solid" />
                </div>
                <span class="text-xl font-black text-white tracking-tighter">NEXUS<span class="text-[#0078F2]">KEYS</span></span>
            </a>
        </div>

        <h1 class="text-xl sm:text-2xl font-bold text-center text-white tracking-tight mb-1.5">
            Đăng ký tài khoản NexusKeys
        </h1>
        <p class="text-xs text-white/60 text-center mb-6">
            Đăng ký để mua game bản quyền, nhận ưu đãi độc quyền và quản lý kho game cá nhân.
        </p>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="egs-auth-error">
                <svg class="w-5 h-5 shrink-0 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span class="text-xs font-medium">@ErrorMessage</span>
            </div>
        }

        <form @onsubmit="HandleRegister" @onsubmit:preventDefault="true" class="space-y-4">
            <div>
                <label for="register-username" class="block text-xs font-semibold text-white/70 mb-1.5">Tên hiển thị</label>
                <input id="register-username" 
                       type="text" 
                       @bind="RegisterRequest.Username" 
                       @bind:event="oninput" 
                       required 
                       autocomplete="username" 
                       class="egs-auth-input" 
                       placeholder="Ví dụ: MasterChief99" />
            </div>

            <div>
                <label for="register-email" class="block text-xs font-semibold text-white/70 mb-1.5">Địa chỉ email</label>
                <input id="register-email" 
                       type="email" 
                       @bind="RegisterRequest.Email" 
                       @bind:event="oninput" 
                       required 
                       autocomplete="email" 
                       class="egs-auth-input" 
                       placeholder="name@example.com" />
            </div>

            <div>
                <label for="register-password" class="block text-xs font-semibold text-white/70 mb-1.5">Mật khẩu</label>
                <div class="relative egs-auth-password-wrapper">
                    <input id="register-password" 
                           type="@(_showPassword ? "text" : "password")" 
                           @bind="RegisterRequest.Password" 
                           @bind:event="oninput" 
                           required 
                           minlength="6" 
                           autocomplete="new-password" 
                           class="egs-auth-input pr-10" 
                           placeholder="Tối thiểu 6 ký tự" />
                    <button type="button" 
                            @onclick="TogglePassword" 
                            class="absolute right-3 top-1/2 -translate-y-1/2 egs-password-toggle text-white/60 hover:text-white transition-colors p-1" 
                            aria-label="@(_showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                        @if (_showPassword)
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        }
                    </button>
                </div>
            </div>

            <div>
                <label for="register-secret" class="block text-xs font-semibold text-white/70 mb-1.5">Mã giới thiệu hoặc Mã ưu đãi (Không bắt buộc)</label>
                <input id="register-secret" 
                       type="text" 
                       @bind="RegisterRequest.SecretCode" 
                       @bind:event="oninput" 
                       autocomplete="off" 
                       class="egs-auth-input" 
                       placeholder="Nhập mã ưu đãi hoặc mã đối tác" />
            </div>

            <div class="flex items-start gap-2.5 pt-1 text-xs text-white/60">
                <input id="terms-agree" 
                       type="checkbox" 
                       required 
                       class="mt-0.5 rounded border-white/20 bg-[#121212] text-[#0078f2] focus:ring-[#0078f2]" />
                <label for="terms-agree" class="leading-relaxed select-none">
                    Tôi đã đọc và đồng ý với <a href="/policies" class="text-white underline hover:text-[#0078f2]">Điều khoản Dịch vụ</a> và <a href="/policies" class="text-white underline hover:text-[#0078f2]">Chính sách Bảo mật</a> của NexusKeys.
                </label>
            </div>

            <button type="submit" class="egs-auth-btn-primary mt-4" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <div class="w-4 h-4 rounded-full border-2 border-white border-t-transparent animate-spin"></div>
                }
                Tiếp tục
            </button>
        </form>

        <div class="text-center text-xs text-white/60 mt-6">
            Đã có tài khoản? 
            <a href="/login" class="text-[#0078f2] hover:underline font-semibold ml-1">Đăng nhập ngay</a>
        </div>

        <div class="mt-6 text-center">
            <a href="/policies" class="text-xs text-white/60 hover:text-white transition-colors">Chính sách bảo mật</a>
        </div>
    </div>
</div>

@code {
    private RegisterRequest RegisterRequest = new();
    private bool IsLoading = false;
    private bool _showPassword = false;
    private string? ErrorMessage;

    protected override void OnInitialized()
    {
        if (AuthViewModel.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private void TogglePassword()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(RegisterRequest.Username) || 
            string.IsNullOrWhiteSpace(RegisterRequest.Email) || 
            string.IsNullOrWhiteSpace(RegisterRequest.Password))
        {
            ErrorMessage = "Vui lòng điền đầy đủ các thông tin bắt buộc.";
            return;
        }
        if (RegisterRequest.Password.Length < 6)
        {
            ErrorMessage = "Mật khẩu phải chứa ít nhất 6 ký tự.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        
        var success = await AuthService.RegisterAsync(RegisterRequest);
        if (success)
        {
            // Auto login upon successful registration
            var loginRequest = new LoginRequest { Email = RegisterRequest.Email, Password = RegisterRequest.Password };
            await AuthViewModel.LoginAsync(loginRequest);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Đăng ký thất bại. Địa chỉ email này có thể đã được sử dụng.";
        }
        
        IsLoading = false;
    }
}
