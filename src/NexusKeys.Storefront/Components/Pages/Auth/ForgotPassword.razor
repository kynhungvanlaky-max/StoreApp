@page "/forgot-password"
@inject Frontend.ViewModels.AuthViewModel AuthViewModel
@inject NavigationManager NavigationManager
@using Frontend.Models.Auth

<PageTitle>Quên Mật Khẩu — NexusKeys</PageTitle>

<div class="egs-auth-container">
    <div class="egs-auth-card">
        @* Top Back Link *@
        <div class="mb-4">
            <a href="/login" class="inline-flex items-center gap-1.5 text-xs text-white/60 hover:text-white transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
                </svg>
                <span>Quay lại đăng nhập</span>
            </a>
        </div>

        @* NexusKeys Brand Badge *@
        <div class="flex justify-center mb-4">
            <a href="/" title="NexusKeys Game Store" class="inline-flex items-center gap-2.5 transition-transform hover:scale-105">
                <div class="w-10 h-10 rounded-xl bg-[#0078F2]/10 border border-[#0078F2]/30 flex items-center justify-center text-[#0078F2] shadow-lg shadow-[#0078F2]/10">
                    <Icon Name="HeroiconName.PuzzlePiece" Class="w-6 h-6 text-[#0078F2]" IconType="HeroiconType.Solid" />
                </div>
                <span class="text-xl font-black text-white tracking-tighter">NEXUS<span class="text-[#0078F2]">KEYS</span></span>
            </a>
        </div>

        <h1 class="text-xl sm:text-2xl font-bold text-center text-white tracking-tight mb-1.5">
            Quên mật khẩu?
        </h1>
        <p class="text-xs text-white/60 text-center mb-6">
            Nhập địa chỉ email liên kết với tài khoản NexusKeys của bạn và chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu.
        </p>

        @if (IsSuccess)
        {
            <div class="p-4 bg-emerald-500/15 border border-emerald-500/30 rounded-lg flex flex-col items-center gap-3 text-emerald-300 text-center mb-6">
                <svg class="w-8 h-8 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-xs leading-relaxed">@SuccessMessage</span>
                <a href="/login" class="egs-auth-btn-primary mt-2">Quay lại Đăng nhập</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="egs-auth-error">
                    <svg class="w-5 h-5 shrink-0 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <span class="text-xs font-medium">@ErrorMessage</span>
                </div>
            }

            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="space-y-4">
                <div>
                    <label for="forgot-email" class="block text-xs font-semibold text-white/70 mb-1.5">Địa chỉ email</label>
                    <input id="forgot-email" 
                           type="email" 
                           @bind="Request.Email" 
                           @bind:event="oninput" 
                           required 
                           autocomplete="email" 
                           class="egs-auth-input" 
                           placeholder="name@example.com" />
                </div>

                <button type="submit" class="egs-auth-btn-primary mt-4" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <div class="w-4 h-4 rounded-full border-2 border-white border-t-transparent animate-spin"></div>
                    }
                    Gửi hướng dẫn
                </button>
            </form>

            <div class="text-center text-xs text-white/60 mt-6">
                Đã nhớ mật khẩu? 
                <a href="/login" class="text-[#0078f2] hover:underline font-semibold ml-1">Đăng nhập ngay</a>
            </div>
        }

        <div class="mt-6 text-center">
            <a href="/policies" class="text-xs text-white/60 hover:text-white transition-colors">Chính sách bảo mật</a>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordRequest Request = new();
    private bool IsLoading = false;
    private bool IsSuccess = false;
    private string? ErrorMessage;
    private string? SuccessMessage;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(Request.Email))
        {
            ErrorMessage = "Vui lòng nhập địa chỉ email của bạn.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            var response = await AuthViewModel.ForgotPasswordAsync(Request);
            if (response.IsSuccessStatusCode)
            {
                IsSuccess = true;
                SuccessMessage = "Nếu địa chỉ email này tồn tại trong hệ thống, chúng tôi đã gửi liên kết đặt lại mật khẩu tới hộp thư của bạn.";
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                ErrorMessage = errorResult.TryGetProperty("message", out var msg) ? msg.GetString() : "Không thể xử lý yêu cầu đặt lại mật khẩu lúc này.";
            }
        }
        catch (Exception)
        {
            ErrorMessage = "Lỗi kết nối mạng. Vui lòng kiểm tra lại đường truyền và thử lại.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
