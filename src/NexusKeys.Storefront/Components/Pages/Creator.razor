@page "/creator"
@page "/support-a-creator"
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Chương Trình Nhà Sáng Tạo — NexusKeys Creator</PageTitle>

<div class="egs-wrap">
    <div class="egs-content">

        @* HERO BANNER *@
        <section class="relative rounded-2xl overflow-hidden bg-gradient-to-r from-[#181820] via-[#241a2e] to-[#121216] border border-white/10 p-8 md:p-12 mb-12 shadow-2xl">
            <div class="flex flex-col lg:flex-row items-center justify-between gap-8 relative z-10">
                <div class="max-w-xl">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0078f2]/15 border border-[#0078f2]/30 text-[#40a9ff] text-xs font-bold uppercase tracking-wider mb-6">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                        Tiếp Thị & Doanh Thu Sáng Tạo
                    </div>

                    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-4">
                        Chương Trình NexusKeys Creator
                    </h1>

                    <p class="text-white/70 text-base sm:text-lg mb-8 leading-relaxed">
                        Kiếm thêm thu nhập bằng việc sáng tạo nội dung cho các tựa game bạn yêu thích. Nhận tối thiểu từ 5% trên mỗi giao dịch khi cộng đồng của bạn mua game trên NexusKeys Store bằng mã Creator Tag của bạn.
                    </p>

                    <div class="flex items-center gap-4">
                        <button type="button" @onclick="ToggleApply" class="egs-auth-btn-primary inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-[#0078f2] hover:bg-[#006bd8] text-white font-bold text-sm tracking-wide shadow-lg shadow-[#0078f2]/30 transition-all cursor-pointer">
                            <span>Đăng Ký Mã Creator Tag</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </button>
                    </div>
                </div>

                @* Visual Graphic *@
                <div class="shrink-0 flex flex-col items-center justify-center w-56 h-56 rounded-3xl bg-[#202028]/90 border border-white/15 backdrop-blur-md shadow-2xl p-6 text-center egs-card-hover">
                    <span class="text-5xl font-black text-[#40a9ff] tracking-tight mb-1">5%+</span>
                    <span class="text-xs font-bold text-white uppercase tracking-widest mb-3">Hoa Hồng Doanh Thu</span>
                    <span class="text-xs text-white/60">Tối thiểu 5% giá trị trên mọi đơn hàng phát sinh từ mã của bạn</span>
                </div>
            </div>
        </section>

        @* SIMULATOR / CODE CHECKER *@
        <section class="rounded-2xl bg-[#18181c] border border-white/10 p-8 mb-14">
            <h2 class="text-xl font-bold text-white mb-2">Ước Tính Thu Nhập Creator Hàng Tháng</h2>
            <p class="text-sm text-white/50 mb-6">Xem thu nhập tiềm năng dựa trên quy mô cộng đồng ủng hộ của bạn</p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="p-5 rounded-xl bg-[#202024] border border-white/10">
                    <span class="text-xs text-white/50 uppercase font-bold tracking-wider block mb-2">Cộng đồng</span>
                    <span class="text-2xl font-black text-white">500 Người chơi</span>
                    <span class="text-xs text-white/40 block mt-1">Chi tiêu trung bình: ₫250k/tháng</span>
                    <div class="mt-4 pt-3 border-t border-white/10">
                        <span class="text-xs text-white/60">Thu nhập ước tính:</span>
                        <span class="text-base font-bold text-[#40a9ff] block">~ ₫6.250.000 / tháng</span>
                    </div>
                </div>

                <div class="p-5 rounded-xl bg-[#202024] border border-[#0078f2]/40 shadow-lg shadow-[#0078f2]/10 relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-[#0078f2] text-white text-xs font-bold px-2.5 py-0.5 rounded-bl">Phổ biến</div>
                    <span class="text-xs text-white/50 uppercase font-bold tracking-wider block mb-2">Cộng đồng</span>
                    <span class="text-2xl font-black text-white">2.500 Người chơi</span>
                    <span class="text-xs text-white/40 block mt-1">Chi tiêu trung bình: ₫250k/tháng</span>
                    <div class="mt-4 pt-3 border-t border-white/10">
                        <span class="text-xs text-white/60">Thu nhập ước tính:</span>
                        <span class="text-base font-bold text-[#0078f2] block">~ ₫31.250.000 / tháng</span>
                    </div>
                </div>

                <div class="p-5 rounded-xl bg-[#202024] border border-white/10">
                    <span class="text-xs text-white/50 uppercase font-bold tracking-wider block mb-2">Cộng đồng</span>
                    <span class="text-2xl font-black text-white">10.000+ Người chơi</span>
                    <span class="text-xs text-white/40 block mt-1">Chi tiêu trung bình: ₫250k/tháng</span>
                    <div class="mt-4 pt-3 border-t border-white/10">
                        <span class="text-xs text-white/60">Thu nhập ước tính:</span>
                        <span class="text-base font-bold text-emerald-400 block">~ ₫125.000.000+ / tháng</span>
                    </div>
                </div>
            </div>
        </section>

        @* ELIGIBILITY & HOW IT WORKS *@
        <section class="mb-14">
            <h2 class="text-xl font-bold text-white mb-6">Tiêu Chuẩn Tham Gia Chương Trình</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="egs-card-hover egs-shimmer-card rounded-2xl bg-[#1c1c20] border border-white/10 p-6">
                    <div class="w-10 h-10 rounded-lg bg-[#0078f2]/15 text-[#0078f2] flex items-center justify-center font-bold mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-white mb-2">1.000+ Người Theo Dõi</h3>
                    <p class="text-sm text-white/60 leading-relaxed">
                        Sở hữu tối thiểu 1.000 người theo dõi trên YouTube, Twitch, TikTok, Facebook Gaming hoặc các kênh mạng xã hội chính.
                    </p>
                </div>

                <div class="egs-card-hover egs-shimmer-card rounded-2xl bg-[#1c1c20] border border-white/10 p-6">
                    <div class="w-10 h-10 rounded-lg bg-emerald-500/15 text-emerald-400 flex items-center justify-center font-bold mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-white mb-2">Tài Khoản Nhận Hoa Hồng</h3>
                    <p class="text-sm text-white/60 leading-relaxed">
                        Có khả năng nhận thanh toán chuyển khoản ngân hàng nội địa hoặc ví điện tử định kỳ hàng tháng.
                    </p>
                </div>

                <div class="egs-card-hover egs-shimmer-card rounded-2xl bg-[#1c1c20] border border-white/10 p-6">
                    <div class="w-10 h-10 rounded-lg bg-purple-500/15 text-purple-400 flex items-center justify-center font-bold mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-white mb-2">Quy Chuẩn Cộng Đồng</h3>
                    <p class="text-sm text-white/60 leading-relaxed">
                        Tuân thủ tiêu chuẩn cộng đồng NexusKeys, chia sẻ nội dung lành mạnh và minh bạch thông tin mã giới thiệu tới người xem.
                    </p>
                </div>
            </div>
        </section>

        @if (_showApplication)
        {
            <div class="p-6 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-sm font-semibold mb-12 animate-pulse">
                ✓ Cổng đăng ký đang mở! Vui lòng đăng nhập tài khoản NexusKeys của bạn để kết nối kênh truyền thông và nhận mã Creator Tag.
            </div>
        }
    </div>
</div>

@code {

    private bool _showApplication = false;

    private void ToggleApply()
    {
        _showApplication = true;
    }
}
