@page "/cart"
@inject Frontend.ViewModels.CartViewModel VM
@inject Frontend.Services.ToastService ToastService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Giỏ Hàng — NexusKeys</PageTitle>
<h1 class="sr-only">Giỏ hàng</h1>

<div class="egs-wrap">
    <div class="egs-content">

        @* Checkout Stepper: Step 1 Active *@
        <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-[#18181c] border border-white/10 shadow-lg">
            <div class="flex items-center justify-between max-w-3xl mx-auto">
                <!-- Step 1: Active -->
                <div class="flex items-center gap-2.5 sm:gap-3">
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#0078f2] text-white flex items-center justify-center font-black text-xs sm:text-sm shadow-md shadow-[#0078f2]/40 ring-4 ring-[#0078f2]/20">
                        1
                    </div>
                    <div>
                        <span class="text-xs uppercase font-bold text-[#0078f2] block tracking-wider">Bước 1</span>
                        <span class="text-xs sm:text-sm font-bold text-white whitespace-nowrap">Giỏ Hàng</span>
                    </div>
                </div>

                <!-- Connector Line 1-2 -->
                <div class="flex-1 h-[2px] mx-3 sm:mx-6 bg-white/10 rounded-full"></div>

                <!-- Step 2: Upcoming -->
                <div class="flex items-center gap-2.5 sm:gap-3 opacity-50">
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#202024] text-white/50 border border-white/15 flex items-center justify-center font-bold text-xs sm:text-sm">
                        2
                    </div>
                    <div>
                        <span class="text-xs uppercase font-bold text-white/40 block tracking-wider">Bước 2</span>
                        <span class="text-xs sm:text-sm font-semibold text-white/60 whitespace-nowrap">Thanh Toán</span>
                    </div>
                </div>

                <!-- Connector Line 2-3 -->
                <div class="flex-1 h-[2px] mx-3 sm:mx-6 bg-white/10 rounded-full"></div>

                <!-- Step 3: Upcoming -->
                <div class="flex items-center gap-2.5 sm:gap-3 opacity-50">
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#202024] text-white/50 border border-white/15 flex items-center justify-center font-bold text-xs sm:text-sm">
                        3
                    </div>
                    <div>
                        <span class="text-xs uppercase font-bold text-white/40 block tracking-wider">Bước 3</span>
                        <span class="text-xs sm:text-sm font-semibold text-white/60 whitespace-nowrap">Hoàn Tất & Nhận Key</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-6 pb-4 border-b border-white/10 flex items-center justify-between">
            <h1 class="text-2xl font-black text-white tracking-tight">Giỏ Hàng Của Tôi</h1>
            <span class="text-xs text-white/50">(@VM.Items.Count sản phẩm trong kho)</span>
        </div>

    @if (VM.Items.Count == 0)
    {
        <div class="bg-[#202024] rounded-2xl border border-white/10 p-12 text-center shadow-xl">
            <h2 class="text-2xl font-bold text-white mb-2">Giỏ hàng trống</h2>
            <p class="text-gray-400 mb-6">Bạn chưa thêm sản phẩm nào vào giỏ hàng. Khám phá kho trò chơi và ứng dụng bản quyền khổng lồ của chúng tôi ngay!</p>
            <a href="/products" class="egs-auth-btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#0078f2] text-white font-bold text-sm">
                <Icon Name="HeroiconName.BuildingStorefront" Class="w-5 h-5 mr-2" /> Đến Cửa Hàng
            </a>
        </div>
    }
    else
    {
        <div class="flex flex-col lg:flex-row gap-8">
            @* Cart Items List *@
            <div class="flex-1 space-y-4">
                @foreach (var item in VM.Items)
                {
                    <div @onclick="() => VM.ToggleSelectionAsync(item.ProductId)" 
                         class="egs-card-hover cursor-pointer bg-[#202024] rounded-xl border p-4 flex gap-4 items-center group transition-all duration-300
                                @(item.IsSelected ? "border-[#0078F2] shadow-lg shadow-[#0078F2]/20" : "border-white/10 opacity-70 hover:opacity-100 hover:border-white/30")">
                        
                        <div class="flex-shrink-0">
                            @if (item.IsSelected)
                            {
                                <Icon Name="HeroiconName.CheckCircle" Class="w-6 h-6 text-[#0078f2]" IconType="HeroiconType.Solid" />
                            }
                            else
                            {
                                <div class="w-6 h-6 rounded-full border-2 border-white/30 group-hover:border-[#0078f2] transition-colors"></div>
                            }
                        </div>

                        <div class="w-32 aspect-video rounded-lg overflow-hidden bg-[#18181c] flex-shrink-0">
                            <ProductImage Src="@item.ImageUrl" Alt="@item.Name" ImageClass="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-white text-base line-clamp-1"><a href="/products/@item.ProductId" @onclick:stopPropagation="true" class="hover:text-[#0078f2] transition-colors">@item.Name</a></h3>
                            <div class="text-[#0078f2] font-black text-sm mt-1">@item.Price.ToString("N0") đ</div>
                        </div>
                        <button @onclick="@(() => VM.RemoveFromCartAsync(item.ProductId))" @onclick:stopPropagation="true" class="w-9 h-9 rounded-lg flex items-center justify-center text-white/40 hover:text-red-400 hover:bg-red-500/10 transition-colors" title="Xóa khỏi giỏ">
                            <Icon Name="HeroiconName.Trash" Class="w-5 h-5" />
                        </button>
                    </div>
                }
                
                <div class="flex justify-between items-center mt-6 p-4 bg-[#18181c] rounded-xl border border-white/10">
                    <button type="button" @onclick="() => _showClearCartModal = true" class="px-4 py-2 rounded-lg text-red-400 hover:text-red-300 hover:bg-red-500/10 text-xs font-bold uppercase tracking-wider transition-colors">Xóa toàn bộ</button>
                    <a href="/products" class="px-4 py-2 rounded-lg text-[#0078f2] hover:text-[#4da6ff] hover:bg-[#0078f2]/10 text-xs font-bold uppercase tracking-wider transition-colors">Tiếp tục mua sắm</a>
                </div>
            </div>
            
            @* Order Summary *@
            <div class="w-full lg:w-96 flex-shrink-0">
                <div class="sticky top-[104px] bg-[#18181c] rounded-2xl border border-white/10 shadow-xl overflow-hidden">
                    <div class="p-5 sm:p-6 border-b border-white/10 bg-[#202024]/60">
                        <h2 class="text-lg font-bold text-white tracking-tight">Tóm Tắt Đơn Hàng</h2>
                    </div>
                    
                    <div class="p-5 sm:p-6 space-y-4">
                        <div class="flex justify-between text-white/60 text-sm">
                            <span>Tạm tính (@VM.SelectedTotalItems sản phẩm)</span>
                            <span class="text-white font-medium">@VM.SelectedTotalAmount.ToString("N0") đ</span>
                        </div>
                        <div class="flex justify-between text-white/60 text-sm">
                            <span>Giảm giá</span>
                            <span class="text-white font-medium">0 đ</span>
                        </div>

                        @* Creator Tag Section *@
                        <div class="p-3.5 rounded-xl bg-[#202024] border border-white/10">
                            <div class="flex items-center justify-between text-xs text-white/70 mb-1">
                                <span class="font-semibold flex items-center gap-1.5">
                                    <Icon Name="HeroiconName.Ticket" Class="w-4 h-4 text-[#0078f2]" />
                                    Creator Tag / Mã Coupon
                                </span>
                                <button type="button" @onclick="() => _showCreatorModal = true" class="text-[#0078f2] hover:underline font-bold">
                                    @(!string.IsNullOrEmpty(_appliedCreatorTag) ? "Thay đổi" : "+ Thêm mã")
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(_appliedCreatorTag))
                            {
                                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-[#0078f2]/10 border border-[#0078f2]/30 text-xs mt-1.5">
                                    <span class="font-mono font-bold text-[#0078f2]">@_appliedCreatorTag</span>
                                    <span class="text-emerald-400 font-semibold text-[11px]">Đã áp dụng ✓</span>
                                </div>
                            }
                        </div>

                        <div class="h-[1px] bg-white/10 my-2"></div>
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-white">Tổng cộng</span>
                            <div class="text-right">
                                <span class="text-3xl font-black text-[#0078f2]">@VM.SelectedTotalAmount.ToString("N0") đ</span>
                                <div class="text-xs text-white/70 mt-1">Đã bao gồm VAT (nếu có)</div>
                            </div>
                        </div>
                        
                        @if (VM.SelectedTotalItems == 0)
                        {
                            <button type="button" disabled class="w-full h-12 rounded-xl bg-[#202024] text-white/40 border border-white/10 text-xs font-bold uppercase tracking-wider cursor-not-allowed flex items-center justify-center gap-2 mt-4">
                                <span>Vui lòng chọn sản phẩm để thanh toán</span>
                            </button>
                        }
                        else
                        {
                            <a href="/checkout" class="w-full h-12 rounded-xl bg-[#0078f2] hover:bg-[#0060c2] active:scale-[0.98] text-white text-xs sm:text-sm font-black uppercase tracking-wider transition-all shadow-lg shadow-[#0078f2]/30 flex items-center justify-center gap-2 cursor-pointer mt-4">
                                <span>Thanh Toán Ngay (@VM.SelectedTotalItems)</span>
                                <Icon Name="HeroiconName.ArrowRight" Class="w-5 h-5 ml-1" />
                            </a>
                        }
                        
                        <div class="flex items-center justify-center gap-2 mt-4 opacity-50">
                            <Icon Name="HeroiconName.LockClosed" Class="w-5 h-5" />
                            <span class="text-xs">Thanh toán an toàn & bảo mật</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
</div>

@* Confirm Clear Cart Modal *@
@if (_showClearCartModal)
{
    <div class="egs-modal-backdrop" @onclick="() => _showClearCartModal = false" role="dialog" aria-modal="true" aria-labelledby="clear-cart-title">
        <div class="egs-modal-card max-w-md p-6 sm:p-7" @onclick:stopPropagation="true">
            <button type="button" 
                    class="absolute top-4 right-4 w-8 h-8 rounded-lg text-white/50 hover:text-white hover:bg-white/10 flex items-center justify-center transition-colors"
                    aria-label="Đóng"
                    @onclick="() => _showClearCartModal = false">
                <Icon Name="HeroiconName.XMark" Class="w-5 h-5" />
            </button>

            <div class="w-12 h-12 rounded-2xl bg-red-500/20 text-red-400 flex items-center justify-center mb-4">
                <Icon Name="HeroiconName.Trash" Class="w-6 h-6" />
            </div>

            <h3 id="clear-cart-title" class="text-xl font-black text-white">Xóa Toàn Bộ Giỏ Hàng?</h3>
            <p class="text-xs sm:text-sm text-white/60 mt-2 leading-relaxed">
                Tất cả các sản phẩm đang có trong giỏ hàng sẽ bị xóa. Bạn có chắc chắn muốn tiếp tục thực hiện không?
            </p>

            <div class="mt-6 flex items-center justify-end gap-3">
                <button type="button" 
                        @onclick="() => _showClearCartModal = false"
                        class="px-5 py-2.5 rounded-xl border border-white/15 bg-transparent hover:bg-white/10 text-white/80 hover:text-white text-xs sm:text-sm font-semibold transition-colors">
                    Hủy bỏ
                </button>
                <button type="button" 
                        @onclick="ConfirmClearCart"
                        class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs sm:text-sm font-bold uppercase tracking-wider transition-all shadow-lg shadow-red-600/30">
                    Xác nhận xóa
                </button>
            </div>
        </div>
    </div>
}

@* Support-A-Creator / Coupon Modal *@
@if (_showCreatorModal)
{
    <div class="egs-modal-backdrop" @onclick="() => _showCreatorModal = false" role="dialog" aria-modal="true" aria-labelledby="creator-modal-title">
        <div class="egs-modal-card max-w-md p-6 sm:p-7" @onclick:stopPropagation="true">
            <button type="button" 
                    class="absolute top-4 right-4 w-8 h-8 rounded-lg text-white/50 hover:text-white hover:bg-white/10 flex items-center justify-center transition-colors"
                    aria-label="Đóng"
                    @onclick="() => _showCreatorModal = false">
                <Icon Name="HeroiconName.XMark" Class="w-5 h-5" />
            </button>

            <div class="flex items-center gap-2 mb-4">
                <div class="w-9 h-9 rounded-xl bg-[#0078f2]/20 text-[#0078f2] flex items-center justify-center">
                    <Icon Name="HeroiconName.Ticket" Class="w-5 h-5" />
                </div>
                <div>
                    <h3 id="creator-modal-title" class="text-base font-bold text-white">Mã Nhà Sáng Tạo & Coupon</h3>
                    <p class="text-xs text-white/70">Hỗ trợ streamer hoặc nhập mã ưu đãi</p>
                </div>
            </div>

            <div class="mb-4">
                <label for="creator-tag-input" class="block text-xs font-semibold text-white/70 uppercase tracking-wider mb-2">Creator Tag / Voucher</label>
                <input id="creator-tag-input" type="text" @bind="_creatorTagInput" @bind:event="oninput" placeholder="Ví dụ: NEXUS2026, NEXUS50..." class="w-full bg-[#121216] border border-white/15 focus:border-[#0078f2] text-white px-3.5 py-2.5 rounded-xl text-sm font-mono uppercase tracking-wider focus:outline-none transition-colors" />
                <p class="text-sm text-white/70 mt-1.5 leading-relaxed">Nhà sáng tạo sẽ nhận được một phần doanh thu từ giao dịch này.</p>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2">
                <button type="button" @onclick="() => _showCreatorModal = false" class="px-4 py-2 rounded-xl border border-white/10 text-white/70 hover:text-white text-xs font-semibold">
                    Hủy
                </button>
                <button type="button" @onclick="ApplyCreatorTag" disabled="@(string.IsNullOrWhiteSpace(_creatorTagInput))" class="px-5 py-2 rounded-xl bg-[#0078f2] hover:bg-[#0068d6] text-white text-xs font-bold uppercase tracking-wider transition-colors disabled:opacity-50">
                    Áp dụng
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showClearCartModal = false;
    private bool _showCreatorModal = false;
    private string _creatorTagInput = "";
    private string _appliedCreatorTag = "";
    private string _subnavSearch = "";

    private void HandleSubnavSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_subnavSearch))
        {
            NavigationManager.NavigateTo($"/products?search={Uri.EscapeDataString(_subnavSearch)}");
        }
    }

    protected override void OnInitialized()
    {
        VM.StateChanged += StateHasChanged;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VM.InitializeAsync();
        }
    }

    private async Task ConfirmClearCart()
    {
        await VM.ClearCartAsync();
        _showClearCartModal = false;
        ToastService.ShowSuccess("Đã xóa sạch giỏ hàng.");
    }

    private void ApplyCreatorTag()
    {
        if (!string.IsNullOrWhiteSpace(_creatorTagInput))
        {
            _appliedCreatorTag = _creatorTagInput.Trim().ToUpper();
            _showCreatorModal = false;
            ToastService.ShowSuccess($"Đã áp dụng mã {_appliedCreatorTag} thành công!");
        }
    }
    
    public void Dispose()
    {
        VM.StateChanged -= StateHasChanged;
    }
}
