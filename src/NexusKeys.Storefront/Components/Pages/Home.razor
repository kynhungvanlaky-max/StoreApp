                        <button type="button" class="egs-card-bookmark @(_wishlistedTitles.Contains("The Witcher 3: Wild Hunt") ? "is-active text-[#0078f2]" : "")"
                                @onclick:preventDefault="true" @onclick:stopPropagation="true"
                                @onclick='() => ToggleWishlist("The Witcher 3: Wild Hunt")'
