                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/1145350/library_600x900.jpg" alt="Hades II" class="egs-mini-thumb" />
                            <button type="button" class="egs-mini-bookmark @(_wishlistedTitles.Contains("Hades II") ? "is-active text-[#0078f2]" : "")"
