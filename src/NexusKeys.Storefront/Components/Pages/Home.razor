    private int _heroIndex = 0;
    private HeroSlide CurrentSlide => _slides[_heroIndex];
    private System.Threading.Timer? _autoSlideTimer;
    private bool _isPaused = false;
    private readonly HashSet<string> _wishlistedTitles = new(StringComparer.OrdinalIgnoreCase);

    private void ToggleWishlist(string title)
    {
        if (_wishlistedTitles.Contains(title))
        {
            _wishlistedTitles.Remove(title);
            ToastService.ShowInfo($"Đã xóa \"{title}\" khỏi danh sách yêu thích.");
        }
        else
        {
            _wishlistedTitles.Add(title);
            ToastService.ShowSuccess($"Đã thêm \"{title}\" vào danh sách yêu thích!");
        }
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        _autoSlideTimer = new System.Threading.Timer(_ =>
        {
            if (_isPaused) return;
            InvokeAsync(() =>
            {
                _heroIndex = (_heroIndex + 1) % _slides.Length;
                StateHasChanged();
            });
        }, null, 5000, 5000);
    }

    private void SetHeroSlide(int index)
    {
        if (index >= 0 && index < _slides.Length)
        {
            _heroIndex = index;
            ResetTimer();
        }
    }

    private void NextHeroSlide()
    {
        _heroIndex = (_heroIndex + 1) % _slides.Length;
        ResetTimer();
    }

    private void PrevHeroSlide()
    {
        _heroIndex = (_heroIndex - 1 + _slides.Length) % _slides.Length;
        ResetTimer();
    }

    private void PauseAutoSlide()
    {
        _isPaused = true;
    }

    private void ResumeAutoSlide()
    {
        _isPaused = false;
        ResetTimer();
    }

    private void ResetTimer()
    {
        _autoSlideTimer?.Change(5000, 5000);
    }

    private async Task ScrollTrack(string elementId, int delta)
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('{elementId}')?.scrollBy({{ left: {delta}, behavior: 'smooth' }})");
        }
        catch
        {
            // fallback
        }
    }

    public void Dispose()
    {
        _autoSlideTimer?.Dispose();
    }
}
