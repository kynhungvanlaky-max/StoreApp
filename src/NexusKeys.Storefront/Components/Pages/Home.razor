                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/431960/library_600x900.jpg" alt="Wallpaper Engine" class="egs-mini-thumb" />
                            <button type="button" class="egs-mini-bookmark @(_wishlistedTitles.Contains("Wallpaper Engine") ? "is-active text-[#0078f2]" : "")"
                                    @onclick:preventDefault="true" @onclick:stopPropagation="true"
                                    @onclick='() => ToggleWishlist("Wallpaper Engine")'
                                    title="@(_wishlistedTitles.Contains("Wallpaper Engine") ? "Xóa khỏi danh sách ước" : "Thêm vào danh sách ước")"
                                    aria-label="Thêm vào danh sách ước">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="@(_wishlistedTitles.Contains("Wallpaper Engine") ? "currentColor" : "none")" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7c-1.1 0-2 .9-2 2v16l7-4.5 7 4.5V5c0-1.1-.9-2-2-2z"/></svg>
                            </button>
                        </div>
                        <div class="egs-mini-info">
                            <span class="egs-mini-tag text-purple-400">Lập trình & Tiện ích</span>
