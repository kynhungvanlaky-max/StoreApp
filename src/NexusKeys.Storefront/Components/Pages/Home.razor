                                aria-label="Thêm vào danh sách ước">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="@(_wishlistedTitles.Contains("The Witcher 3: Wild Hunt") ? "currentColor" : "none")" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7c-1.1 0-2 .9-2 2v16l7-4.5 7 4.5V5c0-1.1-.9-2-2-2z"/></svg>
                        </button>
                    </div>
                    <span class="egs-card-tag">Trò chơi cơ bản</span>
                    <h3 class="egs-card-name">The Witcher 3: Wild Hunt</h3>
                    <div class="egs-price-row">
                        <span class="egs-pill-discount">-75%</span>
                        <span class="egs-old-price">660.000 đ*</span>
                        <span class="egs-new-price">165.000 đ</span>
                    </div>
                </a>

                @* Discount 2: Cyberpunk 2077 *@
                <a href="@($"/products?search={Uri.EscapeDataString("Cyberpunk 2077")}")" class="egs-discount-card egs-shimmer-card group">
                    <div class="egs-discount-poster relative" style="position: relative;">
                        <span class="absolute top-2.5 left-2.5 z-10 inline-block px-2.5 py-0.5 text-white text-[10px] font-black uppercase tracking-widest bg-gradient-to-r from-[#0078f2] to-[#005fb8] shadow-md shadow-sky-900/40 pointer-events-none" style="clip-path: polygon(0 0, 100% 0, 82% 100%, 0 100%);">GAME</span>
                        <img src="https://cdn.akamai.steamstatic.com/steam/apps/1091500/library_600x900.jpg" alt="Cyberpunk 2077" />
                        <button type="button" class="egs-card-bookmark @(_wishlistedTitles.Contains("Cyberpunk 2077") ? "is-active text-[#0078f2]" : "")"
