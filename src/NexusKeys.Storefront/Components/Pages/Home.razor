                                    @onclick='() => ToggleWishlist("Dave The Diver")'
                                    title="@(_wishlistedTitles.Contains("Dave The Diver") ? "Xóa khỏi danh sách ước" : "Thêm vào danh sách ước")"
                                    aria-label="Thêm vào danh sách ước">
