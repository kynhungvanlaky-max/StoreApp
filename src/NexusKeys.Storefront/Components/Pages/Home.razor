                                aria-label="Thêm vào danh sách ước">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="@(_wishlistedTitles.Contains("Cyberpunk 2077") ? "currentColor" : "none")" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7c-1.1 0-2 .9-2 2v16l7-4.5 7 4.5V5c0-1.1-.9-2-2-2z"/></svg>
                        </button>
                    </div>
                    <span class="egs-card-tag">Trò chơi cơ bản</span>
                    <h3 class="egs-card-name">Cyberpunk 2077</h3>
                    <div class="egs-price-row">
                        <span class="egs-pill-discount">-50%</span>
                        <span class="egs-old-price">990.000 đ*</span>
                        <span class="egs-new-price">495.000 đ</span>
                    </div>
                </a>

                @* Discount 3: Resident Evil 4 Remake *@
