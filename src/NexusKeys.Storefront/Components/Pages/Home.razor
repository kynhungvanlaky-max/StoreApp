@page "/"
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject Frontend.Services.ToastService ToastService
@inject Frontend.ViewModels.WishlistViewModel WishlistViewModel
@implements IDisposable

<PageTitle>NexusKeys | Cửa Hàng Game & Ứng Dụng Bản Quyền Chính Hãng</PageTitle>

<div class="egs-wrap">
    <div class="egs-content">


        @* ================================================================= *@
        @* SECTION 1: HERO SPOTLIGHT (Stage & Animated Rail)                 *@
        @* ================================================================= *@
        <section aria-label="Tiêu điểm nổi bật">
            <div class="egs-hero-grid">
                @* Hero Stage with Animated Slide Transition, Verified Official Cover Art & Overlay *@
                <a href="@CurrentSlide.Link" class="egs-hero-stage egs-card-hover egs-shimmer-card relative" aria-label="@CurrentSlide.Title" style="position: relative;">
                    <img @key="_heroIndex" src="@CurrentSlide.Image" alt="@CurrentSlide.Title" class="egs-hero-bg egs-hero-stage-animated" />
                    <div class="egs-hero-overlay">
                        <span class="egs-hero-badge">@CurrentSlide.Badge</span>
                        <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-white tracking-tight drop-shadow-md">@CurrentSlide.Title</h2>
                        <p class="egs-hero-desc">@CurrentSlide.Description</p>
                        <span class="egs-hero-price">@CurrentSlide.Price</span>
                        <div class="egs-hero-actions">
                            <span class="egs-hero-btn-buy">Khám phá ngay</span>
                            <button type="button" class="egs-hero-btn-icon @(_wishlistedTitles.Contains(CurrentSlide.Title) ? "text-[#0078f2]" : "")"
                                    @onclick:preventDefault="true" @onclick:stopPropagation="true"
                                    @onclick="() => ToggleWishlist(CurrentSlide.Title)"
                                    title="@(_wishlistedTitles.Contains(CurrentSlide.Title) ? "Xóa khỏi danh sách ước" : "Thêm vào danh sách ước")"
                                    aria-label="Thêm vào danh sách ước">
                                <svg width="18" height="18" fill="@(_wishlistedTitles.Contains(CurrentSlide.Title) ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    @if (_wishlistedTitles.Contains(CurrentSlide.Title))
                                    {
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7c-1.1 0-2 .9-2 2v16l7-4.5 7 4.5V5c0-1.1-.9-2-2-2z"/>
                                    }
                                    else
                                    {
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                                    }
                                </svg>
                            </button>
                        </div>
                    </div>
                </a>

                @* Hero Rail with Authentic Dynamic Visuals & Animated Progress Bar *@
                <div class="egs-hero-rail-wrap">
                    <div class="egs-hero-rail">
                        @for (int i = 0; i < _slides.Length; i++)
                        {
                            var idx = i;
                            var slide = _slides[idx];
                            var isActive = _heroIndex == idx;
                            <button type="button"
                                    class="egs-rail-item @(isActive ? "active" : "")"
                                    @onclick="() => SetHeroSlide(idx)"
                                    @onmouseenter="PauseAutoSlide"
                                    @onmouseleave="ResumeAutoSlide">
                                <img src="@slide.Thumb" alt="@slide.Title" class="egs-rail-thumb" />
                                <span class="egs-rail-title">@slide.Title</span>
                                @if (isActive)
                                {
                                    <div @key="@($"timer-{_heroIndex}")" class="egs-rail-timer"></div>
                                }
                            </button>
                        }
                    </div>

                    @* Rail Carousel Controls *@
                    <div class="egs-rail-arrows">
                        <button type="button" class="egs-circle-btn" @onclick="PrevHeroSlide" aria-label="Slide trước">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <button type="button" class="egs-circle-btn" @onclick="NextHeroSlide" aria-label="Slide tiếp theo">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        @* ================================================================= *@
        @* SECTION 2: DISCOVER SOMETHING NEW & 6 MINI CARDS                   *@
        @* ================================================================= *@
        <section aria-label="Khám phá sản phẩm mới">
            <div class="egs-section-header mb-4">
                <div class="egs-section-title-wrap">
                    <a href="/products" class="egs-section-title hover:text-white flex items-center gap-2">
                        <span>Khám phá sản phẩm mới</span>
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>

            <div class="egs-discover-row">
                <a href="@($"/products?search={Uri.EscapeDataString("Red Dead Redemption 2")}")" class="egs-discover-banner egs-card-hover egs-shimmer-card">
                    <img src="https://cdn.akamai.steamstatic.com/steam/apps/1174180/library_hero.jpg" alt="Red Dead Redemption 2" />
                    <div class="egs-discover-overlay">
                        <span class="egs-discover-badge">Tâm điểm nổi bật</span>
                        <h3 class="egs-discover-title">Red Dead Redemption 2</h3>
                        <p class="egs-discover-desc">Trải nghiệm tuyệt phẩm miền Tây hoang dã với hơn 175 giải thưởng Game của Năm danh giá.</p>
                        <div class="pt-1">
                            <span class="egs-discover-btn">Khám phá ngay</span>
                        </div>
                    </div>
                </a>

                <div class="egs-mini-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    @* Mini 1: Chop Chop Together (From User Screenshot) *@
                    <a href="@($"/products?search={Uri.EscapeDataString("Chop Chop Together")}")" class="egs-mini-card group">
                        <div class="egs-mini-thumb-wrap relative" style="position: relative;">
                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/3065360/header.jpg" alt="Chop Chop Together" class="egs-mini-thumb" />
                            <button type="button" class="egs-mini-bookmark @(_wishlistedTitles.Contains("Chop Chop Together") ? "is-active text-[#0078f2]" : "")"
                                    @onclick:preventDefault="true" @onclick:stopPropagation="true"
                                    @onclick='() => ToggleWishlist("Chop Chop Together")'
                                    title="@(_wishlistedTitles.Contains("Chop Chop Together") ? "Xóa khỏi danh sách ước" : "Thêm vào danh sách ước")"
                                    aria-label="Thêm vào danh sách ước">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="@(_wishlistedTitles.Contains("Chop Chop Together") ? "currentColor" : "none")" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7c-1.1 0-2 .9-2 2v16l7-4.5 7 4.5V5c0-1.1-.9-2-2-2z"/></svg>
                            </button>
