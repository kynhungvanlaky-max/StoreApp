        @* ================================================================= *@
        @* SECTION 3: SPOTLIGHT FULL BANNER (Helldivers 2)                    *@
        @* ================================================================= *@
        <section aria-label="Banner nổi bật">
            <div class="egs-full-banner-wrap">
                <a href="@($"/products?search={Uri.EscapeDataString("HELLDIVERS™ 2")}")" class="egs-full-banner egs-card-hover egs-shimmer-card">
                    <img src="https://cdn.akamai.steamstatic.com/steam/apps/553850/library_hero.jpg" alt="HELLDIVERS™ 2" />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent p-6 sm:p-10 flex flex-col justify-center max-w-xl">
                        <span class="text-xs uppercase tracking-widest font-extrabold text-[#0078f2] mb-1">Hiện có trên Store</span>
                        <h3 class="text-2xl sm:text-4xl font-black text-white leading-tight mb-2">HELLDIVERS™ 2</h3>
                        <p class="text-xs sm:text-sm text-white/80 line-clamp-2 mb-4">Gia nhập Lực lượng Helldivers và chiến đấu vì Tự Do trên khắp thiên hà rực lửa trong tựa game bắn súng góc nhìn thứ ba kịch tính.</p>
                        <div class="flex items-center gap-3">
                            <span class="egs-hero-btn-buy">Chơi ngay • 790.000 đ</span>
                        </div>
                    </div>
                </a>
            </div>
