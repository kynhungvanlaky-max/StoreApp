@page "/news"
@inject Frontend.ViewModels.NewsViewModel VM
@inject NavigationManager NavigationManager
@using Frontend.Models.News
@using Frontend.Services
@implements IDisposable

<PageTitle>Tin Tức & Sự Kiện — NexusKeys</PageTitle>

<div class="egs-wrap">
    <div class="egs-content">

        @* Tiêu đề trang *@
        <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight mb-6 sm:mb-8">
            Tin Tức & Sự Kiện — NexusKeys
        </h1>

        @if (VM.IsLoading)
        {
            <div class="animate-pulse space-y-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
                    @for (int i = 0; i < 2; i++)
                    {
                        <div class="space-y-3">
                            <div class="aspect-[16/9] w-full bg-[#202024] rounded-md"></div>
                            <div class="h-3 w-20 bg-[#202024] rounded"></div>
                            <div class="h-5 w-full bg-[#202024] rounded"></div>
                            <div class="h-4 w-3/4 bg-[#202024] rounded"></div>
                        </div>
                    }
                </div>
                <div class="border-t border-white/10 my-8"></div>
                <div class="space-y-6">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 pb-6 border-b border-white/10">
                            <div class="w-full sm:w-56 md:w-64 aspect-video bg-[#202024] rounded-md flex-shrink-0"></div>
                            <div class="flex-1 space-y-2.5">
                                <div class="h-3 w-24 bg-[#202024] rounded"></div>
                                <div class="h-5 w-5/6 bg-[#202024] rounded"></div>
                                <div class="h-4 w-2/3 bg-[#202024] rounded"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (VM.PagedArticles.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-24 text-center bg-[#18181c] border border-white/10 rounded-2xl p-8">
                <div class="w-16 h-16 bg-[#202024] rounded-full flex items-center justify-center mb-4 text-white/40">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Chưa có bài viết mới</h3>
                <p class="text-gray-400 text-xs sm:text-sm">Trở lại sau để cập nhật những thông tin và sự kiện mới nhất từ NexusKeys.</p>
            </div>
        }
        else
        {
            var isFirstPage = VM.CurrentPage == 1;
            var featuredArticles = isFirstPage ? VM.PagedArticles.Take(2).ToList() : new List<NewsArticleDto>();
            var listArticles = isFirstPage ? VM.PagedArticles.Skip(2).ToList() : VM.PagedArticles;

            @* 2 Tin nổi bật hàng đầu (Featured Top Stories) *@
            @if (featuredArticles.Count > 0)
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-8">
                    @foreach (var article in featuredArticles)
                    {
                        var cover = GameMediaHelper.GetNewsCover(article.Id, article.Title, article.CoverImageUrl);
                        <a href="/news/@article.Id" class="group flex flex-col cursor-pointer">
                            <div class="aspect-[16/9] w-full overflow-hidden rounded-md bg-[#202024] mb-3">
                                <img src="@cover" alt="@article.Title" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-102" />
                            </div>
                            <div class="text-[11px] font-semibold text-white/50 uppercase tracking-wider mb-1.5">
                                @FormatRelativeTime(article.PublishedAt)
                            </div>
                            <h2 class="text-base sm:text-lg font-bold text-white group-hover:text-white/80 transition-colors line-clamp-2 leading-snug mb-2">
                                @article.Title
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(article.Summary))
                            {
                                <p class="text-xs sm:text-sm text-white/70 line-clamp-2 leading-relaxed mb-3">
                                    @article.Summary
                                </p>
                            }
                            <div class="mt-auto">
                                <span class="inline-block text-xs sm:text-sm font-semibold text-white underline underline-offset-4 group-hover:text-white/80 transition-colors">
                                    Đọc thêm
                                </span>
                            </div>
                        </a>
                    }
                </div>

                @* Đường kẻ ngang phân cách mỏng *@
                <div class="border-t border-white/10 my-8"></div>
            }

            @* Danh sách bài viết bên dưới (Horizontal List View) *@
            @if (listArticles.Count > 0)
            {
                <div class="space-y-6">
                    @foreach (var article in listArticles)
                    {
                        var cover = GameMediaHelper.GetNewsCover(article.Id, article.Title, article.CoverImageUrl);
                        <a href="/news/@article.Id" class="group flex flex-col sm:flex-row items-start gap-4 sm:gap-6 pb-6 border-b border-white/10 transition-colors cursor-pointer">
                            <div class="w-full sm:w-48 md:w-56 lg:w-64 aspect-video flex-shrink-0 rounded-md overflow-hidden bg-[#202024]">
                                <img src="@cover" alt="@article.Title" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-102" />
                            </div>
                            <div class="flex-1 min-w-0 flex flex-col justify-between self-stretch">
                                <div>
                                    <div class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-1.5">
                                        @FormatCategoryAndTime(article)
                                    </div>
                                    <h3 class="text-sm sm:text-base md:text-lg font-bold text-white group-hover:text-white/80 transition-colors line-clamp-2 leading-snug mb-1.5">
                                        @article.Title
                                    </h3>
                                    @if (!string.IsNullOrWhiteSpace(article.Summary))
                                    {
                                        <p class="text-xs sm:text-sm text-white/60 line-clamp-2 leading-relaxed mb-2 hidden sm:block">
                                            @article.Summary
                                        </p>
                                    }
                                </div>
                                <div class="mt-2 sm:mt-0">
                                    <span class="inline-block text-xs sm:text-sm font-semibold text-white underline underline-offset-4 group-hover:text-white/80 transition-colors">
                                        Đọc thêm
                                    </span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }

            @* Phân trang tối giản NexusKeys: 1 2 3 4 5 ... 212 > *@
            @if (VM.TotalPages > 1)
            {
                <div class="flex justify-center items-center gap-4 text-xs sm:text-sm font-semibold pt-10 pb-16 select-none">
                    @foreach (var p in GetPageNumbers(VM.CurrentPage, VM.TotalPages))
                    {
                        if (p == -1)
                        {
                            <span class="text-white/30 px-1">...</span>
                        }
                        else
                        {
                            var pageNum = p;
                            <button type="button" 
                                    class="min-w-6 text-center transition-colors @(pageNum == VM.CurrentPage ? "text-white font-bold" : "text-white/50 hover:text-white")"
                                    @onclick="@(() => VM.LoadPageAsync(pageNum))">
                                @pageNum
                            </button>
                        }
                    }

                    @if (VM.CurrentPage < VM.TotalPages)
                    {
                        <button type="button"
                                class="text-white/50 hover:text-white transition-colors ml-2"
                                title="Trang kế tiếp"
                                @onclick="@(() => VM.LoadPageAsync(VM.CurrentPage + 1))">
                            <svg class="w-4 h-4 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        VM.StateChanged += StateHasChanged;
        await VM.LoadArticlesAsync();
    }

    public void Dispose()
    {
        VM.StateChanged -= StateHasChanged;
    }

    private string FormatRelativeTime(DateTime publishedAt)
    {
        var span = DateTime.UtcNow - publishedAt.ToUniversalTime();
        if (span.TotalHours < 1)
        {
            var mins = Math.Max(1, (int)span.TotalMinutes);
            return $"{mins} PHÚT TRƯỚC";
        }
        if (span.TotalDays < 1)
        {
            var hours = Math.Max(1, (int)span.TotalHours);
            return $"{hours} GIỜ TRƯỚC";
        }
        if (span.TotalDays < 30)
        {
            var days = (int)span.TotalDays;
            return $"{days}NG TRƯỚC";
        }
        if (span.TotalDays < 365)
        {
            var months = Math.Max(1, (int)(span.TotalDays / 30));
            return $"{months}THG TRƯỚC";
        }
        var years = Math.Max(1, (int)(span.TotalDays / 365));
        return $"{years}N TRƯỚC";
    }

    private string FormatCategoryAndTime(NewsArticleDto article)
    {
        var time = FormatRelativeTime(article.PublishedAt);
        if (!string.IsNullOrWhiteSpace(article.Title))
        {
            if (article.Title.Contains("Cập nhật", StringComparison.OrdinalIgnoreCase) || article.Title.Contains("Update", StringComparison.OrdinalIgnoreCase) || article.Title.Contains("Patch", StringComparison.OrdinalIgnoreCase))
                return $"CẬP NHẬT TRÒ CHƠI | {time}";
            if (article.Title.Contains("Điểm tin", StringComparison.OrdinalIgnoreCase) || article.Title.Contains("Tuần", StringComparison.OrdinalIgnoreCase) || article.Title.Contains("Week", StringComparison.OrdinalIgnoreCase))
                return $"{time}";
            if (article.Title.Contains("Hướng dẫn", StringComparison.OrdinalIgnoreCase) || article.Title.Contains("Guide", StringComparison.OrdinalIgnoreCase))
                return $"HƯỚNG DẪN | {time}";
        }
        return $"TIN TỨC | {time}";
    }

    private IEnumerable<int> GetPageNumbers(int current, int total)
    {
        if (total <= 7)
        {
            for (int i = 1; i <= total; i++) yield return i;
            yield break;
        }

        yield return 1;

        if (current > 3)
        {
            yield return -1;
        }

        int start = Math.Max(2, current - 1);
        int end = Math.Min(total - 1, current + 1);

        if (current <= 3)
        {
            start = 2;
            end = 4;
        }
        else if (current >= total - 2)
        {
            start = total - 3;
            end = total - 1;
        }

        for (int i = start; i <= end; i++)
        {
            yield return i;
        }

        if (current < total - 2)
        {
            yield return -1;
        }

        yield return total;
    }
}
