@page "/news/{Id:int}"
@inject Frontend.ViewModels.NewsViewModel VM
@inject Frontend.Services.ToastService ToastService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Frontend.Services
@implements IDisposable

<PageTitle>@(VM.CurrentArticle?.Title ?? "Chi tiết bài viết") — NexusKeys</PageTitle>

<div class="egs-wrap">
    <div class="egs-content">

@if (VM.IsLoading)
{
    <div class="max-w-4xl mx-auto py-12 animate-pulse space-y-6">
        <div class="h-4 w-40 bg-[#202024] rounded"></div>
        <div class="h-10 w-3/4 bg-[#202024] rounded"></div>
        <div class="aspect-video w-full bg-[#202024] rounded-2xl"></div>
        <div class="space-y-3">
            <div class="h-4 w-full bg-[#202024] rounded"></div>
            <div class="h-4 w-full bg-[#202024] rounded"></div>
            <div class="h-4 w-2/3 bg-[#202024] rounded"></div>
        </div>
    </div>
}
else if (VM.CurrentArticle == null)
{
    <div class="flex flex-col items-center justify-center py-32 text-center bg-[#18181c] border border-white/10 rounded-2xl my-8 p-8">
        <div class="w-16 h-16 bg-[#202024] rounded-full flex items-center justify-center mb-4 text-amber-400">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <h1 class="text-2xl font-bold text-white mb-2 tracking-tight">Không tìm thấy bài viết</h1>
        <p class="text-gray-400 mb-6 text-sm">Bài viết này không tồn tại hoặc đã được gỡ bỏ khỏi hệ thống tin tức.</p>
        <a href="/news" class="px-6 py-2.5 text-xs font-bold text-white bg-[#0078F2] rounded-lg hover:bg-[#0066cc] uppercase tracking-wider transition-colors">Quay lại tin tức</a>
    </div>
}
else
{
    var article = VM.CurrentArticle;
    var cover = GameMediaHelper.GetNewsCover(article.Id, article.Title, article.CoverImageUrl);

    @* Breadcrumbs *@
    <div class="flex items-center gap-2 text-xs text-white/50 mb-6 font-semibold">
        <a href="/" class="hover:text-white transition-colors">Cửa hàng</a>
        <span>›</span>
        <a href="/news" class="hover:text-white transition-colors">Tin tức</a>
        <span>›</span>
        <span class="text-white truncate max-w-sm">@article.Title</span>
    </div>

    <article class="max-w-4xl mx-auto pb-16">
        @* Editorial Header *@
        <header class="mb-8">
            <div class="flex items-center gap-3 mb-4">
                <span class="px-2.5 py-0.5 rounded text-[11px] font-black uppercase tracking-wider bg-[#0078f2] text-white">Tin tức chính thức</span>
                <span class="text-xs text-white/40">•</span>
                <span class="text-xs text-white/60">@article.PublishedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white leading-tight mb-6 tracking-tight">
                @article.Title
            </h1>

            <div class="flex items-center justify-between py-4 border-t border-b border-white/10">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-[#0078f2]/20 border border-[#0078f2]/40 text-[#0078f2] font-black flex items-center justify-center text-sm">
                        @article.AuthorName.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <div class="font-bold text-white text-sm">@article.AuthorName</div>
                        <div class="text-[11px] text-white/60">Biên tập viên NexusKeys</div>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button type="button" @onclick="CopyArticleLinkAsync" class="px-3 py-1.5 rounded-lg bg-[#202024] hover:bg-white/15 text-white text-xs font-bold transition-colors border border-white/10 flex items-center gap-1.5" title="Sao chép liên kết">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Chia sẻ</span>
                    </button>
                </div>
            </div>
        </header>

        @* Hero Image *@
        <div class="aspect-[16/9] w-full rounded-2xl overflow-hidden bg-black mb-10 shadow-2xl border border-white/10">
            <img src="@cover" alt="@article.Title" class="w-full h-full object-cover" />
        </div>

        @* Content Body *@
        <div class="space-y-6 text-white/80 leading-relaxed text-base sm:text-lg">
            <p class="text-lg sm:text-xl font-medium text-white leading-normal p-5 rounded-2xl bg-[#18181c] border-l-4 border-[#0078f2]">
                @article.Summary
            </p>

            <div class="prose prose-invert max-w-none text-white/80 space-y-4">
                @((MarkupString)article.Content)
            </div>
        </div>

        @* Footer Tags & Back *@
        <div class="mt-14 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-white/50 uppercase tracking-wider">Chủ đề:</span>
                <span class="px-2.5 py-1 rounded-md bg-white/5 text-white/80 text-xs font-semibold">NexusKeys</span>
                <span class="px-2.5 py-1 rounded-md bg-white/5 text-white/80 text-xs font-semibold">Ưu đãi</span>
                <span class="px-2.5 py-1 rounded-md bg-white/5 text-white/80 text-xs font-semibold">Cộng đồng</span>
            </div>

            <a href="/news" class="px-5 py-2.5 rounded-xl bg-[#202024] hover:bg-white/15 text-white text-xs font-bold uppercase tracking-wider transition-colors border border-white/10">
                ← Quay lại danh sách tin tức
            </a>
        </div>
    </article>
}

    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private string _subnavSearch = "";

    private void HandleSubnavSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_subnavSearch))
        {
            NavigationManager.NavigateTo($"/products?search={Uri.EscapeDataString(_subnavSearch.Trim())}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        VM.StateChanged += StateHasChanged;
        await VM.LoadArticleDetailsAsync(Id);
    }

    private async Task CopyArticleLinkAsync()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", NavigationManager.Uri);
        ToastService.ShowSuccess("Đã sao chép liên kết bài viết vào bộ nhớ tạm!");
    }
    
    public void Dispose()
    {
        VM.StateChanged -= StateHasChanged;
    }
}
