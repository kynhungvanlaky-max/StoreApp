@page "/profile/wallet"
@implements IDisposable
@inject Frontend.ViewModels.ProfileViewModel VM
@inject Frontend.Services.ToastService ToastService
@inject Frontend.Services.WalletService WalletService
@layout Frontend.Components.Layout.ProfileLayout

<PageTitle>Ví NexusPay — NexusKeys</PageTitle>
<h1 class="sr-only">Ví NexusPay</h1>

<div class="space-y-6 w-full">
    @if (VM.IsLoading && VM.Profile == null)
    {
        <div class="flex items-center justify-center h-64 bg-[#18181c] rounded-2xl border border-white/10">
            <div class="flex flex-col items-center gap-3">
                <span class="loading loading-spinner loading-lg text-[#0078f2]"></span>
                <span class="text-xs text-white/60 uppercase tracking-widest font-bold">Đang tải ví...</span>
            </div>
        </div>
    }
    else if (VM.Profile != null)
    {
        @* Balance Hero Card *@
        <div class="bg-[#18181c] rounded-2xl border border-white/10 p-6 sm:p-8 relative overflow-hidden shadow-2xl">
            @* Ambient Glow *@
            <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-[#0078f2]/15 blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -left-24 w-64 h-64 rounded-full bg-purple-500/10 blur-3xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-[#0078f2]/20 text-[#0078f2] border border-[#0078f2]/30">
                            Ví Điện Tử Tiện Lợi
                        </span>
                        <span class="text-xs text-white/60">• Thanh toán 0% phí</span>
                    </div>
                    <span class="text-xs font-bold text-white/60 uppercase tracking-wider block mb-1">Số Dư Khả Dụng NexusPay</span>
                    <div class="text-4xl sm:text-5xl font-black text-white tracking-tight drop-shadow-sm flex items-baseline gap-2">
                        @VM.Profile.WalletBalance.ToString("N0") <span class="text-2xl text-[#0078f2] font-extrabold">₫</span>
                    </div>
                    <p class="text-sm text-white/60 mt-2 leading-relaxed">Dùng để thanh toán tức thì tất cả game và key kích hoạt trên NexusKeys Storefront.</p>
                </div>

                <div class="flex flex-col sm:flex-row gap-3">
                    <button type="button" @onclick="ShowTopUpModal" class="px-6 py-3.5 rounded-xl bg-[#0078f2] hover:bg-[#0060c2] text-white text-xs sm:text-sm font-black uppercase tracking-wider transition-all shadow-lg shadow-[#0078f2]/30 hover:shadow-[#0078f2]/50 active:scale-95 flex items-center justify-center gap-2">
                        <Icon Name="HeroiconName.PlusCircle" Class="w-5 h-5" />
                        <span>Nạp Tiền Vào Ví</span>
                    </button>
                </div>
            </div>
        </div>

        @* Recent Transactions Table *@
        <div class="bg-[#18181c] rounded-2xl border border-white/10 shadow-xl overflow-hidden">
            <div class="p-5 sm:p-6 border-b border-white/10 bg-[#202024]/60 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <Icon Name="HeroiconName.ListBullet" Class="w-5 h-5 text-[#0078f2]" />
                    <h2 class="text-base sm:text-lg font-bold text-white">Lịch Sử Giao Dịch</h2>
                </div>
                <span class="px-2.5 py-0.5 rounded text-xs font-black uppercase tracking-wider bg-white/5 text-white/60 border border-white/10">
                    Gần đây
                </span>
            </div>
            
            <div>
                @if (_transactions.Any())
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-white">
                            <thead class="bg-[#202024]/40 border-b border-white/10 text-white/60 text-[11px] font-black uppercase tracking-wider">
                                <tr>
                                    <th class="py-3.5 px-4 sm:px-6">Mã GD</th>
                                    <th class="py-3.5 px-4">Thời gian</th>
                                    <th class="py-3.5 px-4">Nội dung</th>
                                    <th class="py-3.5 px-4 sm:px-6 text-right">Số tiền</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                @foreach (var tx in _transactions)
                                {
                                    <tr class="hover:bg-white/[0.02] transition-colors">
                                        <td class="py-4 px-4 sm:px-6 font-mono text-xs text-white/60">
                                            TXN-@tx.Id
                                        </td>
                                        <td class="py-4 px-4 text-xs text-white/60 whitespace-nowrap">
                                            @tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="py-4 px-4 text-xs sm:text-sm font-medium text-white/90">
                                            @(tx.TransactionType switch
                                            {
                                                "Deposit" => "Nạp tiền vào ví NexusPay",
                                                "Purchase" or "Payment" => "Thanh toán đơn hàng",
                                                "Refund" => "Hoàn tiền",
                                                _ => tx.TransactionType
                                            })
                                            @if (tx.Status == "Pending")
                                            {
                                                <span class="ml-2 px-2 py-0.5 rounded text-xs font-black uppercase tracking-wider bg-amber-500/20 text-amber-400 border border-amber-500/30">
                                                    Đang xử lý
                                                </span>
                                            }
                                        </td>
                                        <td class="py-4 px-4 sm:px-6 text-right whitespace-nowrap">
                                            @if (tx.Amount > 0)
                                            {
                                                <span class="font-black text-emerald-400 flex items-center justify-end gap-1">
                                                    <Icon Name="HeroiconName.ArrowUpRight" Class="w-3.5 h-3.5" />
                                                    <span>+@tx.Amount.ToString("N0") ₫</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="font-black text-red-400 flex items-center justify-end gap-1">
                                                    <Icon Name="HeroiconName.ArrowDownRight" Class="w-3.5 h-3.5" />
                                                    <span>-@Math.Abs(tx.Amount).ToString("N0") ₫</span>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-12 text-center text-white/60">
                        <Icon Name="HeroiconName.Inbox" Class="w-12 h-12 mx-auto text-white/40 mb-3" />
                        <p class="text-sm">Chưa có giao dịch nào được ghi nhận.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* Top-up Modal *@
@if (_isTopUpModalOpen)
{
    <div class="egs-modal-backdrop" @onclick="CloseTopUpModal" role="dialog" aria-modal="true" aria-labelledby="wallet-topup-title">
        <div class="egs-modal-card max-w-lg p-6 sm:p-8" style="max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
            @* Close Button *@
            <button type="button" 
                    class="absolute top-5 right-5 w-8 h-8 rounded-lg text-white/60 hover:text-white hover:bg-white/10 flex items-center justify-center transition-colors"
                    aria-label="Đóng hộp thoại"
                    @onclick="CloseTopUpModal">
                <Icon Name="HeroiconName.XMark" Class="w-5 h-5" />
            </button>

            @* Modal Header *@
            <div class="flex items-center gap-3.5 mb-6">
                <div class="w-12 h-12 rounded-xl bg-[#0078f2]/15 border border-[#0078f2]/30 text-[#0078f2] flex items-center justify-center shrink-0">
                    <Icon Name="HeroiconName.Wallet" Class="w-6 h-6" />
                </div>
                <div>
                    <h3 id="wallet-topup-title" class="font-black text-xl text-white tracking-tight uppercase">Nạp Ví NexusPay</h3>
                    <p class="text-xs text-white/60">Chọn mệnh giá hoặc nhập số tiền tùy ý bạn muốn nạp vào ví.</p>
                </div>
            </div>
            
            <div class="space-y-4">
                <label class="text-xs font-bold uppercase tracking-wider text-white/70 block">Mệnh giá phổ biến</label>
                <div class="grid grid-cols-3 gap-2.5">
                    @foreach (var amount in _topUpOptions)
                    {
                        var isSelected = _selectedAmount == amount && !_customAmount.HasValue;
                        <button type="button" @onclick="() => SelectAmount(amount)" 
                                class="py-3 px-2 rounded-xl border text-center transition-all duration-200 @(isSelected ? "bg-[#0078f2] border-[#0078f2] text-white shadow-lg shadow-[#0078f2]/30 font-black scale-[1.02]" : "bg-[#202024] border-white/10 text-white/80 hover:bg-[#28282d] hover:border-white/20")">
                            <span class="block text-base font-black">@(amount >= 1000000 ? $"{amount / 1000000}Tr" : $"{amount / 1000}K")</span>
                            <span class="block text-xs text-white/60">@amount.ToString("N0")₫</span>
                        </button>
                    }
                </div>
                
                <div class="pt-2">
                    <label for="custom-wallet-amount" class="text-xs font-bold uppercase tracking-wider text-white/70 block mb-1.5">Hoặc số tiền tùy chỉnh</label>
                    <div class="relative flex items-center">
                        <input id="custom-wallet-amount" type="number" aria-label="Số tiền nạp tùy chỉnh" @bind="_customAmount" @bind:event="oninput" min="50000" step="10000"
                               class="w-full bg-[#202024] text-white rounded-xl px-4 py-3 border border-white/10 focus:border-[#0078f2] focus:ring-1 focus:ring-[#0078f2] outline-none text-sm placeholder:text-white/50 transition-all font-medium" 
                               placeholder="Tối thiểu 50,000 VNĐ" />
                        <span class="absolute right-4 text-xs font-bold text-white/60 pointer-events-none">VNĐ</span>
                    </div>
                </div>

                @* Payment Method Previews *@
                <div class="pt-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-white/70 block mb-2">Cổng thanh toán tự động</span>
                    <div class="grid grid-cols-3 gap-2 text-center text-xs">
                        <button type="button" @onclick='() => _selectedGateway = "VNPay"' 
                                class="p-3 rounded-xl border flex flex-col items-center justify-center gap-1 transition-all @(_selectedGateway == "VNPay" ? "bg-[#0078f2]/15 border-[#0078f2] shadow-md shadow-[#0078f2]/20" : "bg-[#202024] border-white/10 text-white/70 hover:border-white/20")">
                            <span class="text-xs font-black @(_selectedGateway == "VNPay" ? "text-[#0078f2]" : "text-white")">VNPay QR</span>
                            <span class="text-[11px] text-emerald-400 font-bold uppercase">Khuyên dùng</span>
                        </button>
                        <button type="button" @onclick='() => _selectedGateway = "MoMo"' 
                                class="p-3 rounded-xl border flex flex-col items-center justify-center gap-1 transition-all @(_selectedGateway == "MoMo" ? "bg-[#d82d8b]/15 border-[#d82d8b] shadow-md shadow-[#d82d8b]/20" : "bg-[#202024] border-white/10 text-white/70 hover:border-white/20")">
                            <span class="text-xs font-bold @(_selectedGateway == "MoMo" ? "text-[#d82d8b] font-black" : "text-[#d82d8b]")">Ví MoMo</span>
                            <span class="text-[11px] text-white/60 font-bold uppercase">Quét mã</span>
                        </button>
                        <button type="button" @onclick='() => _selectedGateway = "ATM"' 
                                class="p-3 rounded-xl border flex flex-col items-center justify-center gap-1 transition-all @(_selectedGateway == "ATM" ? "bg-white/15 border-white shadow-md" : "bg-[#202024] border-white/10 text-white/70 hover:border-white/20")">
                            <span class="text-xs font-bold text-white">Thẻ ATM / Visa</span>
                            <span class="text-[11px] text-white/60 font-bold uppercase">Nội địa & QT</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-end gap-3">
                <button type="button" class="px-5 py-2.5 rounded-xl border border-white/15 text-white/70 hover:text-white hover:bg-white/10 text-xs sm:text-sm font-semibold transition-colors" @onclick="CloseTopUpModal">
                    Hủy bỏ
                </button>
                <button type="button" class="px-6 py-2.5 rounded-xl bg-[#0078f2] hover:bg-[#0060c2] text-white text-xs sm:text-sm font-black uppercase tracking-wider transition-all shadow-lg shadow-[#0078f2]/30 flex items-center gap-2 disabled:opacity-40 disabled:hover:bg-[#0078f2] active:scale-95" disabled="@(!IsValidAmount || _isProcessing)" @onclick="ProcessTopUp">
                    @if (_isProcessing)
                    {
                        <span class="loading loading-spinner loading-xs"></span>
                    }
                    <span>Nạp @(AmountToCharge.ToString("N0"))đ</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isTopUpModalOpen = false;
    private bool _isProcessing = false;
    private string _selectedGateway = "VNPay";
    private int _selectedAmount = 0;
    private int? _customAmount = null;
    
    private readonly int[] _topUpOptions = { 50000, 100000, 200000, 500000, 1000000, 2000000 };
    
    private List<Frontend.Services.TransactionDto> _transactions = new();

    private bool IsValidAmount => _selectedAmount > 0 || (_customAmount.HasValue && _customAmount.Value >= 50000);
    
    private int AmountToCharge => _customAmount.HasValue && _customAmount.Value >= 50000 ? _customAmount.Value : _selectedAmount;

    protected override async Task OnInitializedAsync()
    {
        VM.StateChanged += StateHasChanged;
        await VM.LoadProfileAsync();
        
        if (VM.Profile != null)
        {
            _transactions = await WalletService.GetTransactionsAsync();
        }
    }

    private void ShowTopUpModal()
    {
        _selectedAmount = 100000;
        _customAmount = null;
        _isTopUpModalOpen = true;
    }

    private void CloseTopUpModal()
    {
        _isTopUpModalOpen = false;
    }

    private void SelectAmount(int amount)
    {
        _selectedAmount = amount;
        _customAmount = null;
    }

    private async Task ProcessTopUp()
    {
        if (!IsValidAmount) return;
        
        _isProcessing = true;
        
        var success = await WalletService.DepositAsync(AmountToCharge);
        
        if (success)
        {
            await VM.LoadProfileAsync();
            _transactions = await WalletService.GetTransactionsAsync();
            ToastService.ShowSuccess($"Nạp thành công {AmountToCharge.ToString("N0")}đ vào ví!");
        }
        else
        {
            ToastService.ShowError("Có lỗi xảy ra khi nạp tiền, vui lòng thử lại.");
        }
        
        _isProcessing = false;
        _isTopUpModalOpen = false;
    }

    public void Dispose()
    {
        VM.StateChanged -= StateHasChanged;
    }
}
