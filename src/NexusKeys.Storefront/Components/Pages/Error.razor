@page "/Error"
@using System.Diagnostics

<PageTitle>Đã Xảy Ra Sự Cố — NexusKeys</PageTitle>

<div class="egs-wrap">
    <div class="egs-content">
        <section class="py-24 min-h-[65vh] flex items-center justify-center text-center" aria-labelledby="error-title">
            <div class="max-w-md mx-auto egs-card-hover bg-[#18181c] border border-white/10 rounded-3xl p-10 shadow-2xl">
                <div class="w-16 h-16 mx-auto mb-6 flex items-center justify-center rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400">
                    <Icon Name="HeroiconName.ExclamationTriangle" Class="w-8 h-8" />
                </div>
                <p class="text-xs font-black uppercase tracking-[0.25em] text-red-400 mb-2">Hệ Thống Gặp Sự Cố</p>
                <h1 id="error-title" class="text-2xl sm:text-3xl font-black text-white mb-3 tracking-tight">Đã Xảy Ra Lỗi Xử Lý</h1>
                <p class="text-white/70 text-sm leading-relaxed mb-4">
                    Yêu cầu của bạn chưa thể hoàn tất vào lúc này. Hãy thử tải lại trang hoặc quay trở về trang chủ cửa hàng.
                </p>
                @if (ShowRequestId)
                {
                    <p class="text-[11px] text-white/70 font-mono mb-8 bg-[#202024] py-1 px-3 rounded border border-white/10 inline-block">
                        Mã yêu cầu: @RequestId
                    </p>
                }
                <div class="flex flex-col sm:flex-row justify-center gap-3">
                    <a href="." class="px-6 py-3 rounded-xl bg-[#0078f2] hover:bg-[#006bd8] text-white text-xs font-bold tracking-wide transition-all shadow-lg shadow-[#0078f2]/30">
                        Tải lại trang
                    </a>
                    <a href="/" class="px-6 py-3 rounded-xl bg-[#202024] hover:bg-[#28282d] border border-white/15 text-white text-xs font-semibold transition-all">
                        Về trang chủ
                    </a>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
