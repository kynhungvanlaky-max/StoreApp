@inherits LayoutComponentBase
@inject Frontend.ViewModels.AuthViewModel AuthViewModel
@inject Frontend.ViewModels.CartViewModel CartViewModel
@inject Frontend.ViewModels.WishlistViewModel WishlistViewModel
@inject Frontend.ViewModels.ProfileViewModel ProfileViewModel
@inject NavigationManager NavigationManager
@implements IDisposable

<div id="top" class="min-h-screen w-full max-w-full overflow-x-hidden flex flex-col bg-[#121212] text-white font-sans selection:bg-[#0078f2]/40 selection:text-white">
    <Navbar />

    <main class="nui-main flex-1 relative z-0 flex flex-col">
        @if (_requiresAuthentication && !_authReady)
        {
            <div class="flex-1 min-h-[60vh] flex items-center justify-center" role="status" aria-label="Đang kiểm tra phiên đăng nhập">
                <div class="w-10 h-10 border-2 border-white/20 border-t-[#0078f2] rounded-full animate-spin"></div>
            </div>
        }
        else if (!_requiresAuthentication || AuthViewModel.IsLoggedIn)
        {
            @Body
        }
    </main>
    
    @if (_showChatWidget)
    {
        <Frontend.Components.Layout.ChatWidget />
    }
    <Frontend.Components.Layout.ToastContainer />

    <Footer />
</div>

<div id="blazor-error-ui" data-nosnippet style="display: none;">
    Đã xảy ra lỗi ngoài dự kiến.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss" aria-label="Đóng">×</span>
</div>

@code {
    private bool _authReady;
    private bool _requiresAuthentication;
    private bool _showChatWidget;

    protected override void OnInitialized()
    {
        _requiresAuthentication = RequiresAuthentication(NavigationManager.Uri);
        _showChatWidget = ShouldShowChatWidget(NavigationManager.Uri);
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthViewModel.InitializeAsync();
            var initializers = new List<Task> { CartViewModel.InitializeAsync() };
            if (AuthViewModel.IsLoggedIn)
            {
                initializers.Add(WishlistViewModel.LoadWishlistAsync());
                initializers.Add(ProfileViewModel.LoadProfileAsync());
            }

            await Task.WhenAll(initializers);
            _authReady = true;
            RedirectAnonymousUserIfNeeded();
            StateHasChanged();
        }
    }

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        await InvokeAsync(() =>
        {
            _requiresAuthentication = RequiresAuthentication(args.Location);
            _showChatWidget = ShouldShowChatWidget(args.Location);
            RedirectAnonymousUserIfNeeded();
            StateHasChanged();
        });
    }

    private void RedirectAnonymousUserIfNeeded()
    {
        if (!_authReady || !_requiresAuthentication || AuthViewModel.IsLoggedIn)
        {
            return;
        }

        var relativePath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(relativePath)}");
    }

    private static bool RequiresAuthentication(string uri)
    {
        var path = new Uri(uri).AbsolutePath.ToLowerInvariant();
        return path.StartsWith("/profile", StringComparison.Ordinal)
            || path.StartsWith("/orders", StringComparison.Ordinal)
            || path.StartsWith("/checkout", StringComparison.Ordinal)
            || path.StartsWith("/wishlist", StringComparison.Ordinal);
    }

    private static bool ShouldShowChatWidget(string uri)
    {
        var path = new Uri(uri).AbsolutePath.ToLowerInvariant();
        return path != "/assistant"
            && path != "/login"
            && path != "/register"
            && path != "/forgot-password"
            && path != "/reset-password"
            && !path.StartsWith("/checkout", StringComparison.Ordinal);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
