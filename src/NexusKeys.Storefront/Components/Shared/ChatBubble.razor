@using Frontend.Models.Assistant

<div class="chat @(Message.Role == "user" ? "chat-end" : "chat-start")">
    <div class="chat-image avatar">
        <div class="w-8 h-8 rounded-full border @(Message.Role == "user" ? "bg-[#28282d] border-white/20 text-white" : "bg-[#0078f2]/15 border-[#0078f2]/40 text-[#0078f2]") flex items-center justify-center shadow-sm">
            @if (Message.Role == "user")
            {
                <Icon Name="HeroiconName.User" Class="w-4 h-4 text-white/80" />
            }
            else
            {
                <Icon Name="HeroiconName.CpuChip" Class="w-4 h-4 text-[#0078f2]" />
            }
        </div>
    </div>
    <div class="chat-header text-xs font-semibold text-white/70 mb-1.5 ml-1">
        @(Message.Role == "user" ? "Bạn" : "Nexus Assistant")
        <time class="text-xs text-white/50 ml-1.5">@Message.Timestamp.ToString("HH:mm")</time>
    </div>
    <div class="chat-bubble @(Message.Role == "user" ? "bg-[#0078f2] text-white shadow-md rounded-2xl" : "bg-[#202024] border border-white/10 text-white/90 shadow-sm rounded-2xl") px-4 py-2.5">
        @if (Message.Role == "assistant")
        {
            <div class="prose prose-sm prose-invert max-w-none text-white/90 leading-relaxed">
                @((MarkupString)FormatMessage(Message.Content))
            </div>
        }
        else
        {
            @Message.Content
        }
    </div>
</div>

@code {
    [Parameter]
    public ChatMessage Message { get; set; } = default!;

    private string FormatMessage(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        
        var encoded = System.Net.WebUtility.HtmlEncode(content);
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        encoded = encoded.Replace("\n", "<br/>");
        
        return encoded;
    }
}
