@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var adminName = ViewData["AdminName"]?.ToString() ?? Context.Request.Cookies["admin_name"] ?? "Quản trị viên";
    var adminEmail = ViewData["AdminEmail"]?.ToString() ?? Context.Request.Cookies["admin_email"] ?? string.Empty;
    var adminRole = ViewData["AdminRole"]?.ToString() ?? (Context.Items["AdminRole"] as string) ?? Backend.Extensions.JwtRoleExtractor.ExtractRole(Context.Request.Cookies["access_token"]) ?? "Administrator";
    var isAdmin = string.Equals(adminRole, "Administrator", StringComparison.OrdinalIgnoreCase);
    var isDeveloper = string.Equals(adminRole, "Developer", StringComparison.OrdinalIgnoreCase);
    var isStaff = string.Equals(adminRole, "Staff", StringComparison.OrdinalIgnoreCase);
    var roleDisplayName = isAdmin ? "Quản Trị Viên" : (isDeveloper ? "Developer" : "Nhân Viên");
    var panelSubtitle = isAdmin ? "Admin Control" : (isDeveloper ? "Developer Studio" : "Staff Panel");
    var apiOnline = Equals(Context.Items["ApiOnline"], true);
    var frontendBaseUrl = Configuration["AppSettings:FrontendBaseUrl"]?.TrimEnd('/') ?? "http://localhost:5205";
}
<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@antiforgeryToken" />
    <title>@ViewData["Title"] - NEXUS Management Portal</title>
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexus-admin.css" asp-append-version="true" />
</head>
<body class="bg-slate-50 text-slate-800 h-screen overflow-hidden flex font-sans selection:bg-indigo-500/20 selection:text-indigo-700">

    <!-- SIDEBAR NAVIGATION CONTAINER -->
    <div id="sidebarOverlay" class="hidden fixed inset-0 z-30 bg-slate-900/50 backdrop-blur-sm lg:hidden" onclick="toggleSidebar(false)"></div>
    <aside id="adminSidebar" class="fixed inset-y-0 left-0 w-72 -translate-x-full lg:translate-x-0 lg:static bg-white border-r border-slate-200 h-screen flex flex-col shadow-sm z-40 flex-shrink-0 transition-transform duration-200">
        
        <!-- Sidebar Brand Logo Header -->
        <div class="h-[76px] flex items-center px-6 border-b border-slate-100 justify-between">
            <a href="/" class="flex items-center gap-3 text-slate-900 group">
                <div class="admin-brand-mark group-hover:-rotate-3 group-hover:scale-105 transition-transform flex-shrink-0">
                    <svg class="w-6 h-6" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M13 35V13L35 35V13" stroke="currentColor" stroke-width="4.5" stroke-linecap="square" stroke-linejoin="miter" />
                        <circle cx="24" cy="24" r="3.5" fill="currentColor" />
                        <path d="M24 27.5V34" stroke="currentColor" stroke-width="3" stroke-linecap="square" />
                    </svg>
                </div>
                <div class="flex flex-col">
                    <div class="admin-brand-wordmark flex items-center leading-tight">
                        <span>NEXUS</span><span>KEYS</span>
                    </div>
                    <span class="admin-brand-subtitle">@panelSubtitle</span>
                </div>
            </a>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold @(isAdmin ? "bg-indigo-50 text-indigo-700 border-indigo-200" : (isDeveloper ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-sky-50 text-sky-700 border-sky-200")) border leading-normal min-h-[16px] inline-flex items-center">@roleDisplayName</span>
        </div>

        <!-- Sidebar Navigation Menu Links -->
        <nav class="flex-1 px-4 py-6 flex flex-col gap-1.5 overflow-y-auto custom-scrollbar">
            
            <!-- SECTION 1: TỔNG QUAN -->
            <div class="text-[11px] font-extrabold text-slate-400 mb-1.5 px-3 uppercase tracking-wider">Tổng Quan</div>
            <a href="/" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "sidebar-link-active" : "sidebar-link-inactive")">
                <i class="fa-solid fa-chart-pie text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "text-indigo-600" : "text-slate-400")"></i>
                <span>Dashboard</span>
            </a>

            <!-- SECTION 2: QUẢN LÝ THƯƠNG MẠI -->
            <div class="text-[11px] font-extrabold text-slate-400 mb-1.5 mt-5 px-3 uppercase tracking-wider">Quản Lý Thương Mại</div>
            
            <a href="/Products" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "sidebar-link-active" : "sidebar-link-inactive")">
                <i class="fa-solid fa-gamepad text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "text-indigo-600" : "text-slate-400")"></i>
                <span class="flex-1">Sản Phẩm (Game)</span>
            </a>

            <a href="/Orders" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Orders" ? "sidebar-link-active" : "sidebar-link-inactive")">
                <i class="fa-solid fa-receipt text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Orders" ? "text-indigo-600" : "text-slate-400")"></i>
                <span class="flex-1">Đơn Hàng</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 leading-normal min-h-[16px] inline-flex items-center">Mới</span>
            </a>

            <a href="/Keys" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Keys" ? "sidebar-link-active" : "sidebar-link-inactive")">
                <i class="fa-solid fa-key text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Keys" ? "text-indigo-600" : "text-slate-400")"></i>
                <span class="flex-1">Kho Key Game</span>
            </a>

            @if (isAdmin)
            {
                <a href="/Users" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "sidebar-link-active" : "sidebar-link-inactive")">
                    <i class="fa-solid fa-users text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "text-indigo-600" : "text-slate-400")"></i>
                    <span class="flex-1">Khách Hàng</span>
                </a>

                <a href="/Coupons" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Coupons" ? "sidebar-link-active" : "sidebar-link-inactive")">
                    <i class="fa-solid fa-ticket text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Coupons" ? "text-indigo-600" : "text-slate-400")"></i>
                    <span class="flex-1">Mã Giảm Giá</span>
                </a>

                <a href="/Promotions" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Promotions" ? "sidebar-link-active" : "sidebar-link-inactive")">
                    <i class="fa-solid fa-bullhorn text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Promotions" ? "text-indigo-600" : "text-slate-400")"></i>
                    <span class="flex-1">Khuyến Mãi</span>
                </a>
            }

            <!-- SECTION 3: NỘI DUNG & CẤU HÌNH -->
            <div class="text-[11px] font-extrabold text-slate-400 mb-1.5 mt-5 px-3 uppercase tracking-wider">Nội Dung & Cấu Hình</div>

            <a href="/Comments" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Comments" ? "sidebar-link-active" : "sidebar-link-inactive")">
                <i class="fa-solid fa-comments text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Comments" ? "text-indigo-600" : "text-slate-400")"></i>
                <span class="flex-1">Đánh Giá & Bình Luận</span>
            </a>

            <a href="/News" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "News" ? "sidebar-link-active" : "sidebar-link-inactive")">
                <i class="fa-solid fa-newspaper text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "News" ? "text-indigo-600" : "text-slate-400")"></i>
                <span class="flex-1">Tin Tức & Bài Viết</span>
            </a>

            <a href="/Support" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Support" ? "sidebar-link-active" : "sidebar-link-inactive")">
                <i class="fa-solid fa-headset text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Support" ? "text-indigo-600" : "text-slate-400")"></i>
                <span class="flex-1">Yêu Cầu Hỗ Trợ</span>
            </a>

            @if (isAdmin)
            {
                <a href="/PaymentConfigs" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PaymentConfigs" ? "sidebar-link-active" : "sidebar-link-inactive")">
                    <i class="fa-solid fa-credit-card text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PaymentConfigs" ? "text-indigo-600" : "text-slate-400")"></i>
                    <span class="flex-1">Cổng Thanh Toán</span>
                </a>

                <a href="/AiAssistantConfigs" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AiAssistantConfigs" ? "sidebar-link-active" : "sidebar-link-inactive")">
                    <i class="fa-solid fa-robot text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AiAssistantConfigs" ? "text-indigo-600" : "text-slate-400")"></i>
                    <span class="flex-1">Cấu Hình Trợ Lý AI</span>
                </a>

                <!-- SECTION 4: HỆ THỐNG (CHỈ DÀNH CHO ADMIN) -->
                <div class="text-[11px] font-extrabold text-slate-400 mb-1.5 mt-5 px-3 uppercase tracking-wider">Hệ Thống</div>

                <a href="/Transactions" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transactions" ? "sidebar-link-active" : "sidebar-link-inactive")">
                    <i class="fa-solid fa-money-bill-transfer text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transactions" ? "text-indigo-600" : "text-slate-400")"></i>
                    <span class="flex-1">Lịch Sử Giao Dịch</span>
                </a>

                <a href="/AuditLogs" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AuditLogs" ? "sidebar-link-active" : "sidebar-link-inactive")">
                    <i class="fa-solid fa-shield-halved text-base @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AuditLogs" ? "text-indigo-600" : "text-slate-400")"></i>
                    <span class="flex-1">Nhật Ký Hệ Thống</span>
                </a>
            }

        </nav>

        <!-- Sidebar Footer Admin User Card & Logout -->
        <div class="p-4 border-t border-slate-100 bg-slate-50/60">
            <div class="flex items-center gap-3 p-2 rounded-xl bg-white border border-slate-200/80 mb-3 shadow-2xs">
                <div class="w-9 h-9 rounded-lg @(isAdmin ? "bg-indigo-600" : (isDeveloper ? "bg-emerald-600" : "bg-sky-600")) flex items-center justify-center text-white font-black text-sm shadow-sm flex-shrink-0">
                    @(adminName.Length > 0 ? adminName.Substring(0, 1).ToUpperInvariant() : "U")
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-black text-slate-800 truncate">@adminName</p>
                    <p class="text-[11px] @(isAdmin ? "text-indigo-600" : (isDeveloper ? "text-emerald-600" : "text-sky-600")) font-semibold truncate">@roleDisplayName</p>
                </div>
            </div>
            <a href="@frontendBaseUrl" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200/80 rounded-xl font-bold transition-all text-xs mb-2 shadow-2xs">
                <i class="fa-solid fa-store"></i>
                <span>Xem Cửa Hàng</span>
            </a>
            <form method="post" asp-controller="Auth" asp-action="Logout">
                <button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200/80 rounded-xl font-bold transition-all text-xs shadow-2xs active:scale-95">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Đăng Xuất</span>
                </button>
            </form>
        </div>

    </aside>

    <!-- MAIN BODY CONTAINER -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden bg-slate-50">
        
        <!-- Header Top Navigation Bar -->
        <header class="h-[76px] bg-white/90 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-20 flex items-center justify-between px-4 sm:px-6 lg:px-8 shadow-2xs">
            
            <div class="flex items-center gap-4">
                <button type="button" class="lg:hidden w-10 h-10 rounded-xl border border-slate-200 bg-white text-slate-600" onclick="toggleSidebar(true)" aria-label="Mở menu quản trị">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h2 class="text-xl font-black text-slate-900 tracking-tight">@ViewData["Title"]</h2>
            </div>

            <div class="flex items-center gap-5">
                <!-- System Status Indicator Badge -->
                <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs font-bold shadow-2xs @(apiOnline ? "bg-emerald-50 text-emerald-700 border-emerald-200/80" : "bg-rose-50 text-rose-700 border-rose-200/80")">
                    <span class="w-2 h-2 rounded-full @(apiOnline ? "bg-emerald-500 animate-pulse" : "bg-rose-500")"></span>
                    <span>@(apiOnline ? "API hoạt động" : "API gián đoạn")</span>
                </div>

                <!-- Admin / Staff / Developer Info Header Avatar -->
                <div class="flex items-center gap-3 border-l border-slate-200/80 pl-5">
                    <div class="w-9 h-9 rounded-xl @(isAdmin ? "bg-indigo-600 shadow-indigo-200" : (isDeveloper ? "bg-emerald-600 shadow-emerald-200" : "bg-sky-600 shadow-sky-200")) text-white flex items-center justify-center font-black text-sm shadow-xs flex-shrink-0">
                        @(adminName.Length > 0 ? adminName.Substring(0, 1).ToUpperInvariant() : "U")
                    </div>
                    <div class="hidden md:block">
                        <p class="text-xs font-extrabold text-slate-800 leading-tight">@adminName</p>
                        <p class="text-[11px] @(isAdmin ? "text-indigo-600" : (isDeveloper ? "text-emerald-600" : "text-sky-600")) font-medium">@roleDisplayName</p>
                    </div>
                </div>
            </div>

        </header>

        <!-- Main Body Scrollable View -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="bg-emerald-50 text-emerald-800 p-4 rounded-2xl mb-6 font-semibold border border-emerald-200 flex items-center gap-3 shadow-2xs">
                    <i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="bg-rose-50 text-rose-800 p-4 rounded-2xl mb-6 font-semibold border border-rose-200 flex items-center gap-3 shadow-2xs">
                    <i class="fa-solid fa-circle-exclamation text-rose-600 text-lg"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Script imports -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        function toggleSidebar(open) {
            document.getElementById('adminSidebar')?.classList.toggle('-translate-x-full', !open);
            document.getElementById('sidebarOverlay')?.classList.toggle('hidden', !open);
        }

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>'"]/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            })[character]);
        }

        function safeUrl(value) {
            try {
                const url = new URL(value, window.location.origin);
                return ['http:', 'https:'].includes(url.protocol) ? escapeHtml(url.href) : '';
            } catch {
                return '';
            }
        }

        async function apiFetch(url, options = {}) {
            const headers = new Headers(options.headers || {});
            const token = document.querySelector('meta[name="request-verification-token"]')?.content;
            if (token && !['GET', 'HEAD', 'OPTIONS'].includes((options.method || 'GET').toUpperCase())) {
                headers.set('RequestVerificationToken', token);
            }

            const response = await fetch(url, { ...options, headers });
            if (response.status === 401 || response.status === 403) {
                window.location.href = '/Auth/Login?expired=true';
            }
            return response;
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
