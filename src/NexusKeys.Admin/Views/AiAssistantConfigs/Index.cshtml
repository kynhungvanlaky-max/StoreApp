@model Backend.Models.AiAssistantConfigViewModel

@{
    ViewData["Title"] = "Cấu Hình Trợ Lý AI";
}

<!-- Floating Toast Container -->
<div id="toastContainer" class="fixed top-6 right-6 z-50 flex flex-col gap-3 pointer-events-none"></div>

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 border-b border-slate-100 pb-6">
        <div>
            <div class="flex items-center gap-3">
                <h3 class="text-xl font-black text-slate-800">Cấu Hình Trợ Lý Ảo Nexus AI</h3>
                <span id="statusBadge" class="px-2.5 py-0.5 rounded-full text-xs font-black transition-colors @(Model.IsEnabled ? "bg-emerald-100 text-emerald-700" : "bg-rose-100 text-rose-700")">
                    @(Model.IsEnabled ? "Đang Bật" : "Tạm Tắt")
                </span>
            </div>
            <p class="text-xs text-slate-400 font-medium mt-1">Cấu hình mô hình ngôn ngữ lớn (LLM), API Key, tính cách (Persona) và thử nghiệm trực tiếp.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" onclick="loadDefaultPrompt()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold transition-all text-xs flex items-center gap-2 active:scale-95">
                <i class="fa-solid fa-rotate-left"></i>
                <span>Nạp Prompt Chuẩn</span>
            </button>
            <button type="button" id="btnSaveConfig" onclick="saveConfigs()" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold shadow-sm shadow-indigo-200 transition-all active:scale-95 text-xs flex items-center gap-2">
                <i class="fa-solid fa-floppy-disk" id="saveIcon"></i>
                <span id="saveText">Lưu Cấu Hình</span>
            </button>
        </div>
    </div>

    <!-- Main Configs Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-8">
        
        <!-- Left Column: Configuration Cards (7 cols) -->
        <div class="xl:col-span-7 space-y-8">

            <!-- 1. Chế Độ Hoạt Động Card -->
            <div class="border border-slate-200 rounded-3xl p-6 bg-slate-50/50 transition-all duration-300">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-200/80">
                    <div class="w-10 h-10 rounded-2xl bg-indigo-100 text-indigo-600 font-black flex items-center justify-center text-sm">
                        <i class="fa-solid fa-sliders"></i>
                    </div>
                    <div>
                        <h4 class="text-base font-extrabold text-slate-800">Chế Độ Hoạt Động & Nhà Cung Cấp</h4>
                        <span class="text-xs font-bold text-slate-500">Thiết lập nguồn xử lý AI chính cho website</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Toggle Switch -->
                    <div class="p-4 bg-white border border-slate-200 rounded-2xl flex items-center justify-between shadow-xs">
                        <div>
                            <div class="text-xs font-bold text-slate-800 uppercase tracking-wider">Trạng Thái AI</div>
                            <div class="text-[11px] text-slate-400 font-medium mt-0.5">Bật/Tắt chat trên toàn website</div>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="ai_IsEnabled" class="sr-only peer" @(Model.IsEnabled ? "checked" : "") onchange="updateStatusBadge(this.checked)">
                            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                        </label>
                    </div>

                    <!-- Provider Selection -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Mô Hình Ưu Tiên (Provider)</label>
                        <select id="ai_Provider" onchange="highlightActiveProvider()" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 font-bold focus:border-indigo-600 focus:outline-none shadow-xs">
                            <!option value="Auto" @(Model.Provider == "Auto" ? "selected" : "")>Auto (Gemini ưu tiên, fallback Ollama)</!option>
                            <!option value="Gemini" @(Model.Provider == "Gemini" ? "selected" : "")>Google Gemini (Cloud API)</!option>
                            <!option value="Ollama" @(Model.Provider == "Ollama" ? "selected" : "")>Ollama (Local AI Server)</!option>
                            <!option value="Disabled" @(Model.Provider == "Disabled" ? "selected" : "")>Tạm ngưng phục vụ</!option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- 2. Google Gemini Card -->
            <div id="cardGemini" class="border border-slate-200 rounded-3xl p-6 bg-slate-50/50 transition-all duration-300">
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200/80">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-blue-100 text-blue-600 font-black flex items-center justify-center text-sm">
                            <i class="fa-brands fa-google"></i>
                        </div>
                        <div>
                            <h4 class="text-base font-extrabold text-slate-800">Cổng Google Gemini AI</h4>
                            <span class="text-xs font-bold text-blue-600">Cloud API (Tốc Độ Cao)</span>
                        </div>
                    </div>
                    <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-xl font-bold transition-colors text-xs flex items-center gap-1.5 active:scale-95" title="Mở Google AI Studio để lấy API Key miễn phí">
                        <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                        <span>Lấy API Key</span>
                    </a>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Gemini API Key</label>
                        <div class="relative">
                            <input type="password" id="gemini_ApiKey" value="@Model.GeminiApiKey" placeholder="AIzaSy..." class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 font-mono font-bold pr-10 focus:border-indigo-600 focus:outline-none shadow-xs" />
                            <button type="button" onclick="togglePasswordVisibility('gemini_ApiKey')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-sm" title="Hiện/Ẩn API Key">
                                <i class="fa-solid fa-eye" id="gemini_ApiKey_icon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Model Name</label>
                            <select id="gemini_Model" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 font-bold focus:border-indigo-600 focus:outline-none shadow-xs">
                                <!option value="gemini-3.7-flash" @(Model.GeminiModel == "gemini-3.7-flash" ? "selected" : "")>gemini-3.7-flash (Mới nhất)</!option>
                                <!option value="gemini-3.6-flash" @(Model.GeminiModel == "gemini-3.6-flash" ? "selected" : "")>gemini-3.6-flash (Mặc định)</!option>
                                <!option value="gemini-2.5-flash" @(Model.GeminiModel == "gemini-2.5-flash" ? "selected" : "")>gemini-2.5-flash</!option>
                                <!option value="gemini-2.5-pro" @(Model.GeminiModel == "gemini-2.5-pro" ? "selected" : "")>gemini-2.5-pro</!option>
                                <!option value="gemini-1.5-flash" @(Model.GeminiModel == "gemini-1.5-flash" ? "selected" : "")>gemini-1.5-flash</!option>
                            </select>
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Temperature</label>
                                <span id="tempValueLabel" class="text-xs font-black text-indigo-600">@Model.GeminiTemperature</span>
                            </div>
                            <input type="range" id="gemini_Temperature" min="0.0" max="1.0" step="0.05" value="@Model.GeminiTemperature" oninput="updateTemperatureLabel(this.value)" class="w-full accent-indigo-600 cursor-pointer mt-2" />
                            <div class="flex justify-between text-xs text-slate-500 font-medium mt-1">
                                <span id="tempDesc">0.7 (Cân bằng & tự nhiên)</span>
                                <span>Tối đa: 1.0</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Ollama Card -->
            <div id="cardOllama" class="border border-slate-200 rounded-3xl p-6 bg-slate-50/50 transition-all duration-300">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-200/80">
                    <div class="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-600 font-black flex items-center justify-center text-sm">
                        <i class="fa-solid fa-server"></i>
                    </div>
                    <div>
                        <h4 class="text-base font-extrabold text-slate-800">Máy Chủ Ollama Local</h4>
                        <span class="text-xs font-bold text-emerald-600">Chạy Nội Bộ / Offline</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Ollama Base URL</label>
                        <input type="text" id="ollama_BaseUrl" value="@Model.OllamaBaseUrl" placeholder="http://localhost:11434" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 font-mono font-bold focus:border-indigo-600 focus:outline-none shadow-xs" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Model Name</label>
                        <input type="text" id="ollama_Model" value="@Model.OllamaModel" placeholder="qwen2.5:0.5b, llama3..." class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 font-mono font-bold focus:border-indigo-600 focus:outline-none shadow-xs" />
                    </div>
                </div>
            </div>

            <!-- 4. Persona & System Prompt Card -->
            <div class="border border-slate-200 rounded-3xl p-6 bg-slate-50/50">
                <div class="flex items-center justify-between mb-4 pb-4 border-b border-slate-200/80">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-purple-100 text-purple-600 font-black flex items-center justify-center text-sm">
                            <i class="fa-solid fa-brain"></i>
                        </div>
                        <div>
                            <h4 class="text-base font-extrabold text-slate-800">Tính Cách & Chỉ Dẫn Hệ Thống (System Prompt)</h4>
                            <span class="text-xs font-bold text-purple-600">Quy tắc giao tiếp và ngữ cảnh trợ lý</span>
                        </div>
                    </div>
                </div>

                <!-- Interactive Variable Insertion Chips -->
                <div class="mb-3">
                    <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Nhấp để chèn biến động vào vị trí con trỏ:</div>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" onclick="insertVariable('{UserName}')" class="px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 text-indigo-700 rounded-lg text-xs font-mono font-bold transition-all active:scale-95 flex items-center gap-1.5" title="Tên người dùng đang đăng nhập">
                            <i class="fa-solid fa-user text-xs"></i> {UserName}
                        </button>
                        <button type="button" onclick="insertVariable('{WalletBalance}')" class="px-2.5 py-1 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 rounded-lg text-xs font-mono font-bold transition-all active:scale-95 flex items-center gap-1.5" title="Số dư ví Nexus">
                            <i class="fa-solid fa-wallet text-xs"></i> {WalletBalance}
                        </button>
                        <button type="button" onclick="insertVariable('{OwnedGames}')" class="px-2.5 py-1 bg-purple-50 hover:bg-purple-100 border border-purple-200 text-purple-700 rounded-lg text-xs font-mono font-bold transition-all active:scale-95 flex items-center gap-1.5" title="Danh sách game đã sở hữu">
                            <i class="fa-solid fa-gamepad text-xs"></i> {OwnedGames}
                        </button>
                        <button type="button" onclick="insertVariable('{HotGames}')" class="px-2.5 py-1 bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-700 rounded-lg text-xs font-mono font-bold transition-all active:scale-95 flex items-center gap-1.5" title="Danh sách game bán chạy & giá">
                            <i class="fa-solid fa-fire text-xs"></i> {HotGames}
                        </button>
                    </div>
                </div>
                
                <textarea id="ai_SystemPrompt" rows="8" oninput="updatePromptCounter()" class="w-full bg-white border border-slate-200 rounded-2xl p-4 text-xs text-slate-800 font-mono font-medium leading-relaxed focus:border-indigo-600 focus:outline-none shadow-xs" placeholder="Nhập chỉ dẫn tính cách cho trợ lý ảo...">@Model.SystemPrompt</textarea>

                <!-- Prompt Counter Footer -->
                <div class="flex justify-between items-center text-[11px] text-slate-400 font-medium mt-2 px-1">
                    <span id="promptCharCount">Số ký tự: 0</span>
                    <span id="promptTokenEstimate">Ước tính: ~0 tokens</span>
                </div>
            </div>

        </div>

        <!-- Right Column: Live Test Chat Sandbox (5 cols) -->
        <div class="xl:col-span-5">
            <div class="border border-slate-200 rounded-3xl p-6 bg-slate-50/50 sticky top-24 shadow-sm">
                <div class="flex items-center justify-between mb-4 pb-4 border-b border-slate-200/80">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-600 font-black flex items-center justify-center text-sm">
                            <i class="fa-solid fa-flask"></i>
                        </div>
                        <div>
                            <h4 class="text-base font-extrabold text-slate-800">Thử Nghiệm Trực Tiếp</h4>
                            <span class="text-xs font-bold text-amber-600">Sandbox Kiểm Tra Phản Hồi</span>
                        </div>
                    </div>
                    <button type="button" onclick="clearTestChat()" class="p-2 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-200/60 transition-colors text-sm" title="Xóa lịch sử chat thử">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>

                <!-- Chat Box Messages -->
                <div id="testChatMessages" class="h-96 overflow-y-auto space-y-3 p-4 bg-white rounded-2xl border border-slate-200 text-xs custom-scrollbar mb-4 shadow-inner">
                    <div class="flex gap-2.5 items-start">
                        <div class="w-7 h-7 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <div class="bg-slate-50 p-3.5 rounded-2xl rounded-tl-none border border-slate-200 text-slate-800 shadow-2xs max-w-[85%] leading-relaxed">
                            Xin chào Admin! Tôi là Nexus Assistant. Bạn có thể gửi câu hỏi bất kỳ để kiểm tra cấu hình vừa thiết lập.
                        </div>
                    </div>
                </div>

                <!-- Quick Prompts -->
                <div class="mb-3">
                    <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Gợi ý câu hỏi nhanh:</div>
                    <div class="flex flex-wrap gap-1.5">
                        <button type="button" onclick="setQuickTest('Cửa hàng có game bắn súng nào hot không?')" class="px-2.5 py-1 bg-white hover:bg-slate-100 border border-slate-200 rounded-xl text-[11px] text-slate-600 font-bold transition-colors active:scale-95">
                            🔥 Game hot?
                        </button>
                        <button type="button" onclick="setQuickTest('Số dư ví của tôi hiện tại là bao nhiêu?')" class="px-2.5 py-1 bg-white hover:bg-slate-100 border border-slate-200 rounded-xl text-[11px] text-slate-600 font-bold transition-colors active:scale-95">
                            💰 Số dư ví?
                        </button>
                        <button type="button" onclick="setQuickTest('Giải thích thuyết tương đối của Einstein?')" class="px-2.5 py-1 bg-white hover:bg-slate-100 border border-slate-200 rounded-xl text-[11px] text-slate-600 font-bold transition-colors active:scale-95">
                            🚫 Câu hỏi ngoài lề?
                        </button>
                    </div>
                </div>

                <!-- Input Box -->
                <div class="relative">
                    <input type="text" id="testInputMessage" placeholder="Nhập câu hỏi thử nghiệm..." onkeydown="if(event.key==='Enter' && !event.shiftKey){ event.preventDefault(); sendTestChat(); }" class="w-full bg-white border border-slate-200 rounded-xl pl-4 pr-12 py-3 text-xs text-slate-800 font-medium focus:border-indigo-600 focus:outline-none shadow-xs" />
                    <button type="button" id="btnSendTest" onclick="sendTestChat()" class="absolute right-1.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white flex items-center justify-center text-xs transition-all active:scale-95 shadow-sm" title="Gửi câu hỏi">
                        <i class="fa-solid fa-paper-plane" id="sendIcon"></i>
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    const DEFAULT_PROMPT = `Bạn là Nexus Assistant - Trợ lý ảo AI CHUYÊN NGHIỆP của cửa hàng game NexusKeys.
TỪ CHỐI TẤT CẢ CÁC CÂU HỎI KHÔNG LIÊN QUAN ĐẾN: Game, Ứng dụng, Mua bán, Tài khoản, hoặc Cửa hàng NexusKeys.
Nếu người dùng hỏi về chính trị, toán học, lập trình (ngoài game), hoặc bất cứ chủ đề nào ngoài lề, hãy trả lời: 'Xin lỗi, tôi chỉ là trợ lý của NexusKeys nên chỉ có thể hỗ trợ bạn các vấn đề về game, sản phẩm và dịch vụ của cửa hàng.'

BẠN PHẢI TRẢ LỜI NGẮN GỌN, LỊCH SỰ BẰNG TIẾNG VIỆT, KHÔNG DÀI DÒNG. Dùng cấu trúc Markdown để in đậm tên game.

THÔNG TIN NGƯỜI DÙNG HIỆN TẠI:
- Tên: {UserName}
- Số dư ví: {WalletBalance} VNĐ
- Các game đã sở hữu: {OwnedGames}

THÔNG TIN CỬA HÀNG (SẢN PHẨM HOT):
- {HotGames}

NHIỆM VỤ CỦA BẠN:
1. Trả lời câu hỏi của người dùng CẦN BÁM SÁT THÔNG TIN VỀ GAME VÀ CỬA HÀNG.
2. Nếu người dùng hỏi số dư ví, hãy báo cho họ biết chính xác.
3. Nếu người dùng nhờ gợi ý game, hãy gợi ý từ danh sách SẢN PHẨM HOT và KHÔNG gợi ý game họ đã sở hữu.
4. LUÔN LUÔN TỪ CHỐI TRẢ LỜI CÁC CÂU HỎI NGOÀI LỀ. Trả lời súc tích, dưới 120 chữ.`;

    // Toast Notification Utility
    function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        const bgClass = type === 'success' ? 'bg-emerald-600 text-white' : (type === 'warning' ? 'bg-amber-600 text-white' : 'bg-rose-600 text-white');
        const icon = type === 'success' ? 'fa-check-circle' : (type === 'warning' ? 'fa-triangle-exclamation' : 'fa-circle-xmark');
        
        toast.className = `${bgClass} px-5 py-3 rounded-2xl shadow-xl flex items-center gap-3 text-xs font-bold pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-300`;
        toast.innerHTML = `<i class="fa-solid ${icon} text-sm"></i> <span>${message}</span>`;
        
        container.appendChild(toast);
        setTimeout(() => {
            toast.classList.remove('translate-y-2', 'opacity-0');
        }, 10);

        setTimeout(() => {
            toast.classList.add('translate-y-2', 'opacity-0');
            setTimeout(() => toast.remove(), 300);
        }, 3500);
    }

    // Markdown Formatter for Test Chat
    function formatMarkdown(text) {
        if (!text) return '';
        let escaped = text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
        
        // Bold: **text**
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="font-black text-indigo-700">$1</strong>');
        // Italic: *text*
        escaped = escaped.replace(/\*(.*?)\*/g, '<em class="italic">$1</em>');
        // Inline code: `text`
        escaped = escaped.replace(/`(.*?)`/g, '<code class="bg-slate-200 px-1 py-0.5 rounded font-mono text-[11px]">$1</code>');
        // Line breaks
        escaped = escaped.replace(/\n/g, '<br/>');
        return escaped;
    }

    // Insert variable at cursor position in System Prompt textarea
    function insertVariable(variable) {
        const textarea = document.getElementById('ai_SystemPrompt');
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;
        
        textarea.value = text.substring(0, start) + variable + text.substring(end);
        textarea.focus();
        textarea.selectionStart = textarea.selectionEnd = start + variable.length;
        updatePromptCounter();
        showToast(`Đã chèn biến ${variable}`, 'success');
    }

    // Live update Prompt Counter
    function updatePromptCounter() {
        const text = document.getElementById('ai_SystemPrompt').value || '';
        const charCount = text.length;
        const tokenEstimate = Math.ceil(charCount / 4);
        document.getElementById('promptCharCount').innerText = `Số ký tự: ${charCount.toLocaleString('vi-VN')}`;
        document.getElementById('promptTokenEstimate').innerText = `Ước tính: ~${tokenEstimate.toLocaleString('vi-VN')} tokens`;
    }

    // Temperature dynamic description
    function updateTemperatureLabel(val) {
        document.getElementById('tempValueLabel').innerText = val;
        const num = parseFloat(val);
        const desc = document.getElementById('tempDesc');
        if (num < 0.3) {
            desc.innerText = `${num} (Rất chính xác, trả lời theo mẫu)`;
        } else if (num <= 0.75) {
            desc.innerText = `${num} (Cân bằng & tự nhiên - Khuyên dùng)`;
        } else {
            desc.innerText = `${num} (Sáng tạo cao, linh hoạt)`;
        }
    }

    // Highlight card based on selected Provider
    function highlightActiveProvider() {
        const provider = document.getElementById('ai_Provider').value;
        const cardGemini = document.getElementById('cardGemini');
        const cardOllama = document.getElementById('cardOllama');

        if (provider === 'Gemini') {
            cardGemini.classList.remove('opacity-60');
            cardGemini.classList.add('ring-2', 'ring-blue-500/20', 'border-blue-300');
            cardOllama.classList.add('opacity-60');
            cardOllama.classList.remove('ring-2', 'ring-emerald-500/20', 'border-emerald-300');
        } else if (provider === 'Ollama') {
            cardOllama.classList.remove('opacity-60');
            cardOllama.classList.add('ring-2', 'ring-emerald-500/20', 'border-emerald-300');
            cardGemini.classList.add('opacity-60');
            cardGemini.classList.remove('ring-2', 'ring-blue-500/20', 'border-blue-300');
        } else {
            cardGemini.classList.remove('opacity-60', 'ring-2', 'ring-blue-500/20', 'border-blue-300');
            cardOllama.classList.remove('opacity-60', 'ring-2', 'ring-emerald-500/20', 'border-emerald-300');
        }
    }

    function loadDefaultPrompt() {
        if (confirm("Bạn có chắc chắn muốn nạp lại mẫu System Prompt chuẩn của hệ thống?")) {
            document.getElementById('ai_SystemPrompt').value = DEFAULT_PROMPT;
            updatePromptCounter();
            showToast("Đã nạp lại Prompt chuẩn thành công!", "success");
        }
    }

    function togglePasswordVisibility(id) {
        const input = document.getElementById(id);
        const icon = document.getElementById(id + '_icon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    function updateStatusBadge(checked) {
        const badge = document.getElementById('statusBadge');
        if (checked) {
            badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-black bg-emerald-100 text-emerald-700';
            badge.innerText = 'Đang Bật';
            showToast("Đã kích hoạt Trợ lý AI trên website", "success");
        } else {
            badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-black bg-rose-100 text-rose-700';
            badge.innerText = 'Tạm Tắt';
            showToast("Đã tạm tắt Trợ lý AI trên website", "warning");
        }
    }

    function setQuickTest(msg) {
        document.getElementById('testInputMessage').value = msg;
        sendTestChat();
    }

    function clearTestChat() {
        document.getElementById('testChatMessages').innerHTML = `
            <div class="flex gap-2.5 items-start">
                <div class="w-7 h-7 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                    <i class="fa-solid fa-robot"></i>
                </div>
                <div class="bg-slate-50 p-3.5 rounded-2xl rounded-tl-none border border-slate-200 text-slate-800 shadow-2xs max-w-[85%] leading-relaxed">
                    Lịch sử chat đã được xóa. Bạn có thể gửi câu hỏi mới.
                </div>
            </div>`;
        showToast("Đã xóa lịch sử chat thử nghiệm", "success");
    }

    async function saveConfigs() {
        const btn = document.getElementById('btnSaveConfig');
        const saveIcon = document.getElementById('saveIcon');
        const saveText = document.getElementById('saveText');

        // Loading state
        btn.disabled = true;
        saveIcon.className = "fa-solid fa-circle-notch fa-spin";
        saveText.innerText = "Đang Lưu...";

        const payload = [
            { configKey: 'AiAssistant:IsEnabled', configValue: document.getElementById('ai_IsEnabled').checked ? 'true' : 'false' },
            { configKey: 'AiAssistant:Provider', configValue: document.getElementById('ai_Provider').value },
            { configKey: 'AiAssistant:Gemini:ApiKey', configValue: document.getElementById('gemini_ApiKey').value.trim() },
            { configKey: 'AiAssistant:Gemini:Model', configValue: document.getElementById('gemini_Model').value },
            { configKey: 'AiAssistant:Gemini:Temperature', configValue: document.getElementById('gemini_Temperature').value },
            { configKey: 'AiAssistant:Ollama:BaseUrl', configValue: document.getElementById('ollama_BaseUrl').value.trim() },
            { configKey: 'AiAssistant:Ollama:Model', configValue: document.getElementById('ollama_Model').value.trim() },
            { configKey: 'AiAssistant:SystemPrompt', configValue: document.getElementById('ai_SystemPrompt').value }
        ];

        try {
            const res = await apiFetch('/api-proxy/api/v1/assistant/configurations', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                showToast("Lưu cấu hình Trợ lý AI thành công!", "success");
            } else {
                showToast(`Lỗi khi lưu cấu hình (Mã lỗi: ${res.status})`, "error");
            }
        } catch (e) {
            console.error(e);
            showToast("Lỗi kết nối tới máy chủ API.", "error");
        } finally {
            btn.disabled = false;
            saveIcon.className = "fa-solid fa-floppy-disk";
            saveText.innerText = "Lưu Cấu Hình";
        }
    }

    async function sendTestChat() {
        const input = document.getElementById('testInputMessage');
        const text = input.value.trim();
        if (!text) return;

        input.value = '';
        const container = document.getElementById('testChatMessages');
        const btnSend = document.getElementById('btnSendTest');
        const sendIcon = document.getElementById('sendIcon');

        // Append user bubble
        container.innerHTML += `
            <div class="flex gap-2 justify-end">
                <div class="bg-indigo-600 text-white p-3 rounded-2xl rounded-tr-none text-xs shadow-2xs max-w-[85%] font-medium leading-relaxed">
                    ${text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}
                </div>
            </div>`;

        // Append typing indicator
        const loadingId = 'loading_' + Date.now();
        container.innerHTML += `
            <div id="${loadingId}" class="flex gap-2.5 items-start">
                <div class="w-7 h-7 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                    <i class="fa-solid fa-robot"></i>
                </div>
                <div class="bg-slate-50 p-3 rounded-2xl rounded-tl-none border border-slate-200 text-slate-500 shadow-2xs max-w-[85%] flex items-center gap-2">
                    <i class="fa-solid fa-circle-notch fa-spin text-indigo-600"></i> Đang kết nối AI xử lý...
                </div>
            </div>`;
        container.scrollTop = container.scrollHeight;

        // Button state
        btnSend.disabled = true;
        sendIcon.className = "fa-solid fa-circle-notch fa-spin";
        input.disabled = true;

        const testReq = {
            message: text,
            provider: document.getElementById('ai_Provider').value,
            geminiApiKey: document.getElementById('gemini_ApiKey').value.trim(),
            geminiModel: document.getElementById('gemini_Model').value,
            geminiTemperature: parseFloat(document.getElementById('gemini_Temperature').value),
            ollamaBaseUrl: document.getElementById('ollama_BaseUrl').value.trim(),
            ollamaModel: document.getElementById('ollama_Model').value.trim(),
            customSystemPrompt: document.getElementById('ai_SystemPrompt').value
        };

        try {
            const res = await apiFetch('/api-proxy/api/v1/assistant/test-chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(testReq)
            });

            document.getElementById(loadingId)?.remove();

            if (res.ok) {
                const data = await res.json();
                const badgeColor = data.success ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200';
                const formattedReply = formatMarkdown(data.reply);
                
                container.innerHTML += `
                    <div class="flex gap-2.5 items-start">
                        <div class="w-7 h-7 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <div class="space-y-1.5 max-w-[85%]">
                            <div class="bg-slate-50 p-3.5 rounded-2xl rounded-tl-none border border-slate-200 text-slate-800 shadow-2xs leading-relaxed">
                                ${formattedReply}
                            </div>
                            <div class="flex items-center gap-2 text-xs">
                                <span class="px-2.5 py-0.5 rounded-md border ${badgeColor} font-black flex items-center gap-1 min-h-[16px]">
                                    <i class="fa-solid fa-bolt text-xs"></i> ${data.provider} (${data.latencyMs}ms)
                                </span>
                            </div>
                        </div>
                    </div>`;
            } else {
                container.innerHTML += `
                    <div class="flex gap-2.5 items-start">
                        <div class="w-7 h-7 rounded-xl bg-rose-600 text-white flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                        <div class="bg-rose-50 border border-rose-200 text-rose-700 p-3 rounded-2xl rounded-tl-none shadow-2xs max-w-[85%]">
                            Lỗi kiểm tra AI (Mã lỗi ${res.status}). Vui lòng kiểm tra lại API Key hoặc máy chủ Ollama.
                        </div>
                    </div>`;
            }
        } catch (e) {
            document.getElementById(loadingId)?.remove();
            container.innerHTML += `
                <div class="flex gap-2.5 items-start">
                    <div class="w-7 h-7 rounded-xl bg-rose-600 text-white flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div class="bg-rose-50 border border-rose-200 text-rose-700 p-3 rounded-2xl rounded-tl-none shadow-2xs max-w-[85%]">
                        Lỗi kết nối tới máy chủ API.
                    </div>
                </div>`;
        } finally {
            btnSend.disabled = false;
            sendIcon.className = "fa-solid fa-paper-plane";
            input.disabled = false;
            input.focus();
        }

        container.scrollTop = container.scrollHeight;
    }

    // Initialize UI state on page load
    document.addEventListener('DOMContentLoaded', () => {
        updatePromptCounter();
        updateTemperatureLabel(document.getElementById('gemini_Temperature').value);
        highlightActiveProvider();
    });
</script>
}
