@model List<Backend.Models.UserViewModel>

@{
    ViewData["Title"] = "Quản Lý Khách Hàng";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count ?? 0);
    string currentSearch = ViewBag.Search ?? "";
}

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <form method="get" asp-action="Index" class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div class="relative w-full md:w-96">
            <input type="text" name="search" value="@currentSearch" placeholder="Tìm kiếm khách hàng, email..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 pl-11 text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all font-medium placeholder-slate-400" />
            <i class="fa-solid fa-magnifying-glass text-slate-400 absolute left-4 top-3.5 text-sm"></i>
        </div>
    </form>

    <!-- Data Table -->
    <div class="overflow-x-auto min-h-[380px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-wider bg-slate-50/80 border-b border-slate-200">
                    <th class="py-3 px-4 font-bold w-16 text-center rounded-l-xl">ID</th>
                    <th class="py-3 px-4 font-bold">Tài Khoản</th>
                    <th class="py-3 px-4 font-bold">Email</th>
                    <th class="py-3 px-4 font-bold">Quyền Hạn</th>
                    <th class="py-3 px-4 font-bold">Ngày Đăng Ký</th>
                    <th class="py-3 px-4 font-bold text-center">Trạng Thái</th>
                    <th class="py-3 px-4 font-bold text-right rounded-r-xl">Hành Động</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-slate-400 font-medium">
                            <i class="fa-solid fa-users text-3xl text-slate-300 mb-2 block"></i>
                            <span>Chưa có dữ liệu khách hàng.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var u in Model)
                    {
                        var avatarLetter = string.IsNullOrEmpty(u.Username) ? "U" : u.Username.Substring(0, 1).ToUpper();
                        <tr class="hover:bg-slate-50/80 transition-all duration-150 group">
                            <td class="py-3.5 px-4 text-slate-400 font-mono font-bold text-center">#@u.Id</td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-600 text-white font-black text-xs flex items-center justify-center shadow-2xs">@avatarLetter</div>
                                    <div class="font-extrabold text-slate-800 group-hover:text-indigo-600 transition-colors">@u.Username</div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4 text-slate-600 font-medium">@u.Email</td>
                            <td class="py-3.5 px-4">
                                @if (u.RoleName == "Administrator" || u.RoleName == "Admin")
                                {
                                    <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-lg text-xs font-extrabold border border-indigo-200">Admin</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-lg text-xs font-bold border border-slate-200">Customer</span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-slate-400 text-xs font-medium">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="py-3.5 px-4 text-center">
                                @if (u.IsLocked)
                                {
                                    <span class="px-2.5 py-1 bg-rose-50 text-rose-700 rounded-lg text-xs font-bold border border-rose-200"><i class="fa-solid fa-lock mr-1"></i>Đã Khóa</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-200"><i class="fa-solid fa-unlock mr-1"></i>Bình Thường</span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <button onclick="toggleLock(@u.Id, @u.IsLocked.ToString().ToLowerInvariant())" class="w-8 h-8 rounded-lg @(u.IsLocked ? "bg-emerald-50 text-emerald-600 hover:bg-emerald-600" : "bg-rose-50 text-rose-600 hover:bg-rose-600") hover:text-white flex items-center justify-center transition-all shadow-2xs" title="@(u.IsLocked ? "Mở Khóa" : "Khóa")">
                                        <i class="fa-solid @(u.IsLocked ? "fa-unlock" : "fa-lock") text-xs"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-slate-100 pt-6 gap-4">
            <div class="text-sm font-semibold text-slate-500">
                Tổng cộng @totalItems kết quả (Trang @currentPage/@totalPages)
            </div>
            <div class="flex items-center gap-1.5">
                @if (currentPage > 1)
                {
                    <a href="?page=@(currentPage - 1)&search=@currentSearch" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="?page=@i&search=@currentSearch" class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs @(i == currentPage ? "bg-indigo-600 text-white shadow-sm shadow-indigo-200" : "border border-slate-200 bg-white hover:bg-slate-50 text-slate-600") transition-all">@i</a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="?page=@(currentPage + 1)&search=@currentSearch" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    const authHeaders = {};

    async function toggleLock(id, isLocked) {
        if (!confirm("Bạn có chắc chắn muốn thay đổi trạng thái khóa của tài khoản này?")) return;
        try {
            const res = await apiFetch(`/api-proxy/api/v1/users/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json', ...authHeaders },
                body: JSON.stringify({ isLocked: !isLocked })
            });
            if (res.ok) {
                window.location.reload();
            } else {
                alert("Lỗi khi thay đổi trạng thái khóa tài khoản!");
            }
        } catch (e) { console.error(e); }
    }
</script>
}

