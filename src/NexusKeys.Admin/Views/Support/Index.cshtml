@model List<Backend.Models.SupportTicketViewModel>

@{
    ViewData["Title"] = "Quản Lý Yêu Cầu Hỗ Trợ";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count ?? 0);
}

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h3 class="text-xl font-black text-slate-800">Yêu Cầu Hỗ Trợ Khách Hàng (Support Tickets)</h3>
            <p class="text-xs text-slate-400 font-medium mt-1">Tiếp nhận ticket khiếu nại, hỗ trợ kỹ thuật và phản hồi trực tiếp cho khách hàng.</p>
        </div>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto min-h-[380px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-wider bg-slate-50/80 border-b border-slate-200">
                    <th class="py-3 px-4 font-bold w-16 text-center rounded-l-xl">ID</th>
                    <th class="py-3 px-4 font-bold">Chủ Đề</th>
                    <th class="py-3 px-4 font-bold">Email</th>
                    <th class="py-3 px-4 font-bold">Mã Đơn</th>
                    <th class="py-3 px-4 font-bold">Trạng Thái</th>
                    <th class="py-3 px-4 font-bold">Thời Gian</th>
                    <th class="py-3 px-4 font-bold text-right rounded-r-xl">Hành Động</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-slate-400 font-medium">
                            <i class="fa-solid fa-headset text-3xl text-slate-300 mb-2 block"></i>
                            <span>Chưa có yêu cầu hỗ trợ nào.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var t in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-all duration-150 group">
                            <td class="py-3.5 px-4 text-slate-400 font-mono font-bold text-center">#@t.Id</td>
                            <td class="py-3.5 px-4 font-extrabold text-slate-800 group-hover:text-indigo-600 transition-colors">@t.Topic</td>
                            <td class="py-3.5 px-4 text-slate-600 font-medium">@t.Email</td>
                            <td class="py-3.5 px-4 font-mono font-bold text-slate-400">@(string.IsNullOrEmpty(t.OrderId) ? "N/A" : $"#ORD-{t.OrderId}")</td>
                            <td class="py-3.5 px-4">
                                @if (t.Status == "Resolved" || t.Status == "Đã Xử Lý")
                                {
                                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-200">Đã Xử Lý</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-lg text-xs font-bold border border-amber-200">Chờ Phản Hồi</span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-slate-400 text-xs font-medium">@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="py-3.5 px-4 text-right">
                                <button type="button"
                                        data-ticket-id="@t.Id"
                                        data-topic="@t.Topic"
                                        data-content="@t.Content"
                                        data-reply="@(t.AdminReply ?? string.Empty)"
                                        onclick="openReplyModal(this)"
                                        class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold text-xs shadow-sm shadow-indigo-200 transition-all active:scale-95">
                                    <i class="fa-solid fa-reply mr-1"></i> Phản hồi
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-slate-100 pt-6 gap-4">
            <div class="text-sm font-semibold text-slate-500">
                Tổng cộng @totalItems yêu cầu (Trang @currentPage/@totalPages)
            </div>
            <div class="flex items-center gap-1.5">
                @if (currentPage > 1)
                {
                    <a href="?page=@(currentPage - 1)" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="?page=@i" class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs @(i == currentPage ? "bg-indigo-600 text-white shadow-sm shadow-indigo-200" : "border border-slate-200 bg-white hover:bg-slate-50 text-slate-600") transition-all">@i</a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="?page=@(currentPage + 1)" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Modal Reply Ticket -->
<div id="replyModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeReplyModal()"></div>
    
    <div class="relative bg-white rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl border border-slate-200 transform transition-all">
        <div class="p-6 border-b border-slate-100 bg-slate-50/80 flex justify-between items-center">
            <h3 class="text-xl font-black text-slate-800">Phản Hồi Yêu Cầu Hỗ Trợ</h3>
            <button onclick="closeReplyModal()" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-all">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        
        <form id="replyForm" onsubmit="sendReply(event)" class="p-6 space-y-4">
            <input type="hidden" id="tId" />

            <div>
                <label class="block text-xs font-bold text-slate-400 mb-1 uppercase tracking-wider">Chủ Đề Yêu Cầu</label>
                <p id="tTopic" class="text-base font-extrabold text-slate-800 bg-slate-50 p-3 rounded-xl border border-slate-200/80"></p>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-400 mb-1 uppercase tracking-wider">Nội Dung Khách Hàng Gửi</label>
                <p id="tContent" class="text-sm font-medium text-slate-600 bg-slate-50 p-3 rounded-xl border border-slate-200/80 italic"></p>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Nội Dung Phản Hồi Từ Admin</label>
                <textarea id="tReply" rows="3" required placeholder="Nhập câu trả lời chi tiết cho khách hàng..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:border-indigo-500 font-medium"></textarea>
            </div>

            <div class="p-6 border-t border-slate-100 bg-slate-50/60 flex justify-end gap-3 -mx-6 -mb-6 mt-6">
                <button type="button" onclick="closeReplyModal()" class="px-5 py-2.5 rounded-xl text-slate-700 font-bold bg-slate-100 hover:bg-slate-200 transition-all text-xs border border-slate-200">Hủy Bỏ</button>
                <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold transition-all text-xs shadow-sm shadow-indigo-200 active:scale-95">Gửi Phản Hồi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const authHeaders = {};

    function openReplyModal(button) {
        document.getElementById('tId').value = button.dataset.ticketId;
        document.getElementById('tTopic').innerText = button.dataset.topic || '';
        document.getElementById('tContent').innerText = button.dataset.content || '';
        document.getElementById('tReply').value = button.dataset.reply || '';
        document.getElementById('replyModal').classList.remove('hidden');
    }

    function closeReplyModal() {
        document.getElementById('replyModal').classList.add('hidden');
    }

    async function sendReply(e) {
        e.preventDefault();
        const id = document.getElementById('tId').value;
        const replyContent = document.getElementById('tReply').value;

        try {
            const res = await apiFetch(`/api-proxy/api/v1/support-tickets/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json', ...authHeaders },
                body: JSON.stringify({ adminReply: replyContent })
            });

            if (res.ok) {
                closeReplyModal();
                window.location.reload();
            } else {
                alert("Lỗi khi gửi phản hồi!");
            }
        } catch (err) { console.error(err); }
    }
</script>
}

