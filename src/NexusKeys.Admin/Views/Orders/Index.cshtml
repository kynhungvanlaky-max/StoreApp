@model List<Backend.Models.OrderViewModel>

@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count ?? 0);
    string currentSearch = ViewBag.Search ?? "";
    string currentStatus = ViewBag.Status ?? "";
}

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <form method="get" asp-action="Index" class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div class="flex items-center gap-3 flex-1 max-w-xl">
            <div class="relative flex-1">
                <input type="text" name="search" value="@currentSearch" placeholder="Tìm kiếm mã đơn hàng (#ORD-)..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 pl-11 text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all font-medium placeholder-slate-400" />
                <i class="fa-solid fa-magnifying-glass text-slate-400 absolute left-4 top-3.5 text-sm"></i>
            </div>
            <select name="status" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-indigo-500 font-bold cursor-pointer">
                <option value="" selected="@(string.IsNullOrEmpty(currentStatus))">Tất cả trạng thái</option>
                <option value="Completed" selected="@(currentStatus == "Completed")">Hoàn Thành</option>
                <option value="Pending" selected="@(currentStatus == "Pending")">Chờ Xử Lý</option>
                <option value="Failed" selected="@(currentStatus == "Failed")">Thất Bại</option>
            </select>
        </div>
    </form>

    <!-- Orders Data Table -->
    <div class="overflow-x-auto min-h-[380px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-wider bg-slate-50/80 border-b border-slate-200">
                    <th class="py-3 px-4 font-bold w-28 rounded-l-xl">Mã ĐH</th>
                    <th class="py-3 px-4 font-bold">Khách Hàng</th>
                    <th class="py-3 px-4 font-bold">Sản Phẩm</th>
                    <th class="py-3 px-4 font-bold">Tổng Tiền</th>
                    <th class="py-3 px-4 font-bold">Trạng Thái</th>
                    <th class="py-3 px-4 font-bold">Thời Gian</th>
                    <th class="py-3 px-4 font-bold text-right rounded-r-xl">Hành Động</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-slate-400 font-medium">
                            <i class="fa-solid fa-receipt text-3xl text-slate-300 mb-2 block"></i>
                            <span>Chưa có dữ liệu đơn hàng.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var o in Model)
                    {
                        var itemsStr = o.Items != null && o.Items.Any() ? string.Join(", ", o.Items) : "N/A";
                        <tr class="hover:bg-slate-50/80 transition-all duration-150 group">
                            <td class="py-3.5 px-4 font-mono font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">#ORD-@o.Id</td>
                            <td class="py-3.5 px-4 font-semibold text-slate-800">@(string.IsNullOrEmpty(o.Username) ? "Khách Vãng Lai" : o.Username)</td>
                            <td class="py-3.5 px-4 text-slate-600 font-medium max-w-xs truncate" title="@itemsStr">@itemsStr</td>
                            <td class="py-3.5 px-4 font-black text-indigo-600">@o.TotalAmount.ToString("N0")đ</td>
                            <td class="py-3.5 px-4">
                                @if (o.Status == "Completed" || o.Status == "Hoàn Thành")
                                {
                                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-200">Hoàn Thành</span>
                                }
                                else if (o.Status == "Pending" || o.Status == "Chờ Xử Lý")
                                {
                                    <span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-lg text-xs font-bold border border-amber-200">Chờ Xử Lý</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 bg-rose-50 text-rose-700 rounded-lg text-xs font-bold border border-rose-200">Thất Bại</span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-slate-400 text-xs font-medium">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="py-3.5 px-4 text-right">
                                <a href="/Orders/Details/@o.Id" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-indigo-50 text-slate-700 hover:text-indigo-600 rounded-xl text-xs font-bold border border-slate-200 transition-all shadow-2xs">
                                    <i class="fa-solid fa-eye text-xs"></i>
                                    <span>Chi tiết</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-slate-100 pt-6 gap-4">
            <div class="text-sm font-semibold text-slate-500">
                Tổng cộng @totalItems kết quả (Trang @currentPage/@totalPages)
            </div>
            <div class="flex items-center gap-1.5">
                @if (currentPage > 1)
                {
                    <a href="?page=@(currentPage - 1)&search=@currentSearch&status=@currentStatus" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="?page=@i&search=@currentSearch&status=@currentStatus" class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs @(i == currentPage ? "bg-indigo-600 text-white shadow-sm shadow-indigo-200" : "border border-slate-200 bg-white hover:bg-slate-50 text-slate-600") transition-all">@i</a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="?page=@(currentPage + 1)&search=@currentSearch&status=@currentStatus" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>
