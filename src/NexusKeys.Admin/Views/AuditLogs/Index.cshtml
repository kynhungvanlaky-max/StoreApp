@model List<Backend.Models.AuditLogViewModel>

@{
    ViewData["Title"] = "Nhật Ký Hệ Thống (Audit Logs)";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count ?? 0);
}

<div class="admin-card p-8 mb-8">
    <!-- Header Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h3 class="text-xl font-black text-slate-800">Nhật Ký Hoạt Động Quản Trị Hệ Thống</h3>
            <p class="text-xs text-slate-400 font-medium mt-1">Ghi lại toàn bộ lịch sử thao tác thêm, sửa, xóa và thay đổi cấu hình từ các tài khoản Admin.</p>
        </div>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto min-h-[380px]">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-wider bg-slate-50/80 border-b border-slate-200">
                    <th class="py-3 px-4 font-bold w-16 text-center rounded-l-xl">ID</th>
                    <th class="py-3 px-4 font-bold">Admin Thao Tác</th>
                    <th class="py-3 px-4 font-bold">Hành Động (Action)</th>
                    <th class="py-3 px-4 font-bold">Đối Tượng (Entity)</th>
                    <th class="py-3 px-4 font-bold max-w-sm">Chi Tiết</th>
                    <th class="py-3 px-4 font-bold text-right rounded-r-xl">Thời Gian</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="py-12 text-center text-slate-400 font-medium">
                            <i class="fa-solid fa-shield-halved text-3xl text-slate-300 mb-2 block"></i>
                            <span>Chưa có nhật ký hoạt động nào.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var a in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-all duration-150 group">
                            <td class="py-3.5 px-4 text-slate-400 font-mono font-bold text-center">#@a.Id</td>
                            <td class="py-3.5 px-4 font-extrabold text-indigo-600">@a.AdminUsername</td>
                            <td class="py-3.5 px-4 font-bold text-slate-800">@a.Action</td>
                            <td class="py-3.5 px-4">
                                <span class="px-2 py-0.5 bg-slate-100 text-slate-600 font-mono text-xs rounded border border-slate-200">@a.EntityType #@(a.EntityId?.ToString() ?? "N/A")</span>
                            </td>
                            <td class="py-3.5 px-4 text-slate-600 font-medium max-w-sm truncate" title="@a.Details">@(string.IsNullOrEmpty(a.Details) ? "N/A" : a.Details)</td>
                            <td class="py-3.5 px-4 text-right text-slate-400 text-xs font-medium">@a.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-slate-100 pt-6 gap-4">
            <div class="text-sm font-semibold text-slate-500">
                Tổng cộng @totalItems kết quả (Trang @currentPage/@totalPages)
            </div>
            <div class="flex items-center gap-1.5">
                @if (currentPage > 1)
                {
                    <a href="?page=@(currentPage - 1)" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="?page=@i" class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs @(i == currentPage ? "bg-indigo-600 text-white shadow-sm shadow-indigo-200" : "border border-slate-200 bg-white hover:bg-slate-50 text-slate-600") transition-all">@i</a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="?page=@(currentPage + 1)" class="w-9 h-9 flex items-center justify-center border border-slate-200 bg-white hover:bg-slate-50 transition-all text-slate-600 rounded-xl text-xs shadow-2xs">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>
