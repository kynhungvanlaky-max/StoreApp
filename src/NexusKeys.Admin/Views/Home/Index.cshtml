@model Backend.Models.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard Tổng Quan";
    var revenueLabels = JsonSerializer.Serialize(Model.MonthlyRevenue.Select(x => x.Month));
    var revenueValues = JsonSerializer.Serialize(Model.MonthlyRevenue.Select(x => x.Revenue));
    var orderValues = JsonSerializer.Serialize(Model.MonthlyRevenue.Select(x => x.OrdersCount));
    var statusLabels = JsonSerializer.Serialize(Model.OrdersByStatus.Select(x => x.Status switch
    {
        "Completed" => "Đã hoàn thành",
        "Pending" => "Chờ thanh toán",
        "Failed" => "Thất bại",
        _ => x.Status
    }));
    var statusValues = JsonSerializer.Serialize(Model.OrdersByStatus.Select(x => x.Count));
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 lg:gap-6 mb-8">
    <div class="admin-card p-6">
        <p class="text-xs uppercase tracking-wider font-extrabold text-slate-400">Tổng doanh thu</p>
        <h3 class="text-2xl font-black text-indigo-600 mt-2">@Model.TotalRevenue.ToString("N0")đ</h3>
    </div>
    <div class="admin-card p-6">
        <p class="text-xs uppercase tracking-wider font-extrabold text-slate-400">Tổng đơn hàng</p>
        <h3 class="text-2xl font-black text-slate-900 mt-2">@Model.TotalOrders.ToString("N0")</h3>
    </div>
    <div class="admin-card p-6">
        <p class="text-xs uppercase tracking-wider font-extrabold text-slate-400">Key khả dụng</p>
        <h3 class="text-2xl font-black text-amber-600 mt-2">@Model.AvailableKeys.ToString("N0")</h3>
    </div>
    <div class="admin-card p-6">
        <p class="text-xs uppercase tracking-wider font-extrabold text-slate-400">Khách hàng</p>
        <h3 class="text-2xl font-black text-violet-600 mt-2">@Model.CustomerCount.ToString("N0")</h3>
    </div>
    <div class="admin-card p-6">
        <p class="text-xs uppercase tracking-wider font-extrabold text-slate-400">Sản phẩm</p>
        <h3 class="text-2xl font-black text-cyan-600 mt-2">@Model.TotalProducts.ToString("N0")</h3>
    </div>
    <div class="admin-card p-6">
        <p class="text-xs uppercase tracking-wider font-extrabold text-slate-400">Hỗ trợ đang chờ</p>
        <h3 class="text-2xl font-black text-rose-600 mt-2">@Model.PendingSupportTickets.ToString("N0")</h3>
    </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8">
    <div class="admin-card p-6 xl:col-span-2">
        <h3 class="text-lg font-black text-slate-900">Doanh thu và đơn hàng 12 tháng</h3>
        <p class="text-xs text-slate-500 font-semibold mt-1 mb-5">Chỉ tính các đơn đã hoàn thành</p>
        <div class="relative h-[300px]"><canvas id="revenueChart"></canvas></div>
    </div>
    <div class="admin-card p-6">
        <h3 class="text-lg font-black text-slate-900">Đơn hàng theo trạng thái</h3>
        <p class="text-xs text-slate-500 font-semibold mt-1 mb-5">Phân bố dữ liệu hiện tại</p>
        <div class="relative h-[260px]"><canvas id="statusChart"></canvas></div>
    </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <div class="admin-card p-6 xl:col-span-2">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-black text-slate-900">Đơn hàng gần đây</h3>
            <a href="/Orders" class="text-xs font-bold text-indigo-600">Xem tất cả →</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm min-w-[640px]">
                <thead><tr class="border-b text-xs uppercase text-slate-400"><th class="py-3">Mã đơn</th><th>Khách hàng</th><th>Giá trị</th><th>Trạng thái</th><th>Thời gian</th></tr></thead>
                <tbody class="divide-y divide-slate-100">
                @if (!Model.RecentOrders.Any())
                {
                    <tr><td colspan="5" class="py-10 text-center text-slate-400">Chưa có đơn hàng.</td></tr>
                }
                else
                {
                    foreach (var order in Model.RecentOrders)
                    {
                        var (badgeClass, statusText) = order.Status switch
                        {
                            "Completed" => ("bg-emerald-100 text-emerald-800 border border-emerald-200", "Đã hoàn thành"),
                            "Pending" => ("bg-amber-100 text-amber-800 border border-amber-200", "Chờ thanh toán"),
                            "Failed" => ("bg-rose-100 text-rose-800 border border-rose-200", "Thất bại"),
                            _ => ("bg-slate-100 text-slate-700 border border-slate-200", order.Status)
                        };
                        <tr class="hover:bg-slate-50">
                            <td class="py-3 font-bold">#@order.Id</td>
                            <td>@order.CustomerEmail</td>
                            <td class="font-bold">@order.TotalAmount.ToString("N0")đ</td>
                            <td>
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold @badgeClass">
                                    <span class="w-1.5 h-1.5 rounded-full @(order.Status == "Completed" ? "bg-emerald-500" : order.Status == "Pending" ? "bg-amber-500" : order.Status == "Failed" ? "bg-rose-500" : "bg-slate-400")"></span>
                                    @statusText
                                </span>
                            </td>
                            <td class="text-xs text-slate-400">@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-card p-6">
        <h3 class="text-lg font-black text-slate-900 mb-5">Sản phẩm bán chạy</h3>
        <div class="space-y-3">
        @if (!Model.TopProducts.Any())
        {
            <p class="py-8 text-center text-sm text-slate-400">Chưa có dữ liệu bán hàng.</p>
        }
        else
        {
            var rank = 0;
            foreach (var product in Model.TopProducts)
            {
                rank++;
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <div class="flex items-center gap-3 min-w-0"><span class="w-8 h-8 rounded-lg bg-indigo-600 text-white font-black flex items-center justify-center">@rank</span><span class="font-bold text-sm truncate">@product.ProductName</span></div>
                    <div class="text-right ml-3"><p class="text-xs font-black">@product.TotalSold bán</p><p class="text-[11px] text-emerald-600">@product.TotalRevenue.ToString("N0")đ</p></div>
                </div>
            }
        }
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    if (typeof Chart === 'undefined') return;
    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: { labels: @Html.Raw(revenueLabels), datasets: [
            { label: 'Doanh thu (VNĐ)', data: @Html.Raw(revenueValues), borderColor: '#4f46e5', backgroundColor: 'rgba(79,70,229,.08)', fill: true, tension: .35 },
            { label: 'Đơn hàng', data: @Html.Raw(orderValues), borderColor: '#8b5cf6', borderDash: [5,5], tension: .35 }
        ]},
        options: { responsive: true, maintainAspectRatio: false }
    });
    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: { labels: @Html.Raw(statusLabels), datasets: [{ data: @Html.Raw(statusValues), backgroundColor: ['#4f46e5','#10b981','#f59e0b','#ef4444','#8b5cf6'] }] },
        options: { responsive: true, maintainAspectRatio: false, cutout: '68%' }
    });
});
</script>
}
