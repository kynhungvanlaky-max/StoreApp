@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập Quản Trị - NEXUSKEYS";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var frontendUrl = (string?)ViewBag.FrontendUrl ?? Backend.Extensions.PortalUrlHelper.GetFrontendUrl(null, Context);
    var storefrontLoginUrl = (string?)ViewBag.StorefrontLoginUrl ?? $"{frontendUrl}/login?returnUrl=/admin";
    var errorMessage = (string?)ViewBag.ErrorMessage;
}
<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-950">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-4 selection:bg-indigo-500/30 selection:text-indigo-200" style="font-family: 'Be Vietnam Pro', sans-serif;">

    <!-- Login Card: Đơn giản, gọn gàng, căn giữa -->
    <div class="w-full max-w-[420px] bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-6 sm:p-8 space-y-6">

        <!-- Logo & Header -->
        <div class="text-center space-y-2">
            <div class="inline-flex w-12 h-12 rounded-xl bg-indigo-600 text-white items-center justify-center shadow-lg shadow-indigo-600/30">
                <svg class="w-6 h-6" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13 35V13L35 35V13" stroke="currentColor" stroke-width="4.5" stroke-linecap="square" stroke-linejoin="miter" />
                    <circle cx="24" cy="24" r="3.5" fill="currentColor" />
                    <path d="M24 27.5V34" stroke="currentColor" stroke-width="3" stroke-linecap="square" />
                </svg>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-tight text-white">NEXUSKEYS</h1>
                <p class="text-xs text-slate-400 mt-0.5">Cổng Quản Trị Hệ Thống</p>
            </div>
        </div>

        <!-- Error Alert -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="p-3 bg-rose-500/10 border border-rose-500/30 rounded-xl flex items-center gap-2.5 text-rose-300 text-xs font-medium">
                <i class="fa-solid fa-circle-exclamation text-rose-400 shrink-0"></i>
                <div class="flex-1">@errorMessage</div>
            </div>
        }

        <!-- Main Form (Hỗ trợ cả nhập tay và 1-click Demo) -->
        <form method="POST" action="/Auth/Login" class="space-y-4">
            <input type="hidden" name="__RequestVerificationToken" value="@token" />

            <!-- Email -->
            <div>
                <label for="email" class="block text-xs font-semibold text-slate-300 mb-1.5">
                    Email
                </label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 pointer-events-none">
                        <i class="fa-solid fa-envelope text-xs"></i>
                    </span>
                    <input id="email" 
                           type="email" 
                           name="email" 
                           required 
                           value="admin@nexuskeys.com"
                           class="w-full pl-9 pr-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" 
                           placeholder="admin@nexuskeys.com" />
                </div>
            </div>

            <!-- Password -->
            <div>
                <label for="password" class="block text-xs font-semibold text-slate-300 mb-1.5">
                    Mật khẩu
                </label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 pointer-events-none">
                        <i class="fa-solid fa-lock text-xs"></i>
                    </span>
                    <input id="password" 
                           type="password" 
                           name="password" 
                           required 
                           value="Admin123!"
                           class="w-full pl-9 pr-9 py-2 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" 
                           placeholder="••••••••" />
                    <button type="button" 
                            onclick="togglePassword()" 
                            class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-200 transition-colors"
                            title="Hiện/ẩn mật khẩu">
                        <i id="pwdEyeIcon" class="fa-solid fa-eye-slash text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- Nút Đăng Nhập Chính -->
            <button type="submit" 
                    class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-xl shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.99]">
                <i class="fa-solid fa-arrow-right-to-bracket text-xs"></i>
                <span>Đăng nhập</span>
            </button>

            <!-- Khối Demo Nhanh 1-Click (Gọn gàng, đơn giản) -->
            <div class="pt-2 border-t border-slate-800 space-y-2">
                <div class="flex items-center justify-between text-[11px] text-slate-400">
                    <span class="flex items-center gap-1 font-medium">
                        <i class="fa-solid fa-bolt text-amber-400"></i> Đăng nhập nhanh Demo:
                    </span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                    <button type="submit" name="action" value="demo-admin"
                            class="py-1.5 px-2 bg-slate-800 hover:bg-indigo-600/20 border border-slate-700 hover:border-indigo-500/40 text-slate-200 hover:text-indigo-300 rounded-lg text-xs font-medium transition-all text-center active:scale-95"
                            title="Tài khoản Admin (Toàn quyền)">
                        👑 Admin
                    </button>
                    <button type="submit" name="action" value="demo-staff"
                            class="py-1.5 px-2 bg-slate-800 hover:bg-sky-600/20 border border-slate-700 hover:border-sky-500/40 text-slate-200 hover:text-sky-300 rounded-lg text-xs font-medium transition-all text-center active:scale-95"
                            title="Tài khoản Nhân viên (Quản lý đơn, ticket)">
                        🛠️ Staff
                    </button>
                    <button type="submit" name="action" value="demo-dev"
                            class="py-1.5 px-2 bg-slate-800 hover:bg-emerald-600/20 border border-slate-700 hover:border-emerald-500/40 text-slate-200 hover:text-emerald-300 rounded-lg text-xs font-medium transition-all text-center active:scale-95"
                            title="Tài khoản Developer (Nhà phát hành)">
                        💻 Dev
                    </button>
                </div>
            </div>
        </form>

        <!-- Footer Links -->
        <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
            <a href="@frontendUrl" class="hover:text-indigo-300 transition-colors inline-flex items-center gap-1.5">
                <i class="fa-solid fa-store text-[11px]"></i>
                <span>Xem Cửa Hàng</span>
            </a>
            <a href="@storefrontLoginUrl" class="hover:text-indigo-300 transition-colors inline-flex items-center gap-1.5">
                <span>Storefront Login</span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>
        </div>

    </div>

    <!-- Toggle Password Visibility Script -->
    <script>
        function togglePassword() {
            const pwd = document.getElementById('password');
            const icon = document.getElementById('pwdEyeIcon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            } else {
                pwd.type = 'password';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
        }
    </script>
</body>
</html>
