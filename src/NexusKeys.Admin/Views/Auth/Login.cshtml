@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập Quản Trị - NEXUSKEYS";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var frontendUrl = (string?)ViewBag.FrontendUrl ?? Backend.Extensions.PortalUrlHelper.GetFrontendUrl(null, Context);
    var storefrontLoginUrl = (string?)ViewBag.StorefrontLoginUrl ?? $"{frontendUrl}/login?returnUrl=/admin";
    var errorMessage = (string?)ViewBag.ErrorMessage;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts: Inter / Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexus-admin.css" asp-append-version="true" />
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 selection:bg-indigo-500/30 selection:text-indigo-200" style="font-family: 'Be Vietnam Pro', sans-serif;">
    <div class="w-full max-w-md bg-slate-800/90 backdrop-blur-xl rounded-3xl border border-slate-700/80 shadow-2xl p-6 sm:p-8 space-y-6">
        
        <!-- Brand Logo Header -->
        <div class="text-center space-y-2">
            <div class="inline-flex w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-600 text-white items-center justify-center mb-1 shadow-lg shadow-indigo-500/30">
                <svg class="w-7 h-7" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13 35V13L35 35V13" stroke="currentColor" stroke-width="4.5" stroke-linecap="square" stroke-linejoin="miter" />
                    <circle cx="24" cy="24" r="3.5" fill="currentColor" />
                    <path d="M24 27.5V34" stroke="currentColor" stroke-width="3" stroke-linecap="square" />
                </svg>
            </div>
            <div class="flex items-center justify-center gap-1.5 text-lg font-black tracking-wider text-white">
                <span>NEXUS</span><span class="text-indigo-400">KEYS</span>
                <span class="ml-1 px-2 py-0.5 text-[10px] uppercase font-bold tracking-widest bg-indigo-500/20 text-indigo-300 rounded-md border border-indigo-500/40">Portal</span>
            </div>
            <p class="text-xs text-slate-400">Cổng Quản Trị Hệ Thống NexusKeys</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="p-3.5 bg-rose-500/10 border border-rose-500/30 rounded-xl flex items-start gap-3 text-rose-300 text-xs font-medium">
                <i class="fa-solid fa-triangle-exclamation text-rose-400 mt-0.5 text-sm"></i>
                <div class="flex-1">@errorMessage</div>
            </div>
        }

        <!-- Demo Admin 1-Click Card -->
        <div class="bg-gradient-to-r from-purple-900/30 via-indigo-900/20 to-purple-900/30 border border-purple-500/40 rounded-2xl p-4 text-center space-y-3">
            <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-purple-300 uppercase tracking-wider flex items-center gap-1.5">
                    <i class="fa-solid fa-shield-halved text-purple-400"></i> Trải Nghiệm Demo
                </span>
                <span class="text-[10px] font-mono text-purple-200/70 bg-purple-500/20 px-2 py-0.5 rounded-full border border-purple-500/30">Administrator</span>
            </div>
            
            <form method="POST" action="/Auth/Login">
                <input type="hidden" name="__RequestVerificationToken" value="@token" />
                <input type="hidden" name="email" value="admin@nexuskeys.com" />
                <input type="hidden" name="password" value="Admin123!" />
                <button type="submit" name="action" value="demo"
                        class="w-full py-3 px-4 bg-gradient-to-r from-purple-600 via-indigo-600 to-purple-700 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-purple-600/30 hover:shadow-purple-600/50 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]">
                    <i class="fa-solid fa-bolt text-yellow-300"></i>
                    <span>Đăng nhập Demo Admin (1-Click)</span>
                </button>
            </form>

            <div class="flex items-center justify-between text-[11px] text-slate-400 pt-1 border-t border-purple-500/20 font-mono">
                <span>admin@nexuskeys.com</span>
                <span>Admin123!</span>
            </div>
        </div>

        <div class="relative flex items-center justify-center">
            <div class="border-t border-slate-700 w-full"></div>
            <span class="bg-slate-800 px-3 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Hoặc nhập tài khoản</span>
        </div>

        <!-- Direct Email/Password Login Form -->
        <form method="POST" action="/Auth/Login" class="space-y-4">
            <input type="hidden" name="__RequestVerificationToken" value="@token" />

            <div>
                <label for="admin-email" class="block text-xs font-semibold text-slate-300 mb-1.5">Địa chỉ Email</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-envelope text-xs"></i>
                    </span>
                    <input id="admin-email" 
                           type="email" 
                           name="email" 
                           required 
                           value="admin@nexuskeys.com"
                           class="w-full pl-10 pr-4 py-2.5 bg-slate-900/80 border border-slate-700 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all" 
                           placeholder="admin@nexuskeys.com" />
                </div>
            </div>

            <div>
                <label for="admin-password" class="block text-xs font-semibold text-slate-300 mb-1.5">Mật khẩu</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-lock text-xs"></i>
                    </span>
                    <input id="admin-password" 
                           type="password" 
                           name="password" 
                           required 
                           value="Admin123!"
                           class="w-full pl-10 pr-4 py-2.5 bg-slate-900/80 border border-slate-700 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all" 
                           placeholder="••••••••" />
                </div>
            </div>

            <button type="submit" 
                    class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/50 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]">
                <i class="fa-solid fa-arrow-right-to-bracket text-xs"></i>
                <span>Đăng nhập Quản Trị</span>
            </button>
        </form>

        <!-- Secondary Actions -->
        <div class="pt-2 border-t border-slate-700/60 text-center space-y-2.5 text-xs text-slate-400">
            <div>
                <span>Muốn đăng nhập qua tài khoản Web?</span>
                <a href="@storefrontLoginUrl" class="text-indigo-400 hover:text-indigo-300 font-semibold hover:underline ml-1">
                    Đăng nhập qua Storefront &rarr;
                </a>
            </div>
            <div>
                <a href="@frontendUrl" class="text-slate-500 hover:text-slate-300 transition-colors text-[11px] inline-flex items-center gap-1.5">
                    <i class="fa-solid fa-house text-[10px]"></i> Về trang chủ Cửa hàng NexusKeys
                </a>
            </div>
        </div>

    </div>
</body>
</html>
