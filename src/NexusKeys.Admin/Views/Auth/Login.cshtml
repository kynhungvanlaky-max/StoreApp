@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập Cổng Quản Trị - NEXUSKEYS";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var frontendUrl = (string?)ViewBag.FrontendUrl ?? Backend.Extensions.PortalUrlHelper.GetFrontendUrl(null, Context);
    var storefrontLoginUrl = (string?)ViewBag.StorefrontLoginUrl ?? $"{frontendUrl}/login?returnUrl=/admin";
    var errorMessage = (string?)ViewBag.ErrorMessage;
}
<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-950">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Tailwind CSS JIT -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    colors: {
                        nexus: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            400: '#818cf8',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nexus-admin.css" asp-append-version="true" />
    <style>
        @@keyframes pulseSlow {
            0%, 100% { opacity: 0.35; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(1.08); }
        }
        .glow-blob-1 {
            animation: pulseSlow 8s ease-in-out infinite;
        }
        .glow-blob-2 {
            animation: pulseSlow 10s ease-in-out infinite 2s;
        }
        .admin-glass {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.85) 0%, rgba(15, 23, 42, 0.95) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
    </style>
</head>
<body class="h-full bg-slate-950 text-slate-100 flex items-center justify-center p-4 sm:p-6 lg:p-8 font-sans selection:bg-indigo-500/30 selection:text-indigo-200 relative overflow-x-hidden min-h-screen">

    <!-- Ambient Glowing Background Aura -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
        <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-indigo-600/20 rounded-full blur-[140px] glow-blob-1"></div>
        <div class="absolute -bottom-40 -right-40 w-[650px] h-[650px] bg-purple-600/20 rounded-full blur-[160px] glow-blob-2"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-600/10 rounded-full blur-[180px]"></div>
        <!-- Subtle Grid Pattern -->
        <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:24px_24px]"></div>
    </div>

    <!-- Main Container: 2-Column Split Showcase on Desktop -->
    <main class="w-full max-w-5xl rounded-3xl border border-slate-800/80 shadow-[0_25px_70px_rgba(0,0,0,0.6)] admin-glass overflow-hidden my-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[640px]">
            
            <!-- LEFT COLUMN: Brand Story, System Highlights & Live Architecture (5 cols) -->
            <div class="lg:col-span-5 bg-gradient-to-br from-slate-900/90 via-indigo-950/40 to-slate-950/90 p-8 sm:p-10 border-b lg:border-b-0 lg:border-r border-slate-800/70 flex flex-col justify-between relative overflow-hidden">
                <!-- Inner Decorative Glow -->
                <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10 space-y-6">
                    <!-- Brand Badge & Logo -->
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-purple-600 text-white flex items-center justify-center shadow-lg shadow-indigo-500/30 flex-shrink-0">
                            <svg class="w-7 h-7" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M13 35V13L35 35V13" stroke="currentColor" stroke-width="4.5" stroke-linecap="square" stroke-linejoin="miter" />
                                <circle cx="24" cy="24" r="3.5" fill="currentColor" />
                                <path d="M24 27.5V34" stroke="currentColor" stroke-width="3" stroke-linecap="square" />
                            </svg>
                        </div>
                        <div>
                            <div class="flex items-center gap-1.5 leading-none">
                                <span class="text-xl font-black tracking-wider text-white">NEXUS</span>
                                <span class="text-xl font-black tracking-wider text-indigo-400">KEYS</span>
                            </div>
                            <span class="inline-block mt-1 px-2 py-0.5 text-[9px] uppercase font-bold tracking-widest bg-indigo-500/20 text-indigo-300 rounded-md border border-indigo-500/30 font-mono">
                                Admin Studio v2.5
                            </span>
                        </div>
                    </div>

                    <!-- Intro Title -->
                    <div class="space-y-2 pt-2">
                        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight leading-snug">
                            Hệ Thống Quản Trị & <span class="bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">Cấp Phát License</span>
                        </h1>
                        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-normal">
                            Trung tâm giám sát toàn diện: kho License key game AAA, luồng xử lý đơn hàng tự động, quản lý người dùng và trợ lý ảo AI.
                        </p>
                    </div>

                    <!-- Core Architecture Features -->
                    <div class="space-y-3 pt-2">
                        <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-800/40 border border-slate-700/40">
                            <div class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center shrink-0 text-xs font-bold">
                                <i class="fa-solid fa-microchip"></i>
                            </div>
                            <div class="text-xs">
                                <p class="font-bold text-slate-200">.NET 10 & Clean Architecture</p>
                                <p class="text-[11px] text-slate-400">Deadlock-free concurrency, xử lý tranh chấp key tức thì.</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-800/40 border border-slate-700/40">
                            <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-xs font-bold">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div class="text-xs">
                                <p class="font-bold text-slate-200">Bảo Mật Phân Quyền RBAC</p>
                                <p class="text-[11px] text-slate-400">Kiểm soát chặt chẽ giữa Admin, Staff & Developer.</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-800/40 border border-slate-700/40">
                            <div class="w-8 h-8 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center shrink-0 text-xs font-bold">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </div>
                            <div class="text-xs">
                                <p class="font-bold text-slate-200">Nexus Gemini AI Assistant</p>
                                <p class="text-[11px] text-slate-400">Cấu hình prompt, nhiệt độ và test phản hồi trực tiếp.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Status Pill -->
                <div class="relative z-10 pt-6 mt-6 border-t border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span class="font-mono text-emerald-300 font-semibold">PostgreSQL 16+ Online</span>
                    </div>
                    <span class="font-mono text-slate-500 text-[10px]">Render Cloud Free</span>
                </div>
            </div>

            <!-- RIGHT COLUMN: Interactive Login Form & 1-Click Role Switcher (7 cols) -->
            <div class="lg:col-span-7 p-6 sm:p-10 flex flex-col justify-between space-y-6">
                
                <div>
                    <!-- Top Action Bar -->
                    <div class="flex items-center justify-between pb-6 border-b border-slate-800/80">
                        <div>
                            <h2 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
                                <i class="fa-solid fa-door-open text-indigo-400 text-base"></i> Đăng Nhập Quản Trị
                            </h2>
                            <p class="text-xs text-slate-400 mt-0.5">Xác thực quyền truy cập vào cổng điều hành hệ thống.</p>
                        </div>
                        <a href="@frontendUrl" 
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-indigo-300 hover:text-white transition-all shadow-sm group">
                            <i class="fa-solid fa-store group-hover:scale-110 transition-transform"></i>
                            <span class="hidden sm:inline">Xem Cửa Hàng</span>
                        </a>
                    </div>

                    <!-- Error Alert (If Any) -->
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mt-5 p-3.5 bg-rose-500/10 border border-rose-500/30 rounded-2xl flex items-start gap-3 text-rose-300 text-xs font-medium animate-[shake_0.4s_ease-in-out]">
                            <i class="fa-solid fa-circle-exclamation text-rose-400 mt-0.5 text-sm shrink-0"></i>
                            <div class="flex-1 leading-relaxed">@errorMessage</div>
                        </div>
                    }

                    <!-- 1-Click Role Demo Selector Section -->
                    <div class="mt-6 bg-slate-900/60 border border-indigo-500/20 rounded-2xl p-4 sm:p-5 space-y-3.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black uppercase tracking-wider text-indigo-300 flex items-center gap-1.5">
                                <i class="fa-solid fa-bolt text-amber-400"></i> Đăng Nhập 1-Click Theo Vai Trò
                            </span>
                            <span class="text-[10px] text-slate-400 font-medium">Bấm vào vai trò để vào ngay</span>
                        </div>

                        <!-- 3 Demo Role Cards -->
                        <form method="POST" action="/Auth/Login" class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                            <input type="hidden" name="__RequestVerificationToken" value="@token" />

                            <!-- Admin Demo -->
                            <button type="submit" name="action" value="demo-admin"
                                    class="p-3 rounded-xl bg-gradient-to-b from-purple-900/40 to-slate-900/90 border border-purple-500/40 hover:border-purple-400 hover:bg-purple-900/50 text-left transition-all group active:scale-95 shadow-sm">
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-xs font-black text-white group-hover:text-purple-300 transition-colors flex items-center gap-1.5">
                                        👑 Admin
                                    </span>
                                    <i class="fa-solid fa-arrow-right text-[10px] text-purple-400 group-hover:translate-x-0.5 transition-transform"></i>
                                </div>
                                <p class="text-[10px] text-purple-200/80 truncate">admin@nexuskeys.com</p>
                                <span class="inline-block mt-1 text-[9px] font-mono font-semibold text-purple-300 bg-purple-500/20 px-1.5 py-0.5 rounded">Toàn quyền</span>
                            </button>

                            <!-- Staff Demo -->
                            <button type="submit" name="action" value="demo-staff"
                                    class="p-3 rounded-xl bg-gradient-to-b from-sky-900/40 to-slate-900/90 border border-sky-500/40 hover:border-sky-400 hover:bg-sky-900/50 text-left transition-all group active:scale-95 shadow-sm">
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-xs font-black text-white group-hover:text-sky-300 transition-colors flex items-center gap-1.5">
                                        🛠️ Nhân Viên
                                    </span>
                                    <i class="fa-solid fa-arrow-right text-[10px] text-sky-400 group-hover:translate-x-0.5 transition-transform"></i>
                                </div>
                                <p class="text-[10px] text-sky-200/80 truncate">staff@nexuskeys.com</p>
                                <span class="inline-block mt-1 text-[9px] font-mono font-semibold text-sky-300 bg-sky-500/20 px-1.5 py-0.5 rounded">Đơn & Ticket</span>
                            </button>

                            <!-- Developer Demo -->
                            <button type="submit" name="action" value="demo-dev"
                                    class="p-3 rounded-xl bg-gradient-to-b from-emerald-900/40 to-slate-900/90 border border-emerald-500/40 hover:border-emerald-400 hover:bg-emerald-900/50 text-left transition-all group active:scale-95 shadow-sm">
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-xs font-black text-white group-hover:text-emerald-300 transition-colors flex items-center gap-1.5">
                                        💻 Developer
                                    </span>
                                    <i class="fa-solid fa-arrow-right text-[10px] text-emerald-400 group-hover:translate-x-0.5 transition-transform"></i>
                                </div>
                                <p class="text-[10px] text-emerald-200/80 truncate">dev@cdprojekt.com</p>
                                <span class="inline-block mt-1 text-[9px] font-mono font-semibold text-emerald-300 bg-emerald-500/20 px-1.5 py-0.5 rounded">Nhà phát hành</span>
                            </button>
                        </form>
                    </div>

                    <!-- Divider -->
                    <div class="relative flex items-center justify-center my-6">
                        <div class="border-t border-slate-800 w-full"></div>
                        <span class="bg-slate-900/90 px-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Hoặc nhập email & mật khẩu</span>
                    </div>

                    <!-- Direct Email/Password Form -->
                    <form id="loginForm" method="POST" action="/Auth/Login" class="space-y-4">
                        <input type="hidden" name="__RequestVerificationToken" value="@token" />

                        <!-- Email Input -->
                        <div>
                            <label for="admin-email" class="block text-xs font-bold text-slate-300 mb-1.5">
                                Địa chỉ Email Tài khoản
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-envelope text-xs"></i>
                                </span>
                                <input id="admin-email" 
                                       type="email" 
                                       name="email" 
                                       required 
                                       value="admin@nexuskeys.com"
                                       class="w-full pl-10 pr-4 py-2.5 bg-slate-950/70 border border-slate-700/80 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all font-medium" 
                                       placeholder="admin@nexuskeys.com" />
                            </div>
                        </div>

                        <!-- Password Input with Toggle Eye -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label for="admin-password" class="block text-xs font-bold text-slate-300">
                                    Mật khẩu
                                </label>
                                <span class="text-[10px] font-mono text-slate-500">Mặc định: Admin123!</span>
                            </div>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-lock text-xs"></i>
                                </span>
                                <input id="admin-password" 
                                       type="password" 
                                       name="password" 
                                       required 
                                       value="Admin123!"
                                       class="w-full pl-10 pr-10 py-2.5 bg-slate-950/70 border border-slate-700/80 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all font-mono tracking-wider" 
                                       placeholder="••••••••" />
                                <button type="button" 
                                        onclick="togglePassword()" 
                                        class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-200 transition-colors cursor-pointer"
                                        title="Ẩn / Hiện mật khẩu">
                                    <i id="pwdEyeIcon" class="fa-solid fa-eye-slash text-xs"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" 
                                class="w-full py-3 px-4 bg-gradient-to-r from-indigo-600 via-indigo-500 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/50 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98] mt-2">
                            <i class="fa-solid fa-shield-halved text-xs"></i>
                            <span>ĐĂNG NHẬP VÀO HỆ THỐNG</span>
                        </button>
                    </form>
                </div>

                <!-- Footer / Secondary Links -->
                <div class="pt-4 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400">
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-user-lock text-[10px] text-slate-500"></i>
                        <span>Đăng nhập với phiên Storefront?</span>
                        <a href="@storefrontLoginUrl" class="text-indigo-400 hover:text-indigo-300 font-bold hover:underline">
                            Chuyển sang Storefront &rarr;
                        </a>
                    </div>
                    <span class="text-[11px] font-mono text-slate-500">
                        RFC 7807 • JWT Protected
                    </span>
                </div>

            </div>

        </div>
    </main>

    <!-- JavaScript Helpers: Password toggle & Fill helper -->
    <script>
        function togglePassword() {
            const pwdInput = document.getElementById('admin-password');
            const eyeIcon = document.getElementById('pwdEyeIcon');
            if (pwdInput.type === 'password') {
                pwdInput.type = 'text';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            } else {
                pwdInput.type = 'password';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            }
        }
    </script>
</body>
</html>
